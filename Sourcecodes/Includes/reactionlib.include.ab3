;-- basic implementation of NewList-macro
;-- not used atm
Statement NewL{*listPtr.List}
  *listPtr\lh_Head = &*listPtr\lh_Tail
  *listPtr\lh_Tail = 0
  *listPtr\lh_TailPred = &*listPtr\lh_Head
End Statement

;-- general init of a given list
Function.List InitList{*list1.List}
  If *list1 Then NewList(*list1)
  Function Return *list1  
End Statement

; *********************************************************************************

Function.List InitChooserList{}
  *list1.List = AllocMem_(SizeOf.List, #MEMF_PUBLIC)
  If *list1 Then NewList(*list1)
  ;NPrint "new list at ", Hex$(*list1)
  Function Return *list1
End Function

Statement AddChooserListEntry{*listPtr.List, entry.s}
  If *listPtr
    _tags.l = VarArgs(#CNA_Text, StrAddr(entry), #TAG_DONE)
    *node.Node = AllocChooserNodeA_(_tags)
    If *node Then AddTail_ *listPtr, *node
    ;NPrint "added node ", Hex$(*node)
  EndIf
End Statement

Statement FreeChooserLabels{*listPtr.List}
  If *listPtr
    *ln.Node = *listPtr\lh_Head
    Repeat
      *succ.Node = *ln\ln_Succ
      If Peek.l(*ln) <> 0
        FreeChooserNode_ *ln
        ;NPrint "freed node ", Hex$(*ln)
      EndIf
      *ln = *succ
    Until *succ = 0

    FreeMem_ *listPtr, SizeOf.List
  EndIf
End Statement

; *********************************************************************++++
Statement FreeClickTabs{*list1.List}
  If *list1
    *ln.Node = 0
    Repeat
      *ln = RemHead_(*list1)
      If *ln Then FreeClickTabNode_(*ln)
    Until *ln = 0
    FreeMem_ *list1, SizeOf.List
  EndIf
End Statement

Function.List ClickTabsA{text.s}
  *list1.List = AllocMem_(SizeOf.List, #MEMF_PUBLIC)
  
  If *list1 
    NewList(*list1)
    id.w = 0 
    Repeat
      entry.s = ""
      If Instr(text,"|")
        entry.s = Left$(text,Instr(text,"|")-1)
        text = UnRight$(text,FLen(entry)+1)
      Else
        entry = text
        text = UnRight$(text,FLen(entry))
      EndIf

      If entry
        _tags.l = VarArgs(#TNA_Text, StrAddr(entry), #TNA_Number, id, #TAG_DONE)
        *node.Node = AllocClickTabNodeA_(_tags)
    
        If *node <> 0 
          AddTail_ *list1, *node
          id + 1
        Else
          FreeClickTabs{*list1}
          *list1 = 0
         entry = ""
        EndIf
      EndIf
    Until entry = ""
  EndIf
  Function Return *list1
End Statement

;****************************************************************************/

Function.List InitListBrowserList{}
  *list1.List = AllocMem_(SizeOf.List, #MEMF_PUBLIC)
  If *list1 Then NewList(*list1)
  Function Return *list1
End Function

Statement AddListBrowserListEntry{*listPtr.List, columns.w, _tags.l}
  If *listPtr <> 0 AND _tags <> 0
    *node.Node = AllocListBrowserNodeA_(columns,_tags)
    If *node Then AddTail_ *listPtr, *node
  EndIf
End Statement

Statement FreeListBrowserNodes{*list1.List}
  If *list1
    FreeListBrowserList_ *list1
    FreeMem_ *list1, SizeOf.List
  EndIf
End Statement

;--
;-- creates a labellist for a one column listview only
;--
Function.List BrowserNodesA{text.s}
  *list1.List = AllocMem_(SizeOf.List, #MEMF_PUBLIC)
  
  If *list1 
    NewList(*list1)

    Repeat
      entry.s = ""
      If Instr(text,"|")
        entry.s = Left$(text,Instr(text,"|")-1)
        text = UnRight$(text,FLen(entry)+1)
      Else
        entry = text
        text = UnRight$(text,FLen(entry))
      EndIf

      If entry
          NPrint "added " + entry
        _tags.l = VarArgs(#LBNA_Column, 0, #LBNCA_Text, StrAddr(entry), #TAG_DONE)
        *node.Node = AllocListBrowserNodeA_(1,_tags)

        If *node <> 0 
          AddTail_ *list1, *node
        Else
          FreeListBrowserNodes{*list1}
          *list1 = 0
         entry = ""
        EndIf
      EndIf
    Until entry = ""
  EndIf  
  Function Return *list1
End Function

;****************************************************************************/
Statement FreeRadioButtons{*list1.List}
  If *list1
    *ln.Node = *list1\lh_Head
    Repeat
      *succ.Node = *ln\ln_Succ
      If Peek.l(*ln) <> 0
        FreeRadioButtonNode_ *ln
      EndIf
      *ln = *succ
    Until *succ = 0

    FreeMem_ *list1, SizeOf.List
  EndIf
End Statement

Function.List RadioButtonsA{text.s}
  *list1.List = AllocMem_(SizeOf.List, #MEMF_PUBLIC)
  
  If *list1 
    NewList(*list1)
    id.w = 0
    Repeat
      entry.s = ""
      If Instr(text,"|")
        entry.s = Left$(text,Instr(text,"|")-1)
        text = UnRight$(text,FLen(entry)+1)
      Else
        entry = text
        text = UnRight$(text,FLen(entry))
      EndIf

      If entry
        NPrint "added " + entry
        _tags.l = VarArgs(#RBNA_Labels, StrAddr(entry), #TAG_DONE)
        *node.Node = AllocRadioButtonNodeA_(id, _tags)

        If *node <> 0
          AddTail_ *list1, *node
          id + 1
        Else
          FreeRadioButtons{*list1}
          *list1 = 0
          entry = ""
        EndIf
      EndIf
    Until entry = ""
  EndIf  
  Function Return *list1
End Function

;****************************************************************************/
Function.ListLabelNode AddListviewLabel{*list1.List,label.s,id.w}
  If *list1
    If label <> ""
      *node.ListLabelNode = AllocVec_(SizeOf.ListLabelNode, #MEMF_ANY | #MEMF_CLEAR)
      If *node
        *node\lvn_RenderForeground = 1
        *node\lvn_RenderBackground = 0
        *node\lvn_SelectForeground = 2
        *node\lvn_SelectBackground = 3
        *node\lvn_Node\ln_Name = StrAddr(label)
        If id>-1 Then *node\lvn_Node\ln_Type = id AND 255
        AddTail_ *list1, *node
        Function Return *node
      EndIf
    EndIf
  EndIf
End Function

Function.List ListviewLabelsA{text.s}
  *list1.List = AllocMem_(SizeOf.List, #MEMF_PUBLIC)
  If *list1 Then NewList(*list1)

  If text <> ""
    id.w = 0
    Repeat
      entry.s = ""
      If Instr(text,"|")
        entry.s = Left$(text,Instr(text,"|")-1)
        text = UnRight$(text,FLen(entry)+1)
      Else
        entry = text
        text = UnRight$(text,FLen(entry))
      EndIf

      If entry
        *node.ListLabelNode = AddListviewLabel{*list1,entry,id}
        If *node
          id + 1
        Else
          entry = ""
         EndIf
      EndIf
    Until entry = ""  
  EndIf

  Function Return *list1
End Function


Statement FreeListviewLabels{*list1.List}
  If *list1
    *ln.Node = *list1\lh_Head
    Repeat
      *succ.Node = *ln\ln_Succ

      If Peek.l(*ln) <> 0 Then FreeVec_ *ln

      *ln = *succ
    Until *succ = 0

    FreeMem_ *list1, SizeOf.List
  EndIf
End Statement

