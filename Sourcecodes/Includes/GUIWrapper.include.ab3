Function.l GUI_OpenWindow{winid.s, wx.w, wy.w, ww.w, wh.w,@winobj.l}
  If GUIMode = #GUI_WIZARD
    WZWindow WZID(winid),?wzgui,128,wx,wy,ww,wh,WZID(winid)
    Use Window WZID(winid)
  EndIf

  If GUIMode = #GUI_REACTION
    If winobj > 0
      *win.Window = !RA_OpenWindow{winobj}
      If *win
        UseAsBlitzWin WZID(winid), *win, winobj
        GUI_AttachGadgetsToWindow{WZID(winid)}
        Use Window WZID(winid)
        Function Return *win
      EndIf
    Else
      error{"No window object!"}
    EndIf
  EndIf
  

End Function

Function.l GUI_CloseWindow{winid.s}
  If GUIMode = #GUI_WIZARD
    WZCloseWindow WZID(winid)
  EndIf

  If GUIMode = #GUI_REACTION
    winptr.l = Peek.l(Addr Window(WZID(winid)))
    winobj.l = Peek.l(Addr Window(WZID(winid)) + $10)
    If winptr AND winobj
      If GetAttr_(#WINDOW_AppPort, winobj, &appport.l)
        DeleteMsgPort_ appport
      EndIf
      If GetAttr_(#WINDOW_MenuStrip, winobj, &menuStrip.l)
        ClearMenuStrip_ winptr
      EndIf

      UnuseBlitzWin WZID(winid)
    EndIf
  EndIf
End Function

;==================================================================================
Function.s GUI_MenuName{}
SHARED guimenulist()
  If GUIMode = #GUI_WIZARD
    Function Return WZMenuName
  EndIf
  If GUIMode = #GUI_REACTION
    *winptr.Window = Peek.l(Addr Window(Used Window))
    item.l = ItemAddress_(*winptr\MenuStrip,EventCode)
    If item
      userdata.l = PeekL(item + $22)
      Function Return GUI_GetMenuName{userdata}
    EndIf

  EndIf
End Function

Function.s GUI_GadName{}
  If GUIMode = #GUI_WIZARD
    Function Return WZGadName
  EndIf

  If GUIMode = #GUI_REACTION
    *gad1.gadgetobject = GUI_GetGadgetById{GadgetHit,EventWindow}
    If *gad1
      Function Return *gad1\name
    EndIf
  EndIf
End Function

Function.s GUI_GetGadgetString{gadid.s}
  If GUIMode = #GUI_WIZARD
    Function Return WZ_GetStringField{gadid.s}
  EndIf

  If GUIMode = #GUI_REACTION
    gadobj.l = GUI_GetObjectValueLong{gadid}
    If gadobj
      result.l = 0 
      GetAttr_ #STRINGA_TextVal, gadobj, &result
      If result
        Function Return Peek.s(Peek.l(result))
      EndIf
    Else
      error{"Gadget is not valid."}
    EndIf
  EndIf
End Statement


Statement GUI_SetGadgetString{gadid.s, message.s}
  winptr.l = Peek.l(Addr Window(Used Window))
  gadobj.l = GUI_GetObjectValueLong{gadid}
  If gadobj AND winptr  
    SetGadgetAttrsA_ gadobj, winptr, 0, VarArgs(#GA_Text,StrAddr(message),#TAG_DONE)
  Else
    error{"Could not set gadget string! " + Hex$(winptr) + " " + Hex$(gadobj)}
  EndIf
End Statement


Macro GUI_Print; {gadid.s, value.l, @attribute.l}
  If GUIMode = #GUI_WIZARD
    WZPrint `1, `2
  EndIf

  If GUIMode = #GUI_REACTION
    winptr.l = Peek.l(Addr Window(Used Window))
    *gad1.gadgetobject = GUI_GetGadgetByName{`1}
    gadobj.l = *gad1\reactionobject
    If gadobj AND winptr
;      CNIF `0 = 2
;      SetGadgetAttrsA_ *gad1\reactionobject, winptr, 0, VarArgs(`3, `2, #TAG_DONE)
;      CELSE
      SetGadgetAttrsA_ *gad1\reactionobject, winptr, 0, VarArgs(#GA_Text, `2, #TAG_DONE)
;      CEND
    Else
      error{"Could not set gadget attribute! " + Hex$(winptr) + " " + Hex$(gadobj)}
    EndIf
  EndIf
End Macro

Function.l GUI_Input{@attribute.l}
  If GUIMode = #GUI_WIZARD
    Function Return WZInput
  EndIf

  If GUIMode = #GUI_REACTION
    *gad1.gadgetobject = GUI_GetGadgetById{GadgetHit}
    *gadobj.l = *gad1\reactionobject
    If *gadobj
      GetAttr_ attribute, *gadobj, &result.l
      Function Return result
    EndIf
  EndIf
End Function

;==================================================================================

Statement GUI_ClearTable{gadid.s}
SHARED guitabledata()

  If GUIMode = #GUI_WIZARD
    WZ_ClearTable{gadid}
  EndIf

  If GUIMode = #GUI_REACTION
    id.w = GUI_GetTableId{gadid}

    If guitabledata(id)\labels
      FreeListBrowserNodes{guitabledata(id)\labels} 
      guitabledata(id)\labels = InitListBrowserList{}
    EndIf
  EndIf
End Statement

Statement GUI_KillTable{gadid.s}
SHARED guitabledata()

  If GUIMode = #GUI_WIZARD
    WZ_KillTable{gadid}
  EndIf

  If GUIMode = #GUI_REACTION
    id.w = GUI_GetTableId{gadid}

    If guitabledata(id)\columninfo
      FreeLBColumnInfo_ guitabledata(id)\columninfo : guitabledata(id)\columninfo = 0
    EndIf

    If guitabledata(id)\labels
      FreeListBrowserNodes{guitabledata(id)\labels} : guitabledata(id)\labels = 0
    EndIf

  EndIf
End Statement

Statement GUI_UpdateTable{gadid.s}
SHARED guitabledata()

  If GUIMode = #GUI_WIZARD
    WZ_UpdateTable{gadid}
  EndIf

  If GUIMode = #GUI_REACTION
    id.w = GUI_GetTableId{gadid}
    *win.Window = guitabledata(id)\window
    *gad.l = guitabledata(id)\gadobject
    *cinfo.ColumnInfo = guitabledata(id)\columninfo
    *lblist.List = guitabledata(id)\labels

    If *win AND *gad AND *cinfo AND *lblist
      If SetGadgetAttrsA_(*gad, *win, 0, VarArgs(#LISTBROWSER_ColumnInfo, *cinfo, #LISTBROWSER_Labels,*lblist, #TAG_DONE))
        RefreshGList_ *gad, *win, 0, 1
      EndIf
    Else
      error{"Could not update table: " + Hex$(*win)+ " " + Hex$(*gad) + " " + Hex$(*cinfo)}
    EndIf
  EndIf
End Statement

Statement GUI_InitTable{winid.s, gadid.s, columns.b, @order.w}
SHARED guitabledata()

  If GUIMode = #GUI_WIZARD
    WZ_InitTable{winid, gadid, columns, order}
  EndIf
  
  If GUIMode = #GUI_REACTION
    If columns <=0
      error{"You cannot init a table with 0 columns"}
      Statement Return
    EndIf
    GUI_SetTableId{gadid,WZID(gadid) + FLen(gadid)}

    id.w = GUI_GetTableId{gadid}
    guitabledata(id)\window = Peek.l(Addr Window(WZID(winid)))
    guitabledata(id)\gadobject = GUI_GetObjectValueLong{gadid}
    guitabledata(id)\labels = InitListBrowserList{}    
    guitabledata(id)\columns = columns
  EndIf
End Statement

Statement GUI_SetTableTitle{gadid.s, ct0.s, @ct1.s, @ct2.s, @ct3.s, @ct4.s, @ct5.s, @ct6.s, @ct7.s}
SHARED guitabledata()

  If GUIMode = #GUI_WIZARD
    WZ_SetTableTitle{gadid, ct0, ct1, ct2, ct3, ct4, ct5, ct6, ct7}
  EndIf

  If GUIMode = #GUI_REACTION
    id.w = GUI_GetTableId{gadid}
    columns.b = guitabledata(id)\columns

    InitTagList id, 50

    For t.b = 0 To columns - 1
      ctitle.s = ""
      Select t 
      Case 0 : ctitle = ct0
      Case 1 : ctitle = ct1
      Case 2 : ctitle = ct2
      Case 3 : ctitle = ct3
      Case 4 : ctitle = ct4
      Case 5 : ctitle = ct5
      Case 6 : ctitle = ct6
      End Select
      AddTags id, #LBCIA_Column, t, #LBCIA_Title, StrAddr(ctitle), #LBCIA_Flags,0, #LBCIA_Sortable, True, #LBCIA_AutoSort, True
    Next t

    *cinfo.ColumnInfo = AllocLBColumnInfoA_(columns, TagList(id))
    guitabledata(id)\columninfo = *cinfo
    guitabledata(id)\columns = columns
  EndIf
End Statement

Statement GUI_SetPriority{gadid.s, wt0.b, @wt1.b, @wt2.b, @wt3.b, @wt4.b, @wt5.b, @wt6.b, @wt7.b}
SHARED guitabledata()

  If GUIMode = #GUI_WIZARD
    WZ_SetPriority{gadid, wt0, wt1, wt2, wt3, wt4, wt5, wt6, wt7}
  EndIf

  If GUIMode = #GUI_REACTION
    id.w = GUI_GetTableId{gadid}
    *win.Window = guitabledata(id)\window
    *gad.l = guitabledata(id)\gadobject
    *cinfo.ColumnInfo = guitabledata(id)\columninfo
    *lblist.List = guitabledata(id)\labels

    If *win AND *gad AND *cinfo
      If *lblist Then SetGadgetAttrsA_ *gad, *win, 0, VarArgs(#LISTBROWSER_Labels, 0, #TAG_DONE)

      columns.b = guitabledata(id)\columns
      For t.b = 0 To columns - 1
        weight.b = 0
        Select t 
        Case 0 : weight = wt0
        Case 1 : weight = wt1
        Case 2 : weight = wt2
        Case 3 : weight = wt3
        Case 4 : weight = wt4
        Case 5 : weight = wt5
        Case 6 : weight = wt6
        Case 7 : weight = wt7
        End Select
        If weight > 0
          weight = weight * 10
          SetLBColumnInfoAttrsA_ *cinfo,VarArgs(#LBCIA_Column, t, #LBCIA_Weight, weight, #TAG_DONE)
        EndIf
      Next t
      If *lblist Then SetGadgetAttrsA_ *gad, *win, 0, VarArgs(#LISTBROWSER_Labels, *lblist, #TAG_DONE)
    Else
      error{"Could not set columns weight!"}
    EndIf
  EndIf  
End Statement


Statement GUI_SetTableAlign{gadid.s, ct0.w, @ct1.w, @ct2.w, @ct3.w, @ct4.w, @ct5.w, @ct6.w, @ct7.w}
SHARED guitabledata()

  If GUIMode = #GUI_WIZARD
    WZ_SetTableAlign{gadid, ct0, ct1, ct2, ct3, ct4, ct5, ct6, ct7}
  EndIf
  
  If GUIMode = #GUI_REACTION
    id.w = GUI_GetTableId{gadid}
    *win.Window = guitabledata(id)\window
    *gad.l = guitabledata(id)\gadobject
    *cinfo.ColumnInfo = guitabledata(id)\columninfo
    *lblist.List = guitabledata(id)\labels

    If *win AND *gad AND *cinfo
      If *lblist Then SetGadgetAttrsA_ *gad, *win, 0, VarArgs(#LISTBROWSER_Labels, 0, #TAG_DONE)

      columns.b = guitabledata(id)\columns
      For t.b = 0 To columns - 1
        alignment.b = 0
        Select t 
        Case 0 : alignment = ct0
        Case 1 : alignment = ct1
        Case 2 : alignment = ct2
        Case 3 : alignment = ct3
        Case 4 : alignment = ct4
        Case 5 : alignment = ct5
        Case 6 : alignment = ct6
        End Select
        Select alignment
        Case #WZALIGN_LEFT  : alignment = 0
        Case #WZALIGN_RIGHT : alignment = #CIF_RIGHT
        Case #WZALIGN_CENTER: alignment = #CIF_CENTER
        End Select
        If alignment > 0
          SetLBColumnInfoAttrsA_ *cinfo,VarArgs(#LBCIA_Column, t, #LBCIA_Flags, alignment, #TAG_DONE)
        EndIf
      Next t
      If *lblist 
        If SetGadgetAttrsA_(*gad, *win, 0, VarArgs(#LISTBROWSER_Labels, *lblist, #TAG_DONE))
          RefreshGList_ *gad, *win, 0, 1        
        EndIf
      EndIf
    Else
      error{"Could not set columns alignment!"}  
    EndIf
  EndIf  
End Statement

Statement GUI_AddRow{gadid.s, r0.s, @r1.s, @r2.s, @r3.s, @r4.s, @r5.s}
SHARED guitabledata()

  If GUIMode = #GUI_WIZARD
    WZ_AddRow{gadid, r0, r1, r2, r3, r4, r5}
  EndIf

  If GUIMode = #GUI_REACTION
    id.w = GUI_GetTableId{gadid}

    If guitabledata(id)\labels = 0
      error{"Could not add row!"}
      Statement Return
    EndIf

    *cinfo.ColumnInfo = guitabledata(id)\columninfo

    id2.w = id + 1
    InitTagList id2,50

    For t.b = 0 To guitabledata(id)\columns - 1
      cell.s = ""
      Select t 
      Case 0 : cell = r0
      Case 1 : cell = r1
      Case 2 : cell = r2
      Case 3 : cell = r3
      Case 4 : cell = r4
      Case 5 : cell = r5
      End Select

      ;-- get the justification-Flag of the column to set proper value for each entry
      justify.l = 0
      GetLBColumnInfoAttrsA_ *cinfo, VarArgs(#LBCIA_Column, t,#LBCIA_Flags, &justify, #TAG_DONE)
      If justify = #CIF_RIGHT Then justify = #LCJ_RIGHT Else justify = #LCJ_LEFT

      AddTags id2,#LBNA_Column, t, #LBNCA_Text, StrAddr(cell), #LBNCA_HorizJustify, justify
    Next t

    AddListBrowserListEntry{guitabledata(id)\labels, guitabledata(id)\columns, TagList(id2)}
  EndIf
End Statement


Statement GUI_TableSort{gadid.s, column.b}
SHARED guitabledata()

  If GUIMode = #GUI_WIZARD
    WZ_TableSort{gadid, column}
  EndIf

  If GUIMode = #GUI_REACTION
    id.w = GUI_GetTableId{gadid}
    *win.Window = guitabledata(id)\window
    *gad.l = guitabledata(id)\gadobject
    *cinfo.ColumnInfo = guitabledata(id)\columninfo
    *lblist.List = guitabledata(id)\labels

    If *win AND *gad AND *cinfo
      SetLBColumnInfoAttrsA_ *cinfo, VarArgs(#LISTBROWSER_SortColumn, column-1,#TAG_DONE)
    Else
      error{"Could not set sort flag to column info!"}
    EndIf
  EndIf
End Statement


Function GUI_GetNumberOfEntries{gadid.s}
  If GUIMode = #GUI_WIZARD
    Function Return WZ_GetNumberOfEntries{gadid}
  EndIf

  If GUIMode = #GUI_REACTION
    GetAttr_ #LISTBROWSER_TotalNodes, GUI_GetObjectValueLong{gadid}, &entries.l
    Function Return entries
  EndIf
End Function

Statement GUI_DrawTable{gadid.s}
  If GUIMode = #GUI_WIZARD
    WZ_DrawTable{gadid}
  EndIf
End Statement

Function.l GUI_Row{gadid.s}
  If GUIMode = #GUI_WIZARD
    Function Return WZ_Row{gadid}
  EndIf

  If GUIMode = #GUI_REACTION
    row.l = 0
    GetAttr_ #LISTBROWSER_Selected, GUI_GetObjectValueLong{gadid}, &row
    Function Return row
  EndIf
End Function


Statement GUI_SetActiveRow{gadid.s, row.l}
  If GUIMode = #GUI_WIZARD
    WZ_SetActiveRow{gadid, row}
  EndIf

  If GUIMode = #GUI_REACTION
  EndIf
End Function

Statement GUI_SetTableReadOnly{gadid.s, state.b}
  If GUIMode = #GUI_WIZARD
    WZ_SetTableReadOnly{gadid, state}
  EndIf

  If GUIMode = #GUI_REACTION
  EndIf
End Function



Function.s GUI_GetCell{gadid.s, row.l, column.l}
  If GUIMode = #GUI_WIZARD
    Function Return WZ_GetCell{gadid, row, column}
  EndIf

  If GUIMode = #GUI_REACTION
    GetAttr_ #LISTBROWSER_SelectedNode, GUI_GetObjectValueLong{gadid}, &node.l
    If node
      GetListBrowserNodeAttrsA_ node, VarArgs(#LBNA_Column, column-1, #LBNCA_Text,  &text_ptr.l, #TAG_DONE)
      ;NPrint gadid, " ", row," ",column, " ", Peek.s(text_ptr)
      Function Return Peek.s(text_ptr)
    EndIf
    ;#LBNCA_Integer, &integer_val, // 3. Fetch integer data for column 2 (if any)
  EndIf
End Statement

Function.l GUI_Column{gadid.s}
  If GUIMode = #GUI_WIZARD
    Function Return WZ_Column{gadid}
  EndIf

  If GUIMode = #GUI_REACTION
  EndIf
End Function

Function.l GUI_CheckTableEvent{ev.l, @gadid.s}
  If GUIMode = #GUI_WIZARD
;    If ev = #IDCMP_IDCMPUPDATE OR ev = #IDCMP_GADGETUP
      Function Return WZ_CheckTableEvent{ev}
;    EndIf
  EndIf

  If GUIMode = #GUI_REACTION
    Select ev
     Case #IDCMP_GADGETUP
      *gad1.gadgetobject = GUI_GetGadgetById{GadgetHit}
      If *gad1
        If *gad1\reactionobject
          GetAttr_ #LISTBROWSER_RelEvent, *gad1\reactionobject, &clickTime.l
          Select clickTime
          Case #LBRE_NORMAL
            Function Return #WZTABLEEVENT_CELLSELECTED        
          Case #LBRE_DOUBLECLICK
            Function Return #WZTABLEEVENT_DOUBLECLICK
          Case #LBRE_TITLECLICK
            Function Return #WZTABLEEVENT_TITLECLICK
          End Select
        Else
          error{"Could not check gadget"}
        EndIf
      EndIf
    End Select
  EndIf
End Function

; =============================================================
Statement dummy{}
  If GUIMode = #GUI_WIZARD
  EndIf

  If GUIMode = #GUI_REACTION
  EndIf
End Statement
; =============================================================

; ==============================================================================================
CNIF #__include = 0

GUIMode = #GUI_REACTION
GUIMode = #GUI_WIZARD

WBStartup ;: NoCli
WbToScreen 0 : Use Screen 0 : ScreenToFront_ 0

;If GUIMode = #GUI_WIZARD
  RunErrsOff
  WZLoadGUI ?wzgui
  RunErrsOn
;EndIf

;-- show a simple progress bar without actually doing something...
;Goto skip
GUI_ShowMessage{"Initiation in progress !",0}
For i.b = 1 To 100 Step 5
  GUI_Update_Gauge{i,100}
  Delay_ 1
Next i
GUI_HideMessage{}
skip:

;-- open the reaction window, centered to the screen
If GUIMode = #GUI_REACTION
  Dim fpatt.w(15)
  fpatt(0) = $AAAA,$5555,$AAAA,$5555,$AAAA,$5555,$AAAA,$5555
  fpatt(8) = $AAAA,$5555,$AAAA,$5555,$AAAA,$5555,$AAAA,$5555

  *listbrowser.l = !ListBrowserObject, @@
            #GA_ID, WZID("TABELLE"), @@
            #GA_RelVerify, True, @@
            #LISTBROWSER_ColumnTitles, True, @@
            #LISTBROWSER_TitleClickable, True, @@
            #LISTBROWSER_ShowSelected, True, @@
            #LISTBROWSER_Separators, True, @@
            !ListBrowserEnd
  GUI_RegisterObjectLong{"TABELLE", *listbrowser}

  *space.l = !SpaceObject, !EndObject
  *args.l  = !ButtonObject, @@
            #GA_ID, WZID("TABELLE_STATUS"), @@
            #GA_RelVerify, True, @@
            #GA_ReadOnly, False, @@
            #BUTTON_BevelStyle, #BVS_THIN, @@
            #BUTTON_Transparent, True, @@
            !ButtonEnd
  GUI_RegisterObjectLong{"TABELLE_STATUS",*args}

  *sublay1.l = !VLayoutObject, @@
            #LAYOUT_HorizAlignment, #LALIGN_CENTER, @@
            #LAYOUT_VertAlignment, #LALIGN_CENTER, @@
            #LAYOUT_BevelStyle, #BVS_NONE, @@
            #LAYOUT_AddChild, *listbrowser, @@
            #LAYOUT_AddChild, *space, @@
            #CHILD_WeightedHeight, 0, @@            
            #LAYOUT_AddChild, *args, @@
            #CHILD_WeightedHeight, 0, @@
            !LayoutEnd

  *winlayout.l = !VLayoutObject, @@
            #LAYOUT_FillPen,0, @@
            #LAYOUT_SpaceOuter, True, @@
            #LAYOUT_SpaceInner, True, @@
            #LAYOUT_FillPattern, &fpatt(0),@@
            #LAYOUT_FillPen, #SHINEPEN,@@
            #LAYOUT_AddChild, *sublay1, @@
            !LayoutEnd

  *winobj.l = !WindowObject, @@
            #WA_Title, StrAddr("Table-Demo"), @@
            #WA_Activate, True, @@
            #WA_DepthGadget, True, @@
            #WA_DragBar, True, @@
            #WA_CloseGadget, True, @@
            #WA_SizeGadget, True, @@
            #WA_Width, ScreenWidth/2, @@
            #WA_Height, ScreenHeight/2, @@
            #WA_IDCMP, #IDCMP_GADGETUP | #IDCMP_REFRESHWINDOW | #IDCMP_VANILLAKEY | #IDCMP_CLOSEWINDOW | #IDCMP_GADGETDOWN | #IDCMP_IDCMPUPDATE, @@
            #WINDOW_Position, #WPOS_CENTERSCREEN, @@
            #WINDOW_AppPort, BlitzMsgPort, @@
            #WINDOW_ParentGroup, *winlayout, @@
            !EndObject
EndIf

GUI_OpenWindow{"WIN_TABELLE", ScreenWidth/4,ScreenHeight/4,ScreenWidth/2,ScreenHeight/2,*winobj}
GUI_InitTable{"WIN_TABELLE","TABELLE", 5}
GUI_SetTableTitle{"TABELLE","Name","Type","Size","Bits","Comment"}
GUI_SetPriority{"TABELLE",2,2,2,2,2}
GUI_DrawTable{"TABELLE"}

;-- fill table with some data
ChDir "sys:" : a.l = 0
While MoreEntries
  a + 1
  If EntryDIR Then d$ ="Dir" Else d$ = "File"
  GUI_AddRow{"TABELLE", EntryName$, d$, Str$(EntrySize), EntryBits$,"####"};EntryComment$}
;  If Left$(EntryName$,1)="D"
;    WZ_SetRowPen{"TABELLE",-1,-1,#FSF_BOLD}
;  EndIf
Wend
GUI_UpdateTable{"TABELLE"}

;--
;-- main loop
;--
exit.b = False
Repeat
  ev.l = WaitEvent
  


  ;-- close bubblehelp of open
  If (ev <> #IDCMP_INTUITICKS) AND (ev <> #IDCMP_ACTIVEWINDOW) AND (ev <> #IDCMP_MOUSEMOVE) AND (ev <> #IDCMP_GADGETHELP)
    DefaultOutput
    NPrint "EVENT: ",Hex$(ev), "  Code: ",EventCode, " Qualifier: ",EventQualifier, " Gadget: ",GadgetHit
    GUI_HideBubble{}
  EndIf

  ;-- we have to "convert" the idcmpupdate event from wizard to gadetup to make the code run with both guis
  If GUIMode = #GUI_WIZARD
    If ev = #IDCMP_IDCMPUPDATE AND GadgetHit = -1 Then ev = #IDCMP_GADGETUP
  EndIf

  Select ev
    Case #IDCMP_CLOSEWINDOW
      Select EventWindow
      Case WZID("WIN_TABELLE")
        exit = True
      End Select

    Case #IDCMP_GADGETHELP
      GUI_ShowBubble{}

    Case #IDCMP_IDCMPUPDATE
      NPrint "IDCMP Update code: ",EventCode,"  Gadgethit: ",GadgetHit, " ",GUI_GadName{}

    Case #IDCMP_GADGETUP
      NPrint "Gadget up ", GadgetHit, " Value:", EventCode, " gadname: ",  GUI_GadName{}

    Case #IDCMP_VANILLAKEY
      NPrint "Vanillakey ",EventVanillaKey

    Case #IDCMP_RAWKEY
      NPrint "Rawkey ",EventRawKey

;    Case #IDCMP_MOUSEMOVE
;      NPrint "X: ",EMouseX, ",Y: ",EMouseY

    Case #IDCMP_MOUSEBUTTONS
      NPrint "Buttons pressen"

  End Select

  Select GUI_CheckTableEvent{ev, "TABELLE"}
    Case #WZTABLEEVENT_TITLECLICK
      error{"a title was clicked on"}

    Case #WZTABLEEVENT_DOUBLECLICK
      x.w = GUI_Row{"TABELLE"}
      y.w = GUI_Column{"TABELLE"}
      error{"Selected via doubleclick: "+Str$(x)+","+Str$(y)}

    Case #WZTABLEEVENT_CELLSELECTED
      x.w = GUI_Row{"TABELLE"}
      y.w = GUI_Column{"TABELLE"}
      If (x > 0) AND (y > 0)
        z.s = "TABELLE" + ": cell " + Str$(x) + "," + Str$(y) + ":" + WZ_GetCell{"TABELLE",x,y} + "___" + WZ_GetCell{"TABELLE",x,2}
      Else
        If x <> ox.w
          z.s = "selected row: " + Str$(x)
        EndIf
      EndIf
      ox.w = x
      Use Window WZID("WIN_TABELLE")
      !GUI_Print{"TABELLE_STATUS",z}
    End Select

Until exit = True

ende:
GUI_HideBubble{}
;-- removes all entries of the tables
GUI_KillTable{"TABELLE"}
;-- close the window and all attached objects
GUI_CloseWindow{"WIN_TABELLE"}
;-- free additional memory
GUI_Cleanup{}
End








Goto wzguiEnd:
wzgui:
IncBin "blitz3:sourcecodes/includes/wizard_Tools.include.wizard"
wzguiEnd:

CEND
