#GUI_WIZARD   = 1 
#GUI_REACTION = 2
SHARED GUIMode.b

CNIF #__include = 0
  OPTIMIZE 5|8 : SYNTAX 6
CEND

; -- requirements for wizard
XINCLUDE "wizard_Table.include.ab3"

; -- requirements for Reaction
XINCLUDE "hashmap.include.ab3"
XINCLUDE "reactionlib.include.ab3"

SHARED *WindowBase.Library
SHARED *LayoutBase.Library
SHARED *ButtonBase.Library
SHARED *LabelBase.Library
SHARED *FuelgaugeBase.Library
SHARED *SpaceBase.Library
SHARED *ListbrowserBase.Library
SHARED *StringBase.Library
SHARED *IntegerBase.Library
SHARED *ChooserBase.Library

*WindowBase.Library = OpenLibrary_("window.class", 44)
*LayoutBase.Library = OpenLibrary_("gadgets/layout.gadget", 44)
*SpaceBase.Library = OpenLibrary_("gadgets/space.gadget", 44)  
*LabelBase.Library  = OpenLibrary_("images/label.image", 44)
*ButtonBase.Library = OpenLibrary_("gadgets/button.gadget", 44)
*FuelgaugeBase = OpenLibrary_("gadgets/fuelgauge.gadget", 44)
*ListbrowserBase.Library = OpenLibrary_("gadgets/listbrowser.gadget", 44)
*StringBase.Library = OpenLibrary_("gadgets/string.gadget", 44)
*IntegerBase.Library = OpenLibrary_("gadgets/integer.gadget", 44)
*ChooserBase.Library = OpenLibrary_("gadgets/chooser.gadget", 44)
If *FuelgaugeBase = 0
  error{"Could not open needed reaction classes."}
  End
EndIf

;-- we use a hashmap to store objectpointers in a key-value list
SHARED *guiobjects.hashmap
*guiobjects.hashmap = hashmap_Create{14}

NEWTYPE.tabledata
  columns.w
  *columninfo.ColumnInfo
  *labels.List   

  *window.Window        ; the window the listbrower gadget belongs to
  *gadobject.l          ; the reaction gadget object
End NEWTYPE
Dim guitabledata.tabledata(20)

NEWTYPE.gadgetobject
  id.l
  name.s
  reactionobject.l
  windowobject.l
  windowptr.Window
  windownum.w
End NEWTYPE

Dim List guigadgetlist.gadgetobject(50)

Function.l GUI_GetGadgetById{id.w, @winnum.w}
SHARED guigadgetlist()
  If id <> -1
    found.b = False
    ResetList guigadgetlist()
    While NextItem(guigadgetlist()) OR found
      If guigadgetlist()\id = id
        If winnum <> -1
          If guigadgetlist()\windownum = winnum
            found = True
          EndIf
        Else
          found = True
        EndIf      
      EndIf
      If found 
        Pop While
        *gad1.gadgetobject = guigadgetlist()
        Function Return *gad1
      EndIf
    Wend
  EndIf
End Function

Function.l GUI_GetGadgetByName{objname.s, @winnum.w}
SHARED guigadgetlist()
  If objname <> ""
    found.b = False
    ResetList guigadgetlist()
    While NextItem(guigadgetlist()) OR found = True
      If guigadgetlist()\name = objname
        If winnum <> -1
          If guigadgetlist()\windownum = winnum
            found = True
          EndIf
        Else
          found = True
        EndIf      
      EndIf
      If found 
        Pop While
        *gad1.gadgetobject = guigadgetlist()
        Function Return *gad1
      EndIf
    Wend
  EndIf
End Function

Statement GUI_AttachGadgetsToWindow{num.q}
SHARED guigadgetlist()

  ResetList guigadgetlist()
  While NextItem(guigadgetlist())
    If guigadgetlist()\windownum = 0 
      guigadgetlist()\windownum = num
    EndIf
  Wend
End Statement

Function.b GUI_AddGadget{objname.s, id.l, objectpointer.l}
SHARED guigadgetlist()

  *gad1.gadgetobject = GUI_GetGadgetByName{objname, objectpointer.l}
  If *gad1
    error{"Gadget already registered: ",objname}
    Function Return False
  EndIf

  If AddItem(guigadgetlist())
    guigadgetlist()\id = id
    guigadgetlist()\name = objname
    guigadgetlist()\reactionobject = objectpointer
    Function Return True
  EndIf
End Function


NEWTYPE.ml
  id.l
  name.s
End NEWTYPE
Dim List guimenulist.ml(50)

Statement GUI_Cleanup{}
  If *WindowBase    Then CloseLibrary_(*WindowBase)
  If *LayoutBase    Then CloseLibrary_(*LayoutBase)
  If *LabelBase     Then CloseLibrary_(*LabelBase)
  If *SpaceBase     Then CloseLibrary_(*SpaceBase)
  If *ButtonBase    Then CloseLibrary_(*ButtonBase)
  If *FuelgaugeBase Then CloseLibrary_(*FuelgaugeBase)
  If *ListbrowserBase Then CloseLibrary_ *ListbrowserBase
  If *StringBase    Then CloseLibrary_ *StringBase
  If *IntegerBase   Then CloseLibrary_ *IntegerBase
  If *ChooserBase   Then CloseLibrary_ *ChooserBase
End Statement
!autoexit{GUI_Cleanup}


Function.l GUI_RegisterObject{objname.s, value.s}
  If objname <> ""
    Function Return hashmap_AddItem{*guiobjects, objname, value}
  EndIf
End Function

Function.l GUI_RegisterObjectLong{objname.s, value.l}
  If objname <> ""
    If value>$FFFF
      If GetAttr_(#GA_ID, value, &result.l)
        GUI_AddGadget{objname, result, value}
      EndIf
    EndIf
    Function Return hashmap_AddItem{*guiobjects, objname, Str$(value)}
  EndIf
End Function

Function.s GUI_GetObjectValue{objname.s}
  If objname <> ""
    Function Return hashmap_GetItem{*guiobjects, objname}
  EndIf
End Function

Function.l GUI_GetObjectValueLong{objname.s}
  If objname <> ""
    value.s = hashmap_GetItem{*guiobjects, objname}
    If value <> "" Then Function Return Vallong(value)
  EndIf
End Function

Statement GUI_UnRegisterObject{objname.s}
  If objname <> ""
    hashmap_RemItem{*guiobjects, objname}
  EndIf
End Statement

Statement GUI_SetTableId{gadid.s,tableid.l}
  GUI_RegisterObjectLong{"TABLE_" + gadid,tableid}
End Statement

Function.l GUI_GetTableId{gadid.s}
  Function Return GUI_GetObjectValueLong{"TABLE_" + gadid}
End Function

Function.s GUI_GetMenuName{id.l}
SHARED guimenulist()
  ResetList guimenulist()
  While NextItem(guimenulist())
    If guimenulist()\id = id
      Pop While : Function Return guimenulist()\name
    EndIf
  Wend
End Function

Statement GUI_SetMenuItem{itemname.s}
SHARED guimenulist()
  If AddItem(guimenulist())
    guimenulist()\id = WZID(itemname)
    guimenulist()\name = itemname
  EndIf
End Statement

Statement GUI_CheckAvailablility{}
  If GUIMode = #GUI_WIZARD
    WZ_CheckLibrary{}
  EndIf
  
  If GUIMode = #GUI_REACTION
    libName.s = "window.class"
    libVersion.w = 44

    If dos_CheckLib{libName,libVersion} = 0
      error{"At least version " + Str$(libVersion) + " of " + libName + " needed."}
      End
    EndIf
  EndIf    
End Statement

Function.b GUI_IsOpen{winid.s}
  If GUIMode = #GUI_WIZARD
    Function Return WZ_IsOpen{winid}
  EndIf

  If GUIMode = #GUI_REACTION
    If Peek.l(Addr Window(WZID(winid))) = 0
      Function Return False
    Else
      Function Return True
    EndIf
  EndIf
End Function


Statement GUI_ChangeWindowTitle{wizid.s, newtitle.s}
  If GUIMode = #GUI_WIZARD
    WZ_ChangeTitle{wizid,newtitle}
  EndIf

  If GUIMode = #GUI_REACTION
    *winptr.l = GUI_GetObjectValueLong{wizid}
    If *winptr
      SetWindowTitles_ *winptr,StrAddr(newtitle),-1
    EndIf
  EndIf
End Statement

Function GUI_ShowMessage{message.s, @textMode.l} ;textMode -1: just a text, textMode 0: progress bar
  usedwin.w = Used Window

  If GUIMode = #GUI_WIZARD
    WZ_ShowMessage{message, textMode}
  EndIf

  If GUIMode = #GUI_REACTION
    *winptr.l = Peek.l(Addr Window(WZID("WIN_PROGRESS")))
    If *winptr = 0
        Dim fpatt.w(15)
        fpatt(0) = $AAAA,$5555,$AAAA,$5555,$AAAA,$5555,$AAAA,$5555
        fpatt(8) = $AAAA,$5555,$AAAA,$5555,$AAAA,$5555,$AAAA,$5555
        
        g_lb.l = !ButtonObject, #GA_ReadOnly, False, #GA_Text, StrAddr(message), #BUTTON_BevelStyle, #BVS_THIN, #BUTTON_Transparent, True, !ButtonEnd
        g_ly.l = !VLayoutObject, #LAYOUT_HorizAlignment, #LALIGN_CENTER, #LAYOUT_VertAlignment, #LALIGN_CENTER, #LAYOUT_BevelStyle, #BVS_NONE, #LAYOUT_AddChild, g_lb, !LayoutEnd      

        If textMode = 0 ; add fuelgauge to layout if needed
          g_fg.l = !FuelGaugeObject, #GA_ID, 1, #FUELGAUGE_Min, 0, #FUELGAUGE_Max, 100, #FUELGAUGE_Level, 0, #FUELGAUGE_Percent, True, !FuelGaugeEnd
          SetGadgetAttrsA_ g_ly,0,0,VarArgs(#LAYOUT_AddChild, g_fg,#TAG_DONE)
        EndIf

        g_wl.l = !VLayoutObject, #LAYOUT_FillPen,0, #LAYOUT_SpaceOuter, True, #LAYOUT_SpaceInner, True, #LAYOUT_FillPattern, &fpatt(0),#LAYOUT_FillPen,#SHINEPEN,#LAYOUT_AddChild,g_ly,!LayoutEnd
        winobj.l = !WindowObject, #WA_Activate,-1,#WA_DepthGadget,-1, #WA_DragBar,-1, #WA_Width,500, #WA_Height,80, #WINDOW_Position, #WPOS_CENTERSCREEN, #WINDOW_ParentGroup,g_wl,!EndObject
        If winobj
            *winptr.l = !RA_OpenWindow{winobj}
            UseAsBlitzWin WZID("WIN_PROGRESS"), *winptr, winobj
            GUI_RegisterObjectLong{"GAD_MESSAGE", g_lb}
            GUI_RegisterObjectLong{"GAD_PROGRESS", g_fg}
        EndIf

    Else
        gadobj.l = GUI_GetObjectValueLong{"GAD_MESSAGE"}
        SetGadgetAttrsA_ gadobj, *winptr, 0, VarArgs(#GA_Text,StrAddr(message),#TAG_DONE)
    EndIf 
  EndIf
  If usedwin<>-1 Then Use Window usedwin
End Function

Statement GUI_HideMessage{}
  usedwin.w = Used Window
  If GUIMode = #GUI_WIZARD
    WZ_HideMessage{}
  EndIf

  If GUIMode = #GUI_REACTION
    If GUI_IsOpen{"WIN_PROGRESS"}
      UnuseBlitzWin WZID("WIN_PROGRESS")
    EndIf

    GUI_UnRegisterObject{"GAD_MESSAGE"}
    GUI_UnRegisterObject{"GAD_PROGRESS"}
  EndIf
  If usedwin<>-1 Then Use Window usedwin
End Statement

Function GUI_Update_Gauge{value.l,max.w}
  If GUIMode = #GUI_WIZARD
    !WZ_Update_Gauge{value, max}
  EndIf

  If GUIMode = #GUI_REACTION
    *winptr.l = Peek.l(Addr Window(WZID("WIN_PROGRESS")))
    gadobj.l = GUI_GetObjectValueLong{"GAD_PROGRESS"}
    If *winptr AND gadobj
      procent.l = (value * 100) / max
      SetGadgetAttrsA_ gadobj, *winptr, 0, VarArgs(#FUELGAUGE_Level, procent,#TAG_DONE)
      Function Return procent
    Else    
      error{"Could not update " + Hex$(*winptr) + "/" + Hex$(gadobj)}
    EndIf
  EndIf 
End Function

