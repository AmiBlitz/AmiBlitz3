CNIF @#PREFS_WBPATTERN_H=0 
#PREFS_WBPATTERN_H = 1
;/*
;**	$VER: wbpattern.h 47.1 (2.8.2019)
;**
;**	File format for wbpattern preferences
;**
;**	Copyright (C) 2019 Hyperion Entertainment CVBA.
;**	    Developed under license.
;*/

;/*****************************************************************************/

CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 

CNIF @#LIBRARIES_IFFPARSE_H=0 
INCLUDE"libraries/iffparse.ab3" 
CEND 

;/*****************************************************************************/

#ID_PTRN = MAKE_ID('P','T','R','N')

;/*****************************************************************************/

NEWTYPE.WBPatternPrefs

wbp_Reserved.l [4]
wbp_Which.w ;			;/* Which pattern is it */
wbp_Flags.w 
wbp_Revision.b ;			;/* Must be set to zero */
wbp_Depth.b ;			;/* Depth of pattern */
wbp_DataLength.w ;		;/* Length of following data */
End NEWTYPE

;/*****************************************************************************/

;/* constants for WBPatternPrefs.wbp_Which */
#WBP_ROOT = 0
#WBP_DRAWER = 1
#WBP_SCREEN = 2

;/* wbp_Flags values */
#WBPF_PATTERN = $0001
	;/* Data contains a pattern */

#WBPF_NOREMAP = $0010
	;/* Don't remap the pattern */

#WBPF_DITHER_MASK = $0300
	;/* Mask for dithering flags */

;/* PDTA_DitherQuality: see pictureclass.h */
#WBPF_DITHER_DEF = $0000 ;/* DitherQuality: Default */
#WBPF_DITHER_BAD = $0100 ;/* DitherQuality: 0 */
#WBPF_DITHER_GOOD = $0200 ;/* DitherQuality: 2 */
#WBPF_DITHER_BEST = $0300 ;/* DitherQuality: 4 */

;/*
;** The following were added in V47
;** How to place graphics.
;*/
#WBPF_PLACEMENT_MASK = $3000
#WBPF_PLACEMENT_TILE = $0000
#WBPF_PLACEMENT_CENTER = $1000
#WBPF_PLACEMENT_SCALE = $2000
#WBPF_PLACEMENT_SCALEGOOD = $3000

;/*
;** Alignment of the image for pattern
;** Currently ignored
;*/
#WBPF_ALIGNMENT_MASK = $C000
#WBPF_ALIGNMENT_MIDDLE = $0000
#WBPF_ALIGNMENT_LEFTTOP = $4000
#WBPF_ALIGNMENT_RIGHTBOTTOM = $8000

#WBPF_PRECISION_MASK = $0C00
	;/* Mask for color matching precision flags */

;/* OBP_Precision: see pictureclass.h */
#WBPF_PRECISION_DEF = $0000
#WBPF_PRECISION_ICON = $0400
#WBPF_PRECISION_IMAGE = $0800
#WBPF_PRECISION_EXACT = $0C00

;/*****************************************************************************/

#MAXDEPTH = 3	;/*  Max depth supported (8 colors) */
#DEFPATDEPTH = 2	;/*  Depth of default patterns */

;/*  Pattern width & height: */
#PAT_WIDTH = 16
#PAT_HEIGHT = 16

;/*****************************************************************************/

CEND ;/* PREFS_WBPATTERN_H */
