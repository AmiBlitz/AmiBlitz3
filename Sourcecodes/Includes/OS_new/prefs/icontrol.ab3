CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 

CNIF @#LIBRARIES_IFFPARSE_H=0 
INCLUDE"libraries/iffparse.ab3" 
CEND 

CNIF @#UTILITY_TAGITEM_H=0 
INCLUDE"utility/tagitem.ab3" 
CEND 


;/*****************************************************************************/


#ID_ICTL = MAKE_ID('I','C','T','L')


NEWTYPE.IControlPrefs

ic_Reserved.l [4];	;/* System reserved		*/
ic_TimeOut.w ;		;/* Verify timeout		*/
ic_MetaDrag.w ;		;/* Meta drag mouse event	*/
ic_Flags.l ;		;/* IControl flags (see below)	*/
ic_WBtoFront.b ;		;/* CKey: WB to front		*/
ic_FrontToBack.b ;	;/* CKey: front screen to back	*/
ic_ReqTrue.b ;		;/* CKey: Requester TRUE		*/
ic_ReqFalse.b ;		;/* CKey: Requester FALSE	*/

    ;/* Below is valid if Flags ICB_VERSIONED is set and onward if right version */
IC_CURRENTVERSION.#define 2
ic_Version.w ;		;/* Version of this struct	*/
ic_VersionMagic.w ;	;/* must be NULL			*/
ic_HoverSlugishness.b : 3; ;/* version 2 onward, number of intuiticks to wait when moving fast */
ic_HoverFlags.b : 5 ;	;/* version 2 onward, see below	*/
ic_Pad.b 
ic_GUIGeometry.b [4];	;/* Titlebar and border geometry	*/
End NEWTYPE

;/* flags for IControlPrefs.ic_Flags */
#ICB_COERCE_COLORS = 0
#ICB_COERCE_LACE = 1
#ICB_STRGAD_FILTER = 2
#ICB_MENUSNAP = 3
#ICB_MODEPROMOTE = 4
#ICB_CORRECT_RATIO = 5
;/* bits 6..14 are used by OS4 */
#ICB_OFFSCRNWIN = 15
#ICB_MORESIZEGADGETS = 16
#ICB_RATIO_LSB = 17
#ICB_RATIO_MSB = 18
#ICB_VERSIONED = 31

#ICF_COERCE_COLORS = (1 LSL ICB_COERCE_COLORS)
#ICF_COERCE_LACE = (1 LSL ICB_COERCE_LACE)
#ICF_STRGAD_FILTER = (1 LSL ICB_STRGAD_FILTER)
#ICF_MENUSNAP = (1 LSL ICB_MENUSNAP)
#ICF_MODEPROMOTE = (1 LSL ICB_MODEPROMOTE)
#ICF_CORRECT_RATIO = (1 LSL ICB_CORRECT_RATIO)
;/* bits 6..14 are used by OS4 */
#ICF_OFFSCRNWIN = (1 LSL ICB_OFFSCRNWIN)
#ICF_MORESIZEGADGETS = (1 LSL ICB_MORESIZEGADGETS)
#ICF_RATIO_MASK = (3 LSL ICB_RATIO_LSB)
#ICF_RATIO_9_7 = (0 LSL ICB_RATIO_LSB)
#ICF_RATIO_9_8 = (1 LSL ICB_RATIO_LSB)
#ICF_RATIO_1_1 = (2 LSL ICB_RATIO_LSB)
#ICF_RATIO_8_9 = (3 LSL ICB_RATIO_LSB)
#ICF_VERSIONED = (1 LSL ICB_VERSIONED)

#ICF_HF_HOVERGADGETS = (1 LSL 0)
#ICF_HF_REFLECTHOVER = (1 LSL 1)


#ID_IEXC = MAKE_ID('I','E','X','C')


NEWTYPE.IExceptionPrefs

ie_Tags.TagItem [0];	;/* Relocatable tag list including TAG_END, 0 */
End NEWTYPE

;/*****************************************************************************/


CEND ;/* PREFS_ICONTROL_H */
