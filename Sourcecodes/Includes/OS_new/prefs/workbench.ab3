CNIF @#LIBRARIES_IFFPARSE_H=0 
INCLUDE"libraries/iffparse.ab3" 
CEND 

CNIF @#GRAPHICS_GFX_H=0 
INCLUDE"graphics/gfx.ab3" 
CEND 

;/*****************************************************************************/

#ID_WBNC = MAKE_ID('W','B','N','C')

NEWTYPE.WorkbenchPrefs

	;/* settings from workbench.library */
wbp_DefaultStackSize.l ;        ;/* in bytes */
wbp_TypeRestartTime.l ;         ;/* in seconds */
	;/* settings from icon.library */
wbp_IconPrecision.l ;           ;/* PRECISION_#? values */
wbp_EmbossRect.Rectangle 
wbp_Borderless.BOOL 
wbp_MaxNameLength.l 
wbp_NewIconsSupport.BOOL 
wbp_ColorIconSupport.BOOL 
End NEWTYPE

;/* The following includes extensions from V45/Os 3.9 */
NEWTYPE.WorkbenchExtendedPrefs

wbe_BasicPrefs.WorkbenchPrefs 
wbe_IconMemoryType.l ;  ;/* exec MEMF_xxxx, obsolete */
wbe_LockPens.BOOL ;        ;/* if TRUE, locks pens 4..7 with predefined colors */
wbe_DisableTitleBar.BOOL 
wbe_DisableVolumeGauge.BOOL 
  ;/* new for V47 */
wbe_TitleUpdateDelay.w ;  ;/* in milliseconds */
wbe_CopyBufferSize.l ;    ;/* in bytes */
wbe_Flags.l ;             ;/* assorted options */
End NEWTYPE

#ID_WBHD = MAKE_ID('W','B','H','D')

NEWTYPE.WorkbenchHiddenDevicePrefs

whdp_Name.TEXT [0]; ;/* C String including NUL char */
End NEWTYPE

;/* New for V47 */
#ID_WBTF = MAKE_ID('W','B','T','F')

NEWTYPE.WorkbenchTitleFormatPrefs

wtfp_Format.TEXT [0]
End NEWTYPE

;/*****************************************************************************/

CEND ;/* PREFS_WORKBENCH_H */
