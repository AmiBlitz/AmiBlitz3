CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 

CNIF @#LIBRARIES_IFFPARSE_H=0 
INCLUDE"libraries/iffparse.ab3" 
CEND 

;/*****************************************************************************/

#ID_PNTR = MAKE_ID('P','N','T','R')

;/*****************************************************************************/

NEWTYPE.PointerPrefs

pp_Reserved.l [4]
pp_Which.w ;				;/* 0=NORMAL, 1=BUSY */
pp_Size.w ;				;/* see <intuition/pointerclass.h> */
pp_Width.w ;				;/* Width in pixels */
pp_Height.w ;				;/* Height in pixels */
pp_Depth.w ;				;/* Depth */
pp_YSize.w ;				;/* YSize */
pp_X,.w pp_Y;				;/* Hotspot */

    ;/* Color Table:  numEntries = (1  LSL  pp_Depth) - 1 */

    ;/* Data follows */
End NEWTYPE

;/*****************************************************************************/

;/* constants for PointerPrefs.pp_Which */
#WBP_NORMAL = 0
#WBP_BUSY = 1

;/*****************************************************************************/

NEWTYPE.RGBTable

t_Red.b 
t_Green.b 
t_Blue.b 
End NEWTYPE

;/*****************************************************************************/

CEND ;/* PREFS_POINTER_H */
