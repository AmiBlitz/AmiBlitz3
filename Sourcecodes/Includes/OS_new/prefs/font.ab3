#ID_FONT = MAKE_ID('F','O','N','T')


#FONTNAMESIZE = (128)

NEWTYPE.FontPrefs

fp_Reserved.l [3]
fp_Reserved2.w 
fp_Type.w 
fp_FrontPen.b 
fp_BackPen.b 
fp_DrawMode.b 
fp_SpecialDrawMode.b 
fp_TextAttr.TextAttr 
fp_Name.b [FONTNAMESIZE]
End NEWTYPE


;/* constants for FontPrefs.fp_Type */
#FP_WBFONT = 0
#FP_SYSFONT = 1
#FP_SCREENFONT = 2


