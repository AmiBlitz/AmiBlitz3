CNIF @#LIBRARIES_IFFPARSE_H=0 
INCLUDE"libraries/iffparse.ab3" 
CEND 

CNIF @#GRAPHICS_GFX_H=0 
INCLUDE"graphics/gfx.ab3" 
CEND 


;/*****************************************************************************/


#ID_OSCN = MAKE_ID('O','S','C','N')

#OSCAN_MAGIC = $FEDCBA89


NEWTYPE.OverscanPrefs

os_Reserved.l 
os_Magic.l 
os_HStart.w 
os_HStop.w 
os_VStart.w 
os_VStop.w 
os_DisplayID.l 
os_ViewPos.Point 
os_Text.Point 
os_Standard.Rectangle 
End NEWTYPE

;/* os_HStart, os_HStop, os_VStart, os_VStop can only be looked at if
; * os_Magic equals OSCAN_MAGIC. If os_Magic is set to any other value,
; * these four fields are undefined
; */


;/*****************************************************************************/


