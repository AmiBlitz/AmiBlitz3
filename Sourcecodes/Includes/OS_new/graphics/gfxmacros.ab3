CNIF @#GRAPHICS_GFXMACROS_H=0 
#GRAPHICS_GFXMACROS_H = 1
;/*
;**	$VER: gfxmacros.h 47.5 (26.12.2021)
;**
;**	useful macros for graphics manipulations
