CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 

CNIF @#GRAPHICS_GFX_H=0 
INCLUDE"graphics/gfx.ab3" 
CEND 
CNIF @#EXEC_SEMAPHORES_H=0 
INCLUDE"exec/semaphores.ab3" 
CEND 
CNIF @#UTILITY_HOOKS_H=0 
INCLUDE"utility/hooks.ab3" 
CEND 

#NEWLOCKS = 1

;/*
; * Thor says: Keep hands off this structure. Layers builds it for you,
; * and keeps and adminstrates it for you. What's documented here is
; * only of interest for graphics and intuition. Especially, you may
; * only look at the front/back pointer of this layer while keeping the
; * layers list locked, or at the (Super)ClipRect singly (!) linked 
; * list while keeping this layer locked. Bounds are the bounds of this 
; * layer, rp its rastport whose layer is, surprise, surprise, this here.
; * Lock is the access lock you please lock by LockLayer() or 
; * LockLayerRom().
; * Everything else is completely off-limits and for private use only.
; */

NEWTYPE.Layer
  *front,*back.Layer 
  *ClipRect.ClipRect ;      ;/* singly linked list of active cliprects */
  *rp.RastPort ;            ;/* rastport to draw into. Its layer is me */
  bounds.Rectangle ;         ;/* screen bounds of this layer */
  *nlink.Layer ;         ;/* new in V45:
  ;                                         * next back layer for display
  ;                                         * reorganization
  ;                                         */
  priority.w ;                   ;/* internal use: on layer front/back move,
  ;                                         * relative priority of the layers.
  ;                                         * Topmost layer has lowest priority.
  ;                                         */
  Flags.w ;                      ;/* see <graphics/layers.h> */
  *SuperBitMap.BitMap ;   ;/* if non-NULL, superbitmap layer */
  *SuperClipRect.ClipRect ; ;/* super bitmap cliprects if VBitMap != 0*/
                                          ;/* else damage cliprect list for refresh */
  Window.l ;                     ;/* Intuition keeps its window here */
  Scroll_X,Scroll_Y.w ;          ;/* layer displacement */
  *OnScreen.ClipRect ;         ;/* temporary list of on-screen cliprects */
  *OffScreen.ClipRect ;        ;/* temporary list of off-screen cliprects */
  *Backup.ClipRect ;           ;/* temporary copy of un-damaged clips */
  *SuperSaveClipRects.ClipRect ; ;/* five preallocated super cr's */
  *Undamaged.ClipRect ;        ;/* undamaged, un-user clipped version
  ;                                         * of the cliprect, restored on EndUpdate()
  ;                                         */
  *LayerInfo.Layer_Info ;     ;/* points to head of the list */
  Lock.SignalSemaphore ;       ;/* access to this layer */
  *BackFill.Hook ;             ;/* backfill hook */
  reserved1.l 
  *ClipRegion.Region ;         ;/* user InstallClipRegion()'d region */
  *clipped.ClipRect ;          ;/* clipped away by damage list or
  ;                                         * user clip rect
  ;                                         */
  Width,Height.w ;               ;/* system use */
  reserved2.b [18];              ;/* more reserved fields */
  *DamageList.Region ;        ;/* list of rectangles to refresh */
End NEWTYPE

;/*
; * Describes one graphic rectangle of this layer, may it
; * be drawable or not. 
; * The meaning of some fields in here changed in the past,
; * and will remain changing. Chaining is done by Next, and
; * if obscured is non-NULL, BitMap *may* point to a backing
; * store bitmap aligned to multiples of 16 pixels. 
; * Everything else is private, and may change.
; * Especially, note that this structure grew in v33(!!!)
; * and has now been documented to be of this size in
; * v44. NEWCLIPRECTS_1_1 is really, really obsolete.
; * Do *never* allocate this yourself as layers handles them
; * internally more efficiently than AllocMem() could.
; */

NEWTYPE.ClipRect
  *_Next.ClipRect ;           ;/* roms used to find next ClipRect */
  *reservedlink.ClipRect ;   ;/* Currently unused */
  obscured.l ;       ;/* If non-zero, this is a backing store
  ;                                         * cliprect that is currently obscured.
  ;                                         * NEW: In V45, this is no longer a
  ;                                         * valid pointer since a cliprect
  ;                                         * can be obscured by more than one
  ;                                         * layer. Just test for zero or non-
  ;                                         * zero, do *NOT* dereference.
  ;                                         */
  *BitMap.BitMap ;         ;/* backing store bitmap if obscured != NULL */
  bounds.Rectangle ;         ;/* bounds of this cliprect */
  *vlink.ClipRect ;          ;/* Layers private use!!! */
  *home.Layer_Info ;           ;/* where this cliprect belongs to.
  ;                                         * If you *MUST* hack in your private
  ;                                         * cliprects, ensure that you set this
  ;                                         * field to NULL. If you don't, layers
  ;                                         * will pool your cliprect and will
  ;                                         * release it when it "feels like".
  ;                                         * For NULL, V40 behaivour is
  ;                                         * re-established.
  ;                                         */
  reserved.l 
CNIF @#NEWCLIPRECTS_1_1
  Flags.l;          /* Layers private field for cliprects */
CEND;    		    /* MUST be multiple of 8 bytes to buffer */
End NEWTYPE

;/* internal cliprect flags */
#CR_USERCLIPPED = 16      ;/* out of user clip rectangle */
#CR_DAMAGECLIPPED = 32      ;/* out of damage cliprects */

;/* defines for code values for getcode 
; * this really belongs to graphics, and is of no
; * use for layers. It's here only for traditional
; * reasons.
; */
#ISLESSX = 1
#ISLESSY = 2
#ISGRTRX = 4
#ISGRTRY = 8

CEND ;/* GRAPHICS_CLIP_H */
