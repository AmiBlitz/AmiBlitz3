NEWTYPE.SpecialMonitor

spm_Node.ExtendedNode 
spm_Flags.w 
(*.l __STDARGS__ do_monitor) __CLIB_PROTOTYPE((struct MonitorSpec *mspc))
(*.l __STDARGS__ reserved1)()
(*.l __STDARGS__ reserved2)()
(*.l __STDARGS__ reserved3)()
hblank.AnalogSignalInterval 
vblank.AnalogSignalInterval 
hsync.AnalogSignalInterval 
vsync.AnalogSignalInterval 
End NEWTYPE

