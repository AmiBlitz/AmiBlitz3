;/*
;** The functions in the MonitorSpec shall only be used internally, the
;** calling convention is with registers populated below.
;*/

NEWTYPE.MonitorSpec
ms_Node.ExtendedNode 
ms_Flags.w 
ratioh.l 
ratiov.l 
total_rows.w 
total_colorclocks.w 
DeniseMaxDisplayColumn.w 
BeamCon0.w 
min_row.w 
*ms_Special.SpecialMonitor 
ms_OpenCount.w 
(*.l __ASM__ ms_transform)__CLIB_PROTOTYPE((__REG__(a0, struct MonitorSpec *),
Point.__REG__(a1, *),
UWORD),.__REG__(d0, 
Point.__REG__(a2, *)))
(*.l __ASM__ ms_translate)__CLIB_PROTOTYPE((__REG__(a0, struct MonitorSpec *),
Point.__REG__(a1, *),
UWORD),.__REG__(d0, 
Point.__REG__(a2, *)))
(*.l __ASM__ ms_scale)    __CLIB_PROTOTYPE((__REG__(a0, struct MonitorSpec *),
Point.__REG__(a1, *),
UWORD),.__REG__(d0, 
Point.__REG__(a2, *)))
ms_xoffset.w 
ms_yoffset.w 
ms_LegalView.Rectangle 
(*.l __ASM__ ms_maxoscan) __CLIB_PROTOTYPE((__REG__(a0, struct MonitorSpec *),
struct.__REG__(a1, Rectangle *),
ULONG))).__REG__(d0, ;;/* maximum legal overscan */
(*.l __ASM__ ms_videoscan)__CLIB_PROTOTYPE((__REG__(a0, struct MonitorSpec *),
struct.__REG__(a1, Rectangle *),
ULONG))).__REG__(d0, ;;/* video display overscan */
DeniseMinDisplayColumn.w 
DisplayCompatible.l 
DisplayInfoDataBase.List 
DisplayInfoDataBaseSemaphore.SignalSemaphore 
(*.l __STDARGS__ ms_MrgCop)   __CLIB_PROTOTYPE((struct View *))
(*.l __STDARGS__ ms_LoadView) __CLIB_PROTOTYPE((struct View *))
(*.l __ASM__ ms_KillView)     __CLIB_PROTOTYPE((__REG__(a0, struct MonitorSpec *)))
End NEWTYPE

