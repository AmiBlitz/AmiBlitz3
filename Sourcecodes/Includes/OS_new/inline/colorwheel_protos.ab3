CNIF @#_VBCCINLINE_COLORWHEEL_H=0 
#_VBCCINLINE_COLORWHEEL_H = 1

CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 

VOID __ConvertHSBToRGB(__reg("a6") void *, __reg("a0") CONST struct ColorWheelHSB * hsb, __reg("a1") struct ColorWheelRGB * rgb)="\tjsr\t-30(a6)"
#ConvertHSBToRGB(hsb, = rgb) __ConvertHSBToRGB(ColorWheelBase, (hsb), (rgb))

VOID __ConvertRGBToHSB(__reg("a6") void *, __reg("a0") CONST struct ColorWheelRGB * rgb, __reg("a1") struct ColorWheelHSB * hsb)="\tjsr\t-36(a6)"
#ConvertRGBToHSB(rgb, = hsb) __ConvertRGBToHSB(ColorWheelBase, (rgb), (hsb))

CEND ;/*  _VBCCINLINE_COLORWHEEL_H  */
