VOID __AddConfigDev(__reg("a6") void *, __reg("a0") struct ConfigDev * configDev)="\tjsr\t-30(a6)"
#AddConfigDev(configDev) = __AddConfigDev(ExpansionBase, (configDev))

BOOL __AddBootNode(__reg("a6") void *, __reg("d0") LONG bootPri, __reg("d1") ULONG flags, __reg("a0") struct DeviceNode * deviceNode, __reg("a1") struct ConfigDev * configDev)="\tjsr\t-36(a6)"
#AddBootNode(bootPri, = flags, deviceNode, configDev) __AddBootNode(ExpansionBase, (bootPri), (flags), (deviceNode), (configDev))

VOID __AllocBoardMem(__reg("a6") void *, __reg("d0") ULONG slotSpec)="\tjsr\t-42(a6)"
#AllocBoardMem(slotSpec) = __AllocBoardMem(ExpansionBase, (slotSpec))

NEWTYPE.ConfigDev
AllocConfigDev().#define __AllocConfigDev(ExpansionBase)

__AllocExpansionMem(__reg("a6").l void *, __reg("d0") ULONG numSlots, __reg("d1") ULONG slotAlign)="\tjsr\t-54(a6)"
AllocExpansionMem(numSlots,.#define slotAlign) __AllocExpansionMem(ExpansionBase, (numSlots), (slotAlign))

__ConfigBoard(__reg("a6").l void *, __reg("a0") APTR board, __reg("a1") struct ConfigDev * configDev)="\tjsr\t-60(a6)"
ConfigBoard(board,.#define configDev) __ConfigBoard(ExpansionBase, (board), (configDev))

__ConfigChain(__reg("a6").l void *, __reg("a0") APTR baseAddr)="\tjsr\t-66(a6)"
ConfigChain(baseAddr).#define __ConfigChain(ExpansionBase, (baseAddr))

*__FindConfigDev(__reg("a6").ConfigDev void *, __reg("a0") CONST struct ConfigDev * oldConfigDev, __reg("d0") LONG manufacturer, __reg("d1") LONG product)="\tjsr\t-72(a6)"
FindConfigDev(oldConfigDev,.#define manufacturer, product) __FindConfigDev(ExpansionBase, (oldConfigDev), (manufacturer), (product))

__FreeBoardMem(__reg("a6").l void *, __reg("d0") ULONG startSlot, __reg("d1") ULONG slotSpec)="\tjsr\t-78(a6)"
FreeBoardMem(startSlot,.#define slotSpec) __FreeBoardMem(ExpansionBase, (startSlot), (slotSpec))

__FreeConfigDev(__reg("a6").l void *, __reg("a0") struct ConfigDev * configDev)="\tjsr\t-84(a6)"
FreeConfigDev(configDev).#define __FreeConfigDev(ExpansionBase, (configDev))

__FreeExpansionMem(__reg("a6").l void *, __reg("d0") ULONG startSlot, __reg("d1") ULONG numSlots)="\tjsr\t-90(a6)"
FreeExpansionMem(startSlot,.#define numSlots) __FreeExpansionMem(ExpansionBase, (startSlot), (numSlots))

__ReadExpansionByte(__reg("a6").b void *, __reg("a0") CONST_APTR board, __reg("d0") ULONG offset)="\tjsr\t-96(a6)"
ReadExpansionByte(board,.#define offset) __ReadExpansionByte(ExpansionBase, (board), (offset))

__ReadExpansionRom(__reg("a6").l void *, __reg("a0") CONST_APTR board, __reg("a1") struct ConfigDev * configDev)="\tjsr\t-102(a6)"
ReadExpansionRom(board,.#define configDev) __ReadExpansionRom(ExpansionBase, (board), (configDev))

__RemConfigDev(__reg("a6").l void *, __reg("a0") struct ConfigDev * configDev)="\tjsr\t-108(a6)"
RemConfigDev(configDev).#define __RemConfigDev(ExpansionBase, (configDev))

__WriteExpansionByte(__reg("a6").l void *, __reg("a0") APTR board, __reg("d0") ULONG offset, __reg("d1") ULONG byte)="\tjsr\t-114(a6)"
WriteExpansionByte(board,.#define offset, byte) __WriteExpansionByte(ExpansionBase, (board), (offset), (byte))

__ObtainConfigBinding(__reg("a6").l void *)="\tjsr\t-120(a6)"
ObtainConfigBinding().#define __ObtainConfigBinding(ExpansionBase)

__ReleaseConfigBinding(__reg("a6").l void *)="\tjsr\t-126(a6)"
ReleaseConfigBinding().#define __ReleaseConfigBinding(ExpansionBase)

__SetCurrentBinding(__reg("a6").l void *, __reg("a0") struct CurrentBinding * currentBinding, __reg("d0") ULONG bindingSize)="\tjsr\t-132(a6)"
SetCurrentBinding(currentBinding,.#define bindingSize) __SetCurrentBinding(ExpansionBase, (currentBinding), (bindingSize))

__GetCurrentBinding(__reg("a6").l void *, __reg("a0") CONST struct CurrentBinding * currentBinding, __reg("d0") ULONG bindingSize)="\tjsr\t-138(a6)"
GetCurrentBinding(currentBinding,.#define bindingSize) __GetCurrentBinding(ExpansionBase, (currentBinding), (bindingSize))

*__MakeDosNode(__reg("a6").DeviceNode void *, __reg("a0") CONST_APTR parmPacket)="\tjsr\t-144(a6)"
MakeDosNode(parmPacket).#define __MakeDosNode(ExpansionBase, (parmPacket))

__AddDosNode(__reg("a6").BOOL void *, __reg("d0") LONG bootPri, __reg("d1") ULONG flags, __reg("a0") struct DeviceNode * deviceNode)="\tjsr\t-150(a6)"
AddDosNode(bootPri,.#define flags, deviceNode) __AddDosNode(ExpansionBase, (bootPri), (flags), (deviceNode))

