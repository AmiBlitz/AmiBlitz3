#AddICRVector(resource, = iCRBit, interrupt) ({ \
NEWTYPE.Library
_AddICRVector_iCRBit.l = (iCRBit); \
*_AddICRVector_interrupt.Interrupt = (interrupt); \
\.({ 
char.register * _AddICRVector__bn __asm("a6") = (char *) (resource);\
Interrupt.((struct * (*)(struct Library * __asm("a6"), LONG __asm("d0"), struct Interrupt * __asm("a1"))) \
-.(_AddICRVector__bn 6))(_AddICRVector__bn, _AddICRVector_iCRBit, _AddICRVector_interrupt); \
End NEWTYPE);End NEWTYPE)

#RemICRVector(resource, = iCRBit, interrupt) ({ \
