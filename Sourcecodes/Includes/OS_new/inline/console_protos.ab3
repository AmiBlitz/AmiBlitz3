CNIF @#_VBCCINLINE_CONSOLE_H=0 
#_VBCCINLINE_CONSOLE_H = 1

CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 

NEWTYPE.InputEvent
CDInputHandler(events,.#define consoleDevice) __CDInputHandler(ConsoleDevice, (events), (consoleDevice))

__RawKeyConvert(__reg("a6").l void *, __reg("a0") CONST struct InputEvent * events, __reg("a1") STRPTR buffer, __reg("d1") LONG length, __reg("a2") CONST struct KeyMap * keyMap)="\tjsr\t-48(a6)"
RawKeyConvert(events,.#define buffer, length, keyMap) __RawKeyConvert(ConsoleDevice, (events), (buffer), (length), (keyMap))

;/*.#endif _VBCCINLINE_CONSOLE_H  */
