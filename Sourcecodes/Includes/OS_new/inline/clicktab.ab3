#AllocClickTabNodeA(tags) = ({ \
NEWTYPE.TagItem
\.({ 
char.register * _AllocClickTabNodeA__bn __asm("a6") = (char *) (CLICKTAB_BASE_NAME);\
Node.((struct * (*)(char * __asm("a6"), struct TagItem * __asm("a0"))) \
-.(_AllocClickTabNodeA__bn 36))(_AllocClickTabNodeA__bn, _AllocClickTabNodeA_tags); \
End NEWTYPE);End NEWTYPE)

CNIF @#NO_INLINE_STDARG=0 
static __inline__ struct Node * ___AllocClickTabNode(struct Library * ClickTabBase, Tag tags, ...)
{
  return AllocClickTabNodeA((struct TagItem *) &tags)
}

#AllocClickTabNode(tags...) = ___AllocClickTabNode(CLICKTAB_BASE_NAME, tags)
CEND 

