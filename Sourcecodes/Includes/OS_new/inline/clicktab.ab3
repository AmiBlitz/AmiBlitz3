CNIF @#NO_INLINE_STDARG=0 
static __inline__ VOID ___SetClickTabNodeAttrs(struct Library * ClickTabBase, struct Node * node, ...)
{
  SetClickTabNodeAttrsA(node, (struct TagItem *) ((ULONG) &node + sizeof(struct Node *)))
}

