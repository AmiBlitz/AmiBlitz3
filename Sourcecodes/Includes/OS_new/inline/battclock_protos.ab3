CNIF @#_VBCCINLINE_BATTCLOCK_H=0 
#_VBCCINLINE_BATTCLOCK_H = 1

CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 

VOID __ResetBattClock(__reg("a6") void *)="\tjsr\t-6(a6)"
#ResetBattClock() = __ResetBattClock(BattClockBase)

ULONG __ReadBattClock(__reg("a6") void *)="\tjsr\t-12(a6)"
#ReadBattClock() = __ReadBattClock(BattClockBase)

VOID __WriteBattClock(__reg("a6") void *, __reg("d0") ULONG time)="\tjsr\t-18(a6)"
#WriteBattClock(time) = __WriteBattClock(BattClockBase, (time))

CEND ;/*  _VBCCINLINE_BATTCLOCK_H  */
