CNIF @#_VBCCINLINE_CIA_H=0 
#_VBCCINLINE_CIA_H = 1

CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 

NEWTYPE.Interrupt
AddICRVector(resource,.#define iCRBit, interrupt) __AddICRVector((resource), (iCRBit), (interrupt))

__RemICRVector(__reg("a6").l struct Library * resource, __reg("d0") LONG iCRBit, __reg("a1") struct Interrupt * interrupt)="\tjsr\t-12(a6)"
RemICRVector(resource,.#define iCRBit, interrupt) __RemICRVector((resource), (iCRBit), (interrupt))

__AbleICR(__reg("a6").w struct Library * resource, __reg("d0") LONG mask)="\tjsr\t-18(a6)"
AbleICR(resource,.#define mask) __AbleICR((resource), (mask))

__SetICR(__reg("a6").w struct Library * resource, __reg("d0") LONG mask)="\tjsr\t-24(a6)"
SetICR(resource,.#define mask) __SetICR((resource), (mask))

;/*.#endif _VBCCINLINE_CIA_H  */
