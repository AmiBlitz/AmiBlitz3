#AllocChooserNodeA(tags) = ({ \
NEWTYPE.TagItem
\.({ 
char.register * _AllocChooserNodeA__bn __asm("a6") = (char *) (CHOOSER_BASE_NAME);\
Node.((struct * (*)(char * __asm("a6"), struct TagItem * __asm("a0"))) \
-.(_AllocChooserNodeA__bn 36))(_AllocChooserNodeA__bn, _AllocChooserNodeA_tags); \
End NEWTYPE);End NEWTYPE)

CNIF @#NO_INLINE_STDARG=0 
static __inline__ struct Node * ___AllocChooserNode(struct Library * ChooserBase, Tag tags, ...)
{
  return AllocChooserNodeA((struct TagItem *) &tags)
}

#AllocChooserNode(tags...) = ___AllocChooserNode(CHOOSER_BASE_NAME, tags)
CEND 

