__MapRawKey(__reg("a6").w void *, __reg("a0") CONST struct InputEvent * event, __reg("a1") STRPTR buffer, __reg("d1") LONG length, __reg("a2") CONST struct KeyMap * keyMap)="\tjsr\t-42(a6)"
