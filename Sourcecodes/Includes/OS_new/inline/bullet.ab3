CNIF @#_INLINE_BULLET_H=0 
#_INLINE_BULLET_H = 1

CNIF @#CLIB_BULLET_PROTOS_H=0 
#CLIB_BULLET_PROTOS_H = 1
CEND 

CNIF @#EXEC_LIBRARIES_H=0 
INCLUDE"exec/libraries.ab3" 
CEND 
CNIF @#UTILITY_TAGITEM_H=0 
INCLUDE"utility/tagitem.ab3" 
CEND 
CNIF @#DISKFONT_GLYPH_H=0 
INCLUDE"diskfont/glyph.ab3" 
CEND 

CNIF @#BULLET_BASE_NAME=0 
#BULLET_BASE_NAME = BulletBase
CEND 

#OpenEngine() = ({ \
  register char * _OpenEngine__bn __asm("a6") = (char *) (BULLET_BASE_NAME);\
  ((struct GlyphEngine * (*)(char * __asm("a6"))) \
  (_OpenEngine__bn - 30))(_OpenEngine__bn); \
})

#CloseEngine(glyphEngine) = ({ \
NEWTYPE.GlyphEngine
\.({ 
char.register * _CloseEngine__bn __asm("a6") = (char *) (BULLET_BASE_NAME);\
(*)(char.((VOID * __asm("a6"), struct GlyphEngine * __asm("a0"))) \
-.(_CloseEngine__bn 36))(_CloseEngine__bn, _CloseEngine_glyphEngine); \
End NEWTYPE);End NEWTYPE)

#SetInfoA(glyphEngine, = tagList) ({ \
NEWTYPE.GlyphEngine
struct.CONST TagItem * _SetInfoA_tagList = (tagList); \
\.({ 
char.register * _SetInfoA__bn __asm("a6") = (char *) (BULLET_BASE_NAME);\
(*)(char.((ULONG * __asm("a6"), struct GlyphEngine * __asm("a0"), CONST struct TagItem * __asm("a1"))) \
-.(_SetInfoA__bn 42))(_SetInfoA__bn, _SetInfoA_glyphEngine, _SetInfoA_tagList); \
End NEWTYPE);End NEWTYPE)

CNIF @#NO_INLINE_STDARG=0 
static __inline__ ULONG ___SetInfo(struct Library * BulletBase, struct GlyphEngine * glyphEngine, ...)
{
  return SetInfoA(glyphEngine, (CONST struct TagItem *) ((ULONG) &glyphEngine + sizeof(struct GlyphEngine *)))
}

#SetInfo(glyphEngine...) = ___SetInfo(BULLET_BASE_NAME, glyphEngine)
CEND 

#ObtainInfoA(glyphEngine, = tagList) ({ \
NEWTYPE.GlyphEngine
struct.CONST TagItem * _ObtainInfoA_tagList = (tagList); \
