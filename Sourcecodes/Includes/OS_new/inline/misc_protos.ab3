CNIF @#_VBCCINLINE_MISC_H=0 
#_VBCCINLINE_MISC_H = 1

CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 

UBYTE * __AllocMiscResource(__reg("a6") void *, __reg("d0") ULONG unitNum, __reg("a1") CONST_STRPTR name)="\tjsr\t-6(a6)"
#AllocMiscResource(unitNum, = name) __AllocMiscResource(MiscBase, (unitNum), (name))

VOID __FreeMiscResource(__reg("a6") void *, __reg("d0") ULONG unitNum)="\tjsr\t-12(a6)"
#FreeMiscResource(unitNum) = __FreeMiscResource(MiscBase, (unitNum))

CEND ;/*  _VBCCINLINE_MISC_H  */
