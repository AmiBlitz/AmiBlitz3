CNIF @#_VBCCINLINE_DISK_H=0 
#_VBCCINLINE_DISK_H = 1

CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 

BOOL __AllocUnit(__reg("a6") void *, __reg("d0") LONG unitNum)="\tjsr\t-6(a6)"
#AllocUnit(unitNum) = __AllocUnit(DiskBase, (unitNum))

VOID __FreeUnit(__reg("a6") void *, __reg("d0") LONG unitNum)="\tjsr\t-12(a6)"
#FreeUnit(unitNum) = __FreeUnit(DiskBase, (unitNum))

NEWTYPE.DiskResourceUnit
GetUnit(unitPointer).#define __GetUnit(DiskBase, (unitPointer))

__GiveUnit(__reg("a6").l void *)="\tjsr\t-24(a6)"
GiveUnit().#define __GiveUnit(DiskBase)

__GetUnitID(__reg("a6").l void *, __reg("d0") LONG unitNum)="\tjsr\t-30(a6)"
GetUnitID(unitNum).#define __GetUnitID(DiskBase, (unitNum))

__ReadUnitID(__reg("a6").l void *, __reg("d0") LONG unitNum)="\tjsr\t-36(a6)"
ReadUnitID(unitNum).#define __ReadUnitID(DiskBase, (unitNum))

;/*.#endif _VBCCINLINE_DISK_H  */
