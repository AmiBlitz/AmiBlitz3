CNIF @#REACTION_REACTION_H=0 
INCLUDE"reaction/reaction.ab3" 
CEND 

CNIF @#INTUITION_GADGETCLASS_H=0 
INCLUDE"intuition/gadgetclass.ab3" 
CEND 

CNIF @#IMAGES_BEVEL_H=0 
INCLUDE"images/bevel.ab3" 
CEND 

;/*****************************************************************************/

;/* Additional attributes defined by the button.gadget class
; * Our class supports most functions of C= button developer release,
; * however we support many additional options as noted below.
; */

#BUTTON_Dummy = (TAG_USER+$04000000)

#BUTTON_PushButton = (BUTTON_Dummy+1)
	;/* (BOOL) Indicate whether button stays depressed when clicked */

#BUTTON_Glyph = (BUTTON_Dummy+2)
	;/* (struct Image *) Indicate that image is to be drawn using
;	 * BltTemplate. Note this tag is only partial support, only single
;	 * plane glyphs are rendered correctly.
;	 */

#BUTTON_Array = (BUTTON_Dummy+3)
	;/* (LONG) Indicate that text or image pointer is an array */

#BUTTON_TextPen = (BUTTON_Dummy+5)
	;/* (LONG) Pen to use for text (-1 uses TEXTPEN) */

#BUTTON_FillPen = (BUTTON_Dummy+6)
	;/* (LONG) Pen to use for fill (-1 uses FILLPEN) */

#BUTTON_FillTextPen = (BUTTON_Dummy+7)
	;/* (LONG) Pen to use for fill (-1 uses FILLTEXTPEN) */

#BUTTON_BackgroundPen = (BUTTON_Dummy+8)
	;/* (LONG) Pen to use for fill (-1 uses BACKGROUNDPEN) */

#BUTTON_Current = (BUTTON_Dummy+9)
	;/* (LONG) Indicate which item in the array is current */

#BUTTON_RenderImage = GA_Image
#BUTTON_SelectImage = GA_SelectRender

#BUTTON_BevelStyle = (BUTTON_Dummy+13)
	;/* Bevel Box Style */

#BUTTON_Transparent = (BUTTON_Dummy+15)
	;/* Button is transparent, EraseRect fill pattern used (if any)
;	 * to render button background.
;	 */

#BUTTON_Justification = (BUTTON_Dummy+16)
	;/* LEFT/RIGHT/CENTER jutification of GA_Text text */

#BUTTON_SoftStyle = (BUTTON_Dummy+17)
	;/* Sets Font SoftStyle, ie, Bold, Italics, etc */

#BUTTON_AutoButton = (BUTTON_Dummy+18)
	;/* Automatically creates a button with standard scaled glyphs */

#BUTTON_VarArgs = (BUTTON_Dummy+19)
	;/* Argument array for GA_Text varargs string */

#BUTTON_DomainString = (BUTTON_Dummy+20)
	;/* (STRPTR) default string used for domain calculation */

#BUTTON_Integer = (BUTTON_Dummy+21)
	;/* (int) integer value to display a numeric string.
;	 * Useful with notifications from sliders, scrollers, etc
;	 */

#BUTTON_BitMap = (BUTTON_Dummy+22)
	;/* (struct BitMap *) BitMap to render in button, rather than an image... */

#BUTTON_TextPadding = (BUTTON_Dummy+40)
	;/* (BOOL) Put some extra horizontal padding around button's text label? */

#BUTTON_AnimButton = (BUTTON_Dummy+50)
	;/* (BOOL) Is button animatable?  Use to turn animating on or off */

#BUTTON_AnimImages = (BUTTON_Dummy+51)
	;/* (struct Image *) Sets an array of struct Images for animation */

#BUTTON_SelAnimImages = (BUTTON_Dummy+52)
	;/* (struct Image *) sets an array of alternate images for a selected
;	 * state if used, must contain an equal number of images as the
;	 * array used for BUTTON_AnimImages.  It's wise to use the
;	 * same sized images too
;	 */

#BUTTON_MaxAnimImages = (BUTTON_Dummy+53)
	;/* (LONG) Number of images available in the arrays */

#BUTTON_AnimImageNumber = (BUTTON_Dummy+54)
	;/* (LONG) Current image number in the array(s) to use
;	 * the range of available frames is 0..MaxAnimImages-1
;	 */

#BUTTON_AddAnimImageNumber = (BUTTON_Dummy+55)
	;/* (ULONG) Value to be added to the current image number counter
;	 * the counter will wrap around at MaxAnimImages
;	 */

#BUTTON_SubAnimImageNumber = (BUTTON_Dummy+56)
	;/* (ULONG) Value to be subtracted from the current image number counter
;	 * the counter will wrap around when less than 0
;	 */

#BUTTON_EraseBackground = (BUTTON_Dummy+57) ;/* OS4ONLY */

#BUTTON_HorizAlignment = (BUTTON_Dummy+58) ;/* OS4ONLY */

#BUTTON_VertAlignment = (BUTTON_Dummy+59) ;/* OS4ONLY */

;/****************************************************************************/

;/* Justification modes for BUTTON_Justification.
; */
#BCJ_LEFT = 0
#BCJ_CENTER = 1		;/* default - center text */
#BCJ_RIGHT = 2

#BCJ_CENTRE = BCJ_CENTER

#BALIGN_LEFT = 0 ;/* OS4ONLY */
#BALIGN_TOP = 0 ;/* OS4ONLY */
#BALIGN_CENTER = 1 ;/* OS4ONLY */
#BALIGN_RIGHT = 2 ;/* OS4ONLY */
#BALIGN_BOTTOM = 2 ;/* OS4ONLY */

;/* Built-in button glyphs for BUTTON_AutoButton.
; */

#BAG_POPFILE = 1	;/* popup file req */
#BAG_POPDRAWER = 2	;/* popup drawer req */
#BAG_POPFONT = 3	;/* popup font req */
#BAG_CHECKBOX = 4	;/* check glyph button */
#BAG_CANCELBOX = 5	;/* cancel glyph button */
#BAG_UPARROW = 6	;/* up arrow */
#BAG_DNARROW = 7	;/* down arrow */
#BAG_RTARROW = 8	;/* right arrow */
#BAG_LFARROW = 9	;/* left arrow */
#BAG_POPTIME = 10	;/* popup time glyph */
#BAG_POPSCREEN = 11	;/* popup screen mode glyph */
#BAG_POPUP = 12	;/* generic popup */
#BAG_POPDATE = 13	;/* popup date glyph (V47) */
#BAG_POPCOLOR = 14	;/* popup colour glyph (V47) */
#BAG_POPCOLOUR = BAG_POPCOLOR

;/*****************************************************************************/

CEND ;/* GADGETS_BUTTON_H */
