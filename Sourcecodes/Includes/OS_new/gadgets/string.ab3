CNIF @#REACTION_REACTION_H=0 
INCLUDE"reaction/reaction.ab3" 
CEND 

CNIF @#INTUITION_GADGETCLASS_H=0 
INCLUDE"intuition/gadgetclass.ab3" 
CEND 

;/*****************************************************************************/

;/* string.gadget accepts the same tag parameters as the ROM strgclass
; * in addition to those listed below.
; */

#STRINGA_MinVisible = (REACTION_Dummy+$0055000)
	;/* (UWORD) Minimum character length to domain min size on. [ISG]
;	 *         In a layout, a nominal domain would be 2 times this value.
;	 */

#STRINGA_HookType = (REACTION_Dummy+$0055001)
	;/* (UWORD) Use which built-in hook function? [I]
;	 */

;/* The following tags are new for v45 */

#STRINGA_RelVerifySpecial = (REACTION_Dummy+$005500a) ;/* OS4ONLY */

#STRINGA_GetBlockPos = (REACTION_Dummy+$0055010)
	;/* (ULONG) Returns the position of the first and last character
;	 * of the marked block. The upper 16bit (WORD) of the long-word contain
;	 * the start position and the lower 16bit (WORD) the end position.
;	 * When nothing is marked both values will be -1. [G]
;	 */

#STRINGA_Mark = (REACTION_Dummy+$0055011)
	;/* (ULONG) Mark the given block. The upper 16bit of the longword contain
;	 * the start position and the lower one the end position. If one or both
;	 * values are -1, the current block will be unmarked. [ISU]
;	 */

#STRINGA_AllowMarking = (REACTION_Dummy+$0055012)
	;/* (BOOL) Enable/disable marking, defaults to TRUE. [ISUG]
;	 */

#STRINGA_InterimUpdates = (REACTION_Dummy+$0055013)
	;/* (BOOL) Enable/disable interim updates, defaults to TRUE. [IS]
;	 */

#STRINGA_ASLTags = (REACTION_Dummy+$0055013) ;/* OS4ONLY */

#STRINGA_MarkActive = (REACTION_Dummy+$0055014) ;/* OS4ONLY */

#STRINGA_DisablePopup = (REACTION_Dummy+$0055015) ;/* OS4ONLY */

#STRINGA_MinVal = (REACTION_Dummy+$0055016) ;/* OS4ONLY */

#STRINGA_MaxVal = (REACTION_Dummy+$0055017) ;/* OS4ONLY */

;/* Support hook types for STRINGA_HookType
; */
#SHK_CUSTOM = 0
#SHK_PASSWORD = 1
#SHK_IPADDRESS = 2
#SHK_FLOAT = 3
#SHK_HEXIDECIMAL = 4
#SHK_TELEPHONE = 5
#SHK_POSTALCODE = 6
#SHK_AMOUNT = 7
#SHK_UPPERCASE = 8
#SHK_HOTKEY = 9 ;/* new for v45 */

#SHK_HEXADECIMAL = SHK_HEXIDECIMAL

CEND ;/* GADGETS_STRING_H */
