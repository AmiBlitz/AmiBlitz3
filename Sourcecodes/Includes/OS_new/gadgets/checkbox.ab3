CNIF @#REACTION_REACTION_H=0 
INCLUDE"reaction/reaction.ab3" 
CEND 

CNIF @#INTUITION_GADGETCLASS_H=0 
INCLUDE"intuition/gadgetclass.ab3" 
CEND 

;/*****************************************************************************/

;/* Additional attributes defined by the checkbox.gadget class */
#CHECKBOX_Dummy = (REACTION_Dummy + $11000)

#CHECKBOX_TextPen = (CHECKBOX_Dummy+1)
	;/* (WORD) Pen to use for text (~0 uses TEXTPEN). */

#CHECKBOX_FillTextPen = (CHECKBOX_Dummy+2)
	;/* (WORD) Pen to use for fill (~0 uses FILLTEXTPEN). */

#CHECKBOX_BackgroundPen = (CHECKBOX_Dummy+3)
	;/* (WORD) Pen to use for background (~0 uses BACKGROUNDPEN) */

#CHECKBOX_BevelStyle = (CHECKBOX_Dummy+4)
	;/* (WORD) Optional outer bevel style - OBSOLETE */

#CHECKBOX_TextPlace = (CHECKBOX_Dummy+5)
	;/* (LONG) Gadget Text Location (PLACETEXT_LEFT or PLACETEXT_RIGHT). */

#CHECKBOX_Checked = GA_Selected
	;/* (BOOL) Checkmark state. */

#CHECKBOX_Invert = (CHECKBOX_Dummy+6)
	;/* (BOOL) CheckMark state: TRUE is FALSE and FALSE is TRUE. V50. */

;/*****************************************************************************/

CEND ;/* GADGETS_CHECKBOX_H */
