CNIF @#REACTION_REACTION_H=0 
INCLUDE"reaction/reaction.ab3" 
CEND 

CNIF @#INTUITION_IMAGECLASS_H=0 
INCLUDE"intuition/imageclass.ab3" 
CEND 

;/*****************************************************************************/

#DRAWLIST_Dummy = (REACTION_Dummy + $17000)

#DRAWLIST_Directives = (DRAWLIST_Dummy+1)
	;/* (struct DrawList *) Pointer to drawlist directive array. */

#DRAWLIST_RefHeight = (DRAWLIST_Dummy+2)
	;/* (WORD) Reference height of drawlist. */

#DRAWLIST_RefWidth = (DRAWLIST_Dummy+3)
	;/* (WORD) Reference width of drawlist. */

#DRAWLIST_DrawInfo = (DRAWLIST_Dummy+4)
	;/* Obsolete!! Do not use. */

;/*****************************************************************************/

;/* DrawList Primitive Directives
; */

#DLST_END = 0

#DLST_LINE = 1
#DLST_RECT = 2
#DLST_FILL = 3
#DLST_ELLIPSE = 4
#DLST_CIRCLE = 5
#DLST_LINEPAT = 6
#DLST_FILLPAT = 7
#DLST_AMOVE = 8
#DLST_ADRAW = 9
#DLST_AFILL = 10
#DLST_BEVELBOX = 11
#DLST_ARC = 12
#DLST_START = 13
#DLST_BOUNDS = 13
#DLST_LINESIZE = 14

;/*****************************************************************************/

;/* Pass an array of these via DRAWLIST_Directives.
; * Last entry must be DLST_END!
; */

NEWTYPE.DrawList

dl_Directive.w 
dl_X1,.w dl_Y1
dl_X2,.w dl_Y2
dl_Pen.w 
End NEWTYPE

CEND ;/* IMAGES_DRAWLIST_H */
