CNIF @#DOS_STDIO_H=0 
#DOS_STDIO_H = 1
;/*
;**
;**	$VER: stdio.h 47.1 (29.7.2019)
;**
;**	ANSI-like stdio defines for dos buffered I/O
;**
;**	Copyright (C) 2019 Hyperion Entertainment CVBA.
;**	    Developed under license.
;**
;*/

#ReadChar() = FGetC(Input())
#WriteChar(c) = FPutC(Output(),(c))
#UnReadChar(c) = UnGetC(Input(),(c))
;/* next one is inefficient */
#ReadChars(buf,num) = FRead(Input(),(buf),1,(num))
#ReadLn(buf,len) = FGets(Input(),(buf),(len))
#WriteStr(s) = FPuts(Output(),(s))
#VWritef(format,argv) = VFWritef(Output(),(format),(argv))

;/* types for SetVBuf */
#BUF_LINE = 0	;/* flush on \n, etc */
#BUF_FULL = 1	;/* never flush except when needed */
#BUF_NONE = 2	;/* no buffering */

;/* EOF return value */
#ENDSTREAMCH = -1

CEND ;/* DOS_STDIO_H */
