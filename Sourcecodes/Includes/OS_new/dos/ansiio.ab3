CNIF @#DOS_ANSIIO_H=0 
#DOS_ANSIIO_H = 1
;/*
;**
;**      $VER: ansiio.h 47.1 (29.7.2019)
;**
;**      Macros to emulate some ANSI I/O functions
;**      through the dos.library. These macros
;**      replace functions in amiga.lib.
;**
;**      Copyright (C) 2019 Hyperion Entertainment CVBA.
;**          Developed under license.
;**
;*/

#fgetc(stream) = FGetC(stream)
#getchar() = FGetC(Input())
#fgets(s,l,stream) = FGets(stream,s,l)
#ungetc(c,stream) = UnGetC(stream,c)
#fputc(c,stream) = FPutC(stream,c)
#fputs(s,stream) = FPuts(stream,s)
#puts(s) = PutStr(s)
#putchar(c) = FPutC(Output(),c)
#fread(buf,s,n,fh) = FRead(fh,buf,s,n)
#fwrite(buf,s,n,fh) = FWrite(fh,buf,s,n)
#fflush(stream) = Flush(stream)
#fclose(stream) = Close(stream)
#vfprintf(fh,fmt,args) = VFPrintf(fh,fmt,args)
#fprintf = FPrintf
#vprintf(fmt,args) = VPrintf(fmt,args)
#printf = Printf
#perror(s) = PrintFault(IoErr(),s)

CEND ;/* DOS_ANSIIO_H */
