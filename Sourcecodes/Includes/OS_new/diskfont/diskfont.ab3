CNIF @#DISKFONT_DISKFONT_H=0 
#DISKFONT_DISKFONT_H = 1

;/*
;**	$VER: diskfont.h 47.2 (16.11.2021)
;**
;**	diskfont library definitions
;**
;**	Copyright (C) 2019-2022 Hyperion Entertainment CVBA.
;**	    Developed under license.
;*/

CNIF @#EXEC_NODES_H=0 
INCLUDE"exec/nodes.ab3" 
CEND 

CNIF @#EXEC_LISTS_H=0 
INCLUDE"exec/lists.ab3" 
CEND 

CNIF @#GRAPHICS_TEXT_H=0 
INCLUDE"graphics/text.ab3" 
CEND 

#MAXFONTPATH = 256   ;/* including null terminator */

;/* this really belongs to <graphics/text.h> */
#TA_CharSet = (3|TAG_USER)

NEWTYPE.FontContents
fc_FileName.TEXT [MAXFONTPATH]
fc_YSize.w 
fc_Style.b 
fc_Flags.b 
End NEWTYPE

NEWTYPE.TFontContents
tfc_FileName.TEXT [MAXFONTPATH-2]
tfc_TagCount.w ;	;/* including the TAG_DONE tag */
    ;/*
;     *	if tfc_TagCount is non-zero, tfc_FileName is overlayed with
;     *	Text Tags starting at:	(struct TagItem *)
;     *	    &tfc_FileName[MAXFONTPATH-(tfc_TagCount*sizeof(struct TagItem))]
;     */
tfc_YSize.w 
tfc_Style.b 
tfc_Flags.b 
End NEWTYPE


#FCH_ID = $0f00	;/* FontContentsHeader, then FontContents */
#TFCH_ID = $0f02	;/* FontContentsHeader, then TFontContents */
#OFCH_ID = $0f03	;/* FontContentsHeader, then TFontContents,
;			 * associated with outline font */

NEWTYPE.FontContentsHeader
fch_FileID.w ;		;/* FCH_ID */
fch_NumEntries.w ;	;/* the number of FontContents elements */
    ;/* struct FontContents fch_FC[], or struct TFontContents fch_TFC[]; */
End NEWTYPE


#DFH_ID = $0f80
#MAXFONTNAME = 32	;/* font name including ".font\0" */

NEWTYPE.DiskFontHeader
    ;/* the following 8 bytes are not actually considered a part of the	*/
    ;/* DiskFontHeader, but immediately preceed it. The NextSegment is	*/
    ;/* supplied by the linker/loader, and the ReturnCode is the code	*/
    ;/* at the beginning of the font in case someone runs it...		*/
    ;/*	 ULONG dfh_NextSegment;			\* actually a BPTR	*/
    ;/*	 ULONG dfh_ReturnCode;			\* MOVEQ #0,D0 : RTS	*/
    ;/* here then is the official start of the DiskFontHeader...		*/
dfh_DF.Node ;		;/* node to link disk fonts */
dfh_FileID.w ;		;/* DFH_ID */
dfh_Revision.w ;	;/* the font revision */
dfh_Segment.l ;	;/* the segment address when loaded */
dfh_Name.TEXT [MAXFONTNAME]; ;/* stripped font name (null terminated) */
dfh_TF.TextFont ;	;/* loaded TextFont structure */
				;/* dfh_TF.tf_Message.mn_Node.ln_Name */
				;/* points to the full font name */
End NEWTYPE

;/* unfortunately, this needs to be explicitly typed */
;/* used only if dfh_TF.tf_Style FSB_TAGGED bit is set */
;/* moved to dfh_TF.tf_Extension->tfe_Tags during loading */
#dfh_TagList = dfh_Segment


#AFB_MEMORY = 0	;/* dont filter out memory fonts */
#AFF_MEMORY = $0001
#AFB_DISK = 1	;/* dont filter out disk fonts */
#AFF_DISK = $0002
#AFB_SCALED = 2	;/* dont filter out scaled fonts */
#AFF_SCALED = $0004
#AFB_BITMAP = 3	;/* filter out .otag files */
#AFF_BITMAP = $0008
#AFB_OTAG = 4	;/* show .otag files only, */
#AFF_OTAG = $0010	;/* implemented since V46 */
#AFB_TYPE = 6	;/* return diskfont type in [t]af_Type: */
				;/* AFF_DISK|AFF_BITMAP for bitmap fonts, */
				;/* AFF_DISK|AFF_OTAG for .otag fonts, */
				;/* AFF_DISK|AFF_OTAG|AFF_SCALED for */
				;/* scalable .otag fonts. */
#AFF_CHARSET = $0020	;/* reserved */
#AFF_TYPE = $0040	;/* implemented since V46 */

#AFB_TAGGED = 16	;/* return TAvailFonts with taglist */
#AFF_TAGGED = $10000L

NEWTYPE.AvailFonts
af_Type.w ;		;/* MEMORY, DISK, or SCALED */
af_Attr.TextAttr ;	;/* text attributes for font */
End NEWTYPE

NEWTYPE.TAvailFonts
taf_Type.w ;		;/* MEMORY, DISK, or SCALED */
taf_Attr.TTextAttr ;	;/* text attributes for font */
End NEWTYPE

NEWTYPE.AvailFontsHeader
afh_NumEntries.w ;	 ;/* number of AvailFonts elements */
    ;/* struct AvailFonts afh_AF[], or struct TAvailFonts afh_TAF[]; */
End NEWTYPE

;/* structure used by EOpenEngine() ESetInfo() etc (V47) */
NEWTYPE.EGlyphEngine
ege_Reserved.l ;     ;/* System reserved, don't touch */
*ege_BulletBase.Library 
*ege_GlyphEngine.GlyphEngine 
End NEWTYPE

;/* flags for OpenOutlineFont() (V47) */
#OFB_OPEN = 0
#OFF_OPEN = $00000001L

;/* structure returned by OpenOutlineFont() (V47) */
NEWTYPE.OutlineFont
olf_OTagPath.l ;    ;/* full path & name of the .otag file */
*olf_OTagList.TagItem ;    ;/* relocated .otag file in memory     */
olf_EngineName.l ;  ;/* OT_Engine name                     */
olf_LibraryName.l ; ;/* OT_Engine name + ".library"        */
olf_EEngine.EGlyphEngine ;     ;/* All NULL if OFF_OPEN not specified */
olf_Reserved.l ;    ;/* for future expansion               */
olf_UserData.l ;    ;/* for private use                    */
End NEWTYPE

CEND ;/* DISKFONT_DISKFONT_H */
