CNIF @#DATATYPES_SOUNDCLASS_H=0 
#DATATYPES_SOUNDCLASS_H = 1
;/*
;**	$VER: soundclass.h 47.1 (5.4.2021)
;**
;**  Interface definitions for DataType sound objects.
;**
