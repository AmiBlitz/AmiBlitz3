;**	    Developed under license.
;*/

CNIF @#UTILITY_TAGITEM_H=0 
INCLUDE"utility/tagitem.ab3" 
CEND 

CNIF @#DATATYPES_DATATYPESCLASS_H=0 
INCLUDE"datatypes/datatypesclass.ab3" 
CEND 

CNIF @#LIBRARIES_IFFPARSE_H=0 
INCLUDE"libraries/iffparse.ab3" 
CEND 

CNIF @#DEVICES_TIMER_H=0 
INCLUDE"devices/timer.ab3" 
CEND 

;/*****************************************************************************/

#SOUNDDTCLASS = "sound.datatype"

;/*****************************************************************************/

;/* Sound attributes */
#SDTA_Dummy = (DTA_Dummy + 500)
#SDTA_VoiceHeader = (SDTA_Dummy + 1)

;/* (BYTE *) Sample data */
#SDTA_Sample = (SDTA_Dummy + 2)

;/* (ULONG) Length of the sample data (per channel) in UBYTEs */
#SDTA_SampleLength = (SDTA_Dummy + 3)

;/* (UWORD) Period */
#SDTA_Period = (SDTA_Dummy + 4)

;/* (UWORD) Volume. Range from 0 to 64 */
#SDTA_Volume = (SDTA_Dummy + 5)

#SDTA_Cycles = (SDTA_Dummy + 6)

;/* The following tags are new for V40 */

;/* (struct Task *) Task to signal when sound is complete or next buffer needed. */
#SDTA_SignalTask = (SDTA_Dummy + 7)

;/* (ULONG) Signal mask to use on completion or 0 to disable
; *
; *         NOTE: Due to a bug in sound.datatype V40 SDTA_SignalBit
; *               was actually implemented as a signal mask as opposed
; *               to a bit number. The documentation now reflects
; *               this. If you intend to use a signal bit number
; *               instead of the mask, use the new V44 tag
; *               SDTA_SignalBitNumber below.
; */
#SDTA_SignalBit = (SDTA_Dummy + 8)
#SDTA_SignalBitMask = SDTA_SignalBit

;/* (BOOL) Playing a continuous stream of data.  Defaults to FALSE. */
#SDTA_Continuous = (SDTA_Dummy + 9)

;/* The following tags are new for V44 */

;/* (BYTE) Signal bit to use on completion or -1 to disable */
#SDTA_SignalBitNumber = (SDTA_Dummy + 10)

;/* (UWORD) Samples per second */
#SDTA_SamplesPerSec = (SDTA_Dummy + 11)

;/* (TimeVal_Type *) Sample replay period */
#SDTA_ReplayPeriod = (SDTA_Dummy + 12)

;/* (BYTE *) Sample data */
#SDTA_LeftSample = (SDTA_Dummy + 13)
#SDTA_RightSample = (SDTA_Dummy + 14)

;/* (BYTE) Stereo panning */
#SDTA_Pan = (SDTA_Dummy + 15)

;/* (BOOL) FreeVec() all sample data upon OM_DISPOSE. */
#SDTA_FreeSampleData = (SDTA_Dummy + 16)

;/* (BOOL) Wait for the current sample to be played back before
; * switching to the new sample data.
; */
#SDTA_SyncSampleChange = (SDTA_Dummy + 17)

;/* (UBYTE) The actual bitrate of the sample. 8, 16 or 32. (V47) */
#SDTA_BitsPerSample = (SDTA_Dummy + 18)

;/*****************************************************************************/

;/* Data compression methods */
#CMP_NONE = 0
#CMP_FIBDELTA = 1

;/*****************************************************************************/

;/* Unity = Fixed 1.0 = maximum volume */
#Unity = $10000UL

;/*****************************************************************************/

NEWTYPE.VoiceHeader

vh_OneShotHiSamples.l ;	;/* # samples in the high octave 1-shot part */
								;/* (per channel) */
vh_RepeatHiSamples.l ;	;/* # samples in the high octave repeat part */
								;/* (per channel) */
vh_SamplesPerHiCycle.l ;	;/* # samples/cycle in high octave */
								;/* (per channel), else 0 */
vh_SamplesPerSec.w ;		;/* data sampling rate */
vh_Octaves.b ;		;/* # of octaves of waveforms */
vh_Compression.b ;		;/* data compression technique used */
vh_Volume.l ;		;/* playback nominal volume from 0 to Unity
;					 * (full volume). Map this value into
;					 * the output hardware's dynamic range.
;					 */
End NEWTYPE

;/*****************************************************************************/

;/* Channel allocation */
#SAMPLETYPE_Left = (2L)
#SAMPLETYPE_Right = (4L)
#SAMPLETYPE_Stereo = (6L)

typedef long SampleType

;/*****************************************************************************/

;/* IFF types */
#ID_8SVX = MAKE_ID('8','S','V','X')
#ID_VHDR = MAKE_ID('V','H','D','R')
#ID_CHAN = MAKE_ID('C','H','A','N')
#ID_BODY = MAKE_ID('B','O','D','Y')

;/*****************************************************************************/

CEND ;/* DATATYPES_SOUNDCLASS_H */
