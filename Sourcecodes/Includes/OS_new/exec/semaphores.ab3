CNIF @#EXEC_NODES_H=0 
INCLUDE"exec/nodes.ab3" 
CEND ;/* EXEC_NODES_H */

CNIF @#EXEC_LISTS_H=0 
INCLUDE"exec/lists.ab3" 
CEND ;/* EXEC_LISTS_H */

CNIF @#EXEC_PORTS_H=0 
INCLUDE"exec/ports.ab3" 
CEND ;/* EXEC_PORTS_H */

CNIF @#EXEC_TASKS_H=0 
INCLUDE"exec/tasks.ab3" 
CEND ;/* EXEC_TASKS_H */


;/****** SignalSemaphore *********************************************/

;/* Private structure used by ObtainSemaphore() */
NEWTYPE.SemaphoreRequest
  sr_Link.MinNode 
  *sr_Waiter.Task 
End NEWTYPE

;/* Signal Semaphore data structure */
NEWTYPE.SignalSemaphore
  ss_Link.Node 
  ss_NestCount.w 
  ss_WaitQueue.MinList 
  ss_MultipleLink.SemaphoreRequest 
  *ss_Owner.Task 
  ss_QueueCount.w 
End NEWTYPE

;/****** Semaphore procure message (for use in V39 Procure/Vacate) ****/
NEWTYPE.SemaphoreMessage
  ssm_Message.Message 
  *ssm_Semaphore.SignalSemaphore 
End NEWTYPE

#SM_SHARED = (1L)
#SM_EXCLUSIVE = (0L)

;/****** Semaphore (Old Procure/Vacate type, not reliable) ***********/

NEWTYPE.Semaphore
  sm_MsgPort.MsgPort 
  sm_Bids.w 
End NEWTYPE

Macro sm_LockMsg : mp_SigTask :End Macro

CEND ;/* EXEC_SEMAPHORES_H */
