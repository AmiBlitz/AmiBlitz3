CNIF @#EXEC_INITIALIZERS_H=0 
#EXEC_INITIALIZERS_H = 1
;/*
;**	$VER: initializers.h 47.1 (28.6.2019)
;**
;**	Macros for use with the InitStruct() function.
;**
;**	Copyright (C) 2019 Hyperion Entertainment CVBA.
;**	    Developed under license.
;**
;*/

#OFFSET(structName, = structEntry) \
				(&(((struct structName *) 0)->structEntry))
#INITBYTE(offset,value) = $e000,(UWORD) (offset),(UWORD) ((value) LSL 8)
#INITWORD(offset,value) = $d000,(UWORD) (offset),(UWORD) (value)
#INITLONG(offset,value) = $c000,(UWORD) (offset), \
				(UWORD) ((value) LSR 16), \
				(UWORD) ((value) & $ffff)
#INITSTRUCT(size,offset,value,count) = \
				(UWORD) ($c000|(size LSL 12)|(count LSL 8)| \
				((UWORD) ((offset) LSR 16)), \
				((UWORD) (offset)) & $ffff)
CEND ;/* EXEC_INITIALIZERS_H */
