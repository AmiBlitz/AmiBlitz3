CNIF @#EXEC_NODES_H=0 
INCLUDE"exec/nodes.ab3" 
CEND ;/* EXEC_NODES_H */

CNIF @#EXEC_LISTS_H=0 
INCLUDE"exec/lists.ab3" 
CEND ;/* EXEC_LISTS_H */


NEWTYPE.Interrupt
is_Node.Node 
is_Data.l ;		    ;/* server data segment  */
(*is_Code)().l ;	    ;/* server code entry    */
End NEWTYPE


NEWTYPE.IntVector ;/* For EXEC use ONLY! */
iv_Data.l 
(*iv_Code)().l 
*iv_Node.Node 
End NEWTYPE


NEWTYPE.SoftIntList ;/* For EXEC use ONLY! */
sh_List.List 
sh_Pad.w 
End NEWTYPE

#SIH_PRIMASK = ($f0)

;/* this is a fake INT definition, used only for AddIntServer and the like */
#INTB_NMI = 15
#INTF_NMI = (1L LSL 15)

CEND ;/* EXEC_INTERRUPTS_H */
