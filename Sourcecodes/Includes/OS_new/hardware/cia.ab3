CNIF @#HARDWARE_CIA_H=0 
#HARDWARE_CIA_H = 1
;/*
;**	$VER: cia.h 47.1 (1.8.2019)
;**
;**	registers and bits in the Complex Interface Adapter (CIA) chip
;**
;**	Copyright (C) 2019 Hyperion Entertainment CVBA.
;**	    Developed under license.
;*/


CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND ;/* EXEC_TYPES_H */



;/*
; * ciaa is on an ODD address (e.g. the low byte) -- $bfe001
; * ciab is on an EVEN address (e.g. the high byte) -- $bfd000
; *
; * do this to get the definitions:
; *    extern struct CIA ciaa, ciab
; */


NEWTYPE.CIA
ciapra.b 
pad0.b [$ff]
ciaprb.b 
pad1.b [$ff]
ciaddra.b 
pad2.b [$ff]
ciaddrb.b 
pad3.b [$ff]
ciatalo.b 
pad4.b [$ff]
ciatahi.b 
pad5.b [$ff]
ciatblo.b 
pad6.b [$ff]
ciatbhi.b 
pad7.b [$ff]
ciatodlow.b 
pad8.b [$ff]
ciatodmid.b 
pad9.b [$ff]
ciatodhi.b 
pad10.b [$ff]
unusedreg.b 
pad11.b [$ff]
ciasdr.b 
pad12.b [$ff]
ciaicr.b 
pad13.b [$ff]
ciacra.b 
pad14.b [$ff]
ciacrb.b 
End NEWTYPE


;/* interrupt control register bit numbers */
#CIAICRB_TA = 0
#CIAICRB_TB = 1
#CIAICRB_ALRM = 2
#CIAICRB_SP = 3
#CIAICRB_FLG = 4
#CIAICRB_IR = 7
#CIAICRB_SETCLR = 7

;/* control register A bit numbers */
#CIACRAB_START = 0
#CIACRAB_PBON = 1
#CIACRAB_OUTMODE = 2
#CIACRAB_RUNMODE = 3
#CIACRAB_LOAD = 4
#CIACRAB_INMODE = 5
#CIACRAB_SPMODE = 6
#CIACRAB_TODIN = 7

;/* control register B bit numbers */
#CIACRBB_START = 0
#CIACRBB_PBON = 1
#CIACRBB_OUTMODE = 2
#CIACRBB_RUNMODE = 3
#CIACRBB_LOAD = 4
#CIACRBB_INMODE0 = 5
#CIACRBB_INMODE1 = 6
#CIACRBB_ALARM = 7

;/* interrupt control register masks */
#CIAICRF_TA = (1L LSL CIAICRB_TA)
#CIAICRF_TB = (1L LSL CIAICRB_TB)
#CIAICRF_ALRM = (1L LSL CIAICRB_ALRM)
#CIAICRF_SP = (1L LSL CIAICRB_SP)
#CIAICRF_FLG = (1L LSL CIAICRB_FLG)
#CIAICRF_IR = (1L LSL CIAICRB_IR)
#CIAICRF_SETCLR = (1L LSL CIAICRB_SETCLR)

;/* control register A register masks */
#CIACRAF_START = (1L LSL CIACRAB_START)
#CIACRAF_PBON = (1L LSL CIACRAB_PBON)
#CIACRAF_OUTMODE = (1L LSL CIACRAB_OUTMODE)
#CIACRAF_RUNMODE = (1L LSL CIACRAB_RUNMODE)
#CIACRAF_LOAD = (1L LSL CIACRAB_LOAD)
#CIACRAF_INMODE = (1L LSL CIACRAB_INMODE)
#CIACRAF_SPMODE = (1L LSL CIACRAB_SPMODE)
#CIACRAF_TODIN = (1L LSL CIACRAB_TODIN)

;/* control register B register masks */
#CIACRBF_START = (1L LSL CIACRBB_START)
#CIACRBF_PBON = (1L LSL CIACRBB_PBON)
#CIACRBF_OUTMODE = (1L LSL CIACRBB_OUTMODE)
#CIACRBF_RUNMODE = (1L LSL CIACRBB_RUNMODE)
#CIACRBF_LOAD = (1L LSL CIACRBB_LOAD)
#CIACRBF_INMODE0 = (1L LSL CIACRBB_INMODE0)
#CIACRBF_INMODE1 = (1L LSL CIACRBB_INMODE1)
#CIACRBF_ALARM = (1L LSL CIACRBB_ALARM)

;/* control register B INMODE masks */
#CIACRBF_IN_PHI2 = 0
#CIACRBF_IN_CNT = (CIACRBF_INMODE0)
#CIACRBF_IN_TA = (CIACRBF_INMODE1)
#CIACRBF_IN_CNT_TA = (CIACRBF_INMODE0|CIACRBF_INMODE1)

;/*
; * Port definitions -- what each bit in a cia peripheral register is tied to
; */

;/* ciaa port A ($bfe001) */
#CIAB_GAMEPORT1 = (7)   ;/* gameport 1, pin 6 (fire button*) */
#CIAB_GAMEPORT0 = (6)   ;/* gameport 0, pin 6 (fire button*) */
#CIAB_DSKRDY = (5)   ;/* disk ready* */
#CIAB_DSKTRACK0 = (4)   ;/* disk on track 00* */
#CIAB_DSKPROT = (3)   ;/* disk write protect* */
#CIAB_DSKCHANGE = (2)   ;/* disk change* */
#CIAB_LED = (1)   ;/* led light control (0==>bright) */
#CIAB_OVERLAY = (0)   ;/* memory overlay bit */

;/* ciaa port B ($bfe101) -- parallel port */

;/* ciab port A ($bfd000) -- serial and printer control */
#CIAB_COMDTR = (7)   ;/* serial Data Terminal Ready* */
#CIAB_COMRTS = (6)   ;/* serial Request to Send* */
#CIAB_COMCD = (5)   ;/* serial Carrier Detect* */
#CIAB_COMCTS = (4)   ;/* serial Clear to Send* */
#CIAB_COMDSR = (3)   ;/* serial Data Set Ready* */
#CIAB_PRTRSEL = (2)   ;/* printer SELECT */
#CIAB_PRTRPOUT = (1)   ;/* printer paper out */
#CIAB_PRTRBUSY = (0)   ;/* printer busy */

;/* ciab port B ($bfd100) -- disk control */
#CIAB_DSKMOTOR = (7)   ;/* disk motorr* */
#CIAB_DSKSEL3 = (6)   ;/* disk select unit 3* */
#CIAB_DSKSEL2 = (5)   ;/* disk select unit 2* */
#CIAB_DSKSEL1 = (4)   ;/* disk select unit 1* */
#CIAB_DSKSEL0 = (3)   ;/* disk select unit 0* */
#CIAB_DSKSIDE = (2)   ;/* disk side select* */
#CIAB_DSKDIREC = (1)   ;/* disk direction of seek* */
#CIAB_DSKSTEP = (0)   ;/* disk step heads* */

;/* ciaa port A ($bfe001) */
#CIAF_GAMEPORT1 = (1L LSL 7)
#CIAF_GAMEPORT0 = (1L LSL 6)
#CIAF_DSKRDY = (1L LSL 5)
#CIAF_DSKTRACK0 = (1L LSL 4)
#CIAF_DSKPROT = (1L LSL 3)
#CIAF_DSKCHANGE = (1L LSL 2)
#CIAF_LED = (1L LSL 1)
#CIAF_OVERLAY = (1L LSL 0)

;/* ciaa port B ($bfe101) -- parallel port */

;/* ciab port A ($bfd000) -- serial and printer control */
#CIAF_COMDTR = (1L LSL 7)
#CIAF_COMRTS = (1L LSL 6)
#CIAF_COMCD = (1L LSL 5)
#CIAF_COMCTS = (1L LSL 4)
#CIAF_COMDSR = (1L LSL 3)
#CIAF_PRTRSEL = (1L LSL 2)
#CIAF_PRTRPOUT = (1L LSL 1)
#CIAF_PRTRBUSY = (1L LSL 0)

;/* ciab port B ($bfd100) -- disk control */
#CIAF_DSKMOTOR = (1L LSL 7)
#CIAF_DSKSEL3 = (1L LSL 6)
#CIAF_DSKSEL2 = (1L LSL 5)
#CIAF_DSKSEL1 = (1L LSL 4)
#CIAF_DSKSEL0 = (1L LSL 3)
#CIAF_DSKSIDE = (1L LSL 2)
#CIAF_DSKDIREC = (1L LSL 1)
#CIAF_DSKSTEP = (1L LSL 0)

CEND ;/* HARDWARE_CIA_H */
