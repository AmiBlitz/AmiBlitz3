INCLUDE"utility/tagitem.h"
CEND

Macro MAKE_ID
    ('1 LSL 24 | '2 LSL 16 | '3 << LSL 8 | '4)
End Macro

;/*****************************************************************************/

#REACTION_Dummy = (#TAG_USER + $5000000)
; ** The Reaction tags below are used internally to layout and other
; * classes to make some magic happen. They are not intended for your
; * general usage.
; **

#REACTION_TextAttr = (#REACTION_Dummy + 5)
;  ** (struct TextAttr *) Class private tag set internally by layout
;  * only. This tag sets a gadget's font, but does NOT override GA_TextAttr!
;  **

#REACTION_ChangePrefs (#REACTION_Dummy + 6)
;  ** (struct UIPrefs *) Signals classes of dynamic prefs change.
;  **

#REACTION_SpecialPens = (#REACTION_Dummy	+ 7)
;  ** (strut SpecialPens *) Pens used for Xen-style shadowing, etc.
;  **

#REACTION_Justification = (#REACTION_Dummy + 8)
;  ** (UWORD) Class private tag set internally by layout only. This tag
;  * sets a label's justification, but does NOT override LABEL_Justification!
;  **

;/*****************************************************************************/


