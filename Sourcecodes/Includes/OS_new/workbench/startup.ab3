CNIF @#EXEC_PORTS_H=0 
INCLUDE"exec/ports.ab3" 
CEND 

CNIF @#DOS_DOS_H=0 
INCLUDE"dos/dos.ab3" 
CEND 

NEWTYPE.WBStartup
sm_Message.Message ;	;/* a standard message structure */
*sm_Process.MsgPort ;	;/* the process descriptor for you */
sm_Segment.BPTR ;	;/* a descriptor for your code */
sm_NumArgs.l ;	;/* the number of elements in ArgList */
sm_ToolWindow.l ;	;/* description of window */
*sm_ArgList.WBArg ;	;/* the arguments themselves */
End NEWTYPE

NEWTYPE.WBArg
wa_Lock.BPTR ;	;/* a lock descriptor */
wa_Name.l ;	;/* a string relative to that lock */
End NEWTYPE

CEND ;/* !WORKBENCH_STARTUP_H */
