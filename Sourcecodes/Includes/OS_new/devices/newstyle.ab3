CNIF @#DEVICES_NEWSTYLE_H=0 
#DEVICES_NEWSTYLE_H = 1
;/*
;**	$VER: newstyle.h 47.2 (29.9.2021)
;**
;**	Declarations for the NSD command interface.
;**	For 64 bit extensions, see <devices/trackdisk.h>
;**
