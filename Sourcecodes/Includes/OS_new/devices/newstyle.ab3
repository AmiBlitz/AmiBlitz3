;**	    Developed under license.
;*/

CNIF @#EXEC_TYPES_H=0 
INCLUDE"exec/types.ab3" 
CEND 


CNIF @#NSCMD_DEVICEQUERY=0 

;/* Simple additions that are missing from the global V40 "exec/io.h"
; * header file for support of the NewStyleDevice standard.
; * Both were introduced for V43.
; */

#NSCMD_DEVICEQUERY = $4000

;/* The result */
NEWTYPE.NSDeviceQueryResult

	;/* Standard information */
nsdqr_DevQueryFormat.l ;		;/* this is type 0 */
nsdqr_SizeAvailable.l ;		;/* bytes available */

	;/* Common information (READ-ONLY!) */
nsdqr_DeviceType.w ;			;/* what the device does */
nsdqr_DeviceSubType.w ;		;/* depends on the main type */
nsdqr_SupportedCommands.l ;	;/* 0 terminated list of cmds */

	;/* May be extended in the future! Check SizeAvailable! */
End NEWTYPE

;/* For nsdqr_DeviceType */
#NSDEVTYPE_UNKNOWN = 0	;/* No suitable category, anything */
#NSDEVTYPE_GAMEPORT = 1	;/* like gameport.device */
#NSDEVTYPE_TIMER = 2	;/* like timer.device */
#NSDEVTYPE_KEYBOARD = 3	;/* like keyboard.device */
#NSDEVTYPE_INPUT = 4	;/* like input.device */
#NSDEVTYPE_TRACKDISK = 5	;/* like trackdisk.device */
#NSDEVTYPE_CONSOLE = 6	;/* like console.device */
#NSDEVTYPE_SANA2 = 7	;/* A >=SANA2R2 networking device */
#NSDEVTYPE_AUDIOARD = 8	;/* like audio.device */
#NSDEVTYPE_CLIPBOARD = 9	;/* like clipboard.device */
#NSDEVTYPE_PRINTER = 10	;/* like printer.device */
#NSDEVTYPE_SERIAL = 11	;/* like serial.device */
#NSDEVTYPE_PARALLEL = 12	;/* like parallel.device */

;/*------------------------------------------------------------------------*/

CNIF @#NSCMD_TD_READ64=0 

   ;/* Trackdisk specific new style device commands */
#NSCMD_TD_READ64 = $c000
#NSCMD_TD_WRITE64 = $c001
#NSCMD_TD_SEEK64 = $c002
#NSCMD_TD_FORMAT64 = $c003

   ;/* Alias to set the upper 32 bits for a 64 bit IOStdReq */
#io_HighOffset = io_Actual

CEND ;/* NSCMD_TD_READ64 */

CEND ;/* NSCMD_DEVICEQUERY */

CEND ;/* DEVICES_NEWSTYLE_H */
