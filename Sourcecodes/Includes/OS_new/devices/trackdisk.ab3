CNIF @#DEVICES_TRACKDISK_H=0 
#DEVICES_TRACKDISK_H = 1

;/*
;**	$VER: trackdisk.h 47.3 (24.8.2020)
;**
;**	trackdisk device structure and value definitions
;**
