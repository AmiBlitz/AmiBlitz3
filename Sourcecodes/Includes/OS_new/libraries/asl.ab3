#ASL_TopEdge = (ASL_Dummy+4)
#ASL_Width = (ASL_Dummy+5)
#ASL_Height = (ASL_Dummy+6)
#ASL_HookFunc = (ASL_Dummy+7)
#ASL_File = (ASL_Dummy+8)
#ASL_Dir = (ASL_Dummy+9)
#ASL_FontName = (ASL_Dummy+10)
#ASL_FontHeight = (ASL_Dummy+11)
