#ASL_ModeList = (ASL_Dummy+21)
#ASL_ExtFlags1 = (ASL_Dummy+22)
#ASL_Pattern = ASL_FontName
;/* remember what I said up there? Do not use these anymore! */
#FILB_DOWILDFUNC = 7L
#FILB_DOMSGFUNC = 6L
#FILB_SAVE = 5L
#FILB_NEWIDCMP = 4L
#FILB_MULTISELECT = 3L
#FILB_PATGAD = 0L
#FILF_DOWILDFUNC = (1L  LSL  FILB_DOWILDFUNC)
#FILF_DOMSGFUNC = (1L  LSL  FILB_DOMSGFUNC)
#FILF_SAVE = (1L  LSL  FILB_SAVE)
#FILF_NEWIDCMP = (1L  LSL  FILB_NEWIDCMP)
#FILF_MULTISELECT = (1L  LSL  FILB_MULTISELECT)
#FILF_PATGAD = (1L  LSL  FILB_PATGAD)
#FIL1B_NOFILES = 0L
#FIL1B_MATCHDIRS = 1L
#FIL1F_NOFILES = (1L  LSL  FIL1B_NOFILES)
#FIL1F_MATCHDIRS = (1L  LSL  FIL1B_MATCHDIRS)
#FONB_FRONTCOLOR = 0
#FONB_BACKCOLOR = 1
#FONB_STYLES = 2
#FONB_DRAWMODE = 3
#FONB_FIXEDWIDTH = 4
#FONB_NEWIDCMP = 5
#FONB_DOMSGFUNC = 6
