INCLUDE"exec/types.ab3" 
CEND ;/* EXEC_TYPES_H */

CNIF @#EXEC_LISTS_H=0 
INCLUDE"exec/lists.ab3" 
CEND ;/* EXEC_LISTS_H */

CNIF @#EXEC_NODES_H=0 
INCLUDE"exec/nodes.ab3" 
CEND ;/* EXEC_NODES_H */

CNIF @#EXEC_SEMAPHORES_H=0 
INCLUDE"exec/semaphores.ab3" 
CEND 

CNIF @#INTUITION_INTUITION_H=0 
INCLUDE"intuition/intuition.ab3" 
CEND 

CNIF @#INTUITION_SCREENS_H=0 
INCLUDE"intuition/screens.ab3" 
CEND 

CNIF @#INTUITION_CLASSUSR_H=0 
INCLUDE"intuition/classusr.ab3" 
CEND 

CNIF @#DOS_DOS_H=0 
INCLUDE"dos/dos.ab3" 
CEND 

CNIF @#UTILITY_TAGITEM_H=0 
INCLUDE"utility/tagitem.ab3" 
CEND 

CNIF @#APSH_TOOL_ID=0 
#APSH_TOOL_ID = 11000L
#StartupMsgID = (APSH_TOOL_ID+1L)	;/* Startup message */
#LoginToolID = (APSH_TOOL_ID+2L)	;/* Login a tool SIPC port */
#LogoutToolID = (APSH_TOOL_ID+3L)	;/* Logout a tool SIPC port */
#ShutdownMsgID = (APSH_TOOL_ID+4L)	;/* Shutdown message */
#ActivateToolID = (APSH_TOOL_ID+5L)	;/* Activate tool */
#DeactivateToolID = (APSH_TOOL_ID+6L)	;/* Deactivate tool */
#ActiveToolID = (APSH_TOOL_ID+7L)	;/* Tool Active */
#InactiveToolID = (APSH_TOOL_ID+8L)	;/* Tool Inactive */
#ToolStatusID = (APSH_TOOL_ID+9L)	;/* Status message */
#ToolCmdID = (APSH_TOOL_ID+10L)	;/* Tool command message */
#ToolCmdReplyID = (APSH_TOOL_ID+11L)	;/* Reply to tool command */
#ShutdownToolID = (APSH_TOOL_ID+12L)	;/* Shutdown tool */
CEND 

;/* Attributes accepted by GetAmigaGuideAttr() */
#AGA_Dummy = (TAG_USER)
#AGA_Path = (AGA_Dummy+1)
#AGA_XRefList = (AGA_Dummy+2)
#AGA_Activate = (AGA_Dummy+3)
#AGA_Context = (AGA_Dummy+4)

#AGA_HelpGroup = (AGA_Dummy+5)
    ;/* (ULONG) Unique identifier */

#AGA_Reserved1 = (AGA_Dummy+6)
#AGA_Reserved2 = (AGA_Dummy+7)
#AGA_Reserved3 = (AGA_Dummy+8)

#AGA_ARexxPort = (AGA_Dummy+9)
    ;/* (struct MsgPort *) Pointer to the ARexx message port (V40) */

#AGA_ARexxPortName = (AGA_Dummy+10)
   ;/* (STRPTR) Used to specify the ARexx port name (V40) (not copied) */

#AGA_Secure = (AGA_Dummy+11)
   ;/* (BOOL) Disable "ONOPEN", "ONCLOSE" and "LINK RX", "LINK RXS", "LINK SYSTEM" commands (V41) */

typedef void *AMIGAGUIDECONTEXT

NEWTYPE.AmigaGuideMsg

agm_Msg.Message ;			;/* Embedded Exec message structure */
agm_Type.l ;			;/* Type of message */
agm_Data.l ;			;/* Pointer to message data */
agm_DSize.l ;			;/* Size of message data */
agm_DType.l ;			;/* Type of message data */
agm_Pri_Ret.l ;			;/* Primary return value */
agm_Sec_Ret.l ;			;/* Secondary return value */
agm_System1.l 
agm_System2.l 
End NEWTYPE

;/* Allocation description structure */
NEWTYPE.NewAmigaGuide

nag_Lock.BPTR ;			;/* Lock on the document directory */
nag_Name.l ;			;/* Name of document file */
*nag_Screen.Screen ;			;/* Screen to place windows within */
nag_PubScreen.l ;			;/* Public screen name to open on */
nag_HostPort.l ;			;/* Application's ARexx port name */
nag_ClientPort.l ;		;/* Name to assign to the clients ARexx port */
nag_BaseName.l ;			;/* Base name of the application */
nag_Flags.l ;			;/* Flags */
*nag_Context.l ;			;/* NULL terminated context table */
nag_Node.l ;			;/* Node to align on first (defaults to Main) */
nag_Line.l ;			;/* Line to align on */
*nag_Extens.TagItem ;			;/* Tag array extension */
*nag_Client.l ;			;/* Private! MUST be NULL */
End NEWTYPE

;/* public Client flags */
#HTF_LOAD_INDEX = (1L LSL 0)			;/* Force load the index at init time */
#HTF_LOAD_ALL = (1L LSL 1)			;/* Force load the entire database at init */
#HTF_CACHE_NODE = (1L LSL 2)			;/* Cache each node as visited */
#HTF_CACHE_DB = (1L LSL 3)			;/* Keep the buffers around until expunge */
#HTF_UNIQUE = (1L LSL 15)		;/* Unique ARexx port name */
#HTF_NOACTIVATE = (1L LSL 16)		;/* Don't activate window */

#HTFC_SYSGADS = $80000000

;/* Callback function ID's */
#HTH_OPEN = 0
#HTH_CLOSE = 1

#HTERR_NOT_ENOUGH_MEMORY = 100L
#HTERR_CANT_OPEN_DATABASE = 101L
#HTERR_CANT_FIND_NODE = 102L
#HTERR_CANT_OPEN_NODE = 103L
#HTERR_CANT_OPEN_WINDOW = 104L
#HTERR_INVALID_COMMAND = 105L
#HTERR_CANT_COMPLETE = 106L
#HTERR_PORT_CLOSED = 107L
#HTERR_CANT_CREATE_PORT = 108L
#HTERR_KEYWORD_NOT_FOUND = 113L

typedef struct AmigaGuideHost *AMIGAGUIDEHOST

;/* Cross reference node */
NEWTYPE.XRef

xr_Node.Node ;			;/* Embedded node */
xr_Pad.w ;			;/* Padding */
*xr_DF.DocFile ;				;/* Document defined in */
xr_File.l ;			;/* Name of document file */
xr_Name.l ;			;/* Name of item */
xr_Line.l ;			;/* Line defined at */
xr_Reserved.l [2];		;/* Don't touch! (V44) */
End NEWTYPE

#XRSIZE = (sizeof (struct XRef))

;/* Types of cross reference nodes */
#XR_GENERIC = 0
#XR_FUNCTION = 1
#XR_COMMAND = 2
#XR_INCLUDE = 3
#XR_MACRO = 4
#XR_STRUCT = 5
#XR_FIELD = 6
#XR_TYPEDEF = 7
#XR_DEFINE = 8

;/* Callback handle */
NEWTYPE.AmigaGuideHost

agh_Dispatcher.Hook ;		;/* Dispatcher */
agh_Reserved.l ;			;/* Must be 0 */
agh_Flags.l 
agh_UseCnt.l ;			;/* Number of open nodes */
agh_SystemData.l ;		;/* Reserved for system use */
agh_UserData.l ;			;/* Anything you want... */
End NEWTYPE

;/* Methods */
#HM_FINDNODE = 1
#HM_OPENNODE = 2
#HM_CLOSENODE = 3
#HM_EXPUNGE = 10		;/* Expunge DataBase */

;/* HM_FINDNODE */
NEWTYPE.opFindHost

MethodID.l 
*ofh_Attrs.TagItem ;		;/*  R: Additional attributes */
ofh_Node.l ;			;/*  R: Name of node */
ofh_TOC.l ;			;/*  W: Table of Contents */
ofh_Title.l ;			;/*  W: Title to give to the node */
ofh_Next.l ;			;/*  W: Next node to browse to */
ofh_Prev.l ;			;/*  W: Previous node to browse to */
End NEWTYPE

;/* HM_OPENNODE, HM_CLOSENODE */
NEWTYPE.opNodeIO

MethodID.l 
*onm_Attrs.TagItem ;		;/*  R: Additional attributes */
onm_Node.l ;			;/*  R: Node name and arguments */
onm_FileName.l ;		;/*  W: File name buffer */
onm_DocBuffer.l ;		;/*  W: Node buffer */
onm_BuffLen.l ;			;/*  W: Size of buffer */
onm_Flags.l ;			;/* RW: Control flags */
End NEWTYPE

;/* onm_Flags */
#HTNF_KEEP = (1L LSL 0)	;/* Don't flush this node until database is
;				 * closed. */
#HTNF_RESERVED1 = (1L LSL 1)	;/* Reserved for system use */
#HTNF_RESERVED2 = (1L LSL 2)	;/* Reserved for system use */
#HTNF_ASCII = (1L LSL 3)	;/* Node is straight ASCII */
#HTNF_RESERVED3 = (1L LSL 4)	;/* Reserved for system use */
#HTNF_CLEAN = (1L LSL 5)	;/* Remove the node from the database */
#HTNF_DONE = (1L LSL 6)	;/* Done with node */

;/* onm_Attrs */
#HTNA_Dummy = (TAG_USER)
#HTNA_Screen = (HTNA_Dummy+1)	;/* (struct Screen *) Screen that window resides in */
#HTNA_Pens = (HTNA_Dummy+2)	;/* Pen array (from DrawInfo) */
#HTNA_Rectangle = (HTNA_Dummy+3)	;/* Window box */

#HTNA_HelpGroup = (HTNA_Dummy+5)	;/* (ULONG) unique identifier */


;/* HM_EXPUNGE */
NEWTYPE.opExpungeNode

MethodID.l 
*oen_Attrs.TagItem ;		;/*  R: Additional attributes */
End NEWTYPE

CEND ;/* LIBRARIES_AMIGAGUIDE_H */
