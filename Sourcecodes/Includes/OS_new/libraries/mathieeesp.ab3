;**	    Developed under license.
;*/

CNIF @#PI=0 
#PI = ((float)	3.141592653589793))
CEND 

#TWO_PI = (((float)	2)	* PI)
#PI2 = (PI/((float)2))
#PI4 = (PI/((float)4))

CNIF @#E=0 
#E = ((float)	2.718281828459045)
CEND 

#LOG10 = ((float)	2.302585092994046)
#FPTEN = ((float)	10.0)
#FPONE = ((float)	1.0)
#FPHALF = ((float)	0.5)
#FPZERO = ((float)	0.0)
#trunc(x) = ((int)	(x))
#round(x) = ((int)	((x) + 0.5))
#itof(i) = ((float) (i))

#fabs = IEEESPAbs
#floor = IEEESPFloor
#ceil = IEEESPCeil

#tan = IEEESPTan
#atan = IEEESPAtan
#cos = IEEESPCos
#acos = IEEESPAcos
#sin = IEEESPSin
#asin = IEEESPAsin
#exp = IEEESPExp
#pow(a,b) = IEEESPPow((b),(a))
#log = IEEESPLog
#log10 = IEEESPLog10
#sqrt = IEEESPSqrt

#sinh = IEEESPSinh
#cosh = IEEESPCosh
#tanh = IEEESPTanh

;/*
;** The prototypes for the above functions are
;** found in clib/mathieeesingbas_protos.h and
;** clib/mathieeesingtrans_protos.h
;*/

CEND ;/* LIBRARIES_MATHIEEESP_H */
