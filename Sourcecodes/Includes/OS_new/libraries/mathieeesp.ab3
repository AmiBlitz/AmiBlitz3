CNIF @#LIBRARIES_MATHIEEESP_H=0 
#LIBRARIES_MATHIEEESP_H = 1
;/*
;**	$VER: mathieeesp.h 47.1 (29.7.2019)
;**
;**	Include file to use for <math.h>
;**	for mathieeesingbas based floating point
;**
