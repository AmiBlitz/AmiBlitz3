CNIF @#PI=0 
#PI = ((double)	3.141592653589793))
CEND 

#TWO_PI = (((double)	2)	* PI)
#PI2 = (PI/((double)2))
#PI4 = (PI/((double)4))

CNIF @#E=0 
#E = ((double)	2.718281828459045)
CEND 

#LOG10 = ((double)	2.302585092994046)
#FPTEN = ((double)	10.0)
#FPONE = ((double)	1.0)
#FPHALF = ((double)	0.5)
#FPZERO = ((double)	0.0)
#trunc(x) = ((int)	(x))
#round(x) = ((int)	((x) + 0.5))
#itof(i) = ((double) (i))

#fabs = IEEEDPAbs
#floor = IEEEDPFloor
#ceil = IEEEDPCeil

#tan = IEEEDPTan
#atan = IEEEDPAtan
#cos = IEEEDPCos
#acos = IEEEDPAcos
#sin = IEEEDPSin
#asin = IEEEDPAsin
#exp = IEEEDPExp
#pow(a,b) = IEEEDPPow((b),(a))
#log = IEEEDPLog
#log10 = IEEEDPLog10
#sqrt = IEEEDPSqrt

#sinh = IEEEDPSinh
#cosh = IEEEDPCosh
#tanh = IEEEDPTanh

;/*
;** The prototypes for the above functions are
;** found in clib/mathieeedoubbas_protos.h and
;** clib/mathieeedoubtrans_protos.h
;*/

CEND ;/* LIBRARIES_MATHIEEEDP_H */
