#WA_WindowBox = (#WA_Dummy + $3b)

;/*
;** Attributes specific to window.class
;*/

#WINDOW_Dummy = (#REACTION_Dummy + $25000)

#WINDOW_Window = (#WINDOW_Dummy + 1)
    ;/* (struct Window *) Return the pointer to the real      */
    ;/*                   Intuition window structure.         */

#WINDOW_SigMask = (#WINDOW_Dummy + 2)
    ;/* (ULONG) Return the signal bit that you must wait for  */
    ;/*         this window to know if the window as received */
    ;/*         any input.                                    */
    ;/* Defaults to 0.                                        */

#WINDOW_MenuStrip = (#WINDOW_Dummy + 4)
    ;/* (struct MenuStrip *) A list of Menu structure that will */
    ;/*                 be used as the menu of this window    */
    ;/*                 when open.                            */
    ;/* Defaults to NULL.                                     */

#WINDOW_Layout = (#WINDOW_Dummy + 5)
#WINDOW_ParentLayout = #WINDOW_Layout
#WINDOW_ParentGroup = #WINDOW_Layout
    ;/* (Object *)        Layout group object for the window  */
    ;/* Defaults to NULL.                                     */

#WINDOW_UserData = (#WINDOW_Dummy + 6)
    ;/* (APTR) A value that will be stored in the Window      */
    ;/*        Object structure.                              */
    ;/* Defaults to NULL.                                     */

#WINDOW_SharedPort = (#WINDOW_Dummy + 7)
    ;/* (struct MsgPort *) A port that will be used for this  */
    ;/*                    window.  The port will not be      */
    ;/*                    closed at dispose time.            */
    ;/* Defaults to NULL.                                     */

#WINDOW_Zoom = (#WINDOW_Dummy + 8)
    ;/* When TRUE, it will act as a click on the zoom button. */

#WINDOW_FrontBack = (#WINDOW_Dummy + 9)
    ;/* (UWORD) Only WT_FRONT and WT_BACK can be used here.   */
    ;/*         This put the window in front or in back of    */
    ;/*         others windows                                */

#WINDOW_Activate = (#WINDOW_Dummy +10)
    ;/* (BOOL) Activate the window (and its master group) if  */
    ;/*        set to TRUE and the                            */
    ;/*        window is open.                                */

#WINDOW_LockWidth = (#WINDOW_Dummy +11)
    ;/* (BOOL) Lock the window from resize in width.          */
    ;/* Defaults to FALSE.                                    */

#WINDOW_LockHeight = (#WINDOW_Dummy +12)
    ;/* (BOOL) Lock the window from resize in height.         */
    ;/* Defaults to FALSE.                                    */

#WINDOW_AppPort = (#WINDOW_Dummy +13)
	;/* (struct MsgPort *) A shared message port for appmessages */
	;/* 	You must pass this to be able to iconify the window. */
    ;/* Defaults to NULL.                                     */

#WINDOW_Position = (#WINDOW_Dummy +14)
	;/* (ULONG) The initial position to open at.				 */

#WINDOW_IDCMPHook = (#WINDOW_Dummy +15)
    ;/* (struct Hook *) Defaults to NULL.                     */

#WINDOW_IDCMPHookBits = (#WINDOW_Dummy +16)
    ;/* (ULONG) Defaults to 0L.                               */

#WINDOW_GadgetUserData = (#WINDOW_Dummy +17)
#WINDOW_InterpretUserData = #WINDOW_GadgetUserData
	;/* (UWORD) How Gadget.UserData is interpreted.           */
	;/* Defaults to WGUD_IGNORE */

#WINDOW_MenuUserData = (#WINDOW_Dummy +25)
	;/* (UWORD) How GTMENUITEM_USERDATA is interpreted.		*/

#WGUD_HOOK = 0		;/* Gadget/MenuItem UserData points to a Hook */
#WGUD_FUNC = 1		;/* Points to a function */
#WGUD_IGNORE = 2	;/* App private, don't touch it */

#WINDOW_IconTitle = (#WINDOW_Dummy +18)
	;/* (STRPTR) Title of the iconified window.               */

#WINDOW_AppMsgHook = (#WINDOW_Dummy +19)
	;/* (struct Hook *) Defaults to NULL.                     */

#WINDOW_Icon = (#WINDOW_Dummy +20)
	;/* (struct DiskObject *) Custom icon for the window.     */

#WINDOW_AppWindow = (#WINDOW_Dummy +21)
	;/* (BOOL) Make the window a Workbench AppWindow. */

#WINDOW_GadgetHelp = (#WINDOW_Dummy +22)
	;/* (BOOL) Set gadget-help on/off. */

#WINDOW_IconifyGadget = (#WINDOW_Dummy +23)
	;/* (BOOL) Add an iconification gadget to window title bar. */

#WINDOW_TextAttr = (#WINDOW_Dummy +24)
	;/* (struct TextAttr *)Default font for window. If not set, use screen font. */

#WINDOW_BackFillName = (#WINDOW_Dummy +26)
	;/* (STRPTR) replaces the default backfill pattern with this file,
;	 * loaded through datatypes.
;	 */

#WINDOW_RefWindow = (#WINDOW_Dummy +41)
	;/* (struct Window *) Causes WINDOW_Position to be relative to
;	 * to this window vs the screen. (V42)
;	 */

#WINDOW_InputEvent = (#WINDOW_Dummy +42)
	;/* (struct InputEvent *) returns a pointer to an inputevent
;	 * which will be current *ONLY* after a WHMI_RAWKEY. (V42)
;	 */

#WINDOW_HintInfo = (#WINDOW_Dummy +43)
	;/* (struct HintInfo *) Static Array of help hints.
; 	 *      Pointer to a gadget HintInfo array. This is similar in concept
;     *      to Apple's bubble help or Microsoft's help tips. By providing
;     *      this array of helpinfo, and setting WINDOW_GadgetHelp, TRUE,
;     *      window class will transparently manage the help hints.
;	 */

#WINDOW_KillWindow = (#WINDOW_Dummy +44)
#WINDOW_Application = (#WINDOW_Dummy +45)
	;/* ** PRIVATE TAGS SET/GET BY APPLICATION CLASS! ** (V43 BETA)
;	 */

#WINDOW_InterpretIDCMPHook = (#WINDOW_Dummy +46)
	;/* Interpret IDCMPHook results. (V43 BETA)
;	 */

#WINDOW_Parent = (#WINDOW_Dummy +47)
	;/* ** PRIVATE TAGS SET/GET BY APPLICATION CLASS! ** (V43 BETA)
;	 */

#WINDOW_PreRefreshHook = (#WINDOW_Dummy +48)
	;/* (struct Hook *) window.class calls this hook BEFORE RefreshGList() */

#WINDOW_PostRefreshHook = (#WINDOW_Dummy +49)
	;/* (struct Hook *) window.class calls this hook AFTER RefreshGList() */

#WINDOW_AppWindowPtr = (#WINDOW_Dummy +50)
	;/* (struct AppWindow *) GetAttr()'able pointer to AddAppWindow() result. */

;/* New tags for V47 */

#WINDOW_IconNoDispose = (#WINDOW_Dummy + 51)
	;/* (BOOL) Don't dispose WINDOW_Icon. Defaults to FALSE (ie. dispose) */

#WINDOW_NewMenu = (#WINDOW_Dummy + 52)
	;/* (struct NewMenu *) Let window.class create and layout the menus
;	(useful for iconification and screenchanges) */

#WINDOW_Qualifier = (#WINDOW_Dummy + 53)
	;/* (UWORD) Current qualifiers from IntuiMessage */

#WINDOW_CharSet = (#WINDOW_Dummy + 54) ; OS4ONLY

#WINDOW_BuiltInScroll = (#WINDOW_Dummy + 55) ; OS4ONLY

#WINDOW_IDCMPSnoopHook = (#WINDOW_Dummy + 56) ; OS4ONLY

#WINDOW_ShowingHint = (#WINDOW_Dummy + 57) ; OS4ONLY

#WINDOW_NewPrefsHook = (#WINDOW_Dummy + 58) ; OS4ONLY

#WINDOW_Iconifiable = (#WINDOW_Dummy + 59) ; OS4ONLY

#WINDOW_PopupGadget = (#WINDOW_Dummy + 60) ; OS4ONLY

#WINDOW_PopupHook = (#WINDOW_Dummy + 61) ; OS4ONLY

#WINDOW_PopupItem = (#WINDOW_Dummy + 62) ; OS4ONLY

#WINDOW_JumpScreensMenu = (#WINDOW_Dummy + 63) ; OS4ONLY

#WINDOW_UniqueID = (#WINDOW_Dummy + 64) ; OS4ONLY

#WINDOW_MenuAddress = (#WINDOW_Dummy + 65) ; OS4ONLY

#WINDOW_MenuType = (#WINDOW_Dummy + 66) ; OS4ONLY

#WINDOW_MenuContext = (#WINDOW_Dummy + 67) ; OS4ONLY

;/*** PRIVATE ***/

#WINDOW_VertProp = (#WINDOW_Dummy +27)
	;/* (BOOL) Enable vertical border scroller if true. (V45) */

#WINDOW_VertObject = (#WINDOW_Dummy +28)
	;/* (Object *) OM_GET the vertical scroller object pointer. (V45) */

#WINDOW_HorizProp = (#WINDOW_Dummy +29)
	;/* (BOOL) Enable horizontal border scroller if true. (V45) */

#WINDOW_HorizObject = (#WINDOW_Dummy +30)
	;/* (Object *) OM_GET the horizontal scroller object pointer. (V45) */

;/****************************************************************************/

;/* Pre-defined WM_HANDLEINPUT return codes.
; */
#WMHI_LASTMSG = (0) ;/* No more messages                 */
#WMHI_IGNORE = (0) ;/* Ignore                           */
#WMHI_GADGETMASK = ($ffff) ;/* Gadget ID mask value             */
#WMHI_MENUMASK = ($ffff) ;/* Menu ID mask value               */
#WMHI_KEYMASK = ($ff) ;/* Key code mask value              */
#WMHI_CLASSMASK = ($ffff0000) ;/* Event class mask value	         */
#WMHI_CLOSEWINDOW = (1 LSL 16) ;/* The close gadget was clicked     */
                                     ;/* or a hook function trigged close */
#WMHI_GADGETUP = (2 LSL 16) ;/* A gadget was released            */
#WMHI_INACTIVE = (3 LSL 16) ;/* The window was de-activated      */
#WMHI_ACTIVE = (4 LSL 16) ;/* The window was activated         */
#WMHI_NEWSIZE = (5 LSL 16) ;/* The window was resized           */
#WMHI_MENUPICK = (6 LSL 16) ;/* A menu item was picked           */
#WMHI_MENUHELP = (7 LSL 16) ;/* Help was hit in a menu           */
#WMHI_GADGETHELP = (8 LSL 16) ;/* A gadget returns a help code     */
#WMHI_ICONIFY = (9 LSL 16) ;/* Window requests to be iconified  */
#WMHI_UNICONIFY = (10 LSL 16) ;/* Window was uniconified           */
#WMHI_RAWKEY = (11 LSL 16) ;/* Raw key codes                    */
#WMHI_VANILLAKEY = (12 LSL 16) ;/* Vanilla key codes                */
#WMHI_CHANGEWINDOW = (13 LSL 16) ;/* Window moved (or depth arranged) */
#WMHI_INTUITICK = (14 LSL 16) ;/* IDCMP intuitick (maximum 10 per second) */
#WMHI_MOUSEMOVE = (15 LSL 16) ;/* IDCMP mouse move                 */
#WMHI_MOUSEBUTTONS = (16 LSL 16) ;/* IDCMP mouse buttons              */
#WMHI_DISPOSEDWINDOW = (17 LSL 16) ;/* hook function triggered disposal */
#WMHI_JUMPSCREEN = (18 LSL 16) ; OS4ONLY
#WMHI_POPUPMENU = (19 LSL 16) ; OS4ONLY
#WMHI_GADGETDOWN = (20 LSL 16) ; OS4ONLY

;/****************************************************************************/

#WHOOKRSLT_IGNORE = (0) ; OS4ONLY
#WHOOKRSLT_CLOSEWINDOW = (1) ; OS4ONLY
#WHOOKRSLT_DISPOSEWINDOW = (2) ; OS4ONLY

;/****************************************************************************/

#WMF_ZOOMED = ($0001) ;/* Window is in zoomed state		*/
#WMF_ZIPWINDOW = ($0002) ;/* This resize toggled zoom state	*/

;/****************************************************************************/

;/* Possible WINDOW_FrontBack values
; */
#WT_FRONT = True
#WT_BACK = False

;/* Possible WINDOW_Position values
; */
#WPOS_CENTERSCREEN = (1)   ;/* Center on the screen             */
#WPOS_CENTERMOUSE = (2)   ;/* Center under the mouse           */
#WPOS_TOPLEFT = (3)   ;/* Top-left of the screen           */
#WPOS_CENTERWINDOW = (4)   ;/* Center in another window         */
#WPOS_FULLSCREEN = (5)   ;/* Top-left of, and fill visible screen clip */
#WPOS_ENTIRESCREEN = (6)   ;/* Top-left of, and fill the entire screen
;                                           (even for autoscroll screens) (V47) */

;/****************************************************************************/

;/*
; * Window Methods
; */
#WM_HANDLEINPUT = ($570001)

;/* The WM_HANDLEINPUT method should be called by for each received
; * IDCMP message.
; * If the message could be linked to a gadget in the window, the WORD
; * pointed to by wmh_Code will be set to the gadget's return code.
; */

NEWTYPE.wmHandle
  MethodID.l ;						;/* WM_HANDLEINPUT */
  *wmh_Code.w ;						;/* The code from the gadget */
End NEWTYPE

#WM_OPEN = ($570002)
#WM_CLOSE = ($570003)
#WM_NEWPREFS = ($570004)
#WM_ICONIFY = ($570005)
#WM_RETHINK = ($570006)
#WM_ACTIVATEGADGET = ($570007) ; OS4ONLY

NEWTYPE.wmActivateGadget
  MethodID.l 
  *wma_Object.Gadget 
End NEWTYPE

#WM_SNAPSHOT = ($570008) ; OS4ONLY

;enum SnapHow ; OS4ONLY
;{
;    #SAVE = 0,
;    #USE = 1
;}
NEWTYPE.wmSnapshot
  MethodID.l 
  How.b
End NEWTYPE

#WM_UNSNAPSHOT = ($570009) ; OS4ONLY
#WM_RESTORE = ($570010) ; OS4ONLY

;/****************************************************************************/

NEWTYPE.HintInfo
  hi_GadgetID.w ;	;/* Gadget ID this hint belongs to, -1 indicates end. */
  hi_Code.w ;		;/* Code required for this gadget, or -1 if it doesn't matter. */
  hi_Text.l ;		;/* The text of the hint.. */
  hi_Flags.l ;		;/* Flags, currently unsupported and must be set to 0L. */
End NEWTYPE

CEND ;/* CLASSES_WINDOW_H */
