CNIF @#EXEC_MEMORY_H=0 
INCLUDE"exec/memory.ab3" 
CEND 

CNIF @#DOS_DOS_H=0 
INCLUDE"dos/dos.ab3" 
CEND 

CNIF @#DOS_RDARGS_H=0 
INCLUDE"dos/rdargs.ab3" 
CEND 

CNIF @#REXX_STORAGE_H=0 
INCLUDE"rexx/storage.ab3" 
CEND 

CNIF @#REXX_RXSLIB_H=0 
INCLUDE"rexx/rxslib.ab3" 
CEND 

CNIF @#REXX_ERRORS_H=0 
INCLUDE"rexx/errors.ab3" 
CEND 

CNIF @#INTUITION_CLASSES_H=0 
INCLUDE"intuition/classes.ab3" 
CEND 

CNIF @#INTUITION_CLASSUSR_H=0 
INCLUDE"intuition/classusr.ab3" 
CEND 

CNIF @#UTILITY_HOOKS_H=0 
INCLUDE"utility/hooks.ab3" 
CEND 

CNIF @#REACTION_REACTION_H=0 
INCLUDE"reaction/reaction.ab3" 
CEND 

;/*****************************************************************************/

;/* Tags supported by the arexx class
; */
#AREXX_Dummy = (#REACTION_Dummy+$30000)

#AREXX_HostName = (#AREXX_Dummy+1)
	;/* (STRPTR) */
#AREXX_DefExtension = (#AREXX_Dummy+2)
	;/* (STRPTR) */
#AREXX_Commands = (#AREXX_Dummy+3)
	;/* (struct ARexxCmd *) */
#AREXX_ErrorCode = (#AREXX_Dummy+4)
	;/* (ULONG *) */
#AREXX_SigMask = (#AREXX_Dummy+5)
	;/* (ULONG) */
#AREXX_NoSlot = (#AREXX_Dummy+6)
	;/* (BOOL) */
#AREXX_ReplyHook = (#AREXX_Dummy+7)
	;/* (struct Hook *) */
#AREXX_MsgPort = (#AREXX_Dummy+8)
	;/* (struct MsgPort *) */

;/* Possible error result codes
; */
#RXERR_NO_COMMAND_LIST = (1)
#RXERR_NO_PORT_NAME = (2)
#RXERR_PORT_ALREADY_EXISTS = (3)
#RXERR_OUT_OF_MEMORY = (4)

;/* I can't spell, don't use this.
; */
#AREXX_DefExtention = #AREXX_DefExtension

;/*****************************************************************************/

;/* Methods Supported by the ARexx Class.
; */
#AM_HANDLEEVENT = ($590001)
	;/* ARexx class event-handler. */

#AM_EXECUTE = ($590002)
	;/* Execute a host command. */

#AM_FLUSH = ($590003)
	;/* Flush rexx port. */

;/* AM_EXECUTE message.
; */
NEWTYPE.apExecute

MethodID.l ;				;/* AM_EXECUTE */
ape_CommandString.l ;	;/* Command string to execute */
ape_PortName.l ;		;/* Port to send to (usually RXSDIR) */
*ape_RC.l ;				;/* RC pointer */
*ape_RC2.l ;				;/* RC2 pointer */
*ape_Result.l ;			;/* Result pointer */
ape_IO.l ;				;/* I/O handle */
End NEWTYPE


;/*****************************************************************************/

;/* An array of these structures must be passed at object-create time.
; */
NEWTYPE.ARexxCmd

ac_Name.l ;			;/* Command name */
ac_ID.w ;			;/* Unique ID */

	;/* NOTE: The function pointed to by ac_Func() will be called
;	 *       with parameters in CPU registers. Register usage
;	 *       is as follows:
;	 *
;	 *       VOID ac_Func(struct ARexxCmd * cmd, struct RexxMsg * rm)
;	 *                                       A0                   A1
;	 */
*ac_Func.l 

ac_ArgTemplate.l ;	;/* DOS-style argument template */
ac_Flags.l ;			;/* Unused, make NULL */
*ac_ArgList.l ;		;/* Result of ReadArgs() */
ac_RC.l ;				;/* Primary result */
ac_RC2.l ;			;/* Secondary result */
ac_Result.l ;		;/* RESULT variable */
End NEWTYPE

CEND ;/* CLASSES_AREXX_H */
