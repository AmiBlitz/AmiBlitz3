CNIF @#TEXTEDIT_FILETYPE_H=0 
#TEXTEDIT_FILETYPE_H = 1

INCLUDE"intuition/classusr.ab3" 
INCLUDE"gadgets/texteditor.ab3" 

INCLUDE"tools/textedit/plugin.ab3" 

NEWTYPE.EditorSettings
Version.w 
HasLineNumbers:1.BOOL 
CutCopyLineWhenNoSel:1.BOOL 
AutoIndent:1.BOOL 
TabKeyPolicy:2.w 
BOOL.// ReplaceTabsOnPaste:1
WrapColumn.l 
WordWrapMode.b 
IndentationWidth.b 
TabWidth.b 
IndentUsing.b 
End NEWTYPE

#FILETYPEPLUGINHEAD_ID = $46545950 ;/* 'FTYP' identification ID */
#FILETYPEPLUGIN_VERSION = 2

NEWTYPE.Filetype
Node.MinNode 
*WorkingCopy.EditorSettings 
menuNumber.l 
*menuitem.MenuItem 
Version.w 
name.CONST_STRPTR ; // localized GUI visible name
typeName.l ; // name used for prefs files etc
autoFileTypes.l ; // newline separated list of deficon names that will match
*editorSettings.EditorSettings 
__ASM__.l (*installChangeListener)(__REG__(a0, APTR document), __REG__(a1, struct ChangeListener *listener))
__ASM__.l (*executeRexxCommand)(__REG__(a0, APTR document), __REG__(a1, STRPTR rexxCmd)); //only commands in TextEdit, not full rexx
and.// be sure to FreeVec any returned string not TRUE or FALSE
pluginData.l 
__ASM__.l (*terminate)(__REG__(a0, struct Filetype *fType))

	;/* implement this pointer if you want to do syntax highlighting
;	 * See texteditor.h and apidocs of texteditor.gadget for more details */
*highlighterHook.Hook 

	;/* The following functions needs to be filled in if the filetype provides extra
;	 * pages in the filetype options requester.
;	 * Any gadget should have a gadget ID higher than 1000 so as not to conflict with
;	 * other gadgets int the preferences window.
;	 */
*__ASM__.Object (*settingsGadget)(__REG__(a0, struct Filetype *fType), __REG__(d0, ULONG i))
__ASM__.l (*settingsTitle)(__REG__(a0, struct Filetype *fType), __REG__(d0, ULONG i))
__ASM__.BOOL (*loadSettings)(__REG__(a0, struct IFFHandle *iff), __REG__(a1, struct ContextNode *cn), __REG__(a2, struct Filetype * fType))
__ASM__.BOOL (*saveSettings)(__REG__(a0, struct IFFHandle *iff), __REG__(a1, struct ContextNode *cn), __REG__(a2, struct Filetype * fType))
__ASM__.l (*setSettingsFromGUI)(__REG__(a0, struct Filetype *fType))
__ASM__.l (*setGUIFromSettings)(__REG__(a0, struct Filetype *fType), __REG__(a1, struct Window *window))
__ASM__.l (*processGadgetUp)(__REG__(a0, struct Filetype *fType), __REG__(d0, UWORD gadgetID), __REG__(a1, struct Window *window))
__ASM__.l (*applySettings)(__REG__(a0, struct Filetype *fType))
__ASM__.l (*disposeGadgets)(__REG__(a0, struct Filetype *fType))
__ASM__.l (*assignedToDocument)(__REG__(a0, struct Filetype *fType), __REG__(a1, APTR document))
__ASM__.l (*unassignedFromDocument)(__REG__(a0, struct Filetype *fType), __REG__(a1, APTR document))
End NEWTYPE


CEND 
