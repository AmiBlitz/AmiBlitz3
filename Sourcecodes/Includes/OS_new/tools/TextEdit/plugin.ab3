CNIF @#TEXTEDIT_PLUGIN_H=0 
#TEXTEDIT_PLUGIN_H = 1

INCLUDE"exec/types.ab3" 
INCLUDE"dos/dos.ab3" 

;/************************************************************************
;*									*
;*    plugin support stuff						*
;*									*
;************************************************************************/

;/* This is the link structure, which allows us to detect a proper plugin */
NEWTYPE.PluginHead
ph_Security.l ;    ;/* should be PLUGINHEAD_SECURITY */
ph_ID.l ;	      ;/* must be say FILETYPEPLUGINHEAD_ID or EXTENSIONPLUGINHEAD_ID */
ph_SegList.BPTR ;     ;/* set to zero in plugins */
*ph_Next.PluginHead ;        ;/* set to zero in plugins */
ph_Version.w ;     ;/* set to PLUGINHEAD_VERSION */
ph_Reserved.w ;    ;/* only for alignment */
ph_VersString.l ;  ;/* pointer to $VER: string */
*ph_FirstPlugin.Plugin ; ;/* pointer to first plugin */
End NEWTYPE

#PLUGINHEAD_SECURITY = $70FF4E75 ;/* MOVEQ #-1,D0 and RTS */
#PLUGINHEAD_VERSION = 1
#MASTER_VERSION = 2 ;/* the version of this master */

;/* There should be no need to modify the PluginHead structure! Only the
;   ID field should be changed for each project, as this part must be
;   individual.
;*/

;/* And this is the data structure we use */
NEWTYPE.Plugin
*p_Next.Plugin ;    ;/* pointer to next plugin */
p_Version.w ;        ;/* set to say FILETYPEPLUGIN_VERSION or EXTENSIONPLUGIN_VERSION*/
p_MasterVersion.w ;  ;/* set to MASTER_VERSION */
p_PluginVersion.w ;  ;/* the version of this plugin - not checked by textedit */
p_PluginRevision.w ; ;/* and the revision - not checked by textedit*/
p_Identifier.w ;     ;/* an ID to replace internal plugins */
p_Flags.w ;          ;/* some flags to define plugin type */

    ;/* Now the real data comes */
__ASM__.l (*init)(__REG__(a0, APTR userData))
End NEWTYPE

void InitPlugins(STRPTR plugindir, ULONG headerID, struct Plugin *dummyPlugin, struct PluginHead *dummyPluginHead)
void ReleasePlugins(struct Plugin *dummyPlugin, struct PluginHead *dummyPluginHead)

CEND ;/* TEXTEDIT_PLUGIN_H */
