CNIF @#TEXTEDIT_EXTENSION_H=0 
#TEXTEDIT_EXTENSION_H = 1

INCLUDE"intuition/classusr.ab3" 

NEWTYPE.TextEditInterface

    ;/* To be called by extension if it wants to add menus or menu items*/
__ASM__.l (*installChangeListener)(__REG__(a0, APTR document), __REG__(a1, struct ChangeListener *listener))
__ASM__.l (*installLeftBarHook)(__REG__(a0, APTR document), __REG__(a1, struct Hook *leftBarHook))
__ASM__.l (*executeRexxCommand)(__REG__(a0, APTR document), __REG__(a1, STRPTR rexxCmd)); //only commands in TextEdit, not full rexx
and.// be sure to FreeVec any returned string not TRUE or FALSE
__ASM__.l (*insertMenu)(__REG__(d0, ULONG insertPosition), __REG__(a0, struct Menu *menuSnip))
__ASM__.l (*installTopGadget)(__REG__(a0, Object *gadget))
__ASM__.l (*installBottomGadget)(__REG__(a0, Object *gadget))
__ASM__.l (*installSideGadget)(__REG__(a0, Object *gadget))
__ASM__.l (*setWindowFormatStrings)(__REG__(a0, STRPTR titleFormat), __REG__(a1, STRPTR titleModifiedFormat))
__ASM__.l (*activateGadget)(__REG__(a0, Object *gadget))
End NEWTYPE

#EXTENSIONPLUGIN_VERSION = 1
#EXTENSIONPLUGINHEAD_ID = $45585453 ;/* 'EXTS' identification ID */

NEWTYPE.Extension

extensionData.l ; // Extension can freely store data in this member
*tei.TextEditInterface 

sigMask.l ; // the signal mask for which you want the handleSignal called
__ASM__.l (*setWindowPointer)(__REG__(a0, struct Extension *ext), __REG__(a1, struct Window *window))
__ASM__.l (*onNewDocument)(__REG__(a0, struct Extension *ext), __REG__(a1, APTR document))
__ASM__.l (*onCurrentDocumentChanged)(__REG__(a0, struct Extension *ext), __REG__(a1, APTR document))
__ASM__.l (*onDisposeDocument)(__REG__(a0, struct Extension *ext), __REG__(a1, APTR document))
__ASM__.BOOL (*handleGadgetUp)(__REG__(a0, struct Extension *ext), __REG__(d0, UWORD gadgetId))
__ASM__.BOOL (*handleRawKey)(__REG__(a0, struct Extension *ext), __REG__(a1, struct IntuiMessage *msg))
__ASM__.l (*handleSignal)(__REG__(a0, struct Extension *ext), __REG__(d0, ULONG signal))
__ASM__.BOOL (*aboutToQuit)(__REG__(a0, struct Extension *ext))
__ASM__.l (*terminate)(__REG__(a0, struct Extension *ext))
End NEWTYPE


CEND 
