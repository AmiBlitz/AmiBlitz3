BPTR Open( CONST_STRPTR name, LONG accessMode )
LONG Close( BPTR file )
LONG Read( BPTR file, APTR buffer, LONG length )
LONG Write( BPTR file, CONST_APTR buffer, LONG length )
BPTR Input( VOID )
BPTR Output( VOID )
LONG Seek( BPTR file, LONG position, LONG offset )
LONG DeleteFile( CONST_STRPTR name )
LONG Rename( CONST_STRPTR oldName, CONST_STRPTR newName )
BPTR Lock( CONST_STRPTR name, LONG type )
VOID UnLock( BPTR lock )
BPTR DupLock( BPTR lock )
LONG Examine( BPTR lock, struct FileInfoBlock *fileInfoBlock )
LONG ExNext( BPTR lock, struct FileInfoBlock *fileInfoBlock )
LONG Info( BPTR lock, struct InfoData *parameterBlock )
BPTR CreateDir( CONST_STRPTR name )
BPTR CurrentDir( BPTR lock )
LONG IoErr( VOID )
NEWTYPE.MsgPort
Exit(.l LONG returnCode )
LoadSeg(.BPTR CONST_STRPTR name )
UnLoadSeg(.l BPTR seglist )
*DeviceProc(.MsgPort CONST_STRPTR name )
SetComment(.l CONST_STRPTR name, CONST_STRPTR comment )
SetProtection(.l CONST_STRPTR name, LONG protect )
*DateStamp(.DateStamp struct DateStamp *date )
Delay(.l LONG timeout )
WaitForChar(.l BPTR file, LONG timeout )
ParentDir(.BPTR BPTR lock )
IsInteractive(.l BPTR file )
Execute(.l CONST_STRPTR string, BPTR file, BPTR file2 )
functions.;/*--- in V36 or higher (Release 2.0) ---*/
;/*	DOS Object creation/deletion */
AllocDosObject(.l ULONG type, CONST struct TagItem *tags )
AllocDosObjectTagList(.l ULONG type, CONST struct TagItem *tags )
AllocDosObjectTags(.l ULONG type, ULONG tag1type, ... )
FreeDosObject(.l ULONG type, APTR ptr )
;/*	Packet Level routines */
DoPkt(.l struct MsgPort *port, LONG action, LONG arg1, LONG arg2, LONG arg3, LONG arg4, LONG arg5 )
DoPkt0(.l struct MsgPort *port, LONG action )
DoPkt1(.l struct MsgPort *port, LONG action, LONG arg1 )
DoPkt2(.l struct MsgPort *port, LONG action, LONG arg1, LONG arg2 )
DoPkt3(.l struct MsgPort *port, LONG action, LONG arg1, LONG arg2, LONG arg3 )
DoPkt4(.l struct MsgPort *port, LONG action, LONG arg1, LONG arg2, LONG arg3, LONG arg4 )
SendPkt(.l struct DosPacket *dp, struct MsgPort *port, struct MsgPort *replyport )
*WaitPkt(.DosPacket VOID )
ReplyPkt(.l struct DosPacket *dp, LONG res1, LONG res2 )
AbortPkt(.l struct MsgPort *port, struct DosPacket *pkt )
;/*	Record Locking */
LockRecord(.BOOL BPTR fh, ULONG offset, ULONG length, ULONG mode, ULONG timeout )
LockRecords(.BOOL CONST struct RecordLock *recArray, ULONG timeout )
UnLockRecord(.BOOL BPTR fh, ULONG offset, ULONG length )
UnLockRecords(.BOOL CONST struct RecordLock *recArray )
;/*	Buffered File I/O */
SelectInput(.BPTR BPTR fh )
SelectOutput(.BPTR BPTR fh )
FGetC(.l BPTR fh )
FPutC(.l BPTR fh, LONG ch )
UnGetC(.l BPTR fh, LONG character )
FRead(.l BPTR fh, APTR block, ULONG blocklen, ULONG number )
FWrite(.l BPTR fh, CONST_APTR block, ULONG blocklen, ULONG number )
FGets(.l BPTR fh, STRPTR buf, ULONG buflen )
FPuts(.l BPTR fh, CONST_STRPTR str )
VFWritef(.l BPTR fh, CONST_STRPTR format, CONST LONG *argarray )
FWritef(.l BPTR fh, CONST_STRPTR format, ... )
VFPrintf(.l BPTR fh, CONST_STRPTR format, CONST_APTR argarray )
FPrintf(.l BPTR fh, CONST_STRPTR format, ... )
Flush(.l BPTR fh )
SetVBuf(.l BPTR fh, STRPTR buff, LONG type, LONG size )
;/*	DOS Object Management */
DupLockFromFH(.BPTR BPTR fh )
OpenFromLock(.BPTR BPTR lock )
ParentOfFH(.BPTR BPTR fh )
ExamineFH(.BOOL BPTR fh, struct FileInfoBlock *fib )
SetFileDate(.l CONST_STRPTR name, CONST struct DateStamp *date )
NameFromLock(.l BPTR lock, STRPTR buffer, LONG len )
NameFromFH(.l BPTR fh, STRPTR buffer, LONG len )
SplitName(.w CONST_STRPTR name, ULONG separator, STRPTR buf, LONG oldpos, LONG size )
SameLock(.l BPTR lock1, BPTR lock2 )
SetMode(.l BPTR fh, LONG mode )
ExAll(.l BPTR lock, struct ExAllData *buffer, LONG size, LONG data, struct ExAllControl *control )
ReadLink(.l struct MsgPort *port, BPTR lock, CONST_STRPTR path, STRPTR buffer, ULONG size )
MakeLink(.l CONST_STRPTR name, LONG dest, LONG soft )
ChangeMode(.l LONG type, BPTR fh, LONG newmode )
SetFileSize(.l BPTR fh, LONG pos, LONG mode )
;/*	Error Handling */
SetIoErr(.l LONG result )
Fault(.BOOL LONG code, CONST_STRPTR header, STRPTR buffer, LONG len )
PrintFault(.BOOL LONG code, CONST_STRPTR header )
ErrorReport(.l LONG code, LONG type, ULONG arg1, struct MsgPort *device )
;/*	Process Management */
*Cli(.CommandLineInterface VOID )
*CreateNewProc(.Process CONST struct TagItem *tags )
*CreateNewProcTagList(.Process CONST struct TagItem *tags )
*CreateNewProcTags(.Process ULONG tag1type, ... )
RunCommand(.l BPTR seg, LONG stack, CONST_STRPTR paramptr, LONG paramlen )
*GetConsoleTask(.MsgPort VOID )
*SetConsoleTask(.MsgPort struct MsgPort *task )
*GetFileSysTask(.MsgPort VOID )
*SetFileSysTask(.MsgPort struct MsgPort *task )
GetArgStr(.l VOID )
SetArgStr(.l STRPTR string )
*FindCliProc(.Process ULONG num )
MaxCli(.l VOID )
SetCurrentDirName(.BOOL CONST_STRPTR name )
GetCurrentDirName(.BOOL STRPTR buf, LONG len )
SetProgramName(.BOOL CONST_STRPTR name )
GetProgramName(.BOOL STRPTR buf, LONG len )
SetPrompt(.BOOL CONST_STRPTR name )
GetPrompt(.BOOL STRPTR buf, LONG len )
SetProgramDir(.BPTR BPTR lock )
GetProgramDir(.BPTR VOID )
;/*	Device List Management */
SystemTagList(.l CONST_STRPTR command, CONST struct TagItem *tags )
System(.l CONST_STRPTR command, CONST struct TagItem *tags )
SystemTags(.l CONST_STRPTR command, ULONG tag1type, ... )
AssignLock(.l CONST_STRPTR name, BPTR lock )
AssignLate(.BOOL CONST_STRPTR name, CONST_STRPTR path )
AssignPath(.BOOL CONST_STRPTR name, CONST_STRPTR path )
AssignAdd(.BOOL CONST_STRPTR name, BPTR lock )
RemAssignList(.l CONST_STRPTR name, BPTR lock )
*GetDeviceProc(.DevProc CONST_STRPTR name, struct DevProc *dp )
FreeDeviceProc(.l struct DevProc *dp )
*LockDosList(.DosList ULONG flags )
UnLockDosList(.l ULONG flags )
*AttemptLockDosList(.DosList ULONG flags )
RemDosEntry(.BOOL struct DosList *dlist )
AddDosEntry(.l struct DosList *dlist )
*FindDosEntry(.DosList CONST struct DosList *dlist, CONST_STRPTR name, ULONG flags )
*NextDosEntry(.DosList CONST struct DosList *dlist, ULONG flags )
*MakeDosEntry(.DosList CONST_STRPTR name, LONG type )
FreeDosEntry(.l struct DosList *dlist )
IsFileSystem(.BOOL CONST_STRPTR name )
;/*	Handler Interface */
Format(.BOOL CONST_STRPTR filesystem, CONST_STRPTR volumename, ULONG dostype )
Relabel(.l CONST_STRPTR drive, CONST_STRPTR newname )
Inhibit(.l CONST_STRPTR name, LONG onoff )
AddBuffers(.l CONST_STRPTR name, LONG number )
;/*	Date, Time Routines */
CompareDates(.l CONST struct DateStamp *date1, CONST struct DateStamp *date2 )
DateToStr(.l struct DateTime *datetime )
StrToDate(.l struct DateTime *datetime )
;/*	Image Management */
InternalLoadSeg(.BPTR BPTR fh, BPTR table, CONST LONG *funcarray, LONG *stack )
InternalUnLoadSeg(.BOOL BPTR seglist, VOID (*freefunc)() )
NewLoadSeg(.BPTR CONST_STRPTR file, CONST struct TagItem *tags )
NewLoadSegTagList(.BPTR CONST_STRPTR file, CONST struct TagItem *tags )
NewLoadSegTags(.BPTR CONST_STRPTR file, ULONG tag1type, ... )
AddSegment(.l CONST_STRPTR name, BPTR seg, LONG system )
*FindSegment(.Segment CONST_STRPTR name, CONST struct Segment *seg, LONG system )
RemSegment(.l struct Segment *seg )
;/*	Command Support */
CheckSignal(.l LONG mask )
*ReadArgs(.RDArgs CONST_STRPTR arg_template, LONG *array, struct RDArgs *args )
FindArg(.l CONST_STRPTR keyword, CONST_STRPTR arg_template )
ReadItem(.l CONST_STRPTR name, LONG maxchars, struct CSource *cSource )
StrToLong(.l CONST_STRPTR string, LONG *value )
MatchFirst(.l CONST_STRPTR pat, struct AnchorPath *anchor )
MatchNext(.l struct AnchorPath *anchor )
MatchEnd(.l struct AnchorPath *anchor )
ParsePattern(.l CONST_STRPTR pat, UBYTE *patbuf, LONG patbuflen )
MatchPattern(.BOOL CONST UBYTE *patbuf, CONST_STRPTR str )
FreeArgs(.l struct RDArgs *args )
FilePart(.l CONST_STRPTR path )
PathPart(.l CONST_STRPTR path )
AddPart(.BOOL STRPTR dirname, CONST_STRPTR filename, ULONG size )
;/*	Notification */
StartNotify(.BOOL struct NotifyRequest *notify )
EndNotify(.l struct NotifyRequest *notify )
;/*	Environment Variable functions */
SetVar(.BOOL CONST_STRPTR name, CONST_STRPTR buffer, LONG size, LONG flags )
GetVar(.l CONST_STRPTR name, STRPTR buffer, LONG size, LONG flags )
DeleteVar(.l CONST_STRPTR name, ULONG flags )
*FindVar(.LocalVar CONST_STRPTR name, ULONG type )
CliInitNewcli(.l struct DosPacket *dp )
CliInitRun(.l struct DosPacket *dp )
WriteChars(.l CONST_STRPTR buf, ULONG buflen )
PutStr(.l CONST_STRPTR str )
VPrintf(.l CONST_STRPTR format, CONST_APTR argarray )
Printf(.l CONST_STRPTR format, ... )
;/* these were unimplemented until dos 36.147 */
ParsePatternNoCase(.l CONST_STRPTR pat, UBYTE *patbuf, LONG patbuflen )
MatchPatternNoCase(.BOOL CONST UBYTE *patbuf, CONST_STRPTR str )
;/* this was added for V37 dos, returned 0 before then. */
SameDevice(.BOOL BPTR lock1, BPTR lock2 )

;/* NOTE: the following entries did NOT exist before ks 36.303 (2.02) */
;/* If you are going to use them, open dos.library with version 37 */

;/* These calls were added for V39 dos: */
ExAllEnd(.l BPTR lock, struct ExAllData *buffer, LONG size, LONG data, struct ExAllControl *control )
SetOwner(.BOOL CONST_STRPTR name, LONG owner_info )
;/* Added with dos 47.4 */
VolumeRequestHook(.l CONST_STRPTR vol )
GetCurrentDir(.BPTR VOID )
PutErrStr(.l CONST_STRPTR str )
ErrorOutput(.l VOID )
SelectError(.l BPTR fh )
DoShellMethodTagList(.l ULONG method, CONST struct TagItem *tags )
DoShellMethod(.l ULONG method, ULONG tag1type, ... )
ScanStackToken(.l BPTR seg, LONG defaultstack )

