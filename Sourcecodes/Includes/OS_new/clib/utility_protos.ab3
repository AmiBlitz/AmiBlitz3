;/*--- functions in V36 or higher (Release 2.0) ---*/

;/* Tag item functions */

NEWTYPE.TagItem
GetTagData(.l Tag tagValue, ULONG defaultVal, CONST struct TagItem *tagList )
PackBoolTags(.l ULONG initialFlags, CONST struct TagItem *tagList, CONST struct TagItem *boolMap )
*NextTagItem(.TagItem struct TagItem **tagListPtr )
FilterTagChanges(.l struct TagItem *changeList, struct TagItem *originalList, ULONG apply )
MapTags(.l struct TagItem *tagList, CONST struct TagItem *mapList, ULONG mapType )
*AllocateTagItems(.TagItem ULONG numTags )
*CloneTagItems(.TagItem CONST struct TagItem *tagList )
FreeTagItems(.l struct TagItem *tagList )
RefreshTagItemClones(.l struct TagItem *clone, CONST struct TagItem *original )
TagInArray(.BOOL Tag tagValue, CONST Tag *tagArray )
FilterTagItems(.l struct TagItem *tagList, CONST Tag *filterArray, ULONG logic )

;/* Hook functions */

CallHookPkt(.l struct Hook *hook, APTR object, APTR paramPacket )

;/* Date functions */

Amiga2Date(.l ULONG seconds, struct ClockData *result )
Date2Amiga(.l CONST struct ClockData *date )
CheckDate(.l CONST struct ClockData *date )

;/* 32 bit integer muliply functions */

SMult32(.l LONG arg1, LONG arg2 )
UMult32(.l ULONG arg1, ULONG arg2 )

;/* 32 bit integer division funtions. The quotient and the remainder are */
;/* returned respectively in d0 and d1 */

SDivMod32(.l LONG dividend, LONG divisor )
UDivMod32(.l ULONG dividend, ULONG divisor )
functions.;/*--- in V37 or higher (Release 2.04) ---*/

;/* International string routines */

Stricmp(.l CONST_STRPTR string1, CONST_STRPTR string2 )
Strnicmp(.l CONST_STRPTR string1, CONST_STRPTR string2, LONG length )
ToUpper(.b ULONG character )
ToLower(.b ULONG character )
functions.;/*--- in V39 or higher (Release 3.0) ---*/

;/* More tag Item functions */

ApplyTagChanges(.l struct TagItem *list, CONST struct TagItem *changeList )

;/* 64 bit integer muliply functions. The results are 64 bit quantities */
;/* returned in D0 and D1 */

SMult64(.l LONG arg1, LONG arg2 )
UMult64(.l ULONG arg1, ULONG arg2 )

;/* Structure to Tag and Tag to Structure support routines */

PackStructureTags(.l APTR pack, CONST ULONG *packTable, CONST struct TagItem *tagList )
UnpackStructureTags(.l CONST_APTR pack, CONST ULONG *packTable, struct TagItem *tagList )

;/* New, object-oriented NameSpaces */

AddNamedObject(.BOOL struct NamedObject *nameSpace, struct NamedObject *object )
*AllocNamedObjectA(.NamedObject CONST_STRPTR name, CONST struct TagItem *tagList )
*AllocNamedObject(.NamedObject CONST_STRPTR name, ... )
AttemptRemNamedObject(.l struct NamedObject *object )
*FindNamedObject(.NamedObject struct NamedObject *nameSpace, CONST_STRPTR name, CONST struct NamedObject *lastObject )
FreeNamedObject(.l struct NamedObject *object )
NamedObjectName(.l struct NamedObject *object )
ReleaseNamedObject(.l struct NamedObject *object )
RemNamedObject(.l struct NamedObject *object, struct Message *message )

;/* Unique ID generator */

GetUniqueID(.l VOID )


functions.;/*--- in V47 or higher (Release 3.2) ---*/

;/* Reserved vectors for Os4, not populated. */

VSNPrintf(.l STRPTR buffer, ULONG bufsize, CONST_STRPTR fmt, CONST_APTR data )
SNPrintf(.l STRPTR buffer, ULONG bufsize, CONST_STRPTR fmt, ... )

;/* Reserved vectors for Os4, not populated. */

;/* Reserved vector for internal use. */

Strncpy(.l STRPTR dst, CONST_STRPTR src, ULONG size )
Strncat(.l STRPTR dst, CONST_STRPTR src, ULONG size )

;/* 64 bit integer division functions. The input is a 64 bit dividiend in d1:d0 */
;/* with top 32 bits in 32 and a divisor in d2. Results are the quotient in d0 */
;/* and a remainder in d1 */

SDivMod64(.l LONG hi, LONG lo, LONG divisor )
UDivMod64(.l ULONG hi, ULONG lo, ULONG divisor )

__cplusplus.#ifdef 

