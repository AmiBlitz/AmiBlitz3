;/*  Exec support functions */

VOID BeginIO( struct IORequest *ioReq )
NEWTYPE.IORequest
*CreatePort(.MsgPort CONST_STRPTR name, LONG pri )
*CreateStdIO(.IOStdReq CONST struct MsgPort *port )
*CreateTask(.Task CONST_STRPTR name, LONG pri, APTR initPC, ULONG stackSize )
DeleteExtIO(.l struct IORequest *ioReq )
DeletePort(.l struct MsgPort *ioReq )
DeleteStdIO(.l struct IOStdReq *ioReq )
DeleteTask(.l struct Task *task )
NewList(.l struct List *list )
LibAllocPooled(.l APTR poolHeader, ULONG memSize )
LibCreatePool(.l ULONG memFlags, ULONG puddleSize, ULONG threshSize )
LibDeletePool(.l APTR poolHeader )
LibFreePooled(.l APTR poolHeader, APTR memory, ULONG memSize )

;/* Assorted functions in amiga.lib */

FastRand(.l ULONG seed )
RangeRand(.w ULONG maxValue )

;/* Graphics support functions in amiga.lib */

AddTOF(.l struct Isrvstr *i, LONG (*p)(APTR args), APTR a )
RemTOF(.l struct Isrvstr *i )
waitbeam(.l LONG b )

;/* math support functions in amiga.lib */

afp(.FLOAT CONST_STRPTR string )
arnd(.l LONG place, LONG exponent, STRPTR string )
dbf(.FLOAT ULONG exponent_base10, ULONG mant )
fpa(.l FLOAT fnum, STRPTR string )
fpbcd(.l FLOAT fnum, STRPTR string )

;/* Timer support functions in amiga.lib (V36 and higher only) */

TimeDelay(.l LONG unit, ULONG secs, ULONG microsecs )
DoTimer(.l TimeVal_Type *tv, LONG unit, LONG command )

;/*  Commodities functions in amiga.lib (V36 and higher only) */

ArgArrayDone(.l VOID )
*ArgArrayInit(.l LONG argc, CONST_STRPTR *argv )
ArgInt(.l CONST_STRPTR *tt, CONST_STRPTR entry, LONG defaultval )
ArgString(.l CONST_STRPTR *tt, CONST_STRPTR entry, CONST_STRPTR defaultstring )
*HotKey(.CxObj CONST_STRPTR description, struct MsgPort *port, LONG id )
*InvertString(.InputEvent CONST_STRPTR str, CONST struct KeyMap *km )
FreeIEvents(.l struct InputEvent *events )

;/* Commodities Macros */

;/* CxObj *CxCustom(LONG(*)(),LONG id)(A0,D0) */
;/* CxObj *CxDebug(LONG id)(D0) */
;/* CxObj *CxFilter(STRPTR description)(A0) */
;/* CxObj *CxSender(struct MsgPort *port,LONG id)(A0,D0) */
;/* CxObj *CxSignal(struct Task *task,LONG signal)(A0,D0) */
;/* CxObj *CxTranslate(struct InputEvent *ie)(A0) */

;/*  ARexx support functions in amiga.lib */

CheckRexxMsg(.BOOL CONST struct RexxMsg *rexxmsg )
GetRexxVar(.l CONST struct RexxMsg *rexxmsg, CONST_STRPTR name, STRPTR *result )
SetRexxVar(.l struct RexxMsg *rexxmsg, CONST_STRPTR name, CONST_STRPTR value, LONG length )

;/*  Intuition hook and boopsi support functions in amiga.lib. */
;/*  These functions do not require any particular ROM revision */
;/*  to operate correctly, though they deal with concepts first introduced */
;/*  in V36.  These functions would work with compatibly-implemented */
;/*  hooks or objects under V34. */

CallHookA(.l struct Hook *hookPtr, Object *obj, APTR message )
CallHook(.l struct Hook *hookPtr, Object *obj, ... )
DoMethodA(.l Object *obj, Msg message )
DoMethod(.l Object *obj, ULONG methodID, ... )
DoSuperMethodA(.l struct IClass *cl, Object *obj, Msg message )
DoSuperMethod(.l struct IClass *cl, Object *obj, ULONG methodID, ... )
CoerceMethodA(.l struct IClass *cl, Object *obj, Msg message )
CoerceMethod(.l struct IClass *cl, Object *obj, ULONG methodID, ... )
HookEntry(.l struct Hook *hookPtr, Object *obj, APTR message )
SetSuperAttrs(.l struct IClass *cl, Object *obj, ULONG tag1, ... )

;/*  Network-support functions in amiga.lib. */
;/*  ACrypt() first appeared in later V39 versions of amiga.lib, but */
;/*  operates correctly under V37 and up. */

ACrypt(.l STRPTR buffer, CONST_STRPTR password, CONST_STRPTR username )

__cplusplus.#ifdef 

;/*.#endif __cplusplus */

;/*.#endif CLIB_ALIB_PROTOS_H */
