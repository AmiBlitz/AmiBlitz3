;/*--- functions in V36 or higher (Release 2.0) ---*/

;/* Gadget Functions */

NEWTYPE.Gadget
*CreateGadget(.Gadget ULONG kind, struct Gadget *gad, struct NewGadget *ng, ... )
FreeGadgets(.l struct Gadget *gad )
GT_SetGadgetAttrsA(.l struct Gadget *gad, struct Window *win, struct Requester *req, CONST struct TagItem *taglist )
GT_SetGadgetAttrs(.l struct Gadget *gad, struct Window *win, struct Requester *req, ... )

;/* Menu functions */

*CreateMenusA(.Menu CONST struct NewMenu *newmenu, struct TagItem *taglist )
*CreateMenus(.Menu CONST struct NewMenu *newmenu, ... )
FreeMenus(.l struct Menu *menu )
LayoutMenuItemsA(.BOOL struct MenuItem *firstitem, APTR vi, CONST struct TagItem *taglist )
LayoutMenuItems(.BOOL struct MenuItem *firstitem, APTR vi, ... )
LayoutMenusA(.BOOL struct Menu *firstmenu, APTR vi, CONST struct TagItem *taglist )
LayoutMenus(.BOOL struct Menu *firstmenu, APTR vi, ... )

;/* Misc Event-Handling Functions */

*GT_GetIMsg(.IntuiMessage struct MsgPort *iport )
GT_ReplyIMsg(.l struct IntuiMessage *imsg )
GT_RefreshWindow(.l struct Window *win, struct Requester *req )
GT_BeginRefresh(.l struct Window *win )
GT_EndRefresh(.l struct Window *win, LONG complete )
*GT_FilterIMsg(.IntuiMessage CONST struct IntuiMessage *imsg )
*GT_PostFilterIMsg(.IntuiMessage struct IntuiMessage *imsg )
*CreateContext(.Gadget struct Gadget **glistptr )

;/* Rendering Functions */

DrawBevelBoxA(.l struct RastPort *rport, LONG left, LONG top, LONG width, LONG height, CONST struct TagItem *taglist )
DrawBevelBox(.l struct RastPort *rport, LONG left, LONG top, LONG width, LONG height, ... )

;/* Visuals Functions */

GetVisualInfoA(.l struct Screen *screen, CONST struct TagItem *taglist )
GetVisualInfo(.l struct Screen *screen, ... )
FreeVisualInfo(.l APTR vi )

;/* New in V47 */

functions.;/*--- in V47 or higher (Release 3.2) ---*/
SetDesignFontA(.l APTR vi, struct TextAttr *tattr, CONST struct TagItem *tags )
SetDesignFont(.l APTR vi, struct TextAttr *tattr, ... )
ScaleGadgetRectA(.l struct NewGadget *ng, CONST struct TagItem *tags )
ScaleGadgetRect(.l struct NewGadget *ng, ... )


functions.;/*--- in V39 or higher (Release 3.0) ---*/

GT_GetGadgetAttrsA(.l struct Gadget *gad, struct Window *win, struct Requester *req, CONST struct TagItem *taglist )
GT_GetGadgetAttrs(.l struct Gadget *gad, struct Window *win, struct Requester *req, ... )


