;/* "speedbar.gadget" */
;/*--- functions in V40 or higher (Release 3.1) ---*/
#pragma amicall(SpeedBarBase, $1e, SPEEDBAR_GetClass())
#pragma amicall(SpeedBarBase, $24, AllocSpeedButtonNodeA(d0,a0))
#if defined(__STORM__)
#pragma tagcall(SpeedBarBase, $24, AllocSpeedButtonNode(d0,a0))
CEND ;/* __STORM__ */
#pragma amicall(SpeedBarBase, $2a, FreeSpeedButtonNode(a0))
#pragma amicall(SpeedBarBase, $30, SetSpeedButtonNodeAttrsA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(SpeedBarBase, $30, SetSpeedButtonNodeAttrs(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(SpeedBarBase, $36, GetSpeedButtonNodeAttrsA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(SpeedBarBase, $36, GetSpeedButtonNodeAttrs(a0,a1))
CEND ;/* __STORM__ */

CEND ;/* PRAGMA_SPEEDBAR_LIB_H */
