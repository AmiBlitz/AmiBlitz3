;/* "chooser.gadget" */
;/*--- functions in V40 or higher (Release 3.1) ---*/
#pragma amicall(ChooserBase, $1e, CHOOSER_GetClass())
#pragma amicall(ChooserBase, $24, AllocChooserNodeA(a0))
#if defined(__STORM__)
#pragma tagcall(ChooserBase, $24, AllocChooserNode(a0))
CEND ;/* __STORM__ */
#pragma amicall(ChooserBase, $2a, FreeChooserNode(a0))
#pragma amicall(ChooserBase, $30, SetChooserNodeAttrsA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(ChooserBase, $30, SetChooserNodeAttrs(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(ChooserBase, $36, GetChooserNodeAttrsA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(ChooserBase, $36, GetChooserNodeAttrs(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(ChooserBase, $3c, ShowChooser(a0,a1,d0,d1))
#pragma amicall(ChooserBase, $42, HideChooser(a0,a1))

CEND ;/* PRAGMA_CHOOSER_LIB_H */
