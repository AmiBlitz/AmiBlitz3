CNIF @#PRAGMA_UTILITY_LIB_H=0 
#PRAGMA_UTILITY_LIB_H = 1

;/*
;**	$VER: utility_lib.h 47.1 (30.11.2021)
;**
;**	Aztec 'C', Maxon 'C' and StormC format pragma files.
;*/

CNIF @#CLIB_UTILITY_PROTOS_H=0 
INCLUDE"clib/utility_protos.ab3" 
CEND ;/* CLIB_UTILITY_PROTOS_H */

;/* "utility.library" */
;/*--- functions in V36 or higher (Release 2.0) ---*/

;/* Tag item functions */

#pragma amicall(UtilityBase, $1e, FindTagItem(d0,a0))
#pragma amicall(UtilityBase, $24, GetTagData(d0,d1,a0))
#pragma amicall(UtilityBase, $2a, PackBoolTags(d0,a0,a1))
#pragma amicall(UtilityBase, $30, NextTagItem(a0))
#pragma amicall(UtilityBase, $36, FilterTagChanges(a0,a1,d0))
#pragma amicall(UtilityBase, $3c, MapTags(a0,a1,d0))
#pragma amicall(UtilityBase, $42, AllocateTagItems(d0))
#pragma amicall(UtilityBase, $48, CloneTagItems(a0))
#pragma amicall(UtilityBase, $4e, FreeTagItems(a0))
#pragma amicall(UtilityBase, $54, RefreshTagItemClones(a0,a1))
#pragma amicall(UtilityBase, $5a, TagInArray(d0,a0))
#pragma amicall(UtilityBase, $60, FilterTagItems(a0,a1,d0))

;/* Hook functions */

#pragma amicall(UtilityBase, $66, CallHookPkt(a0,a2,a1))
;/*--- (1 function slot reserved here) ---*/

;/* Date functions */

;/*--- (1 function slot reserved here) ---*/
#pragma amicall(UtilityBase, $78, Amiga2Date(d0,a0))
#pragma amicall(UtilityBase, $7e, Date2Amiga(a0))
#pragma amicall(UtilityBase, $84, CheckDate(a0))

;/* 32 bit integer muliply functions */

#pragma amicall(UtilityBase, $8a, SMult32(d0,d1))
#pragma amicall(UtilityBase, $90, UMult32(d0,d1))

;/* 32 bit integer division funtions. The quotient and the remainder are */
;/* returned respectively in d0 and d1 */

#pragma amicall(UtilityBase, $96, SDivMod32(d0,d1))
#pragma amicall(UtilityBase, $9c, UDivMod32(d0,d1))
;/*--- functions in V37 or higher (Release 2.04) ---*/

;/* International string routines */

#pragma amicall(UtilityBase, $a2, Stricmp(a0,a1))
#pragma amicall(UtilityBase, $a8, Strnicmp(a0,a1,d0))
#pragma amicall(UtilityBase, $ae, ToUpper(d0))
#pragma amicall(UtilityBase, $b4, ToLower(d0))
;/*--- functions in V39 or higher (Release 3.0) ---*/

;/* More tag Item functions */

#pragma amicall(UtilityBase, $ba, ApplyTagChanges(a0,a1))
;/*--- (1 function slot reserved here) ---*/

;/* 64 bit integer muliply functions. The results are 64 bit quantities */
;/* returned in D0 and D1 */

#pragma amicall(UtilityBase, $c6, SMult64(d0,d1))
#pragma amicall(UtilityBase, $cc, UMult64(d0,d1))

;/* Structure to Tag and Tag to Structure support routines */

#pragma amicall(UtilityBase, $d2, PackStructureTags(a0,a1,a2))
#pragma amicall(UtilityBase, $d8, UnpackStructureTags(a0,a1,a2))

;/* New, object-oriented NameSpaces */

#pragma amicall(UtilityBase, $de, AddNamedObject(a0,a1))
#pragma amicall(UtilityBase, $e4, AllocNamedObjectA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(UtilityBase, $e4, AllocNamedObject(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(UtilityBase, $ea, AttemptRemNamedObject(a0))
#pragma amicall(UtilityBase, $f0, FindNamedObject(a0,a1,a2))
#pragma amicall(UtilityBase, $f6, FreeNamedObject(a0))
#pragma amicall(UtilityBase, $fc, NamedObjectName(a0))
#pragma amicall(UtilityBase, $102, ReleaseNamedObject(a0))
#pragma amicall(UtilityBase, $108, RemNamedObject(a0,a1))

;/* Unique ID generator */

#pragma amicall(UtilityBase, $10e, GetUniqueID())

;/*--- (4 function slots reserved here) ---*/

;/*--- functions in V47 or higher (Release 3.2) ---*/

;/* Reserved vectors for Os4, not populated. */
;/*--- (2 function slots reserved here) ---*/

#pragma amicall(UtilityBase, $138, VSNPrintf(a0,d0,a1,a2))
#if defined(__STORM__)
#pragma tagcall(UtilityBase, $138, SNPrintf(a0,d0,a1,a2))
CEND ;/* __STORM__ */

;/* Reserved vectors for Os4, not populated. */
;/*--- (19 function slots reserved here) ---*/

;/* Reserved vector for internal use. */
;/*--- (1 function slot reserved here) ---*/

#pragma amicall(UtilityBase, $1b6, Strncpy(a1,a0,d0))
#pragma amicall(UtilityBase, $1bc, Strncat(a1,a0,d0))

;/* 64 bit integer division functions. The input is a 64 bit dividiend in d1:d0 */
;/* with top 32 bits in 32 and a divisor in d2. Results are the quotient in d0 */
;/* and a remainder in d1 */

#pragma amicall(UtilityBase, $1c2, SDivMod64(d1,d0,d2))
#pragma amicall(UtilityBase, $1c8, UDivMod64(d1,d0,d2))

CEND ;/* PRAGMA_UTILITY_LIB_H */
