#pragma amicall(AslBase, $1e, AllocFileRequest())
#pragma amicall(AslBase, $24, FreeFileRequest(a0))
#pragma amicall(AslBase, $2a, RequestFile(a0))
#pragma amicall(AslBase, $30, AllocAslRequest(d0,a0))
#if defined(__STORM__)
