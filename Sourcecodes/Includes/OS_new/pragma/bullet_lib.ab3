CNIF @#PRAGMA_BULLET_LIB_H=0 
#PRAGMA_BULLET_LIB_H = 1

;/*
;**	$VER: bullet_lib.h 47.1 (30.11.2021)
;**
;**	Aztec 'C', Maxon 'C' and StormC format pragma files.
