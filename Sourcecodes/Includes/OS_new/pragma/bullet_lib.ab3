CNIF @#CLIB_BULLET_PROTOS_H=0 
INCLUDE"clib/bullet_protos.ab3" 
CEND ;/* CLIB_BULLET_PROTOS_H */

;/* "bullet.library" */
#pragma amicall(BulletBase, $1e, OpenEngine())
#pragma amicall(BulletBase, $24, CloseEngine(a0))
#pragma amicall(BulletBase, $2a, SetInfoA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(BulletBase, $2a, SetInfo(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(BulletBase, $30, ObtainInfoA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(BulletBase, $30, ObtainInfo(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(BulletBase, $36, ReleaseInfoA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(BulletBase, $36, ReleaseInfo(a0,a1))
CEND ;/* __STORM__ */

CEND ;/* PRAGMA_BULLET_LIB_H */
