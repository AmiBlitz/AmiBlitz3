CNIF @#CLIB_REALTIME_PROTOS_H=0 
INCLUDE"clib/realtime_protos.ab3" 
CEND ;/* CLIB_REALTIME_PROTOS_H */

;/* "realtime.library" */
;/*--- functions in V37 or higher (Release 2.04) ---*/

;/* Locks */

#pragma amicall(RealTimeBase, $1e, LockRealTime(d0))
#pragma amicall(RealTimeBase, $24, UnlockRealTime(a0))

;/* Conductor */

#pragma amicall(RealTimeBase, $2a, CreatePlayerA(a0))
#if defined(__STORM__)
#pragma tagcall(RealTimeBase, $2a, CreatePlayer(a0))
CEND ;/* __STORM__ */
#pragma amicall(RealTimeBase, $30, DeletePlayer(a0))
#pragma amicall(RealTimeBase, $36, SetPlayerAttrsA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(RealTimeBase, $36, SetPlayerAttrs(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(RealTimeBase, $3c, SetConductorState(a0,d0,d1))
#pragma amicall(RealTimeBase, $42, ExternalSync(a0,d0,d1))
#pragma amicall(RealTimeBase, $48, NextConductor(a0))
#pragma amicall(RealTimeBase, $4e, FindConductor(a0))
#pragma amicall(RealTimeBase, $54, GetPlayerAttrsA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(RealTimeBase, $54, GetPlayerAttrs(a0,a1))
CEND ;/* __STORM__ */

CEND ;/* PRAGMA_REALTIME_LIB_H */
