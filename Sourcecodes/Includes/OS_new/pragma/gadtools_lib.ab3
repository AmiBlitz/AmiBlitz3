CNIF @#PRAGMA_GADTOOLS_LIB_H=0 
#PRAGMA_GADTOOLS_LIB_H = 1

;/*
;**	$VER: gadtools_lib.h 47.1 (30.11.2021)
;**
;**	Aztec 'C', Maxon 'C' and StormC format pragma files.
;*/

CNIF @#CLIB_GADTOOLS_PROTOS_H=0 
INCLUDE"clib/gadtools_protos.ab3" 
CEND ;/* CLIB_GADTOOLS_PROTOS_H */

;/* "gadtools.library" */

;/*--- functions in V36 or higher (Release 2.0) ---*/

;/* Gadget Functions */

#pragma amicall(GadToolsBase, $1e, CreateGadgetA(d0,a0,a1,a2))
#if defined(__STORM__)
#pragma tagcall(GadToolsBase, $1e, CreateGadget(d0,a0,a1,a2))
CEND ;/* __STORM__ */
#pragma amicall(GadToolsBase, $24, FreeGadgets(a0))
#pragma amicall(GadToolsBase, $2a, GT_SetGadgetAttrsA(a0,a1,a2,a3))
#if defined(__STORM__)
#pragma tagcall(GadToolsBase, $2a, GT_SetGadgetAttrs(a0,a1,a2,a3))
CEND ;/* __STORM__ */

;/* Menu functions */

#pragma amicall(GadToolsBase, $30, CreateMenusA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(GadToolsBase, $30, CreateMenus(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(GadToolsBase, $36, FreeMenus(a0))
#pragma amicall(GadToolsBase, $3c, LayoutMenuItemsA(a0,a1,a2))
#if defined(__STORM__)
#pragma tagcall(GadToolsBase, $3c, LayoutMenuItems(a0,a1,a2))
CEND ;/* __STORM__ */
#pragma amicall(GadToolsBase, $42, LayoutMenusA(a0,a1,a2))
#if defined(__STORM__)
#pragma tagcall(GadToolsBase, $42, LayoutMenus(a0,a1,a2))
CEND ;/* __STORM__ */

;/* Misc Event-Handling Functions */

#pragma amicall(GadToolsBase, $48, GT_GetIMsg(a0))
#pragma amicall(GadToolsBase, $4e, GT_ReplyIMsg(a1))
#pragma amicall(GadToolsBase, $54, GT_RefreshWindow(a0,a1))
#pragma amicall(GadToolsBase, $5a, GT_BeginRefresh(a0))
#pragma amicall(GadToolsBase, $60, GT_EndRefresh(a0,d0))
#pragma amicall(GadToolsBase, $66, GT_FilterIMsg(a1))
#pragma amicall(GadToolsBase, $6c, GT_PostFilterIMsg(a1))
#pragma amicall(GadToolsBase, $72, CreateContext(a0))

;/* Rendering Functions */

#pragma amicall(GadToolsBase, $78, DrawBevelBoxA(a0,d0,d1,d2,d3,a1))
#if defined(__STORM__)
#pragma tagcall(GadToolsBase, $78, DrawBevelBox(a0,d0,d1,d2,d3,a1))
CEND ;/* __STORM__ */

;/* Visuals Functions */

#pragma amicall(GadToolsBase, $7e, GetVisualInfoA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(GadToolsBase, $7e, GetVisualInfo(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(GadToolsBase, $84, FreeVisualInfo(a0))

;/* New in V47 */

;/*--- functions in V47 or higher (Release 3.2) ---*/
#pragma amicall(GadToolsBase, $8a, SetDesignFontA(a0,a1,a2))
#if defined(__STORM__)
#pragma tagcall(GadToolsBase, $8a, SetDesignFont(a0,a1,a2))
CEND ;/* __STORM__ */
#pragma amicall(GadToolsBase, $90, ScaleGadgetRectA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(GadToolsBase, $90, ScaleGadgetRect(a0,a1))
CEND ;/* __STORM__ */


;/* Reserved entries */


;/*--- functions in V39 or higher (Release 3.0) ---*/

#pragma amicall(GadToolsBase, $ae, GT_GetGadgetAttrsA(a0,a1,a2,a3))
#if defined(__STORM__)
#pragma tagcall(GadToolsBase, $ae, GT_GetGadgetAttrs(a0,a1,a2,a3))
CEND ;/* __STORM__ */


CEND ;/* PRAGMA_GADTOOLS_LIB_H */
