CNIF @#PRAGMA_IFFPARSE_LIB_H=0 
#PRAGMA_IFFPARSE_LIB_H = 1

;/*
;**	$VER: iffparse_lib.h 47.1 (30.11.2021)
;**
;**	Aztec 'C', Maxon 'C' and StormC format pragma files.
;*/

CNIF @#CLIB_IFFPARSE_PROTOS_H=0 
INCLUDE"clib/iffparse_protos.ab3" 
CEND ;/* CLIB_IFFPARSE_PROTOS_H */

;/* "iffparse.library" */
;/*--- functions in V36 or higher (Release 2.0) ---*/

;/* Basic functions */

#pragma amicall(IFFParseBase, $1e, AllocIFF())
#pragma amicall(IFFParseBase, $24, OpenIFF(a0,d0))
#pragma amicall(IFFParseBase, $2a, ParseIFF(a0,d0))
#pragma amicall(IFFParseBase, $30, CloseIFF(a0))
#pragma amicall(IFFParseBase, $36, FreeIFF(a0))

;/* Read/Write functions */

#pragma amicall(IFFParseBase, $3c, ReadChunkBytes(a0,a1,d0))
#pragma amicall(IFFParseBase, $42, WriteChunkBytes(a0,a1,d0))
#pragma amicall(IFFParseBase, $48, ReadChunkRecords(a0,a1,d0,d1))
#pragma amicall(IFFParseBase, $4e, WriteChunkRecords(a0,a1,d0,d1))

;/* Context entry/exit */

#pragma amicall(IFFParseBase, $54, PushChunk(a0,d0,d1,d2))
#pragma amicall(IFFParseBase, $5a, PopChunk(a0))
;/*--- (1 function slot reserved here) ---*/

;/* Low-level handler installation */

#pragma amicall(IFFParseBase, $66, EntryHandler(a0,d0,d1,d2,a1,a2))
#pragma amicall(IFFParseBase, $6c, ExitHandler(a0,d0,d1,d2,a1,a2))

;/* Built-in chunk/property handlers */

#pragma amicall(IFFParseBase, $72, PropChunk(a0,d0,d1))
#pragma amicall(IFFParseBase, $78, PropChunks(a0,a1,d0))
#pragma amicall(IFFParseBase, $7e, StopChunk(a0,d0,d1))
#pragma amicall(IFFParseBase, $84, StopChunks(a0,a1,d0))
#pragma amicall(IFFParseBase, $8a, CollectionChunk(a0,d0,d1))
#pragma amicall(IFFParseBase, $90, CollectionChunks(a0,a1,d0))
#pragma amicall(IFFParseBase, $96, StopOnExit(a0,d0,d1))

;/* Context utilities */

#pragma amicall(IFFParseBase, $9c, FindProp(a0,d0,d1))
#pragma amicall(IFFParseBase, $a2, FindCollection(a0,d0,d1))
#pragma amicall(IFFParseBase, $a8, FindPropContext(a0))
#pragma amicall(IFFParseBase, $ae, CurrentChunk(a0))
#pragma amicall(IFFParseBase, $b4, ParentChunk(a0))

;/* LocalContextItem support functions */

#pragma amicall(IFFParseBase, $ba, AllocLocalItem(d0,d1,d2,d3))
#pragma amicall(IFFParseBase, $c0, LocalItemData(a0))
#pragma amicall(IFFParseBase, $c6, SetLocalItemPurge(a0,a1))
#pragma amicall(IFFParseBase, $cc, FreeLocalItem(a0))
#pragma amicall(IFFParseBase, $d2, FindLocalItem(a0,d0,d1,d2))
#pragma amicall(IFFParseBase, $d8, StoreLocalItem(a0,a1,d0))
#pragma amicall(IFFParseBase, $de, StoreItemInContext(a0,a1,a2))

;/* IFFHandle initialization */

#pragma amicall(IFFParseBase, $e4, InitIFF(a0,d0,a1))
#pragma amicall(IFFParseBase, $ea, InitIFFasDOS(a0))
#pragma amicall(IFFParseBase, $f0, InitIFFasClip(a0))

;/* Internal clipboard support */

#pragma amicall(IFFParseBase, $f6, OpenClipboard(d0))
#pragma amicall(IFFParseBase, $fc, CloseClipboard(a0))

;/* Miscellaneous */

#pragma amicall(IFFParseBase, $102, GoodID(d0))
#pragma amicall(IFFParseBase, $108, GoodType(d0))
#pragma amicall(IFFParseBase, $10e, IDtoStr(d0,a0))

CEND ;/* PRAGMA_IFFPARSE_LIB_H */
