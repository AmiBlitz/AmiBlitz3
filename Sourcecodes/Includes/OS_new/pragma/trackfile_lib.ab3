CNIF @#PRAGMA_TRACKFILE_LIB_H=0 
#PRAGMA_TRACKFILE_LIB_H = 1

;/*
;**	$VER: trackfile_lib.h 2.3 (10.8.2020)
;**
;**	Aztec 'C', Maxon 'C' and StormC format pragma files.
;*/

CNIF @#CLIB_TRACKFILE_PROTOS_H=0 
INCLUDE"clib/trackfile_protos.ab3" 
CEND ;/* CLIB_TRACKFILE_PROTOS_H */

;/* "trackfile.device" */
#pragma amicall(TrackFileBase, $2a, TFStartUnitTagList(d0,a0))
#if defined(__STORM__)
#pragma tagcall(TrackFileBase, $2a, TFStartUnitTags(d0,a0))
CEND ;/* __STORM__ */
#pragma amicall(TrackFileBase, $30, TFStopUnitTagList(d0,a0))
#if defined(__STORM__)
#pragma tagcall(TrackFileBase, $30, TFStopUnitTags(d0,a0))
CEND ;/* __STORM__ */
#pragma amicall(TrackFileBase, $36, TFInsertMediaTagList(d0,a0))
#if defined(__STORM__)
#pragma tagcall(TrackFileBase, $36, TFInsertMediaTags(d0,a0))
CEND ;/* __STORM__ */
#pragma amicall(TrackFileBase, $3c, TFEjectMediaTagList(d0,a0))
#if defined(__STORM__)
#pragma tagcall(TrackFileBase, $3c, TFEjectMediaTags(d0,a0))
CEND ;/* __STORM__ */
#pragma amicall(TrackFileBase, $42, TFGetUnitData(d0))
#pragma amicall(TrackFileBase, $48, TFFreeUnitData(a0))

;/*--- functions in V2 or higher ---*/

#pragma amicall(TrackFileBase, $4e, TFChangeUnitTagList(d0,a0))
#if defined(__STORM__)
#pragma tagcall(TrackFileBase, $4e, TFChangeUnitTags(d0,a0))
CEND ;/* __STORM__ */
#pragma amicall(TrackFileBase, $54, TFExamineFileSize(d0))

CEND ;/* PRAGMA_TRACKFILE_LIB_H */
