CNIF @#PRAGMA_DISKFONT_LIB_H=0 
#PRAGMA_DISKFONT_LIB_H = 1

;/*
;**	$VER: diskfont_lib.h 47.1 (30.11.2021)
;**
;**	Aztec 'C', Maxon 'C' and StormC format pragma files.
;*/

CNIF @#CLIB_DISKFONT_PROTOS_H=0 
INCLUDE"clib/diskfont_protos.ab3" 
CEND ;/* CLIB_DISKFONT_PROTOS_H */

;/* "diskfont.library" */
#pragma amicall(DiskfontBase, $1e, OpenDiskFont(a0))
#pragma amicall(DiskfontBase, $24, AvailFonts(a0,d0,d1))
;/*--- functions in V34 or higher (Release 1.3) ---*/
#pragma amicall(DiskfontBase, $2a, NewFontContents(a0,a1))
#pragma amicall(DiskfontBase, $30, DisposeFontContents(a1))
;/*--- functions in V36 or higher (Release 2.0) ---*/
#pragma amicall(DiskfontBase, $36, NewScaledDiskFont(a0,a1))
;/*--- functions in V45 or higher (Release 3.9) ---*/
#pragma amicall(DiskfontBase, $3c, GetDiskFontCtrl(d0))
#pragma amicall(DiskfontBase, $42, SetDiskFontCtrlA(a0))
#if defined(__STORM__)
#pragma tagcall(DiskfontBase, $42, SetDiskFontCtrl(a0))
CEND ;/* __STORM__ */
;/*--- functions in V47 or higher (Release 3.2) ---*/
#pragma amicall(DiskfontBase, $48, EOpenEngine(a0))
#pragma amicall(DiskfontBase, $4e, ECloseEngine(a0))
#pragma amicall(DiskfontBase, $54, ESetInfoA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(DiskfontBase, $54, ESetInfo(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(DiskfontBase, $5a, EObtainInfoA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(DiskfontBase, $5a, EObtainInfo(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(DiskfontBase, $60, EReleaseInfoA(a0,a1))
#if defined(__STORM__)
#pragma tagcall(DiskfontBase, $60, EReleaseInfo(a0,a1))
CEND ;/* __STORM__ */
#pragma amicall(DiskfontBase, $66, OpenOutlineFont(a0,a1,d0))
#pragma amicall(DiskfontBase, $6c, CloseOutlineFont(a0,a1))
#pragma amicall(DiskfontBase, $72, WriteFontContents(a0,a1,a2))
#pragma amicall(DiskfontBase, $78, WriteDiskFontHeaderA(a0,a1,a2))
#if defined(__STORM__)
#pragma tagcall(DiskfontBase, $78, WriteDiskFontHeader(a0,a1,a2))
CEND ;/* __STORM__ */
#pragma amicall(DiskfontBase, $7e, ObtainCharsetInfo(d0,d1,d2))

CEND ;/* PRAGMA_DISKFONT_LIB_H */
