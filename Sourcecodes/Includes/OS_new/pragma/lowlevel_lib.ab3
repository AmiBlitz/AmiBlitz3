CNIF @#PRAGMA_LOWLEVEL_LIB_H=0 
#PRAGMA_LOWLEVEL_LIB_H = 1

;/*
;**	$VER: lowlevel_lib.h 47.1 (30.11.2021)
;**
;**	Aztec 'C', Maxon 'C' and StormC format pragma files.
;*/

CNIF @#CLIB_LOWLEVEL_PROTOS_H=0 
INCLUDE"clib/lowlevel_protos.ab3" 
CEND ;/* CLIB_LOWLEVEL_PROTOS_H */

;/* "lowlevel.library" */
;/*--- functions in V40 or higher (Release 3.1) ---*/

;/* CONTROLLER HANDLING */

#pragma amicall(LowLevelBase, $1e, ReadJoyPort(d0))

;/* LANGUAGE HANDLING */

#pragma amicall(LowLevelBase, $24, GetLanguageSelection())

;/* KEYBOARD HANDLING */

#pragma amicall(LowLevelBase, $30, GetKey())
#pragma amicall(LowLevelBase, $36, QueryKeys(a0,d1))
#pragma amicall(LowLevelBase, $3c, AddKBInt(a0,a1))
#pragma amicall(LowLevelBase, $42, RemKBInt(a1))

;/* SYSTEM HANDLING */

#pragma amicall(LowLevelBase, $48, SystemControlA(a1))
#if defined(__STORM__)
#pragma tagcall(LowLevelBase, $48, SystemControl(a1))
CEND ;/* __STORM__ */

;/* TIMER HANDLING */

#pragma amicall(LowLevelBase, $4e, AddTimerInt(a0,a1))
#pragma amicall(LowLevelBase, $54, RemTimerInt(a1))
#pragma amicall(LowLevelBase, $5a, StopTimerInt(a1))
#pragma amicall(LowLevelBase, $60, StartTimerInt(a1,d0,d1))
#pragma amicall(LowLevelBase, $66, ElapsedTime(a0))

;/* VBLANK HANDLING */

#pragma amicall(LowLevelBase, $6c, AddVBlankInt(a0,a1))
#pragma amicall(LowLevelBase, $72, RemVBlankInt(a1))

;/* Private LVOs for use by nonvolatile.library */


;/* MORE CONTROLLER HANDLING */

#pragma amicall(LowLevelBase, $84, SetJoyPortAttrsA(d0,a1))
#if defined(__STORM__)
#pragma tagcall(LowLevelBase, $84, SetJoyPortAttrs(d0,a1))
CEND ;/* __STORM__ */

;/* Reserved entries */


CEND ;/* PRAGMA_LOWLEVEL_LIB_H */
