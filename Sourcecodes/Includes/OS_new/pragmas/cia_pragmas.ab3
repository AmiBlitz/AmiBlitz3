CNIF @#PRAGMAS_CIA_PRAGMAS_H=0 
#PRAGMAS_CIA_PRAGMAS_H = 1

;/*
;**	$VER: cia_pragmas.h 47.4 (5.2.2022)
;**
;**	Lattice 'C', Aztec 'C', SAS/C and DICE format pragma files.
;*/

CNIF @#CLIB_CIA_PROTOS_H=0 
INCLUDE"clib/cia_protos.ab3" 
CEND ;/* CLIB_CIA_PROTOS_H */

;/****************************************************************************/

;/* The ciaa.resource/ciab.resource library stub functions are part of
; * amiga.lib, but it should not be necessary to use them. The following
; * defines local stub functions which then in turn call the respective
; * ciaa.resource/ciab.resource functions through the "#pragma libcall"
; * command.
; *
; * Because the definition of these local stub functions may conflict with
; * the creation of precompiled header files in Lattice and SAS/C this feature
; * is not enabled by default. You need to add "#define __USE_CIA_STUBS" to
; * enable it.
; */

#ifdef __USE_CIA_STUBS

;/****************************************************************************/

NEWTYPE.Interrupt
__RemICRVector(LONG.l iCRBit, struct Interrupt *interrupt)
__AbleICR(LONG.w mask)
__SetICR(LONG.w mask)



libcall.#pragma __CIABase __AddICRVector 6 9002
libcall.#pragma __CIABase __RemICRVector c 9002
libcall.#pragma __CIABase __AbleICR 12 001
libcall.#pragma __CIABase __SetICR 18 001



struct.STATIC Interrupt *

*__CIABase,.Library 
iCRBit,.w 
*interrupt).Interrupt 

__AddICRVector(iCRBit,.return interrupt)


AddICRVector(resource,.#define iCRBit, interrupt) \
(iCRBit),.__AddICRVector_stub((resource), (interrupt))



VOID.STATIC 

*__CIABase,.Library 
iCRBit,.w 
*interrupt).Interrupt 

interrupt).__RemICRVector(iCRBit, 


RemICRVector(resource,.#define iCRBit, interrupt) \
(iCRBit),.__RemICRVector_stub((resource), (interrupt))



WORD.STATIC 

*__CIABase,.Library 
mask).w 

__AbleICR(mask).return 


AbleICR(resource,.#define mask) \
(mask)).__AbleICR_stub((resource), 



WORD.STATIC 

*__CIABase,.Library 
mask).w 

__SetICR(mask).return 


SetICR(resource,.#define mask) \
(mask)).__SetICR_stub((resource), 



;/*.#endif __USE_CIA_STUBS */



;/*.#endif PRAGMAS_CIA_PRAGMAS_H */
