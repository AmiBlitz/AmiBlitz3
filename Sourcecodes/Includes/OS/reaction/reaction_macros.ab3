Macro ARexxObject :         NewObjectA_(GetClass(*ArexxBase), "",VarArgs(0 :End Macro

;/****************************************************************************
; * Window class method macros
; */
Macro RA_OpenWindow :       DoMethod(`1, #WM_OPEN, 0) :End Macro
Macro RA_CloseWindow :      DoMethod(`1, #WM_CLOSE, 0) :End Macro
Macro RA_HandleInput :      DoMethod(`1, #WM_HANDLEINPUT, `2) :End Macro
Macro RA_Iconify :          DoMethod(`1, #WM_ICONIFY, 0) :End Macro
Macro RA_Uniconify :   RA_OpenWindow(`1)  :End Macro

;/****************************************************************************
; * ARexx class method macros
; */
Macro RA_HandleRexx :       DoMethod(`1, #AM_HANDLEEVENT ) :End Macro
Macro RA_FlushRexx :        DoMethod(`1, #AM_FLUSH )  :End Macro

