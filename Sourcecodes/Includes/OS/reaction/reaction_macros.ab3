;;/****************************************************************************
;; * Lazy typist BGUI inspired macros (BGUI is Copyright Jan van den Baard.)
;; */
Macro HAlign    :  #LAYOUT_HorizAlignment, '1  :End Macro
Macro VAlign    :  #LAYOUT_VertAlignment, '1  :End Macro
Macro Spacing   :  #LAYOUT_InnerSpacing, '1  :End Macro
Macro LOffset   :  #LAYOUT_LeftSpacing, '1  :End Macro
Macro ROffset   :  #LAYOUT_RightSpacing, '1  :End Macro
Macro TOffset   :  #LAYOUT_TopSpacing, '1  :End Macro
Macro BOffset   :  #LAYOUT_BottomSpacing, '1  :End Macro
;
;;/****************************************************************************
;; * And for even lazier typists....
;; */
Macro VCentered :  #LAYOUT_VertAlignment, #LALIGN_CENTER :End Macro
Macro TAligned  :  #LAYOUT_VertAlignment, #LALIGN_TOP  :End Macro
Macro BAligned  :  #LAYOUT_VertAlignment, #LALIGN_BOTTOM  :End Macro
Macro HCentered :  #LAYOUT_HorizAlignment, #LALIGN_CENTER  :End Macro
Macro LAligned  :  #LAYOUT_HorizAlignment, #LALIGN_LEFT :End Macro
Macro RAligned  :  #LAYOUT_HorizAlignment, #LALIGN_RIGHT :End Macro
Macro Offset    :  #LAYOUT_LeftSpacing, '1, #LAYOUT_TopSpacing, '2, #LAYOUT_RightSpacing, '3, #LAYOUT_BottomSpacing, '4 :End Macro
Macro EvenSized :  #LAYOUT_EvenSize, True :End Macro
