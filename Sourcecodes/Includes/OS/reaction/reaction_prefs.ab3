CNIF @#EXEC_SEMAPHORES_H = 0 
INCLUDE "exec/semaphores.ab3"
CEND

Macro RAPREFSSEMAPHORE : "REACTION-PREFS" :End Macro

;/* WARNING: This structure has been changing, and will continue to change.
; * In the future, this structure might possible be accesssed at a higher
; * level via a tag list. For now, except for class authors wishing our
; * support in handling prefs, this is data is to be considered off limits.
; */

Macro ClassActPrefs : UIPrefs :End Macro

NEWTYPE.UIPrefs
	;/* Set PrefsVersion to 1 */
	cap_Semaphore.SignalSemaphore;
	cap_PrefsVersion.w;
	cap_PrefsSize.w;
	cap_BevelType.b;
	cap_LayoutSpacing.w;
	cap_3DLook.b;
	cap_LabelPen.w;
	cap_LabelPlace.b;
	cap_3DLabel.b;
	*cap_Reserved1.l;
	cap_SimpleRefresh.b;
	cap_Pattern.b[256];
	*cap_Reserved2.l;

	cap_3DProp.b;
	cap_Reserved3.b;

	cap_GlyphType.b;	/* currently unsupported/unused!! */
	cap_Reserved4.b;

	*cap_FallbackAttr.TextAttr;
	*cap_LabelAttr.TextAttr;
End NEWTYPE


;/* Bevel Types */
#BVT_GT      = 0	;/* GadTools style 2:1 bevels */
#BVT_THIN    = 1	;/* CA 1:1 bevels */
#BVT_THICK   = 2	;/* CA 2:1 4 color thick bevels */
#BVT_XEN     = 3	;/* 4 color Xen-Style inspired 1/2 shine bevels */
#BVT_XENTHIN = 4	;/* 3 color Xen-Style inspired thin 1/2 shine 1:1 bevels */

;/* Glyph Types */
#GLT_GT   = 0
#GLT_FLAT = 1
#GLT_3D   = 2

CEND
