CNIF @#INTUITION_CGHOOKS_H = 0
INCLUDE "intuition/cghooks.h"
CEND

;/*
; * PRIVATE!
; */
NEWTYPE.SpecialPens
	sp_Version.w;	/* Currently 0 */
	sp_DarkPen.l;	/* XEN/Thick extended locked pen */
	sp_LightPen.l;	/* XEN/Thick extended locked pen */
	;/* NOTE: This structure may grow! */
End NEWTYPE

;/*****************************************************************************
; * Custom method defined and supported by some Reaction Gadgets
; * When this method is supported by more (all?) Reaction Gadgets
; * this structure may move to intuition/gadgetclass.h
; */
#GM_CLIPRECT =  ($550001)

;/* The GM_CLIPRECT method is used to pass a gadget a cliprect
; * it should install before rendering to ObtainGIRPort() rastports
; * to support proper usage within virtual groups.
; */

NEWTYPE.gpClipRect
	MethodID.l;       /* GM_CLIPRECT              */
	*gpc_GInfo.GadgetInfo;      /* GadgetInfo               */
	*gpc_ClipRect.Rectangle;   /* Rectangle To Clip To     */
	gpc_Flags.l;      /* Flags                    */
End NEWTYPE

;/* Possible return values from GM_CLIPRECT
; */
#GMC_VISIBLE	=	2
#GMC_PARTIAL	=	1
#GMC_INVISIBLE	=	0

/**************************************************************************/

CEND ;/* REACTION_REACTION_CLASS_H */
