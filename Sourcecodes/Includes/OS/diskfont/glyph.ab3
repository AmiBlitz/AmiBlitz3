CNIF @#EXEC_LIBRARIES_H=0 
INCLUDE"exec/libraries.ab3" 
CEND 

CNIF @#EXEC_NODES_H=0 
INCLUDE"exec/nodes.ab3" 
CEND 

;/* A GlyphEngine must be acquired via OpenEngine and is read-only */
NEWTYPE.GlyphEngine
*gle_Library.Library ; ;/* engine library */
gle_Name.l ;		;/* library basename: e.g. "bullet" */
    ;/* private library data follows... */
End NEWTYPE

typedef LONG FIXED;		;/* 32 bit signed w/ 16 bits of fraction */

NEWTYPE.GlyphMap
glm_BMModulo.w ;	;/* # of bytes in row: always multiple of 4 */
glm_BMRows.w ;		;/* # of rows in bitmap */
glm_BlackLeft.w ;	;/* # of blank pixel columns at left */
glm_BlackTop.w ;	;/* # of blank rows at top */
glm_BlackWidth.w ;	;/* span of contiguous non-blank columns */
glm_BlackHeight.w ;	;/* span of contiguous non-blank rows */
glm_XOrigin.FIXED ;	;/* distance from upper left corner of bitmap */
glm_YOrigin.FIXED ;	;/*   to initial CP, in fractional pixels */
glm_X0.w ;		;/* approximation of XOrigin in whole pixels */
glm_Y0.w ;		;/* approximation of YOrigin in whole pixels */
glm_X1.w ;		;/* approximation of XOrigin + Width */
glm_Y1.w ;		;/* approximation of YOrigin + Width */
glm_Width.FIXED ;		;/* character advance, as fraction of em width */
*glm_BitMap.b ;		;/* actual glyph bitmap */
End NEWTYPE

NEWTYPE.GlyphWidthEntry
gwe_Node.MinNode ;	;/* on list returned by OT_WidthList inquiry */
gwe_Code.w ;		;/* entry's character code value */
gwe_Width.FIXED ;		;/* character advance, as fraction of em width */
End NEWTYPE

;/* Structure returned when asking for OT_WidthList32,
; * the original GlyphWidthEntry structure is limited to
; * 16 bit glyph code (UWORD gwe_Code).
; */
NEWTYPE.GlyphWidthEntry32
gwe32_Node.MinNode ;	;/* on list returned by OT_WidthList32 inquiry */
gwe32_reserved.w ;	;/* for alignment and backwards compatibility */
gwe32_Width.FIXED ;	;/* character advance, as fraction of em width */
gwe32_Code.l ;		;/* entry's character code value */
End NEWTYPE
CEND ;/* DISKFONT_GLYPH_H */
