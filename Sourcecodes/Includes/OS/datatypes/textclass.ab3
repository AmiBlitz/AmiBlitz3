CNIF @#DATATYPES_TEXTCLASS_H=0 
#DATATYPES_TEXTCLASS_H = 1
;/*
;**	$VER: textclass.h 47.1 (28.6.2019)
;**
;**  Interface definitions for DataType text objects.
;**
