;/* DOS Processes started from the CLI via RUN or NEWCLI have this additional
; * set to data associated with them. This is the extended structure that
; * includes additional interfaces to communicate with the shell
; */

NEWTYPE.ExtendedCommandLineInterface
cle_Result2.l ;	       ;/* Value of IoErr from last command	  */
*cle_SetName.b ;	       ;/* Name of current directory		  */
*cle_CommandDir.l ;     ;/* Head of the path locklist		  */
cle_ReturnCode.l ;     ;/* Return code from last command		  */
*cle_CommandName.b ;    ;/* Name of current command		  */
cle_FailLevel.l ;      ;/* Fail level (set by FAILAT)		  */
*cle_Prompt.b ;	       ;/* Current prompt (set by PROMPT)	  */
*cle_StandardInput.l ;  ;/* Default (terminal) CLI input		  */
*cle_CurrentInput.l ;   ;/* Current CLI input			  */
*cle_CommandFile.b ;    ;/* Name of EXECUTE command file		  */
cle_Interactive.l ;    ;/* Boolean; True if prompts required	  */
cle_Background.l ;     ;/* Boolean; True if CLI created by RUN	  */
*cle_CurrentOutput.l ;  ;/* Current CLI output			  */
cle_DefaultStack.l ;   ;/* Stack size to be obtained in long words */
*cle_StandardOutput.l ; ;/* Default (terminal) CLI output		  */
*cle_Module.l ;	       ;/* SegList of currently loaded command	  */
cle_Hook.Hook ;      ;/* For requesting shell functions          */
*cle_This.ExtendedCommandLineInterface ; ;/* pointer to itself   */
cle_Version.l ;        ;/* Version of the interface. V47 currently */
End NEWTYPE;  ;/* CommandLineInterface */

;/*
;** A line in the history.
;** Never allocate yourself, go through the shell methods.
;*/
NEWTYPE.HistoryNode
hn_Node.MinNode 
hn_Line.l 
End NEWTYPE

;/*
; * Tags used by the shell
; */
#SHELL_DUMMY = (#TAG_USER + 3000)

;/* for FGetShell: If TRUE, a string including a command is
;** requested. Otherwise, only arguments. */
#SHELL_FGETS_FULL = (#SHELL_DUMMY + 1)

;/*
;** For ADDHIST: The line to add
;*/
#SHELL_ADDH_LINE = (#SHELL_DUMMY + 2)

