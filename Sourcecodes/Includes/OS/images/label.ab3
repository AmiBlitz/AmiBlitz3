CNIF @#INTUITION_IMAGECLASS_H=0 
INCLUDE"intuition/imageclass.ab3" 
CEND 


;/*****************************************************************************/

;/* Justification modes.
; */
#LJ_LEFT = 0
#LJ_CENTRE = 1
#LJ_RIGHT = 2

;/* For those that can't spell :)
; */
#LJ_CENTER = #LJ_CENTRE

;/* Obsolete, DON'T USE THESE!
; */
#LABEL_LEFT = #LJ_LEFT
#LABEL_CENTRE = #LJ_CENTRE
#LABEL_CENTER = #LJ_CENTRE
#LABEL_RIGHT = #LJ_RIGHT

;/* Vertical alignment types (OS4ONLY).
; */
#LVALIGN_BOTTOM = 0
#LVALIGN_BASELINE = 1

;/*****************************************************************************/

;/* Additional attributes defined by the Label class
; */
#LABEL_Dummy = (#REACTION_Dummy+$0006000)

#LABEL_DrawInfo = #SYSIA_DrawInfo

#LABEL_Text = (#LABEL_Dummy+1)
 ;/* (STRPTR) Text to print in the label. */

#LABEL_Image = (#LABEL_Dummy+2)
 ;/* (struct Image *) Image to print in the label. */

#LABEL_Mapping = (#LABEL_Dummy+3)
 ;/* (UWORD *) Mapping array for the next image. */

#LABEL_Justification = (#LABEL_Dummy+4)
 ;/* (UWORD) Justification modes (see above) */

#LABEL_Key = (#LABEL_Dummy+5)
 ;/* (UWORD) Returns the underscored key (if any) */

#LABEL_Underscore = (#LABEL_Dummy+6)
 ;/* (TEXT) Defaults to '_'. */

#LABEL_DisposeImage = (#LABEL_Dummy+7)
 ;/* (BOOL) Defaults to FALSE. */

#LABEL_SoftStyle = (#LABEL_Dummy+8)
 ;/* (UBYTE) Defaults to none. */

#LABEL_VerticalSpacing = (#LABEL_Dummy+9)
 ;/* (UWORD) Vertical spacing between text lines. Defaults to 0. */

#LABEL_VerticalAlignment = (#LABEL_Dummy+10) ;/* OS4ONLY */

#LABEL_WordWrap = (#LABEL_Dummy+11) ;/* OS4ONLY */

#LABEL_MenuMode = (#LABEL_Dummy+12) ;/* OS4ONLY */

;/*****************************************************************************/

CEND ;/* IMAGES_LABEL_H */
