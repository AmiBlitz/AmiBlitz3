NEWTYPE.CardHandle
ReleaseCard(.l struct CardHandle *handle, ULONG flags )
*GetCardMap(.CardMemoryMap VOID )
BeginCardAccess(.BOOL struct CardHandle *handle )
EndCardAccess(.BOOL struct CardHandle *handle )
ReadCardStatus(.b VOID )
CardResetRemove(.BOOL struct CardHandle *handle, ULONG flag )
