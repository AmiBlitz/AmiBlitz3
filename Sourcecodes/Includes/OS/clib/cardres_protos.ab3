CardAccessSpeed(.l struct CardHandle *handle, ULONG nanoseconds )
CardProgramVoltage(.l struct CardHandle *handle, ULONG voltage )
CardResetCard(.BOOL struct CardHandle *handle )
CopyTuple(.BOOL struct CardHandle *handle, UBYTE *buffer, ULONG tuplecode, ULONG size )
DeviceTuple(.l CONST UBYTE *tuple_data, struct DeviceTData *storage )
*IfAmigaXIP(.Resident struct CardHandle *handle )
CardForceChange(.BOOL VOID )
CardChangeCount(.l VOID )
CardInterface(.l VOID )

