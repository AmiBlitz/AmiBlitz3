CNIF @#__cplusplus
;extern "C" {
CEND ;/* __cplusplus */

CNIF @#EXEC_LIBRARIES_H=0 
INCLUDE"exec/libraries.ab3" 
CEND 
CNIF @#LIBRARIES_IFFPARSE_H=0 
INCLUDE"libraries/iffparse.ab3" 
CEND 
CNIF @#UTILITY_HOOKS_H=0 
INCLUDE"utility/hooks.ab3" 
CEND 
;/*--- functions in V36 or higher (Release 2.0) ---*/

;/* Basic functions */

NEWTYPE.IFFHandle
OpenIFF(.l struct IFFHandle *iff, LONG rwMode )
ParseIFF(.l struct IFFHandle *iff, LONG control )
CloseIFF(.l struct IFFHandle *iff )
FreeIFF(.l struct IFFHandle *iff )

;/* Read/Write functions */

ReadChunkBytes(.l struct IFFHandle *iff, APTR buf, LONG numBytes )
WriteChunkBytes(.l struct IFFHandle *iff, CONST_APTR buf, LONG numBytes )
ReadChunkRecords(.l struct IFFHandle *iff, APTR buf, LONG bytesPerRecord, LONG numRecords )
WriteChunkRecords(.l struct IFFHandle *iff, CONST_APTR buf, LONG bytesPerRecord, LONG numRecords )

;/* Context entry/exit */

PushChunk(.l struct IFFHandle *iff, LONG type, LONG id, LONG size )
PopChunk(.l struct IFFHandle *iff )

;/* Low-level handler installation */

EntryHandler(.l struct IFFHandle *iff, LONG type, LONG id, LONG position, struct Hook *handler, APTR object )
ExitHandler(.l struct IFFHandle *iff, LONG type, LONG id, LONG position, struct Hook *handler, APTR object )

;/* Built-in chunk/property handlers */

PropChunk(.l struct IFFHandle *iff, LONG type, LONG id )
PropChunks(.l struct IFFHandle *iff, CONST LONG *propArray, LONG numPairs )
StopChunk(.l struct IFFHandle *iff, LONG type, LONG id )
StopChunks(.l struct IFFHandle *iff, CONST LONG *propArray, LONG numPairs )
CollectionChunk(.l struct IFFHandle *iff, LONG type, LONG id )
CollectionChunks(.l struct IFFHandle *iff, CONST LONG *propArray, LONG numPairs )
StopOnExit(.l struct IFFHandle *iff, LONG type, LONG id )

;/* Context utilities */

*FindProp(.StoredProperty struct IFFHandle *iff, LONG type, LONG id )
*FindCollection(.CollectionItem struct IFFHandle *iff, LONG type, LONG id )
*FindPropContext(.ContextNode struct IFFHandle *iff )
*CurrentChunk(.ContextNode struct IFFHandle *iff )
*ParentChunk(.ContextNode struct ContextNode *contextNode )

;/* LocalContextItem support functions */

*AllocLocalItem(.LocalContextItem LONG type, LONG id, LONG ident, LONG dataSize )
LocalItemData(.l struct LocalContextItem *localItem )
SetLocalItemPurge(.l struct LocalContextItem *localItem, struct Hook *purgeHook )
FreeLocalItem(.l struct LocalContextItem *localItem )
*FindLocalItem(.LocalContextItem struct IFFHandle *iff, LONG type, LONG id, LONG ident )
StoreLocalItem(.l struct IFFHandle *iff, struct LocalContextItem *localItem, LONG position )
StoreItemInContext(.l struct IFFHandle *iff, struct LocalContextItem *localItem, struct ContextNode *contextNode )

;/* IFFHandle initialization */

InitIFF(.l struct IFFHandle *iff, LONG flags, struct Hook *streamHook )
InitIFFasDOS(.l struct IFFHandle *iff )
InitIFFasClip(.l struct IFFHandle *iff )

;/* Internal clipboard support */

*OpenClipboard(.ClipboardHandle LONG unitNumber )
CloseClipboard(.l struct ClipboardHandle *clipHandle )

;/* Miscellaneous */

GoodID(.l LONG id )
GoodType(.l LONG type )
IDtoStr(.l LONG id, STRPTR buf )

;__cplusplus.#ifdef  

;/*.#endif __cplusplus */

CEND ;CLIB_IFFPARSE_PROTOS_H */
