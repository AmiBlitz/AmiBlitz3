VOID InitLayers( struct Layer_Info *li )
NEWTYPE.Layer
*CreateBehindLayer(.Layer struct Layer_Info *li, struct BitMap *bm, LONG x0, LONG y0, LONG x1, LONG y1, LONG flags, struct BitMap *bm2 )
UpfrontLayer(.l LONG dummy, struct Layer *layer )
BehindLayer(.l LONG dummy, struct Layer *layer )
MoveLayer(.l LONG dummy, struct Layer *layer, LONG dx, LONG dy )
SizeLayer(.l LONG dummy, struct Layer *layer, LONG dx, LONG dy )
ScrollLayer(.l LONG dummy, struct Layer *layer, LONG dx, LONG dy )
BeginUpdate(.l struct Layer *l )
EndUpdate(.l struct Layer *layer, ULONG flag )
DeleteLayer(.l LONG dummy, struct Layer *layer )
LockLayer(.l LONG dummy, struct Layer *layer )
UnlockLayer(.l struct Layer *layer )
LockLayers(.l struct Layer_Info *li )
UnlockLayers(.l struct Layer_Info *li )
LockLayerInfo(.l struct Layer_Info *li )
SwapBitsRastPortClipRect(.l struct RastPort *rp, struct ClipRect *cr )
*WhichLayer(.Layer struct Layer_Info *li, LONG x, LONG y )
UnlockLayerInfo(.l struct Layer_Info *li )
*NewLayerInfo(.Layer_Info VOID )
DisposeLayerInfo(.l struct Layer_Info *li )
FattenLayerInfo(.l struct Layer_Info *li )
ThinLayerInfo(.l struct Layer_Info *li )
MoveLayerInFrontOf(.l struct Layer *layer_to_move, struct Layer *other_layer )
*InstallClipRegion(.Region struct Layer *layer, struct Region *region )
MoveSizeLayer(.l struct Layer *layer, LONG dx, LONG dy, LONG dw, LONG dh )
*CreateUpfrontHookLayer(.Layer struct Layer_Info *li, struct BitMap *bm, LONG x0, LONG y0, LONG x1, LONG y1, LONG flags, struct Hook *hook, struct BitMap *bm2 )
*CreateBehindHookLayer(.Layer struct Layer_Info *li, struct BitMap *bm, LONG x0, LONG y0, LONG x1, LONG y1, LONG flags, struct Hook *hook, struct BitMap *bm2 )
*InstallLayerHook(.Hook struct Layer *layer, struct Hook *hook )
functions.;/*--- in V39 or higher (Release 3.0) ---*/
*InstallLayerInfoHook(.Hook struct Layer_Info *li, struct Hook *hook )
SortLayerCR(.l struct Layer *layer, LONG dx, LONG dy )
DoHookClipRects(.l struct Hook *hook, struct RastPort *rport, CONST struct Rectangle *rect )
functions.;/*--- in V45 or higher (Release 3.9) ---*/
LayerOccluded(.BOOL struct Layer *layer )
HideLayer(.l struct Layer *layer )
ShowLayer(.l struct Layer *layer, struct Layer *in_front_of )
SetLayerInfoBounds(.BOOL struct Layer_Info *li, CONST struct Rectangle *bounds )

