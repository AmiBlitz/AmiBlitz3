CNIF @#LIBRARIES_KEYMAP_H=0 
#LIBRARIES_KEYMAP_H = 1
;/*
;**	$VER: keymap.h 47.1 (28.6.2019)
;**
;**	key map definitions for keymap.library, and
;**	console.device
