#WBCTRLA_SetDiskInfoHook = (#WBA_Dummy+160)

;/****************************************************************************/

;/* The message your setup/cleanup hook gets invoked with. */
NEWTYPE.SetupCleanupHookMsg
schm_Length.l ; ;/* Size of this data structure (in bytes). */
schm_State.l ; ;/* See below for definitions. */
End NEWTYPE

#SCHMSTATE_TryCleanup = 0 ;/* Workbench will attempt to shut down now. */
#SCHMSTATE_Cleanup = 1 ;/* Workbench will really shut down now. */
#SCHMSTATE_Setup = 2 ;/* Workbench is operational again or
;      * could not be shut down.
;      */

;/****************************************************************************/

