#WBF_DRAWERPOSMASK = $00000003  ;/* Drawer placement mask (text mode) */
#WBF_DRAWERPOSFREE = $00000000  ;/* Place drawers mixed with files */
#WBF_DRAWERPOSHEAD = $00000001  ;/* Place drawers at top of list */
#WBF_DRAWERPOSTAIL = $00000002  ;/* Place drawers at bottom of list */
#WBF_BOUNDTEXTVIEW = $00000080  ;/* Limit scrolling in text mode drawers */
#WBF_OLDDATESFIRST = $00010000  ;/* Reverse default ordering of dates */

