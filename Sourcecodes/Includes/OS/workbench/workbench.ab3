#WBA_Reserved71 = (#WBA_Dummy+149)
#WBA_Reserved72 = (#WBA_Dummy+150)
#WBA_Reserved73 = (#WBA_Dummy+151)
#WBA_Reserved74 = (#WBA_Dummy+152)
#WBA_Reserved75 = (#WBA_Dummy+153)
#WBA_Reserved76 = (#WBA_Dummy+154)
#WBA_Reserved77 = (#WBA_Dummy+155)
#WBA_Reserved78 = (#WBA_Dummy+156)
#WBA_Reserved79 = (#WBA_Dummy+157)

;/****************************************************************************/

#WBA_LAST_TAG = (#WBA_Dummy+160)

;/****************************************************************************/

;/* The message your AppIcon rendering hook gets invoked with. */
NEWTYPE.AppIconRenderMsg
*arm_RastPort.RastPort ; ;/* RastPort to render into */
*arm_Icon.DiskObject ; ;/* The icon to be rendered */
arm_Label.l ; ;/* The icon label txt */
*arm_Tags.TagItem ; ;/* Further tags to be passed on
;       * to DrawIconStateA().
;       */

arm_Left.w ; ;/* \ Rendering origin, not taking the */
arm_Top.w ; ;/* / button border into account. */

arm_Width.w ; ;/* \ Limit your rendering to */
arm_Height.w ; ;/* / this area. */

arm_State.l ; ;/* IDS_SELECTED, IDS_NORMAL, etc. */
End NEWTYPE

;/****************************************************************************/

;/* The message your drop zone hook gets invoked with. */
NEWTYPE.AppWindowDropZoneMsg
*adzm_RastPort.RastPort ;  ;/* RastPort to render into. */
adzm_DropZoneBox.IBox ; ;/* Limit your rendering to this area. */
adzm_ID.l ;  ;/* \ These come from straight */
adzm_UserData.l ;  ;/* / from AddAppWindowDropZoneA(). */
adzm_Action.l ;  ;/* See below for a list of actions. */
End NEWTYPE

#ADZMACTION_Enter = (0)
#ADZMACTION_Leave = (1)

;/****************************************************************************/

;/* The message your icon selection change hook is invoked with. */
NEWTYPE.IconSelectMsg
 ;/* Size of this data structure (in bytes). */
ism_Length.l 

 ;/* Lock on the drawer this object resides in,
;  * NULL for Workbench backdrop (devices).
;  */
ism_Drawer.l

 ;/* Name of the object in question. */
ism_Name.l 

 ;/* One of WBDISK, WBDRAWER, WBTOOL, WBPROJECT,
;  * WBGARBAGE, WBDEVICE, WBKICK or WBAPPICON.
;  */
ism_Type.w 

 ;/* TRUE if currently selected, FALSE otherwise. */
ism_Selected.l 

 ;/* Pointer to the list of tag items passed to
;  * ChangeWorkbenchSelectionA().
;  */
*ism_Tags.TagItem 

 ;/* Pointer to the window attached to this icon,
;  * if the icon is a drawer-like object.
;  */
*ism_DrawerWindow.Window 

 ;/* Pointer to the window the icon resides in. */
*ism_ParentWindow.Window 

 ;/* Position and size of the icon; note that the
;  * icon may not entirely reside within the visible
;  * bounds of the parent window.
;  */
ism_Left.w 
ism_Top.w 
ism_Width.w 
ism_Height.w 
End NEWTYPE

;/* These are the values your hook code can return. */
#ISMACTION_Unselect = (0) ;/* Unselect the icon */
#ISMACTION_Select = (1) ;/* Select the icon */
#ISMACTION_Ignore = (2) ;/* Do not change the selection state. */
#ISMACTION_Stop = (3) ;/* Do not invoke the hook code again,
;      * leave the icon as it is.
;      */

;/****************************************************************************/

;/* The messages your copy hook is invoked with. */
NEWTYPE.CopyBeginMsg

cbm_Length.l ;  ;/* Size of this data structure in bytes. */
cbm_Action.l ;  ;/* Will be set to CPACTION_Begin (see below). */
*cbm_SourceDrawer.l ; ;/* A lock on the source drawer. */
*cbm_DestinationDrawer.l ; ;/* A lock on the destination drawer. */
End NEWTYPE

NEWTYPE.CopyDataMsg
cdm_Length.l ;  ;/* Size of this data structure in bytes. */
cdm_Action.l ;  ;/* Will be set to CPACTION_Copy (see below). */

cdm_SourceLock.l ;  ;/* A lock on the parent directory of the
;      * source file/drawer.
;      */
cdm_SourceName.l ;  ;/* The name of the source file or drawer. */

cdm_DestinationLock.l ; ;/* A lock on the parent directory of the
;      * destination file/drawer.
;      */
cdm_DestinationName.l ; ;/* The name of the destination file/drawer.
;      * This may or may not match the name of
;      * the source file/drawer in case the
;      * data is to be copied under a different
;      * name. For example, this is the case
;      * with the Workbench "Copy" command which
;      * creates duplicates of file/drawers by
;      * prefixing the duplicate's name with
;      * "Copy_XXX_of".
;      */
cdm_DestinationX.l ; ;/* When the icon corresponding to the
;      * destination is written to disk, this
;      * is the position (put into its
;      * DiskObject->do_CurrentX/DiskObject->do_CurrentY
;      * fields) it should be placed at.
;      */
cdm_DestinationY.l 
End NEWTYPE

NEWTYPE.CopyEndMsg
cem_Length.l ;  ;/* Size of this data structure in bytes. */
cem_Action.l ;  ;/* Will be set to CPACTION_End (see below). */
End NEWTYPE

#CPACTION_Begin = (0) ;/* This message arrives when the copying
;      * process is started.
;      */
#CPACTION_Copy = (1) ;/* This message arrives for each file or
;      * drawer to be copied.
;      */
#CPACTION_End = (2) ;/* This message arrives when all files/drawers
;      * have been copied.
;      */

;/****************************************************************************/

;/* The messages your delete hook is invoked with. */
NEWTYPE.DeleteBeginMsg
dbm_Length.l ;  ;/* Size of this data structure in bytes. */
dbm_Action.l ;  ;/* Will be set to either DLACTION_BeginDiscard
;      * or DLACTION_BeginEmptyTrash (see below).
;      */
End NEWTYPE

NEWTYPE.DeleteDataMsg
ddm_Length.l ;  ;/* Size of this data structure in bytes. */
ddm_Action.l ;  ;/* Will be set to either DLACTION_DeleteContents
;      * or DLACTION_DeleteObject (see below).
;      */
*ddm_Lock.l ;  ;/* A Lock on the parent directory of the object
;      * whose contents or which itself should be
;      * deleted.
;      */
ddm_Name.l ;  ;/* The name of the object whose contents or
;      * which itself should be deleted.
;      */
End NEWTYPE

NEWTYPE.DeleteEndMsg
dem_Length.l ;  ;/* Size of this data structure in bytes. */
dem_Action.l ;  ;/* Will be set to DLACTION_End (see below). */
End NEWTYPE

#DLACTION_BeginDiscard = (0) ;/* This indicates that a number of
;       * files and drawers should be
;       * discarded; note that you will
;       * receive a different kind of message
;       * if the trashcan is to be emptied
;       * (see below).
;       */
#DLACTION_BeginEmptyTrash = (1) ;/* This indicates that the following
;       * delete operations are intended to
;       * empty the trashcan.
;       */
#DLACTION_DeleteContents = (3) ;/* This indicates that the object
;       * described by lock and name refers
;       * to a drawer; you should empty its
;       * contents but *DO NOT* delete the
;       * drawer itself!
;       */
#DLACTION_DeleteObject = (4) ;/* This indicates that the object
;       * described by lock and name should
;       * be deleted; this could be a file
;       * or an empty drawer.
;       */
#DLACTION_End = (5) ;/* This indicates that the
;       * deletion process is finished.
;       */

;/****************************************************************************/

;/* The messages your text input hook is invoked with. */
NEWTYPE.TextInputMsg

tim_Length.l ;   ;/* Size of this data structure
;       * in bytes.
;       */
tim_Action.l ;   ;/* One of the TIACTION_...
;       * values listed below.
;       */
tim_Prompt.l ;   ;/* The Workbench suggested
;       * result, depending on what
;       * kind of input is requested
;       * (as indicated by the
;       * tim_Action member).
;       */
End NEWTYPE

#TIACTION_Rename = (0)  ;/* A file or drawer is to be
;       * renamed.
;       */
#TIACTION_RelabelVolume = (1)  ;/* A volume is to be relabeled. */
#TIACTION_NewDrawer = (2)  ;/* A new drawer is to be created. */
#TIACTION_Execute = (3)  ;/* A program or script is to be
;       * executed.
;       */

;/****************************************************************************/

;/* Parameters for the UpdateWorkbench() function. */

#UPDATEWB_ObjectRemoved = (0) ;/* Object has been deleted. */
#UPDATEWB_ObjectAdded = (1) ;/* Object is new or has changed. */

;/****************************************************************************/

CEND ;/* !WORKBENCH_WORKBENCH_H */
