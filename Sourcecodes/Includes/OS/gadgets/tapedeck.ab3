	;/* (LONG) Number of frames in animation.  Only valid when using
;	 * animation controls. */

#TDECK_CurrentFrame = (#TDECK_Dummy + 12)
	;/* (LONG) Current frame.  Only valid when using animation controls. */

;/*****************************************************************************/

