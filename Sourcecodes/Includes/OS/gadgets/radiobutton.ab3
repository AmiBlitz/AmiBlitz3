;/* Defines for the radiobutton node attributes.
; */
#RBNA_Dummy = (#TAG_USER+$020000)

#RBNA_UserData = (#RBNA_Dummy+1)
	;/* (APTR) User Data. */

#RBNA_Labels = (#RBNA_Dummy+2) ;/* obsolete tagname */
#RBNA_Label = (#RBNA_Dummy+2)
    ;/* (STRPTR) Text string of the node. */

#RBNA_HintInfo = (#RBNA_Dummy+3) ;/* OS4ONLY */

#RBNA_Disabled = (#RBNA_Dummy+4) ;/* OS4ONLY */

;/*****************************************************************************/

;/* Additional attributes defined by the RadioButton class
; */
#RADIOBUTTON_Dummy = (#REACTION_Dummy + $14000)

#RADIOBUTTON_Labels = (#RADIOBUTTON_Dummy+1)
	;/* (struct List *) Radio Button Label List. */

#RADIOBUTTON_Strings = (#RADIOBUTTON_Dummy+2)
	;/* RESERVED - presently unsupported */

#RADIOBUTTON_Spacing = (#RADIOBUTTON_Dummy+3)
	;/* (WORD) Spacing between radio buttons */

#RADIOBUTTON_Selected = (#RADIOBUTTON_Dummy+4)
	;/* (WORD) selected radio button (OM_GET/OM_SET/OM_NOTIFY) */

#RADIOBUTTON_LabelPlace = (#RADIOBUTTON_Dummy+5)
	;/* (WORD) label location (OM_GET/OM_SET) */

#RADIOBUTTON_LabelArray = (#RADIOBUTTON_Dummy+6) ;/* OS4ONLY */

;/*****************************************************************************/

