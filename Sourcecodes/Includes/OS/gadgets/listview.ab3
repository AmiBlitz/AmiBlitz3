;/* This defines a entry in the ListView list.
; */
NEWTYPE.ListLabelNode
lvn_Node.Node ;             ;/* Exec Node structure */
lvn_UserData.l 

lvn_RenderForeground.w ; ;/* Render foreground pen */
lvn_RenderBackground.w ; ;/* Render background pen */

lvn_SelectForeground.w ; ;/* Select foreground pen */
lvn_SelectBackground.w ; ;/* Select background pen */

*lvn_RenderImage.Image ;      ;/* Optional rendered imagery */
*lvn_SelectImage.Image ;      ;/* Optional selected imagery */

    ;/* PRIVATE FIELDS - CRASH & BURN! */
lvn_TextLength.w 
lvn_LeftEdge.w 
lvn_TopEdge.w 
lvn_Width.w 
lvn_Height.w 
lvn_Justification.w ;    ;/* text/image justification */
lvn_Selected.w ;         ;/* is node selected? */
End NEWTYPE

;/*****************************************************************************/

#LVJ_LEFT = 0
#LVJ_CENTER = 1
#LVJ_RIGHT = 2

;/*****************************************************************************/

;/* Additional attributes defined by the ListView class */

#LISTVIEW_Dummy = (#TAG_USER+$04000000)

#LISTVIEW_Labels = (#LISTVIEW_Dummy+1)  ;/* (struct List *) listview labels */
#LISTVIEW_Top = (#LISTVIEW_Dummy+2)  ;/* ListView Top Offset */
#LISTVIEW_Visible = (#LISTVIEW_Dummy+3)  ;/* ListView Node Visible */
#LISTVIEW_Total = (#LISTVIEW_Dummy+4)  ;/* ListView Total Nodes */
#LISTVIEW_ShowSelected = (#LISTVIEW_Dummy+6)  ;/* BOOL */
#LISTVIEW_Selected = (#LISTVIEW_Dummy+7)  ;/* Currently selected node number */
#LISTVIEW_SelectedNode = (#LISTVIEW_Dummy+7)  ;/* Currently selected node */
#LISTVIEW_MakeVisible = (#LISTVIEW_Dummy+8)  ;/* make/is node visible */
#LISTVIEW_MultiSelect = (#LISTVIEW_Dummy+9)  ;/* allow multiselect? */
#LISTVIEW_ItemHeight = (#LISTVIEW_Dummy+10) ;/* Node/Item height */
#LISTVIEW_CallHook = (#LISTVIEW_Dummy+11) ;/* Render Hook */
#LISTVIEW_ScrollUp = (#LISTVIEW_Dummy+12) ;/* scroll view up ? labels */
#LISTVIEW_ScrollDown = (#LISTVIEW_Dummy+13) ;/* scroll view down ? labels */
#LISTVIEW_ScrollLeft = (#LISTVIEW_Dummy+14) ;/* scroll view left ? pixels */
#LISTVIEW_ScrollRight = (#LISTVIEW_Dummy+15) ;/* scroll view right ? pixels */
#LISTVIEW_Spacing = (#LISTVIEW_Dummy+16) ;/* not currently implemented */

