CNIF @#REACTION_REACTION_H=0 
INCLUDE "reaction/reaction.ab3" 
CEND 

CNIF @#INTUITION_GADGETCLASS_H=0 
INCLUDE "intuition/gadgetclass.ab3" 
CEND 

;/*****************************************************************************/

;/* Additional attributes defined by the scroller.gadget class
; */

#SCROLLER_Dummy = (#REACTION_Dummy+$0005000)

#SCROLLER_Top = (#SCROLLER_Dummy+1L)
	;/* (WORD) scroller Top value (Defaults to 0). */

#SCROLLER_Visible = (#SCROLLER_Dummy+2L)
	;/* (WORD) visible part of total. */

#SCROLLER_Total = (#SCROLLER_Dummy+3L)
	;/* (WORD) total scroller size. */

#SCROLLER_Orientation = (#SCROLLER_Dummy+4L)
	;/* (WORD) Vertical or Horizontal mode. */

#SCROLLER_Arrows = (#SCROLLER_Dummy+5L)
	;/* (BOOL) Render arrows. */

#SCROLLER_Stretch = (#SCROLLER_Dummy+6L)
	;/* (BOOL) AutoExpand/Stretch Total. */

#SCROLLER_ArrowDelta = (#SCROLLER_Dummy+7L)
	;/* (WORD) Change arrow click makes. */

#SCROLLER_SignalTask = (#SCROLLER_Dummy+10L)
	;/* (struct Task *) Signal this Task while scroller is active */

#SCROLLER_SignalTaskBit = (#SCROLLER_Dummy+11L)
	;/* (ULONG) Signal with this Bit. */

;/*****************************************************************************/

;/* SCROLLER_Orientation Modes
; */

#SORIENT_HORIZ = #FREEHORIZ
#SORIENT_VERT = #FREEVERT

#SCROLLER_HORIZONTAL = #SORIENT_HORIZ
#SCROLLER_VERTICAL = #SORIENT_VERT

CEND ;/* GADGETS_SCROLLER_H */
