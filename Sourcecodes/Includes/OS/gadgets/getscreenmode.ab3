	;/* (WORD) Top edge of the screenmode requester (default: 20) (OM_NEW, OM_SET, OM_GET) */

#GETSCREENMODE_DisplayID = (#GETSCREENMODE_Dummy+6)
	;/* (ULONG) display id of screenmode (default: 0 (LORES_KEY)) (OM_NEW, OM_SET, OM_GET, OM_NOTIFY) */

