;/*
; * getfont.gadget methods
; */
#GSM_REQUEST = ($610001)

;/* The GSM_REQUEST method should be called whenever you want to open
; * a screenmode requester.
; */

NEWTYPE.gsmRequest
  MethodID.l ;				;/* GSM_REQUEST */
  *gsmr_Window.Window ;	    ;/* The window that will be locked when the requester is active.
;								If not provided, no window will be locked and no visual updating
;								of any gadgets will take place. This should be the window the gadget
;								resides in. */
End NEWTYPE

Macro RequestScreenMode : DoMethod('1, #GSM_REQUEST, '2) :End Macro

;/* ReAction synomym for End which can make layout groups easier to follow */

;CNIF @#GetScreenModeEnd=0 
Macro GetScreenModeEnd : #TAG_END) :End Macro
;CEND 

CEND ;/* GADGETS_GETSCREENMODE_H */
