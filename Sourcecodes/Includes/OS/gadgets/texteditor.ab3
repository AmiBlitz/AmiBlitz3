NEWTYPE.ClickMessage
LineContents.l ;  ;/* This field is ReadOnly!!! */
ClickPosition.l 
End NEWTYPE

NEWTYPE.HighlightMessage
Version.l 
Text.l 
StatusOfPrevBlock.l 
End NEWTYPE

;/* Definitions for Setting styles when challanged by HighlightMessage to call
; * HighlightSetFormat */
#TBSTYLE_UNDERLINE = $0001
#TBSTYLE_BOLD = $0002
#TBSTYLE_ITALIC = $0004
#TBSTYLE_SETCOLOR = $0008
#TBSTYLE_SPELLERROR = $0040
#TBSTYLE_COLORMASK = $FF00
#TBSTYLE_STYLEMASK = $00FF
#TBSTYLE_NOTSET = $FF00

NEWTYPE.LeftBarRenderMessage
Command.w ; ;/* LEFTBAR_RENDERCOMMAND */
Version.w ; ;/* For now it is 0 */
BlockNum.l ; ;/* Starting from 0 on the first block of the document */
LineSubNum.l ; ;/* Starting from 0 on the first line of the block */
*RastPort.RastPort ; ;/* The rastport to render into.
;								* Careful it is possible to write outside - for now
;								* Font is set and position points to topleft of area.
;								* You have LeftBarWidth x TxHeight to render within.
;								*/
End NEWTYPE

NEWTYPE.LeftBarMouseMessage
Command.w ; ;/* LEFTBAR_MOUSECOMMAND */
Version.w ; ;/* For now it is 0 */
BlockNum.l ; ;/* Starting from 0 on the first block of the document */
Code.w ; ;/* copied from InputEvent */
Qualifier.w ; ;/* copied from InputEvent */
X.w ;		;/* mouse position relative to upper left corner of the leftbar area for this line */
Y.w 
TimeStamp.timeval ; ;/* copied from InputEvent */
End NEWTYPE


;/* Definitions for the various messages above */
#LEFTBAR_RENDERCOMMAND = 0
#LEFTBAR_MOUSECOMMAND = 1

;/* Definitions for Separator type */

#LNSB_Top = 0 ;/* Mutual exclude: */
#LNSB_Middle = 1 ;/* Placement of    */
#LNSB_Bottom = 2 ;/*  the separator  */
#LNSB_StrikeThru = 3 ;/* Let separator go thru the textfont */
#LNSB_Thick = 4 ;/* Extra thick separator */

#LNSF_Top = (1 LSL #LNSB_Top)
#LNSF_Middle = (1 LSL #LNSB_Middle)
#LNSF_Bottom = (1 LSL #LNSB_Bottom)
#LNSF_StrikeThru = (1 LSL #LNSB_StrikeThru)
#LNSF_Thick = (1 LSL #LNSB_Thick)

;/* Definitions for GA_TEXTEDITOR_LineEndingImported and GA_TEXTEDITOR_LineEndingExport */
#LINEENDING_LF = 0
#LINEENDING_CR = 1
#LINEENDING_CRLF = 2
#LINEENDING_ASIMPORT = 3 ;/* only meaningful for GA_TEXTEDITOR_LineEndingExport*/

