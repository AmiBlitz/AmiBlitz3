;/* Register an instance of this to listen to changes
; * You must keep the structure and members valid as long as it is registered
; * You may add your own data following the structure.
; * It is safe to set function pointers to NULL
; */
NEWTYPE.ChangeListener
*onCharsInserted.l ;)(struct.l ChangeListener *listener, ULONG startBlockNun, ULONG startPosInBlock,endBlockNum,.l ULONG endPosInBlock)
*onCharsDeleted.l;)(struct.l ChangeListener *listener, ULONG startBlockNum, ULONG startPosInBlock,endBlockNum,.l ULONG endPosInBlock)
*onCharEntered.l;)(struct.l ChangeListener *listener, ULONG character)
Reserved1.l 
Reserved2.l ; ;/* all ReservedX members of this struct must be NULL */
Reserved3.l 
Reserved4.l 
Reserved5.l 
End NEWTYPE


NEWTYPE.GP_TEXTEDITOR_ARexxCmd : MethodId.l:*GInfo.GadgetInfo : command.l : End NEWTYPE
NEWTYPE.GP_TEXTEDITOR_BlockInfo : MethodId.l:*GInfo.GadgetInfo :*startx.l : *starty.l : *stopx.l : *stopy.l: End NEWTYPE
NEWTYPE.GP_TEXTEDITOR_ClearText : MethodId.l:*GInfo.GadgetInfo : End NEWTYPE
NEWTYPE.GP_TEXTEDITOR_ExportText : MethodId.l:*GInfo.GadgetInfo : End NEWTYPE
NEWTYPE.GP_TEXTEDITOR_HandleError : MethodId.l:errorocode.l : End NEWTYPE ;/* See below for error codes */
NEWTYPE.GP_TEXTEDITOR_InsertText : MethodId.l:*GInfo.GadgetInfo : text.l : pos.l : End NEWTYPE ;  /* See below for positions */
NEWTYPE.GP_TEXTEDITOR_MarkText : MethodId.l:*GInfo.GadgetInfo : start_crsr_x.l : start_crsr_y.l : stop_crsr_x.l : stop_crsr_y.l : End NEWTYPE
NEWTYPE.GP_TEXTEDITOR_Replace : MethodId.l:*GInfo.GadgetInfo : newstring.l : flags.l : End NEWTYPE
NEWTYPE.GP_TEXTEDITOR_Search : MethodId.l:*GInfo.GadgetInfo : string.l : flags.l : End NEWTYPE ;/* See below for flags */
NEWTYPE.GP_TEXTEDITOR_AddChangeListener : MethodId.l:*GInfo.GadgetInfo : *listener.ChangeListener:End NEWTYPE
NEWTYPE.GP_TEXTEDITOR_ReplaceAll : MethodId.l:*GInfo.GadgetInfo : End NEWTYPE

