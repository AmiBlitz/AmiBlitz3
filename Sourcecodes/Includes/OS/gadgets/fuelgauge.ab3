CNIF @#REACTION_REACTION_H=0 
INCLUDE "reaction/reaction.ab3" 
CEND 

CNIF @#INTUITION_GADGETCLASS_H=0 
INCLUDE "intuition/gadgetclass.ab3" 
CEND 

;/*****************************************************************************/

#FUELGAUGE_Dummy = (#REACTION_Dummy + $12000)

#FUELGAUGE_Min = (#FUELGAUGE_Dummy + 1)
	;/* (LONG) fuelgauge minimum value. */

#FUELGAUGE_Max = (#FUELGAUGE_Dummy + 2)
	;/* (LONG) fuelgauge maximum value. */

#FUELGAUGE_Level = (#FUELGAUGE_Dummy + 3)
	;/* (LONG) fuelgauge level (value between min and max). */

#FUELGAUGE_Orientation = (#FUELGAUGE_Dummy + 4)
	;/* (WORD) orientation mode. */

#FUELGAUGE_Percent = (#FUELGAUGE_Dummy + 5)
	;/* (BOOL) render numeric percentage display. */

#FUELGAUGE_Ticks = (#FUELGAUGE_Dummy + 6)
	;/* (WORD) enable tick marks if number of ticks set is not 0. */

#FUELGAUGE_ShortTicks = (#FUELGAUGE_Dummy + 7)
	;/* (WORD) enable small intermediate tick marks. */

#FUELGAUGE_TickSize = (#FUELGAUGE_Dummy + 8)
	;/* (WORD) height of  large tick makrs. */

#FUELGAUGE_TickPen = (#FUELGAUGE_Dummy + 9)
	;/* (WORD) tickmark pen. */

#FUELGAUGE_PercentPen = (#FUELGAUGE_Dummy + 10)
	;/* (WORD) pen number to use for inner gauge percange rendering. */

#FUELGAUGE_FillPen = (#FUELGAUGE_Dummy + 11)
	;/* (WORD) pen number to use for the fuelbar. */

#FUELGAUGE_EmptyPen = (#FUELGAUGE_Dummy + 12)
	;/* (WORD) fuelgauge background/empty pen number. */

#FUELGAUGE_VarArgs = (#FUELGAUGE_Dummy + 13)
	;/* argument array for GA_Text varargs string */

#FUELGAUGE_Justification = (#FUELGAUGE_Dummy + 14)
	;/* GA_Text justification mode */

;/*****************************************************************************/

;/* FUELGAUGE_Orientation modes
; */
#FGORIENT_HORIZ = 0
#FGORIENT_VERT = 1

;/* FUELGAUGE_Justification modes
; */
#FGJ_LEFT = 0	;/* default */
#FGJ_CENTER = 1
#FGJ_CENTRE = #FGJ_CENTER	;/* english/canadian spellings */

;/* Obsolete, DO NOT USE!
; */
#FUELGAUGE_HORIZONTAL = #FGORIENT_HORIZ
#FUELGAUGE_VERTICAL = #FGORIENT_VERT

CEND ;/* GADGETS_FUELGAUGE_H */
