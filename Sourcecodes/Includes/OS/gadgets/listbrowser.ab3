;/*****************************************************************************/

;/* LBM_ADDNODE creates a listbrowser node and inserts it to the currently
; * attached list. The number of columns is automatically set according to the
; * object's column number. If the node would become visible, it is automatically
; * rendered. This method returns the address of the new node. (V41)
; */
#LBM_ADDNODE = ($580001)

NEWTYPE.lbAddNode
MethodID.l ;   ;/* LBM_ADDNODE */
*lba_GInfo.GadgetInfo ; ;/* to provide rendering info */
*lba_Node.Node ;       ;/* Insert() after this node */
*lba_NodeAttrs.TagItem ; ;/* LBNA taglist */
End NEWTYPE


;/* LBM_REMNODE removes and frees the chosen node. If the node was visible, the
; * display is updated. The method returns 1 if the operation was successful.
; * (V41)
; */
#LBM_REMNODE = ($580002)

NEWTYPE.lbRemNode
MethodID.l ;   ;/* LBM_REMNODE */
*lbr_GInfo.GadgetInfo ; ;/* to provide rendering info */
*lbr_Node.Node ;  ;/* Remove() this node */
End NEWTYPE


;/* LBM_EDITNODE changes the chosen node's attributes and renders the
; * changes. The method returns 1 if the operation was successful. (V41)
; */
#LBM_EDITNODE = ($580003)

NEWTYPE.lbEditNode
MethodID.l ;   ;/* LBM_EDITNODE */
*lbe_GInfo.GadgetInfo ; ;/* to provide rendering info */
*lbe_Node.Node ;  ;/* modify this node */
*lbe_NodeAttrs.TagItem ; ;/* according to this taglist */
End NEWTYPE


;/* LBM_SORT
; */
#LBM_SORT = ($580004)

NEWTYPE.lbSort
MethodID.l ;   ;/* LBM_SORT */
*lbs_GInfo.GadgetInfo ; ;/* to provide rendering info */
lbs_Column.l ;  ;/* Column to sort by */
lbs_Direction.l ;  ;/* Reverse sort */
*lbs_CompareHook.Hook ; ;/* Optional hook to compare items */
End NEWTYPE

;/* For compatibility only; do not use in new code. */
;Macro lbs_Reverse : lbs_Direction : End Macro

#LBMSORT_FORWARD = 0  ;/* Forward sort (down sort arrow) */
#LBMSORT_REVERSE = 1  ;/* Reverse sort (up sort arrow) */

;/* LBM_SHOWCHILDREN
; */
#LBM_SHOWCHILDREN = ($580005)

NEWTYPE.lbShowChildren
MethodID.l ;   ;/* LBM_SHOWCHILDREN */
*lbsc_GInfo.GadgetInfo ; ;/* to provide rendering info */
*lbsc_Node.Node ;  ;/* Starting ParentNode, NULL means start at root. */
lbsc_Depth.w ;  ;/* Depth to Show */
End NEWTYPE


;/* LBM_HIDECHILDREN
; */
#LBM_HIDECHILDREN = ($580006)

NEWTYPE.lbHideChildren
MethodID.l ;   ;/* LBM_HIDECHILDREN */
*lbhc_GInfo.GadgetInfo ; ;/* to provide rendering info */
*lbhc_Node.Node ;  ;/* Starting ParentNode, NULL means start at root. */
lbhc_Depth.w ;  ;/* Depth to Hide */
End NEWTYPE


;/*****************************************************************************/

;/* ListBrowser Node attributes.
; */
#LBNA_Dummy = (#TAG_USER+$5003500)

#LBNA_Selected = (#LBNA_Dummy+1)
 ;/* (BOOL) If the node is to be selected.  Defaults to FALSE. */

#LBNA_Flags = (#LBNA_Dummy+2)
 ;/* (ULONG) Flags for the node.  Defaults to 0. */

#LBNA_UserData = (#LBNA_Dummy+3)
 ;/* (ULONG) User data.  Defaults to NULL. */

#LBNA_Column = (#LBNA_Dummy+4)
 ;/* (WORD) Column in the node that the attributes below effect. Defaults
;  * to 0.*/

#LBNCA_Text = (#LBNA_Dummy+5)
 ;/* (STRPTR) Text to display in the column.  Defaults to NULL. */

#LBNCA_Integer = (#LBNA_Dummy+6)
 ;/* (LONG *) Pointer to an integer to display in the column.  Defaults to NULL. */

#LBNCA_FGPen = (#LBNA_Dummy+7)
 ;/* (WORD) Column foreground pen. */

#LBNCA_BGPen = (#LBNA_Dummy+8)
 ;/* (WORD) Column background pen. */

#LBNCA_Image = (#LBNA_Dummy+9)
 ;/* (struct Image *) Image to display in the column.  Defaults to NULL. */

#LBNCA_SelImage = (#LBNA_Dummy+10)
 ;/* (struct Image *) Image to display in column when selected.  Defaults
;  * to NULL. */

#LBNCA_HorizJustify = (#LBNA_Dummy+11)
#LBNCA_Justification = #LBNCA_HorizJustify
 ;/* (ULONG) Column justification. Defaults to LCJ_LEFT. Not yet implemented. */

#LBNA_Generation = (#LBNA_Dummy+12)
 ;/* Node generation.  Defaults to 0. */

#LBNCA_Editable = (#LBNA_Dummy+13)
 ;/* (BOOL) If this column is editable.  Requires LBNCA_CopyText. Defaults
;  * to FALSE. */

#LBNCA_MaxChars = (#LBNA_Dummy+14)
 ;/* (WORD) Maximum characters in an editable entry.  Required when using
;  * LBNCA_Editable. */

#LBNCA_CopyText = (#LBNA_Dummy+15)
 ;/* Copy the LBNCA_Text contents to an internal buffer. */

#LBNA_CheckBox = (#LBNA_Dummy+16)
 ;/* (BOOL) this is a checkbox node */

#LBNA_Checked = (#LBNA_Dummy+17)
 ;/* (BOOL) is checked if true */

#LBNA_NodeSize = (#LBNA_Dummy+18)
 ;/* (ULONG) size of custom node and optimzie mempool puddles */

#LBNCA_EditTags = (#LBNA_Dummy+19)
 ;/* (struct TagItem *) taglist sent to editable string */

#LBNCA_RenderHook = (#LBNA_Dummy+20)
 ;/* (struct Hook *) effectivly the same as gadtools listview hook */

#LBNCA_HookHeight = (#LBNA_Dummy+22)
 ;/* (WORD) height in pixels of the hook function rendering */

#LBNA_MemPool = (#LBNA_Dummy+23)
 ;/* (APTR) exec memory pool to use */

#LBNA_NumColumns = (#LBNA_Dummy+24)
 ;/* (WORD) for GetListBrowserNodeAttrs() only! */

#LBNA_Priority = (#LBNA_Dummy+25)
 ;/* (UBYTE) Sets the exec node->ln_Pri */

#LBNCA_CopyInteger = (#LBNA_Dummy+26)
 ;/* (BOOL) AllocListBrowserNodeAttrs() or SetListBrowserNodeAttrs() only! */

#LBNCA_WordWrap = (#LBNA_Dummy+27)
 ;/* (BOOL) WordWrap this node's LBNCA_Text data */

#LBNCA_VertJustify = (#LBNA_Dummy+28)
 ;/* (ULONG) Row justification. Defaults to LRJ_BOTTOM. Not yet implemented. */

#LBNCA_FillPen = (#LBNA_Dummy+29)
 ;/* (WORD) Column fill pen. (V47) */

;/* v45 AllocLBColumnInfo(), SetLBColumnInfo(), GetLBColumnInfo()
; * attributes.
; */

#LBCIA_MemPool = (#LBNA_Dummy+50)
 ;/* (APTR) (V45) MemPool for ColumnInfo */

#LBCIA_Column = (#LBNA_Dummy+51)

#LBCIA_Title = (#LBNA_Dummy+52)

#LBCIA_Weight = (#LBNA_Dummy+53)

#LBCIA_Width = (#LBNA_Dummy+54)

#LBCIA_Flags = (#LBNA_Dummy+55)

#LBNCA_SoftStyle = (#LBNA_Dummy+56) ;/* OS4ONLY */

#LBCIA_UserData = (#LBNA_Dummy+57)
    ;/* (APTR) User data */

#LBCIA_AutoSort = (#LBNA_Dummy+58)
    ;/* (BOOL) Automatically sort this column */

#LBCIA_SortDirection = (#LBNA_Dummy+59)
    ;/* (ULONG) Direction of the sort */

#LBCIA_CompareHook = (#LBNA_Dummy+60)
    ;/* (struct Hook *) Sort comparison hook */

#LBCIA_Sortable = (#LBNA_Dummy+61)
    ;/* (BOOL) Column is sortable */

#LBCIA_DraggableSeparator = (#LBNA_Dummy+62)

#LBCIA_Separator = (#LBNA_Dummy+63)

#LBCIA_SortArrow = (#LBNA_Dummy+64)
    ;/* (BOOL) Column has a sort arrow. (V47 and V53.17) */

#LBCIA_CopyTitle = (#LBNA_Dummy+65) ;/* OS4ONLY */

#LBCIA_SoftStyle = (#LBNA_Dummy+66) ;/* OS4ONLY */

#LBCIA_HorizJustify = (#LBNA_Dummy+67) ;/* OS4ONLY */

;/* Flags for the LBNA_Flags node attribute.
; */
#LBFLG_READONLY = 1
#LBFLG_CUSTOMPENS = 2
#LBFLG_HASCHILDREN = 4
#LBFLG_SHOWCHILDREN = 8
#LBFLG_HIDDEN = 16


;/* Justification modes for the LBNCA_HorizJustify (aka LBNCA_Justification)
; *  node column attribute.
; */
#LCJ_LEFT = 0
#LCJ_CENTER = 1
#LCJ_RIGHT = 2
#LCJ_CENTRE = #LCJ_CENTER


;/* Justification modes for the LBNCA_VertJustify node column attribute.
; */
#LRJ_BOTTOM = 0
#LRJ_CENTER = 1
#LRJ_TOP = 2
#LRJ_CENTRE = #LRJ_CENTER


;/* These definitions are for the LBNCA_RenderHook tag.
; */

;/* The different types of messages that a listview callback hook can see.
; */
#LB_DRAW = $202     ;/* Draw yourself, with state */

;/* Possible return values from a render hook.
; */
#LBCB_OK = 0     ;/* callback understands this message type */
#LBCB_UNKNOWN = 1     ;/* callback does not understand this message */

;/* States for LBDrawMsg.lbdm_State.
; */
#LBR_NORMAL = 0     ;/* The usual */
#LBR_SELECTED = 1     ;/* For selected gadgets */

;/* Structure of LB_DRAW messages, object is a (struct Node *).
; */
NEWTYPE.LBDrawMsg
lbdm_MethodID.l ;    ;/* LV_DRAW */
*lbdm_RastPort.RastPort ;   ;/* Where to render to */
*lbdm_DrawInfo.DrawInfo ;   ;/* Useful to have around */
lbdm_Bounds.Rectangle ;   ;/* Limits of where to render */
lbdm_State.l ;     ;/* How to render */
End NEWTYPE


NEWTYPE.lbsm_UserDataA
Integer.l
Text.l
End NEWTYPE

NEWTYPE.lbsm_UserDataB
Integer.l
Text.l
End NEWTYPE

;/* Sort Hook Data Structure.
; */
NEWTYPE.LBSortMsg
lbsm_TypeA.l 
lbsm_UserDataA.l

lbsm_TypeB.l
lbsm_UserDataB.l

lbsm_Column.w;     ;/* Column number */
lbsm_Direction.l;  ;/* Sort direction */
End NEWTYPE



;/*****************************************************************************/

;/* Information for columns of the list browser.
; */
NEWTYPE.ColumnInfo
ci_Width.w 
ci_Title.l 
ci_Flags.l 
End NEWTYPE

;/* Possible ColumnInfo Flags
; */
#CIF_WEIGHTED = 0 ;/* weighted width column */
#CIF_FIXED = 1 ;/* fixed pixel width column */
#CIF_DRAGGABLE = 2
#CIF_NOSEPARATORS = 4
#CIF_SORTABLE = 8
#CIF_CENTER = 16 ;/* V47 */
#CIF_RIGHT = 32 ;/* V47 */
#CIF_CENTRE = #CIF_CENTER

;/*****************************************************************************/

