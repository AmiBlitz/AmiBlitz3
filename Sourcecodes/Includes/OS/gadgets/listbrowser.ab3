#LISTBROWSER_Bottom = (#LISTBROWSER_Dummy+57) ;/* OS4ONLY */

#LISTBROWSER_MakeNodeVisible = (#LISTBROWSER_Dummy+58) ;/* OS4ONLY */

#LISTBROWSER_AutoVirtualWidth = (#LISTBROWSER_Dummy+59) ;/* OS4ONLY */

#LISTBROWSER_HintInfoHook = (#LISTBROWSER_Dummy+60) ;/* OS4ONLY */

#LISTBROWSER_SortColumn = (#LISTBROWSER_Dummy+61)
    ;/* (WORD) Column number to sort */

#LISTBROWSER_Striping = (#LISTBROWSER_Dummy+62)
 ;/* (ULONG) Striping effects. See below for defines. (V47) */

#LISTBROWSER_AllowNoSelection = (#LISTBROWSER_Dummy+63) ;/* OS4ONLY */

#LISTBROWSER_AutoWheel = (#LISTBROWSER_Dummy+64)
 ;/* (BOOL) Whether gadget should handle mouse wheel movements (V47) */

#LISTBROWSER_StayActive = (#LISTBROWSER_Dummy+65)
    ;/* (BOOL) Try harder not to give up keyboard focus (V47) */

#LISTBROWSER_EditTrigger = (#LISTBROWSER_Dummy+66)
