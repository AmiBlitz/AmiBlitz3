 ;/* (struct Image *) Custom checkbox image, Checked state. */

#LISTBROWSER_UncheckedImage = (#LISTBROWSER_Dummy+43)
 ;/* (struct Image *) Custom checkbox image, UnChecked state. */

#LISTBROWSER_TotalNodes = (#LISTBROWSER_Dummy+44)
