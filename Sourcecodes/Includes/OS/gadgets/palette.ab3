CNIF @#GADGETS_PALETTE_H=0 
#GADGETS_PALETTE_H = 1
;/*
;**	$VER: palette.h 47.4 (22.7.2021)
;**
;**	Definitions for the Palette BOOPSI class
;**
;**	Copyright (C) 2019-2022 Hyperion Entertainment CVBA.
;**	    Developed under license.
;*/

;/*****************************************************************************/

CNIF @#REACTION_REACTION_H=0 
INCLUDE "reaction/reaction.ab3" 
CEND 

CNIF @#INTUITION_GADGETCLASS_H=0 
INCLUDE "intuition/gadgetclass.ab3" 
CEND 

;/*****************************************************************************/

;/* Additional attributes defined by the Palette class
; */
#PALETTE_Dummy = (#REACTION_Dummy+$0004000)

#PALETTE_Colour = (#PALETTE_Dummy+1)
	;/* (UWORD) The value in the gadget.  Defaults to 0. */

#PALETTE_ColourOffset = (#PALETTE_Dummy+2)
	;/* (UWORD) Maximum number of characters for the numer (including
;	 * negative sign.  Defaults to 10. */

#PALETTE_ColourTable = (#PALETTE_Dummy+3)
        ;/* (UWORD *) Pointer to a table of pen numbers indicating which colors
;         *           should be used and edited by the palette gadget. */

#PALETTE_NumColours = (#PALETTE_Dummy+4)
	;/* (UWORD) Maximum value for the number. */

#PALETTE_MinColours = (#PALETTE_Dummy+5) ;/* OS4ONLY */

#PALETTE_RenderHook = (#PALETTE_Dummy+7)
	;/* (struct Hook *) Render hook for palette boxes. Defaults to NULL. */

;/*****************************************************************************/

;/* The different types of messages that a palette callback hook can see */
#PB_DRAW = $202  ;/* Draw yourself, with state */

;/* Possible return values from a callback hook */
#PBCB_OK = 0  ;/* Callback understands this message type    */
#PBCB_UNKNOWN = 1  ;/* Callback does not understand this message */

;/* States for PBoxDrawMsg.pbdm_State */
#PBR_NORMAL = 0  ;/* Unselected box */
#PBR_SELECTED = 1  ;/* Selected (active) box */
#PBR_NORMALDISABLED = 2  ;/* Disabled unselected box */
#PBR_SELECTEDDISABLED = 8  ;/* Disabled selected (active) box */

;/* Messages received by a palette callback hook */
NEWTYPE.PBoxDrawMsg
pbdm_MethodID.l ;  ;/* PB_DRAW */
*pbdm_RastPort.RastPort ;  ;/* Where to render to */
*pbdm_DrawInfo.DrawInfo ;  ;/* Useful to have around */
pbdm_Bounds.Rectangle ;    ;/* Limits of where to render */
pbdm_State.l ;     ;/* How to render */
pbdm_Color.l ;     ;/* Color index in palette */
*pbdm_Gadget.Gadget ;    ;/* The palette gadget */
End NEWTYPE

;/*****************************************************************************/

;/* American spellings.
; */
#PALETTE_Color = #PALETTE_Colour
#PALETTE_ColorOffset = #PALETTE_ColourOffset
#PALETTE_ColorTable = #PALETTE_ColourTable
#PALETTE_NumColors = #PALETTE_NumColours

CEND ;/* GADGETS_PALETTE_H */
