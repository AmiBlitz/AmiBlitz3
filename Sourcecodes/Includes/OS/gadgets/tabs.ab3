INCLUDE "utility/tagitem.ab3" 
CEND 

CNIF @#INTUITION_GADGETCLASS_H=0 
INCLUDE "intuition/gadgetclass.ab3" 
CEND 

;/*****************************************************************************/

#TL_TEXTPEN = 0
#TL_BACKGROUNDPEN = 1
#TL_FILLTEXTPEN = 2
#TL_FILLPEN = 3
#MAX_TL_PENS = 4

;/*****************************************************************************/

;/* This structure is used to describe the labels for each of the tabs */
NEWTYPE.tagTabLabel
    tl_Label.l;		;/* Label */
    tl_Pens.w[#MAX_TL_PENS];	;/* Pens */
    *tl_Attrs.TagItem
End NEWTYPE 
;SHARED TabLabel.tagTabLabel
;SHARED *TabLabelP.TagTabLabel

;/*****************************************************************************/

;/* Additional attributes defined by the tabs.gadget class */
#TABS_Dummy = (#TAG_USER+$04000000)

#TABS_Labels = (#TABS_Dummy+1)
    ;/* (TabLabelP) Array of labels */

#TABS_Current = (#TABS_Dummy+2)
    ;/* (LONG) Current tab */

;/*****************************************************************************/

CEND ;/* GADGETS_TABS_H */
