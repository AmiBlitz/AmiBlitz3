CNIF @#REACTION_REACTION_H=0 
INCLUDE "reaction/reaction.ab3" 
CEND 

CNIF @#INTUITION_GADGETCLASS_H=0 
INCLUDE "intuition/gadgetclass.ab3" 
CEND 

;/*****************************************************************************/

;/* Defines for the speedbar node attributes.
; */
#SBNA_Dummy = (#TAG_USER+$010000)

#SBNA_Left = (#SBNA_Dummy+1)
	;/* (WORD) left offset of button. */

#SBNA_Top = (#SBNA_Dummy+2)
	;/* (WORD) top offset of button. */

#SBNA_Width = (#SBNA_Dummy+3)
	;/* (WORD) width of button. */

#SBNA_Height = (#SBNA_Dummy+4)
	;/* (WORD) height of button. */

#SBNA_UserData = (#SBNA_Dummy+5)
	;/* (APTR) user data, have a blast. */

#SBNA_Enabled = (#SBNA_Dummy+6)
	;/* (BOOL) Is this button enabled?. */

#SBNA_Spacing = (#SBNA_Dummy+7)
	;/* (WORD) spacing from last button. */

#SBNA_Highlight = (#SBNA_Dummy+8)
	;/* (WORD) highlight mode (see below). */

#SBNA_Image = (#SBNA_Dummy+9)
	;/* (strcut Image *) render image pointer. */

#SBNA_SelImage = (#SBNA_Dummy+10)
	;/* (strcut Image *) select image pointer. */

#SBNA_Help = (#SBNA_Dummy+11)
	;/* (UBYTE *) optional help text message pointer. */

#SBNA_Toggle = (#SBNA_Dummy+12)
	;/* (BOOL) Make button a toggle button */

#SBNA_Selected = (#SBNA_Dummy+13)
	;/* (BOOL) Sets state of a toggle button */

#SBNA_MXGroup = (#SBNA_Dummy+14)
	;/* (BOOL) Mutual Exclusion Group Button, implies SBNA_Toggle */

#SBNA_Disabled = (#SBNA_Dummy+15)
	;/* (BOOL) Disable this button, ghost pattern to be rendered */

#SBNA_Text = (#SBNA_Dummy+16)
	;/* (STRPTR) Label to display below the image. (V45) */

#SBNA_Spacer = (#SBNA_Dummy+17) ;/* OS4ONLY */

#SBNA_Separator = (#SBNA_Dummy+18) ;/* OS4ONLY */

#SBNA_HintInfo = (#SBNA_Dummy+19) ;/* OS4ONLY */

#SBNA_ButtonID = (#SBNA_Dummy+20) ;/* OS4ONLY */

;/* Possible highlight modes.
; */
#SBH_NONE = 0
#SBH_BACKFILL = 1
#SBH_RECESS = 2
#SBH_IMAGE = 3

;/*****************************************************************************/

;/* Additional attributes defined by the speedbar.gadget class
; */
#SPEEDBAR_Dummy = (#REACTION_Dummy + $13000)

#SPEEDBAR_Buttons = (#SPEEDBAR_Dummy+1)
	;/* (struct List *) button list */

#SPEEDBAR_Orientation = (#SPEEDBAR_Dummy+2)
	;/* (WORD) Horizontal/vertical mode */

#SPEEDBAR_Background = (#SPEEDBAR_Dummy+3)
	;/* (UWORD) SpeedBar Background color */

#SPEEDBAR_Window = (#SPEEDBAR_Dummy+4)
	;/* (struct Window *) Window for WindowBar help */

#SPEEDBAR_StrumBar = (#SPEEDBAR_Dummy+5)
	;/* (BOOL) Allow struming of button bar */

#SPEEDBAR_OnButton = (#SPEEDBAR_Dummy+6)
	;/* (WORD) Turn on a button by id# */

#SPEEDBAR_OffButton = (#SPEEDBAR_Dummy+7)
	;/* (WORD) Turn off a button by id# */

#SPEEDBAR_ScrollLeft = (#SPEEDBAR_Dummy+8)
	;/* (WORD) Scroll buttons left */

#SPEEDBAR_ScrollRight = (#SPEEDBAR_Dummy+9)
	;/* (WORD) Scroll buttons right */

#SPEEDBAR_Top = (#SPEEDBAR_Dummy+10)
	;/* (WORD) Index of first visible button */

#SPEEDBAR_Visible = (#SPEEDBAR_Dummy+11)
	;/* (WORD) Number of visible buttons */

#SPEEDBAR_Total = (#SPEEDBAR_Dummy+12)
	;/* (WORD) Total number of buttons in list */

#SPEEDBAR_Help = (#SPEEDBAR_Dummy+13)
	;/* (STRPTR) Window/Screen Help Text */

#SPEEDBAR_BevelStyle = (#SPEEDBAR_Dummy+14)
	;/* (WORD) Bevel box style (BVS_BUTTON,BVS_THIN,BVS_NONE) */

#SPEEDBAR_Selected = (#SPEEDBAR_Dummy+15)
	;/* (STRPTR) last selected speedbar node number */

#SPEEDBAR_SelectedNode = (#SPEEDBAR_Dummy+16)
	;/* (STRPTR) last selected speedbar node pointer */

#SPEEDBAR_EvenSize = (#SPEEDBAR_Dummy+17)
	;/* (BOOL) size all buttons in bar evenly, using the largest image */

#SPEEDBAR_Font = (#SPEEDBAR_Dummy+18)
	;/* (struct TextFont *) Font to use for SBNA_Text labels (V45) */

#SPEEDBAR_TopNode = (#SPEEDBAR_Dummy+19) ;/* OS4ONLY */

#SPEEDBAR_ButtonType = (#SPEEDBAR_Dummy+20) ;/* OS4ONLY */

#SPEEDBAR_HorizPadding = (#SPEEDBAR_Dummy+21) ;/* OS4ONLY */

#SPEEDBAR_VertPadding = (#SPEEDBAR_Dummy+22) ;/* OS4ONLY */

#SPEEDBAR_ButtonBevelStyle = (#SPEEDBAR_Dummy + $801)
;/* (WORD) Bevel box style of unselected buttons (BVS_BUTTON,BVS_THIN,BVS_NONE)
; * It defaults to BVS_BUTTON, and selected is always BVS_BUTTON. (V47)
; */

;/*****************************************************************************/

#SBM_SETNODEATTRS = ($58000A) ;/* OS4ONLY */

NEWTYPE.sbSetNodeAttrs
MethodID.l ;    ;/* SBM_SETNODEATTRS */
*sb_GInfo.GadgetInfo 
*sb_Node.Node ;     ;/* node whose attributes
;                                        you are changing. */
*sb_AttrList.TagItem ; ;/* list of attributes to change. */
End NEWTYPE

;/*****************************************************************************/

;/* SPEEDBAR_Orientation Modes
; */
#SBORIENT_HORIZ = 0
#SBORIENT_VERT = 1

;/* OBSOLETE DO NOT USE.
; */
#SPEEDBAR_HORIZONTAL = #SBORIENT_HORIZ
#SPEEDBAR_VERTICAL = #SBORIENT_VERT

;/*****************************************************************************/

#SBTYPE_BOTH = 0 ;/* OS4ONLY */
#SBTYPE_TEXT = 1 ;/* OS4ONLY */
#SBTYPE_IMAGE = 2 ;/* OS4ONLY */

CEND ;/* GADGETS_SPEEDBAR_H */
