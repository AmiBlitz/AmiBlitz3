INCLUDE"exec/libraries.ab3" 
CEND 
CNIF @#EXEC_TASKS_H=0 
INCLUDE"exec/tasks.ab3" 
CEND 

CNIF @#DEVICES_PARALLEL_H=0 
INCLUDE"devices/parallel.ab3" 
CEND 
CNIF @#DEVICES_SERIAL_H=0 
INCLUDE"devices/serial.ab3" 
CEND 
CNIF @#DEVICES_TIMER_H=0 
