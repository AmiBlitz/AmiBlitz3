; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = ""
; ExeFile         = ""
; CreateIcon      = 1
; Residents       = ""
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 0
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 0
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 1
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 1
; CursorColumn    = 1
; LabelSearch     = ""
; LabelRemark     = 0
; LabelAll        = 0
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max Shape       = 100
; Max Bank        = 5
; Max MenuList    = 5
; Max GTList      = 20
; Max Palette     = 4
; Max BitMap      = 10
; Max Screen      = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Window      = 20
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max Req-Lib     = 5
; Max GTMenuList  = 5
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max Page        = 4
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; /XTRA
CNIF @#DEVICES_TRACKFILE_H=0 
#DEVICES_TRACKFILE_H = 1

;/*
;** $VER: trackfile.h 2.10 (15.8.2020)
;**
;** A trackdisk.device which uses ADF disk image files
;*/

CNIF @#DOS_DOS_H=0 
INCLUDE"dos/dos.ab3" 
CEND 

CNIF @#DEVICES_TRACKDISK_H=0 
INCLUDE"devices/trackdisk.ab3" 
CEND 

CNIF @#UTILITY_TAGITEM_H=0 
INCLUDE"utility/tagitem.ab3" 
CEND 

;/****************************************************************************/

;/* You can always open the control unit in order to use
; * the device's library functions.
; */
#TFUNIT_CONTROL = (-1)

;/****************************************************************************/

;/* The name of the device. */
Macro TRACKFILENAME : "trackfile.device" :End Macro

;/****************************************************************************/

;/* If you want TFStartUnitTagList() to pick the next unused
; * unit number instead of a specific unit number, use this
; * special unit number instead.
; */
#TFSU_NextAvailableUnit = (-1)

;/****************************************************************************/

;/* Errors that may be returned by TFStartUnitTagList(), TFStopUnitTagList(),
; * TFInsertMediaTagList() and TFEjectMediaTagList().
; */
#TFERROR_UnitBusy = (-202041)
#TFERROR_OutOfMemory = (-202042)
#TFERROR_UnitNotFound = (-202043)
#TFERROR_AlreadyInUse = (-202044)
#TFERROR_UnitNotActive = (-202045)
#TFERROR_InvalidFile = (-202046)
#TFERROR_InvalidFileSize = (-202047)
#TFERROR_NoFileGiven = (-202048)
#TFERROR_Aborted = (-202049)
#TFERROR_InvalidDriveType = (-202050)
#TFERROR_ProcessFailed = (-202051)
#TFERROR_NoMediumPresent = (-202052)
#TFERROR_ReadOnlyVolume = (-202053)
#TFERROR_ReadOnlyFile = (-202054)
#TFERROR_DuplicateDisk = (-202055)
#TFERROR_DuplicateVolume = (-202056)
#TFERROR_Denied = (-202057)
#TFERROR_NotSupported = (-202058)

;/****************************************************************************/

#TF_Dummy = (#TAG_USER + $20200400)

;/****************************************************************************/

;/* Tags for use with TFStartUnitTagList(), TFStopUnitTagList(),
; * TFInsertMediaTagList() and TFEjectMediaTagList().
; */
#TF_ImageFileName = (#TF_Dummy + 1)	;/* (STRPTR) */
#TF_ImageFileHandle = (#TF_Dummy + 2)	;/* (BPTR) */
#TF_WriteProtected = (#TF_Dummy + 3)	;/* (BOOL) */
#TF_DriveType = (#TF_Dummy + 4)	;/* (LONG) */
#TF_Timeout = (#TF_Dummy + 5)	;/* (LONG) */
#TF_EnableChecksums = (#TF_Dummy + 6)	;/* (BOOL) */
#TF_TagItemFailed = (#TF_Dummy + 7)	;/* (struct TagItem **) */
#TF_MaxCacheMemory = (#TF_Dummy + 8)	;/* (ULONG) */
#TF_EnableUnitCache = (#TF_Dummy + 9)	;/* (ULONG) */
#TF_PrefillUnitCache = (#TF_Dummy + 10)	;/* (BOOL) */

;/***************************************************************************/

;/* Ask TFGetUnitData() to return information about all units. */
#TFGUD_AllUnits = (-1)

;/***************************************************************************/

;/* TFExamineFileSize() will return the drive type (e.g. DRIVE3_5, from
; * <devices/trackdisk.h>) associated with the size of an Amiga disk image
; * file, if possible. In any other case it will indicate that the file size
; * does not match a supported drive type.
; */
#TFEFS_Unsupported = (-1)

;/***************************************************************************/

;/* The minimum cache size is 8 tracks, which comes down to about
; * 46,000 bytes and should be sufficient for the root directory,
; * the boot block area, the bitmap blocks or a few directory
; * entries.
; */
#TF_MINIMUM_CACHE_SIZE = (46000)

;/***************************************************************************/

;/* The disk checksum maintained (optionally) by trackfile.device
; * is a 64 bit unsigned integer.
; */
NEWTYPE.TrackFileChecksum
tfc_high.l 
tfc_low.l 
End NEWTYPE

;/***************************************************************************/

;/* Forward declaration */
NEWTYPE.TrackFileUnitData
;/* Read-only linked list of unit information data
; * returned by TFGetUnitData(), and to be released
; * by TFFreeUnitData().
; */

	;/* Information about the next unit, or NULL */
*tfud_Next.TrackFileUnitData 
	;/* Size of this structure; for future extension */
tfud_Size.l 

	;/* Which number is associated with this unit */
tfud_UnitNumber.l 
	;/* Which type of drive is this? See <devices/trackdisk.h> */
tfud_DriveType.l 

	;/* The name of the AmigaDOS device, e.g. DA0; can be NULL */
tfud_DeviceName.l ;	
	;/* The path and name of the disk image file; can be NULL */
tfud_FileName.l 

	;/* Is the unit Process active? */
tfud_IsActive.b
	;/* Is a writable medium present? */	
tfud_IsWritable.b 
	;/* Is a storage medium present? */
tfud_MediumIsPresent.b 
	;/* Is data being read or written right now? */
tfud_IsBusy.b

	;/* Are the disk and track checksums current? */
tfud_ChecksumsEnabled.b
	;/* Current disk checksum, if enabled. */
tfud_Checksum.TrackFileChecksum 

	;/* Are the volume attributes valid? */
tfud_VolumeValid.b
	;/* Name of the volume, if valid */
tfud_VolumeName.b[32]
	;/* Volume creation date and time, if valid */
tfud_VolumeDate.DateStamp 
	;/* Disk file system signature, if valid and available; can be zero */
tfud_FileSysSignature.l 
	;/* Disk boot block checksum, if valid and available; can be zero */
tfud_BootBlockChecksum.l 

	;/* Is a cache enabled for this unit? */
tfud_CacheEnabled.b 
	;/* Total number of cache accesses since unit was started */
tfud_CacheAccesses.l 
	;/* Total number of cache misses since unit was started */
tfud_CacheMisses.l 
End NEWTYPE

;/***************************************************************************/

CEND ;/* DEVICES_TRACKFILE_H */
