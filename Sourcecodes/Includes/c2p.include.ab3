;-- Helper Macros:
Macro __C2PBase_SaveRegs
MOVE.l a4,-(a7) : MOVE.l a5,-(a7) : MOVE.l a6,-(a7) : MOVE.l d7,-(a7)
End Macro

Macro __C2PBase_RestoreRegs
MOVE.l (a7)+,d7 : MOVE.l (a7)+,a6 : MOVE.l (a7)+,a5 : MOVE.l (a7)+,a4
End Macro


; Wrapper Macros:
Macro C2P_AllocMem;{ret.l,context,bytesize}
!__C2PBase_SaveRegs
GetReg a0,`2
GetReg d0,`3
GetReg a6,*_C2PBase
JSR _LVO_C2PBASE_C2P_AllocMem(a6)
!__C2PBase_RestoreRegs
`1 = PutD0
End Macro

