; Open/Close Library:
Function.l c2p_OpenLib{@minVersion.l}
If (*_C2PBase)
  If (minVersion<=*_C2PBase\lib_Version) Then Function Return *_C2PBase
  CloseLibrary_ *_C2PBase : *_C2PBase = 0
End If
If minVersion<0 Then minVersion = 0
*_C2PBase = OpenLibrary_ ("c2p.library",minVersion)
If *_C2PBase
  ; (!) Do some other init stuff here...
Else
  If (minVersion>0)
    error{"Unable to open c2p.library (v"+Str$(minVersion)+"+)!"}
  Else
    error{"Unable to open c2p.library!"}
  End If
End If
Function Return *_C2PBase
End Function

Statement c2p_CloseLib{}
If *_C2PBase
  ; (!) Do some freeing stuff here that you inited in _C2PBase_Init{}...
  CloseLibrary_ *_C2PBase : *_C2PBase = 0
End If
End Statement
!autoexit{c2p_CloseLib}


; Wrapper Functions:
Function.l C2P_AllocMem{_context.l,_bytesize.l}
