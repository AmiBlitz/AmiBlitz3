JSR _LVO_CLICKTABBASE_FreeClickTabNode(a6)
!__ClickTabBase_RestoreRegs
`1 = PutD0
End Macro

Macro clicktab_SetClickTabNodeAttrsA;{ret.l,node,tags}
!__ClickTabBase_SaveRegs
GetReg a0,`2
GetReg a1,`3
GetReg a6,*ClickTabBase
JSR _LVO_CLICKTABBASE_SetClickTabNodeAttrsA(a6)
!__ClickTabBase_RestoreRegs
`1 = PutD0
End Macro

Macro clicktab_GetClickTabNodeAttrsA;{ret.l,node,tags}
!__ClickTabBase_SaveRegs
GetReg a0,`2
GetReg a1,`3
GetReg a6,*ClickTabBase
JSR _LVO_CLICKTABBASE_GetClickTabNodeAttrsA(a6)
!__ClickTabBase_RestoreRegs
`1 = PutD0
End Macro


; Open/Close Library:
Function.l clicktab_OpenLib{@minVersion.l}
If (*ClickTabBase)
  If (minVersion<=*ClickTabBase\lib_Version) Then Function Return *ClickTabBase
  CloseLibrary_ *ClickTabBase : *ClickTabBase = 0
End If
If minVersion<0 Then minVersion = 0
*ClickTabBase = OpenLibrary_ ("clicktab.library",minVersion)
If *ClickTabBase
  ; (!) Do some other init stuff here...
Else
  If (minVersion>0)
    error{"Unable to open clicktab.library (v"+Str$(minVersion)+"+)!"}
  Else
    error{"Unable to open clicktab.library!"}
  End If
End If
Function Return *ClickTabBase
End Function

Statement clicktab_CloseLib?{}
If *ClickTabBase
  ; (!) Do some freeing stuff here that you inited in _ClickTabBase_Init{}...
  CloseLibrary_ *ClickTabBase : *ClickTabBase = 0
End If
End Statement
!autoexit{clicktab_CloseLib}


; Wrapper Functions:
Function.l CLICKTAB_GetClass{}
If (clicktab_OpenLib{}) ; (!) put your min version here if needed!
  !CLICKTAB_GetClass{result.l}
End If
Function Return result
End Function

