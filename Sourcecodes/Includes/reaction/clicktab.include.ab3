; Helper Macros:
Macro __ClickTabBase_SaveRegs
MOVE.l a4,-(a7) : MOVE.l a5,-(a7) : MOVE.l a6,-(a7) : MOVE.l d7,-(a7)
End Macro

Macro __ClickTabBase_RestoreRegs
MOVE.l (a7)+,d7 : MOVE.l (a7)+,a6 : MOVE.l (a7)+,a5 : MOVE.l (a7)+,a4
End Macro


; Wrapper Macros:
Macro CLICKTAB_GetClass;{ret.l}
!__ClickTabBase_SaveRegs
GetReg a6,*ClickTabBase
JSR _LVO_CLICKTABBASE_CLICKTAB_GetClass(a6)
!__ClickTabBase_RestoreRegs
`1 = PutD0
End Macro

Macro clicktab_AllocClickTabNodeA;{ret.l,tags}
!__ClickTabBase_SaveRegs
GetReg a0,`2
GetReg a6,*ClickTabBase
JSR _LVO_CLICKTABBASE_AllocClickTabNodeA(a6)
!__ClickTabBase_RestoreRegs
`1 = PutD0
End Macro

Macro clicktab_FreeClickTabNode;{ret.l,node}
!__ClickTabBase_SaveRegs
