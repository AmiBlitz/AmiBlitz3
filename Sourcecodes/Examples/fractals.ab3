; /XTRA
; Copyright 1987 Compute! Publications, Inc.
; All Rights Reserved.
; Port of the Compute! listing "Fractal Mountains" to AmiBlitz3
OPTIMIZE 5 : NoCli

;-- used for drawing
NEWTYPE.Polygon
  x0.w : y0.w
  x1.w : y1.w
  x2.w : y2.w
End NEWTYPE

;-- one palette entry, 8 bit per channel (0..255)
NEWTYPE.ColorRGB
  r.w
  g.w
  b.w
End NEWTYPE

#GRIDW = 64              ; number of grid cells in x direction (width)
#GRIDD = 128             ; number of grid cells in y direction (depth), must be a multiple of #GRIDW

;-- palette layout: colour 0 = background, 1 = water, then 3 bands of #SHADES brightness levels
#SHADES    = 10                   ; brightness levels per band
#COL_WATER = 1
#COL_GREEN = 2                    ; vegetation:  2..11
#COL_ROCK  = #COL_GREEN + #SHADES ; rock / soil: 12..21
#COL_SNOW  = #COL_ROCK + #SHADES  ; snow:        22..31

DEFTYPE.q
Dim heightMap.q(#GRIDW, #GRIDD)          ; height field, 65 x 129 grid points
Dim bandMap.b(#GRIDW - 1, #GRIDD - 1)    ; colour band of each cell (see CalcBands)
Dim cmap.ColorRGB(31)


;============================================================================================
; -- Brightness of a triangle (1 = dark .. 15 = bright) from the cell centre height (lvC)
; -- and its two corner heights h1, h2.
; -- Simplified but numerically identical form of the old getshade routine:
; -- xrun/yrun were always 0.5 there, so only this formula remains.
; -- The colour band (water, vegetation, rock, snow) is chosen by CalcBands / BandColour.
; -- FAST: local variables are not cleared -> s is always assigned first.
;============================================================================================
Function.q FAST GetLight{h1.q, h2.q, lvC.q}
  s.q = 14 / ((1 + Abs(lvC + lvC - h1 - h2) / 2) * (1 + Abs(h2 - h1) / 2)) + 1
  Function Return s
End Function


;============================================================================================
; -- Palette colour for a brightness (1..15) inside a colour band.
; -- band: first colour of the band (#COL_GREEN, #COL_ROCK, #COL_SNOW) or -1 for water
;============================================================================================
Function.w FAST BandColour{band.w, light.q}
  If band < 0 Then Function Return #COL_WATER
  col.w = band + Int((light - 1) * (#SHADES - 1) / 14)
  Function Return col
End Function


;============================================================================================
; -- Create the height field heightMap() with midpoint displacement.
; -- The field consists of #GRIDD / #GRIDW squares lying one behind the other,
; -- the first iteration (sk = 64) creates the midpoints of all of them.
; -- maxVar: maximum random variation (0 - 2)
; -- Returns the maximum height of the cell centres (used for the snow line).
;============================================================================================
Function.q MakeMount{maxVar.q}
SHARED heightMap()
  DEFTYPE.q ran, oLd, oLd1, oLd2, maxLv

  maxLv = 0
  For iter.b = 6 To 1 Step -1
    sk.w = 2 ^ iter          ; step width of this iteration: 64, 32, ... 2
    hL.w = sk / 2            ; half step

    ;-- tops & bottoms: midpoints of the horizontal edges
    For y.w = 0 To #GRIDD Step sk
      For x.w = hL To #GRIDW Step sk
        ran = (Rnd - 0.5) * maxVar * sk
        oLd = (heightMap(x - hL, y) + heightMap(x + hL, y)) / 2
        heightMap(x, y) = oLd + ran
      Next x
    Next y

    ;-- sides: midpoints of the vertical edges
    For x = 0 To #GRIDW Step sk
      For y = hL To #GRIDD Step sk
        ran = (Rnd - 0.5) * maxVar * sk
        oLd = (heightMap(x, y - hL) + heightMap(x, y + hL)) / 2
        heightMap(x, y) = oLd + ran
      Next y
    Next x

    ;-- centres: average of the two diagonals
    For x = hL To #GRIDW Step sk
      For y = hL To #GRIDD Step sk
        ran = (Rnd - 0.5) * maxVar * sk
        oLd1 = (heightMap(x + hL, y - hL) + heightMap(x - hL, y + hL)) / 2
        oLd2 = (heightMap(x - hL, y - hL) + heightMap(x + hL, y + hL)) / 2
        oLd = (oLd1 + oLd2) / 2
        heightMap(x, y) = oLd + ran
        If heightMap(x, y) > maxLv Then maxLv = heightMap(x, y)
      Next y
    Next x
  Next iter

  Function Return maxLv
End Function


BLITZ

;============================================================================================
; -- Set everything below 0 to water level and choose the colour band of every cell:
; --   centre height <= 0                            -> water
; --   centre height >  snowLine                     -> snow
; --   centre height <  vegLine and slope < maxSlope -> vegetation (green)
; --   everything else                               -> rock / soil (brown)
; -- vegJitter: random offset of vegLine per cell, so the borders of the green areas are frayed
;============================================================================================
Statement CalcBands{snowLine.q, vegLine.q, maxSlope.q, vegJitter.q}
SHARED heightMap(), bandMap()
  DEFTYPE.q h1, h2, h3, h4, c, slope, d

  ;-- everything below 0 is water
  For y.w = 0 To #GRIDD
    For x.w = 0 To #GRIDW
      If heightMap(x, y) < 0 Then heightMap(x, y) = 0
    Next x
  Next y

  For y = 0 To #GRIDD - 1
    For x = 0 To #GRIDW - 1
      h1 = heightMap(x, y)     : h2 = heightMap(x + 1, y)       ; back left, back right
      h3 = heightMap(x, y + 1) : h4 = heightMap(x + 1, y + 1)   ; front left, front right
      c = (h1 + h2 + h3 + h4) / 4

      ;-- slope = steepest edge of the cell
      slope = Abs(h1 - h2)
      d = Abs(h1 - h3) : If d > slope Then slope = d
      d = Abs(h4 - h2) : If d > slope Then slope = d
      d = Abs(h4 - h3) : If d > slope Then slope = d

      band.w = #COL_ROCK
      If c <= 0
        band = -1
      Else
        If c > snowLine
          band = #COL_SNOW
        Else
          If (c < vegLine + (Rnd - 0.5) * vegJitter) AND (slope < maxSlope) Then band = #COL_GREEN
        EndIf
      EndIf
      bandMap(x, y) = band
    Next x
  Next y
End Statement


;============================================================================================
; -- Draw the height field heightMap() back to front (painter's algorithm).
; -- Each grid cell is split into 4 triangles around its centre.
; -- CalcBands must have been called before.
; -- xm, ym  : horizontal / vertical scale per grid step
; -- xshift  : horizontal shear per row
; -- yp      : vertical offset
; -- hScale  : height scale (1 = original heights, larger = higher mountains)
; -- wire    : True = wireframe (only the grid lines, no filled areas, see-through)
;============================================================================================
Statement DrawMount{xm.q, ym.q, xshift.q, yp.q, hScale.q, wire.b}
SHARED heightMap(), bandMap()
  DEFTYPE.Polygon area
  DEFTYPE.q lvC, rx, ry, rx1, ry1, rx2, ry2, rx3, ry3, rx4, ry4
  DEFTYPE.q h1, h2, h3, h4

  For y.w = 0 To #GRIDD - 1
    For x.w = 0 To #GRIDW - 1
      h1 = heightMap(x, y)     : h2 = heightMap(x + 1, y)       ; back left, back right
      h3 = heightMap(x, y + 1) : h4 = heightMap(x + 1, y + 1)   ; front left, front right
      lvC = (h1 + h2 + h3 + h4) / 4
      band.w = bandMap(x, y)

      rx1 = xm * x       + xshift * y       : ry1 = ym * y       + yp - hScale * h1
      rx2 = xm * (x + 1) + xshift * y       : ry2 = ym * y       + yp - hScale * h2
      rx3 = xm * x       + xshift * (y + 1) : ry3 = ym * (y + 1) + yp - hScale * h3
      rx4 = xm * (x + 1) + xshift * (y + 1) : ry4 = ym * (y + 1) + yp - hScale * h4

      If wire
        ;-- wireframe: back and left edge of every cell, the right and front edges
        ;-- only for the last column / row (all other ones are drawn by the neighbour cells)
        Line rx1, ry1, rx2, ry2, BandColour{band, GetLight{h1, h2, lvC}}      ; back edge
        Line rx1, ry1, rx3, ry3, BandColour{band, GetLight{h3, h1, lvC}}      ; left edge
        If x = #GRIDW - 1 Then Line rx2, ry2, rx4, ry4, BandColour{band, GetLight{h2, h4, lvC}}
        If y = #GRIDD - 1 Then Line rx3, ry3, rx4, ry4, BandColour{band, GetLight{h4, h3, lvC}}
      Else
        ;-- centre of the cell
        rx = xm * (x + .5) + xshift * (y + .5)
        ry = ym * (y + .5) + yp - hScale * lvC

        area\x0 = rx  : area\y0 = ry           ; back triangle
        area\x1 = rx1 : area\y1 = ry1
        area\x2 = rx2 : area\y2 = ry2
        Polyf 3, &area, BandColour{band, GetLight{h1, h2, lvC}}

        area\x0 = rx  : area\y0 = ry           ; right triangle
        area\x1 = rx2 : area\y1 = ry2
        area\x2 = rx4 : area\y2 = ry4
        Polyf 3, &area, BandColour{band, GetLight{h2, h4, lvC}}

        area\x0 = rx  : area\y0 = ry           ; left triangle
        area\x1 = rx1 : area\y1 = ry1
        area\x2 = rx3 : area\y2 = ry3
        Polyf 3, &area, BandColour{band, GetLight{h3, h1, lvC}}

        area\x0 = rx  : area\y0 = ry           ; front triangle
        area\x1 = rx3 : area\y1 = ry3
        area\x2 = rx4 : area\y2 = ry4
        Polyf 3, &area, BandColour{band, GetLight{h4, h3, lvC}}
      EndIf
    Next x
  Next y
End Statement


;============================================================================================
; -- main program
;============================================================================================

;-- display parameters (feel free to experiment)
maxVar = 2.0      ; maximum variation (0 - 2), 1 looks nice
xm     = 4.5      ; horizontal scale: screen pixels per grid step in x direction
                  ; (64 steps * 4.5 = 288 pixels, plus shear = 304 of 320 pixels)
ym     = 1.0      ; vertical scale: screen lines per grid step in y direction (depth)
                  ; (128 steps * 1.0 = 128 lines, heights are subtracted on top)
                  ; smaller = view more from the side, larger = more top-down view
xshift = 0.125    ; horizontal shear per row (0 = straight front view, larger = more oblique)
                  ; (128 rows * 0.125 = 16 pixels, so the landscape stays inside 320 pixels)
yp     = 105      ; vertical offset of the back row (leaves room for the highest peaks)
hScale = 1.5      ; height scale: 1 = original heights, larger = higher mountains
                  ; (needed for a side view, otherwise the landscape looks flat)
wire.b = True     ; True = draw a wireframe (grid lines only, faster), False = filled areas

;-- start the randomize routine
RndSeed Timer

;-- init two output bitmaps for double buffering (draw into one, show the other)
BitMap 1,320,256,5
BitMap 0,320,256,5                 ; 5 bitplanes = 32 colours
Use BitMap 0                       ; bitmap 0 is used for the first picture

;-- build the colour map (8 bit per channel)
;-- each band runs linearly from its darkest to its brightest colour
cmap(0)\r = 0 : cmap(0)\g = 0 : cmap(0)\b = 0                               ; background
cmap(#COL_WATER)\r = 0 : cmap(#COL_WATER)\g = 64 : cmap(#COL_WATER)\b = 128 ; water
For i.w = 0 To #SHADES - 1
  f.q = i : f = f / (#SHADES - 1)          ; 0 = darkest .. 1 = brightest (calculated as quick, not integer)
  cmap(#COL_GREEN + i)\r = 20  + 100 * f   ; vegetation:  (20,50,10) .. (120,200,60)
  cmap(#COL_GREEN + i)\g = 50  + 150 * f
  cmap(#COL_GREEN + i)\b = 10  +  50 * f
  cmap(#COL_ROCK + i)\r  = 34  + 221 * f   ; rock / soil: (34,20,10) .. (255,153,76)
  cmap(#COL_ROCK + i)\g  = 20  + 133 * f
  cmap(#COL_ROCK + i)\b  = 10  +  66 * f
  cmap(#COL_SNOW + i)\r  = 100 + 155 * f   ; snow:        (100,100,110) .. (255,255,255)
  cmap(#COL_SNOW + i)\g  = 100 + 155 * f
  cmap(#COL_SNOW + i)\b  = 110 + 145 * f
Next

;-- transfer the colour map to the palette
InitPalette 0,32
For i = 0 To 31
  PalRGB 0, i, Int((cmap(i)\r + 8) / 17), Int((cmap(i)\g + 8) / 17), Int((cmap(i)\b + 8) / 17)
Next

;--
;-- init the screen
;--
Slice 0,44,5 : Show 0 : Use Palette 0

Mouse On : BlitzKeys On

;-- set bitmap 0 as output bitmap for print operations
BitMapOutput 0 : Locate 0,0 : Colour 15

maxLv = MakeMount{maxVar}

;-- colour bands, all relative to the highest point, because the heights are not normalised here
snowLine = maxLv - maxLv / 4    ; the top quarter of the height range is snow
vegLine  = maxLv * 0.35         ; vegetation grows below 35% of the maximum height ...
maxSlope = maxLv * 0.12         ; ... but only where the ground is not too steep
CalcBands{snowLine, vegLine, maxSlope, maxLv * 0.13}

Cls
DrawMount{xm, ym, xshift, yp, hScale, wire}

;-- wait for user interaction
Repeat
  VWait
Until Inkey$ <> "" OR Joyb(0) <> 0
End
