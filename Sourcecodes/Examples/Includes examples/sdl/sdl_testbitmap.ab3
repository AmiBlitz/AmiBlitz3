XINCLUDE "sdl.include.ab3"
XINCLUDE "sdl.res.ab3"

#picture_height = 32
#picture_width  = 32

Function.SDL_Surface LoadXBM{*scr.SDL_Surface, w.w, h.w, *bits.l}

  ;-- Allocate the bitmap
  *bmap.SDL_Surface = SDL_CreateRGBSurface{#SDL_SWSURFACE, w, h, 1, 0, 0, 0, 0}
  If *bmap = 0
    NPrint "Couldn't allocate bitmap: ",SDL_GetError{}
    End
  EndIf
 
  DEFTYPE.l i, j, buf, byte, res

  ;-- Copy the pixels
  *_line.l = *bmap\pixels
  w = (w + 7) / 8

  While ( h > 0 )
    h - 1
    CopyMem_ *bits, *_line, w
    ; X11 Bitmap images have the bits reversed
    ; line = Adresse des Zeilenpuffers, w = Anzahl Bytes
    buf = *_line
    For i = 0 To w - 1
      byte = Peek.b(buf) & $FF        ; & $FF, weil Peek.b vorzeichenbehaftet liest
      res  = 0
      For j = 7 To 0 Step -1
        res  = res | ((byte & $01) LSL j)
        byte = byte LSR 1
      Next j
      Poke.b buf, res
      buf = buf + 1
    Next i
    *_line + *bmap\pitch
    *bits + (.l)w
  Wend
  Function Return *bmap
End Function

; ==============================================================================

DEFTYPE.SDL_Surface *scr, *bmap

; -- Initialize SDL
If SDL_Init{#SDL_INIT_VIDEO} = 0
  NPrint "Init successful."
  NPrint "Quit successful."
Else
  NPrint "No success ", SDL_GetError{}
  Goto exit
EndIf

video_bpp.b = 8
videoflags.l = #SDL_SWSURFACE | #SDL_ANYFORMAT | #SDL_HWSURFACE | #SDL_DOUBLEBUF ; | #SDL_FULLSCREEN
; -- Set 640x480 video mode
*scr = SDL_SetVideoMode{640, 480, video_bpp, videoflags}
If *scr = 0
  NPrint  "Couldn't set 640x480x",video_bpp," video mode: ", SDL_GetError{}
  Goto exit
EndIf
NPrint "SetVideoMode OK"

; -- Set the surface pixels and refresh!
If SDL_LockSurface{*scr} < 0
  NPrint "Couldn't lock the display surface: ", SDL_GetError{}
  Goto exit
EndIf
*buf.l = *scr\pixels
For i.l = 1 To *scr\h-1
  FillMem *buf, *scr\pitch, (i * 255) / *scr\h
  *buf + *scr\pitch
Next i
SDL_UnlockSurface{*scr}
SDL_UpdateRect{*scr, 0, 0, 0, 0}

; -- Load the bitmap
*bmap = LoadXBM{*scr, #picture_width, #picture_height, ?picture_bits}
If *bmap = 0
   Goto exit
EndIf

;-- Wait for a keystroke
DEFTYPE.SDL_Event sdlevent
DEFTYPE.SDL_Rect dst 
done.b = 0
While NOT done
    ;-- Check for events
    While SDL_PollEvent{&sdlevent} AND (done = False)
      Select sdlevent\_type
      Case #SDL_MOUSEBUTTONDOWN
        dst\x = Rnd(620);sdlevent\button\x; - *bmap\w / 2
        dst\y = Rnd(460);sdlevent\button\y; - *bmap\h / 2

        dst\w = *bmap\w
        dst\h = *bmap\h
        ;NPrint dst\x," ",dst\y
        SDL_BlitSurface{*bmap, 0, *scr, &dst}
        SDL_UpdateRects{*scr, 1, &dst}

      Case #SDL_KEYDOWN
        ;-- Any key press quits the app...
        done = True

      Case #SDL_QUIT
        done = True

      End Select
    Wend
Wend

exit:
SDL_Quit{}
End

picture_bits:
Data.b $00, $00, $00, $00   ; ................................
Data.b $00, $00, $00, $00   ; ................................
