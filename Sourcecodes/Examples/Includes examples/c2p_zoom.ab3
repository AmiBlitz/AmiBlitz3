; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = "//Bin"
; ExeFile         = "c2p_zoom"
; CreateIcon      = 0
; Residents       = "all.res,usefullmacs.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 1
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 48
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 0
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 212
; CursorColumn    = 1
; LabelSearch     = ""
; LabelRemark     = 140
; LabelAll        = 5
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max Shape       = 100
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 20
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 5
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 4
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; Max Window      = 20
; /XTRA
OPTIMIZE 5  ; we could optimize For fpu if we want (7)
SYNTAX 6    ; not really needed, but always a good choice!

WBStartup

XINCLUDE "c2p.include.ab3"
;-- 
;--   This example will operate on every pixel of the image. The idea is that a
;--   pixel in the next frame gets a neighbor pixel from the previous frame, from
;--   center to the borders.
;-- 
;--   The effect can represented using two arrays of displacements, For X and Y
;--   coords, in which store the displacement of the current pixel from the
;--   previous.
;-- 
;--   LEFT                       CENTER OF SCREEN                         RIGHT
;--   +---+---+---+---+---+---+---+---+---+---+---+---+---+---+---+---+---+---+
;--   | 3 | 3 | 2 | 2 | 2 | 1 | 1 | 1 | 0 | 0 |-1 |-1 |-1 |-2 |-2 |-2 |-3 |-3 |
;--   +---+---+---+---+---+---+---+---+---+---+---+---+---+---+---+---+---+---+
;-- 
;--   +-----------------------------------------+     +---+
;--   |                    ^                    |     | 2 |  TOP
;--   |                    ^                    |     +---+
;--   |                    ^                    |     | 1 |
;--   | <<<  <<  <<  <  <  0  >  >  >>  >>  >>> |     +---+
;--   |                    v                    |     | 1 |
;--   |                    v                    |     +---+
;--   |                    v                    |     | 0 |
;--   +-----------------------------------------+     +---+  MIDDLE OF SCREEN
;--                                                   | 0 |
;--                                                   +---+
;--                                                   |-1 |
;--                                                   +---+
;--                                                   |-1 |
;--                                                   +---+
;--                                                   |-2 |
;--                                                   +---+  BOTTOM
;-- 
;--   The effect is similar to a pinch zoom. On every frame a group of random
;--   pixels is drawn onto the screen. Using single pixels, the algorithm seems
;--   to be similare to a starfield, but it"snt. Maybe it"s worth to test the
;--   algorithm using a image.
;-- 
;--   This example is not optimized, please see the zoom-optimized.e source and
;--   compare the performances.
;-- 


#WIDTH         = 320
#HEIGHT        = 240
#PLANAR_FORMAT = #C2P_CONTEXT_PLANAR_FORMAT_4_BIT
#SPEED         = 32
#NUM_FRAMES    = 80

Statement setPalette{*vp.ViewPort}
  DEFTYPE.l i
  DEFTYPE.l r, g, b

  For i = 0 To 15
    r = i
    g = Max(0, i - 1)
    b = i / 4
    SetRGB4_ *vp, i, r, g, b
  Next
End Statement

Statement update{*c2pbuffer.l, *c2pchunky.l, *dx.l, *dy.l}
  DEFTYPE.l x, y
  DEFTYPE.l c
  DEFTYPE.l *c2pbuffer_row
  DEFTYPE.l *c2pchunky_row
  DEFTYPE.l *row
  DEFTYPE.l middle

  *c2pbuffer_row = *c2pbuffer
  *c2pchunky_row = *c2pchunky

  For y = 0 To #HEIGHT - 1
    tmp.l = Peek.b(*dy + y) * #WIDTH
    *row = *c2pchunky_row + tmp

    For x = 0 To #WIDTH - 1
      tmp.l = Peek.b(*dx + x)
      c = Peek.b(*row + x + tmp)
      Poke.b *c2pbuffer_row + x, c
    Next

    *c2pbuffer_row = *c2pbuffer_row + #WIDTH
    *c2pchunky_row = *c2pchunky_row + #WIDTH
  Next

  middle = (#WIDTH LSR 1) -1
  *row = *c2pbuffer + (#WIDTH * ((#HEIGHT LSR 1) - 1)) + middle
  Poke.b *row + 0, 0
  Poke.b *row + 1, 0
  *row = *row + #WIDTH
  Poke.b *row + 0, 0
  Poke.b *row + 1, 0

End Statement



; ====
DEFTYPE.l *context
DEFTYPE.l *c2pchunky
DEFTYPE.BitMap *bmap
DEFTYPE.Screen *scr
DEFTYPE.Window *win
DEFTYPE.l i
DEFTYPE.l *c2pbuffer
DEFTYPE.l *dx
DEFTYPE.l *dy
DEFTYPE.l x, y, c
DEFTYPE.l _step
DEFTYPE.l size
DEFTYPE.l *swap

DEFTYPE.l startsec, startmic
DEFTYPE.l seconds, micros
DEFTYPE.s fps_str
DEFTYPE.l frame_count
DEFTYPE.q fps

DEFTYPE.l error

size = #WIDTH * #HEIGHT
error = 0

*context = C2P_CreateContext{}
If *context
  NPrint "context created..."
  error = C2P_SetContextParameter{*context, #C2P_CONTEXT_PARAMETER_TYPE, #C2P_CONTEXT_TYPE_BITMAP}
  If error <> 0 Then Goto destroy_context

  error = C2P_SetContextParameter{*context, #C2P_CONTEXT_PARAMETER_WIDTH, #WIDTH}
  If error <> 0 Then Goto destroy_context

  error = C2P_SetContextParameter{*context, #C2P_CONTEXT_PARAMETER_HEIGHT, #HEIGHT}
  If error <> 0 Then Goto destroy_context

  error = C2P_SetContextParameter{*context, #C2P_CONTEXT_PARAMETER_PLANAR_FORMAT, #PLANAR_FORMAT}
  If error <> 0 Then Goto destroy_context

  If C2P_InitializeContext{*context} = 0
    NPrint "context initiated..."
    *bmap = C2P_GetContextParameter{*context, #C2P_CONTEXT_PARAMETER_BITMAP}
    *c2pchunky = C2P_GetContextParameter{*context, #C2P_CONTEXT_PARAMETER_CHUNKY}

    *c2pbuffer = C2P_AllocMem{*context, size}

    ;-> delta initialization
    *dx = C2P_AllocMem{*context, #WIDTH * 4}
    *dy = C2P_AllocMem{*context, #HEIGHT * 4}
    _step = 1
    i = 0
    For x = 0 To (#WIDTH / 2) - 2
      Poke.b *dx + #WIDTH / 2 - x - 2, _step
      Poke.b *dx + #WIDTH / 2 + x + 1, -_step
      i + 1
      If i >= #SPEED
        i = 0
        _step + 1
      EndIf
    Next

    _step = 1
    i = 0
    For y = 0 To (#HEIGHT / 2) - 2
      Poke.b *dy + #HEIGHT / 2 - y - 2, _step
      Poke.b *dy + #HEIGHT / 2 + y + 1,-_step
      i + 1
      If i >= #SPEED
        i = 0
        _step + 1
      EndIf
    Next

    *scr = OpenScreenTagList_ ( 0, VarArgs(@@
      #SA_Depth,       #PLANAR_FORMAT, @@
      #SA_Width,       #WIDTH, @@
      #SA_Height,      #HEIGHT, @@
      #SA_Title,       StrAddr("c2p.library"), @@
      #SA_ShowTitle,   False, @@
      #SA_Type,        #CUSTOMSCREEN | #CUSTOMBITMAP, @@
      #SA_BitMap,      *bmap, @@
      #SA_Exclusive,   True, @@
      #SA_Quiet,       True))

    If *scr <> 0
      *win = OpenWindowTagList_(0, VarArgs(@@
        #WA_IDCMP,           #IDCMP_CLOSEWINDOW | #IDCMP_VANILLAKEY, @@
        #WA_Top,             0,@@
        #WA_Left,            0,@@
        #WA_Width,           #WIDTH,@@
        #WA_Height,          #HEIGHT,@@
        #WA_CustomScreen,    *scr,@@
        #WA_Backdrop,        True,@@
        #WA_Borderless,      True,@@
        #WA_Flags,           #WFLG_RMBTRAP))

      If *win <> 0
        setPalette{*scr\ViewPort}
        ScreenToFront_ *scr
        ActivateWindow_ *win

        CurrentTime_ &startsec, &startmic
        frame_count = 0

        For i = 0 To #NUM_FRAMES

          RunErrsOff

          For _step = 0 To 10
            x = Rnd(#WIDTH)
            y = Rnd(#HEIGHT)
            c = Rnd(16)
            C2P_WritePixel{*context, x, y, c}
          Next

          update{*c2pbuffer, *c2pchunky, *dx, *dy}

          ;-> change chunky buffer source
          error = C2P_SetContextParameter{*context, #C2P_CONTEXT_PARAMETER_CHUNKY, *c2pbuffer}
          If error <> 0 Then Goto end_loop

          ;-> swap For next round
          *swap = *c2pchunky
          *c2pchunky = *c2pbuffer
          *c2pbuffer = *swap

          WaitTOF_
          C2P_Chunky2Planar{*context}

          RunErrsOn

          frame_count + 1
        Next
        end_loop:

        CurrentTime_ &seconds, &micros
        seconds = seconds - startsec
        Print "Total time = ",seconds, " seconds -> "
        If seconds
          fps = 1.0 * (frame_count / seconds)
          NPrint  fps, " frame per second..."
        EndIf

        CloseWindow_ *win
      EndIf
      CloseScreen_ *scr
    EndIf
  EndIf

destroy_context:
    C2P_DestroyContext{*context}
EndIf

If error <> 0
  NPrint "Got error: ", error
EndIf

NPrint "exit"
End
