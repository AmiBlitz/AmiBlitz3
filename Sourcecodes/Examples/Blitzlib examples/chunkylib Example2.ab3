; /XTRA
;********************************************************************
;         ChunkyToPlanar Example  by Giuseppe Perniola
;         E-Mail: perniolapa@bccsanteramo.it
;********************************************************************
;         This source is an example of ChunkyToPlanar command
;
;         ChunkyToPlanar is optimised for 020+ with FastRam
;********************************************************************
;NOTE:    The width of the Bitmap must be multiple of 32 (32-64...)
;         The height is not limited
;********************************************************************

NoCli
WBStartup

#width=160                           ; <= Width Bitmap and Chunky buffer
#height=128                          ; <= Height Bitmap and Chunky buffer
#planes=8                            ; <= Number of planes -> colors=2^planes

DEFTYPE.w a,x,y
DEFTYPE.q b,d
DEFTYPE.l c,e

BitMap 0,#width,#height,#planes      ; <= Initializes Bitmap
InitChunky 0,#width,#height,2        ; <= Initializes ChunkyBuffer

Screen 0,0,0,320,256,#planes,$0,"ChunkyToPlanar Example",1,2
Window 0,0,11,320,245,$400|$1000,"by Giuseppe Perniola",1,2
Use Window 0
WCls 0
For a=4 To 2^#planes-1
  AGARGB a,0,0,a*256/2^#planes
Next

NPrint "Width  Chunky    : "+Str$(#width)
NPrint "Height Chunky    : "+Str$(#height)
NPrint "Colors Chunky    : "+Str$(2^#planes)
NPrint "Precision        : 1x1"

; fill the chunkybuffer with data
a = 4
For y = 0 To #height-1
  For x = 0 To #width-1
    GPlot 0,x,y,a
    a + 1 : If a > 2^#planes-1 Then a = 4
  Next
Next
GPlot 0,0,0,2
GPlot 0,#width-1,#height-1,2

SetInt 5
  c + 1
End SetInt

;-- convert chunkybuffer to bitmap
For z.b = 0 To 5
  ChunkyToBitMap 0,0                     ; <= CONVERSION!
  BitMaptoWindow 0,0,0,0,0,90,#width,#height
Next z
ClrInt 5

d = 1.0 / 50 * c * 1000
b = 50.0 / c
Colour 1,0
NPrint "Time c2p         : "+Str$(d)+" ms"
NPrint "Frames for second: "+Str$(b)

MouseWait
Free BitMap 0
CloseWindow 0
Free Window 0
CloseScreen 0
FreeChunky 0                   ; <= Frees the ChunkyBuffer 0
End
