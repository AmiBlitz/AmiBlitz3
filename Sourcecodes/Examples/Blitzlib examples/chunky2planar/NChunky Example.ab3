; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = ""
; ExeFile         = ""
; CreateIcon      = 0
; Residents       = ",all.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 0
; FuncOptimize    = 0
; Version         = 0.0.0
; NumberOfBuilds  = 35
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 0
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 16
; CursorColumn    = 55
; LabelSearch     = ""
; LabelRemark     = 0
; LabelAll        = 0
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max Shape       = 100
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 20
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 5
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 4
; Max Window      = 20
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; /XTRA
; *********************************************************
;                  New Chunky Library
;    Coded by AlphaSOUND - (c) 1998 Fantaisie software
;    Frédéric Laboureu
; *********************************************************

; *********************************************************
;               Example 1 - 3D star zoomer
; A chunky buffer is drawn with NChunkyCls / NChunkyPlot /
; NChunkyBoxf and shown on a planar AGA screen with one of
; several chunky-to-planar (c2p) methods. The frame rate of
; the selected method is shown in the top line.
;
;   left mouse button  : next c2p method
;   right mouse button : quit
;
; The loop runs without VWait, so the frame rate shows how
; fast drawing + c2p are (at most 50 fps are visible on a
; PAL screen, the rest is dropped).
; *********************************************************

WBStartup
OPTIMIZE 5 : SYNTAX 4

#W      = 320                         ; chunky buffer / screen
#H      = 200
#CX     = #W / 2                      ; centre of the star field
#CY     = #H / 2 + 4
#NSTARS = 400
#ZMAX   = 1024                        ; farthest star distance
#SPEED  = 12                          ; distance per frame
#FOCUS  = 200                         ; projection: x * #FOCUS / z
#ISHIFT = 12                          ; fixed point bits of the reciprocal table
#TOP    = 10                          ; status line height (not used by stars)

Dim stx.l(#NSTARS - 1)
Dim sty.l(#NSTARS - 1)
Dim stz.l(#NSTARS - 1)
Dim inv.l(#ZMAX)                      ; inv(z) = (#FOCUS << #ISHIFT) / z
Dim mname$(4)
mname$(0) = "c2p040_320_200"
mname$(1) = "c2pBitMapRows"
mname$(2) = "NChunkyToBitmapV39"
mname$(3) = "NChunkyToBitmapV40"
mname$(4) = "WriteChunkyPixels_"

vbl.l = 0                             ; vertical blank counter (1/50 s), see SetInt 5

; ---------------------------------------------------------
; place star i at a random position (far = 1: at the back)
; ---------------------------------------------------------
Statement NewStar{i.l, far.l}
  SHARED stx(), sty(), stz()
  stx(i) = Rnd(2 * #W * 4) - #W * 4
  sty(i) = Rnd(2 * #H * 4) - #H * 4
  If far
    stz(i) = #ZMAX
  Else
    stz(i) = Rnd(#ZMAX - 1) + 1
  EndIf
End Statement

; ---------------------------------------------------------
; move all stars towards the viewer and draw them
; ---------------------------------------------------------
Statement DrawStars{}
  SHARED stx(), sty(), stz(), inv()
  For i.l = 0 To #NSTARS - 1
    z.l = stz(i) - #SPEED
    If z < 1
      NewStar{i, 1}
      z = stz(i)
    EndIf
    stz(i) = z
    iz.l = inv(z)                      ; multiply by the reciprocal instead of dividing
    px.l = #CX + ((stx(i) * iz) ASR #ISHIFT)
    py.l = #CY + ((sty(i) * iz) ASR #ISHIFT)
    If (px >= 0) AND (px < #W - 1) AND (py >= #TOP) AND (py < #H - 1)
      c.l = 255 - z / 4                ; near = bright
      If c < 24 Then c = 24
      If z < 256                       ; near stars: 2 x 2 pixels
        px2.l = px + 1
        py2.l = py + 1
        NChunkyBoxf px, py, px2, py2, c
      Else
        NChunkyPlot px, py, c
      EndIf
    Else
      NewStar{i, 1}                    ; left the screen: back to the start
    EndIf
  Next
End Statement

; *********************************************************
;                     Starting Program...
; *********************************************************
NInitChunky 0
NChunkyBuffer 0, #W, #H

; BitMap with 8 bitplanes directly one after the other (needed by
; c2p040_320_200 and c2pBitMapRows)
bmsize.l = (#W * #H) + 10000
*BitmapPtr.l = AllocMem(bmsize, #MEMF_CHIP|#MEMF_CLEAR)
If *BitmapPtr = 0 Then End
CludgeBitMap 0, #W, #H, 8, *BitmapPtr + 8
Screen 0, 0, 0, #W, #H, 8, 0, "New Library Chunky Test V1.60", 0, 0, 0
Use BitMap 0 : BitMapOutput 0
bmadr.l = Addr BitMap(0)                       ; struct BitMap for c2pBitMapRows

; palette: 0 = black, 1..255 = dark blue .. white
InitPalette 0, 256
For i.l = 1 To 255
  b.l = i + 48
  If b > 255 Then b = 255
  AGAPalRGB 0, i, i, i, b
Next
Use Palette 0

For i = 0 To #NSTARS - 1
  NewStar{i, 0}
Next

; reciprocal table: x * #FOCUS / z = (x * inv(z)) ASR #ISHIFT
; (|x| <= 4 * #W, so x * inv(1) still fits into a long)
inv(0) = 0
For i = 1 To #ZMAX
  inv(i) = (#FOCUS LSL #ISHIFT) / i
Next

; vertical blank counter for the frame rate (instead of DateStamp_)
SetInt 5
  vbl + 1
End SetInt

chunkymethod.l = 0
frames.l = 0
t0.l = vbl
fps$ = "--"
quit.l = 0

Repeat
  NChunkyCls 0
  DrawStars{}

  ;-- do the chunky to planar conversion
  Select chunkymethod
  Case 0    ; optimized merge c2p (tuned for the 68040, runs on 68020+), fixed to 320x200
    c2p040_320_200 NChunkyID, *BitmapPtr + 4

  Case 1    ; merge c2p for any range of rows, 68000+; needs the address of the BitMap structure (not of a bitplane)
    dummy.b = c2pBitMapRows(NChunkyID, bmadr, 0, #H)

  Case 2
    ; uses standard os function WritePixelArray8 that came with OS2.0, but needs AllocBitmap of OS3.0
    ;NChunkyToBitmapV39(0)

    ; uses native used version of WriteChunkyPixels (OS3.1)
    NChunkyToBitmapV40(0)

    ; direct use of os function
    ;*scr.Screen = Peek.l(Addr Screen(0))
    ;WriteChunkyPixels_ *scr\RastPort, 0, 0, #W - 1, #H - 1, NChunkyID, #W

  End Select

  ;-- frame rate, measured over about one second
  frames + 1
  dt.l = vbl - t0
  If dt >= 50
    f10.l = (frames * 500) / dt         ; frames per second * 10
    fps$ = Str$(f10 / 10) + "." + Str$(f10 MOD 10)
    frames = 0
    t0 = vbl
  EndIf
  Colour 255, 0
  Locate 0, 0
  Print Str$(chunkymethod), ": ", mname$(chunkymethod), "  ", fps$, " fps   "

  ;-- mouse: left = next method, right = quit
  mb.l = Joyb(0)
  If mb = 1
    chunkymethod + 1
    If chunkymethod > 2 Then chunkymethod = 0
    While Joyb(0) <> 0
      VWait
    Wend
    frames = 0
    t0 = vbl
    fps$ = "--"
  EndIf
  If mb = 2 Then quit = 1
Until quit

While Joyb(0) <> 0
  VWait
Wend
ClrInt 5
Free Screen 0
FreeMem *BitmapPtr, bmsize
End
