; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = ""
; ExeFile         = ""
; CreateIcon      = 0
; Residents       = ""
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 0
; FuncOptimize    = 0
; Version         = 0.0.0
; NumberOfBuilds  = 122
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 0
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 1
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 79
; CursorColumn    = 49
; LabelSearch     = ""
; LabelRemark     = 0
; LabelAll        = 0
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max Shape       = 100
; Max Bank        = 5
; Max MenuList    = 5
; Max GTList      = 20
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; /XTRA
; -- Reaction Simple Window, as demonstrated at
; -- http://www.pjhutchison.org/tutorial/reaction_window.html

; activate new syntax mode
OPTIMIZE 4

#INTUI_V36_NAMES_ONLY = 1
INCDIR "blitz3:sourcecodes/includes/OS/"
INCLUDE "exec/types.ab3"

INCLUDE "exec/memory.ab3"

INCLUDE "intuition/sghooks.ab3"
INCLUDE "intuition/intuition.ab3"

INCLUDE "intuition/icclass.ab3"
INCLUDE "intuition/classes.ab3"

INCLUDE "clib/graphics_protos.ab3"
INCLUDE "clib/reaction_lib_protos.ab3"

INCLUDE "proto/intuition.ab3"

INCLUDE "workbench/startup.ab3"

INCLUDE "workbench/workbench.ab3"

INCLUDE "utility/tagitem.ab3"

INCLUDE "proto/exec.ab3"

INCLUDE "proto/window.ab3"

INCLUDE "proto/layout.ab3"

INCLUDE "classes/window.ab3"

INCLUDE "gadgets/layout.ab3"
INCLUDE "images/label.ab3"

INCLUDE "clib/alib_protos.ab3"

INCLUDE "reaction/reaction.ab3"

INCLUDE "reaction/reaction_macros.ab3"



; ===========================================================

DEFTYPE.Library *WindowBase, *LayoutBase
DEFTYPE.MsgPort *AppPort
DEFTYPE.Window *win

*WindowBase = OpenLibrary_("window.class", 44)
*LayoutBase = OpenLibrary_("gadgets/layout.gadget", 44)
*LabelBase  = OpenLibrary_("images/label.image",0)

If (*WindowBase = 0 OR *LayoutBase=0 OR *LabelBase=0)
    NPrint "A library could not be opened!"
    End
EndIf

*AppPort = CreateMsgPort_
If *AppPort
    button1.l = !ButtonObject, @@
              #GA_Text, StrAddr("Button1"), @@
              #End))
    button2.l = !ButtonObject, @@
              #GA_Text, StrAddr("Button2"), @@
              #End))
    button3.l = !ButtonObject, @@
              #GA_Text, StrAddr("Button3"), @@
              #End))

    label.l = !LabelObject, @@
              #LABEL_Text, StrAddr("This is the first application\\n"), @@
              #LABEL_Text, StrAddr("that has been compiled with AmiBlitz3!\\n"), @@
              #LABEL_Text, StrAddr("Nice !"), @@
              #End))

    vlay1.l = !VLayoutObject, @@
              #LAYOUT_BevelStyle, #BVS_GROUP, @@
              #LAYOUT_Label,StrAddr("Data"), @@
              #LAYOUT_LabelPlace, #BVJ_TOP_LEFT, @@
              #LAYOUT_HorizAlignment, #LALIGN_CENTER, @@              
              #LAYOUT_AddImage, label, @@
              #End))
;              #LAYOUT_HorizAlignment, #LALIGN_CENTER, @@

    vlay2.l = !VLayoutObject, @@
              #LAYOUT_SpaceOuter, True, @@
              #LAYOUT_SpaceInner, True, @@
              #LAYOUT_BevelStyle, #BVS_THIN, @@
              #LAYOUT_Label,StrAddr("Buttons"), @@
              #LAYOUT_LabelPlace, #BVJ_TOP_LEFT, @@
              #LAYOUT_AddChild, button1, @@
              #LAYOUT_AddChild, button2, @@
              #LAYOUT_AddChild, button3, @@
              #End))


    winlayout.l = !VLayoutObject, @@
      #LAYOUT_SpaceOuter, True, @@
      #LAYOUT_SpaceInner, True, @@
      #LAYOUT_DeferLayout, True, @@
      #LAYOUT_AddChild, vlay1, @@ 
      #LAYOUT_AddChild, vlay2, @@     
      #End))

    *winobj = !WindowObject, @@
      #WA_ScreenTitle, StrAddr("AmiBlitz3: ReAction !!"), @@
      #WA_Title, StrAddr("AmiBlitz3 ReAction Example"), @@
      #WA_Activate, True, @@
      #WA_DepthGadget, True, @@
      #WA_DragBar, True, @@
      #WA_CloseGadget, True, @@
      #WA_SizeGadget, True, @@
      #WA_Width, 200, @@
      #WA_Height, 150, @@
      #WINDOW_IconifyGadget, True, @@
      #WINDOW_IconTitle, "Example", @@
      #WINDOW_AppPort, *AppPort, @@
      #WINDOW_Position, #WPOS_CENTERSCREEN, @@
      #WINDOW_ParentGroup, winlayout, @@
      #End))



  If (*winobj)
    *win = !RA_OpenWindow{*winobj}
    If *win
      DEFTYPE.l _wait, signal, app, done, result
      DEFTYPE.w code
      GetAttr_ #WINDOW_SigMask, *winobj, &signal
      app = 1 LSL *AppPort\mp_SigBit
      NPrint "app:",Hex$(app)," signal:",Hex$(signal)

      done = False
      While (NOT done)
        _wait = Wait_( signal | #SIGBREAKF_CTRL_C | app)
        
        If (_wait AND #SIGBREAKF_CTRL_C)
          done = True
        Else
          Repeat
            result = !RA_HandleInput{*winobj, code}

            Select (result AND #WMHI_CLASSMASK)
            Case #WMHI_CLOSEWINDOW:
              done = True
            Case #WMHI_ICONIFY
              NPrint "Iconify"
            Case #WMHI_GADGETDOWN
              NPrint "Button ", Hexw$(code)
            Case #WMHI_GADGETHELP
              NPrint "Gadget help ", Hexw$(code)
            Case #WMHI_CHANGEWINDOW
              NPrint "Window changed!"
            Case #WMHI_INACTIVE
              NPrint "Window inactive"
            Case #WMHI_ACTIVE
              NPrint "Window active!"
            
            Default
              If result
                NPrint "received signal: ", Hex$(_wait)
                NPrint ">> ",Hex$(result), " code: ",Hexw$(code)
              EndIf
            End Select
          Until done OR (result = #WMHI_LASTMSG)
        EndIf
      Wend
      DisposeObject_ *winobj
    EndIf
  Else
    NPrint "Window could not be opened."
  EndIf

  DeleteMsgPort_ *AppPort
EndIf

If (*WindowBase) Then CloseLibrary_ *WindowBase
If (*LayoutBase) Then CloseLibrary_ *LayoutBase
If (*LabelBase) Then CloseLibrary_ *LabelBase

