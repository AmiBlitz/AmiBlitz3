;-- activate new syntax mode
WBStartup : OPTIMIZE 4 : SYNTAX 3

; basic implementation of NewList-macro
Statement NewL{*listPtr.List}
  *listPtr\lh_Head = &*listPtr\lh_Tail
  *listPtr\lh_Tail = 0
  *listPtr\lh_TailPred = &*listPtr\lh_Head
End Statement


Function.List InitChooserList{}
  *list1.List = AllocMem_(SizeOf.List, #MEMF_PUBLIC)
  If *list1 Then NewList(*list1)
  ;NPrint "new list at ", Hex$(*list1)
  Function Return *list1
End Function

Statement AddChooserListEntry{*listPtr.List, entry.s}
  If *listPtr
    _tags.l = VarArgs(#CNA_Text, StrAddr(entry), #TAG_DONE)
    *node.Node = AllocChooserNodeA_(_tags)
    If *node Then AddTail_ *listPtr, *node
    NPrint "added node ", Hex$(*node)
  EndIf
End Statement

Statement FreeChooserLabels{*listPtr.List}
  If *listPtr
    *ln.Node = *listPtr\lh_Head
    Repeat
      *succ.Node = *ln\ln_Succ
      If Peek.l(*ln) <> 0
        FreeChooserNode_ *ln
        NPrint "freed node ", Hex$(*ln)
      EndIf
      *ln = *succ
    Until *succ = 0
    NPrint "freeing list at ", Hex$(*listPtr)
    FreeMem_ *listPtr, SizeOf.List
  EndIf
End Statement

; =====================================================================
*WindowBase.Library = OpenLibrary_("window.class", 44)
*LabelBase.Library  = OpenLibrary_("images/label.image", 44)
*LayoutBase.Library = OpenLibrary_("gadgets/layout.gadget", 44)
*SpaceBase.Library = OpenLibrary_("gadgets/space.gadget", 44)
*CheckboxBase.Library = OpenLibrary_("gadgets/checkbox.gadget", 44)
*ChooserBase.Library = OpenLibrary_("gadgets/chooser.gadget", 44)
*StringBase.Library = OpenLibrary_("gadgets/string.gadget", 44)
*IntegerBase.Library = OpenLibrary_("gadgets/integer.gadget", 44)
*GetfileBase.Library = OpenLibrary_("gadgets/getfile.gadget", 44)
*GetfontBase.Library = OpenLibrary_("gadgets/getfont.gadget", 44)
*GetscreenmodeBase.Library = OpenLibrary_("gadgets/getscreenmode.gadget", 44)

If (*WindowBase = 0 OR *LayoutBase=0 OR *LabelBase=0 OR *CheckboxBase=0 OR *ChooserBase=0 OR *StringBase=0 OR *IntegerBase=0 OR *GetfileBase=0 OR *GetfontBase=0)
  NPrint "A library could not be opened!"
  Goto cleanup
EndIf

*AppPort.MsgPort = CreateMsgPort_
If *AppPort = 0
  NPrint "Could not get a message port."
  Goto cleanup
EndIf

; =============================================================================
