#GID_INTEGER_1  = 7
#GID_GETFILE    = 8
#GID_GETFONT    = 9
#GID_GETSCREEN  = 10


space1.l  = !SpaceObject, !EndObject
space2.l  = !SpaceObject, !EndObject

button1.l = !ButtonObject, @@
            #GA_ID, #GID_BUTTON_QUIT, @@
            #GA_RelVerify, True, @@
            #GA_Text, StrAddr("_Quit"), @@
            !EndObject

