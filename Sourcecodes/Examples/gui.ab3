; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = ""
; ExeFile         = ""
; CreateIcon      = 0
; Residents       = "all2.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 1
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 16
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 0
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 35
; CursorColumn    = 40
; LabelSearch     = ""
; LabelRemark     = 0
; LabelAll        = 0
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 11
; Max GadgetList  = 5
; Max Shape       = 100
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 26
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 5
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 32
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; Max Window      = 20
; /XTRA
OPTIMIZE 4 : SYNTAX 4
XINCLUDE "GUIWrapper.include.ab3"
GUIMode = #GUI_REACTION

RunErrsOff
WZLoadGUI ?wzgui
RunErrsOn

Goto skip_progressbar
GUI_ShowMessage{"hallo",0}
For i.b = 0 To 100 Step 10
  GUI_Update_Gauge{i,100}
  Delay_ 10
Next
Delay_ 20
GUI_HideMessage{}
skip_progressbar:


;-- open the reaction window, centered to the screen
If GUIMode = #GUI_REACTION
  Dim fpatt.w(15)
  fpatt(0) = $AAAA,$5555,$AAAA,$5555,$AAAA,$5555,$AAAA,$5555
  fpatt(8) = $AAAA,$5555,$AAAA,$5555,$AAAA,$5555,$AAAA,$5555

  *chooserList1.List = InitChooserList{}
  AddChooserListEntry{*chooserList1, "Hallo"}  
  *chooser.l = !ChooserObject, @@
              #GA_ID, WZID("MANAGER_CYCLE"), @@
              #GA_RelVerify, True, @@
              #CHOOSER_Labels, *chooserList1, @@
              #CHOOSER_DropDown, True, @@
              !ChooserEnd
  GUI_RegisterObjectLong{"MANAGER_CYCLE", *chooser}

  *listbrowser.l = !ListBrowserObject, @@
          #GA_ID, WZID("TABELLE"), @@
          #GA_RelVerify, True, @@
          #LISTBROWSER_ColumnTitles, True, @@
          #LISTBROWSER_TitleClickable, True, @@
          #LISTBROWSER_ShowSelected, True, @@
          #LISTBROWSER_Separators, True, @@
          !ListBrowserEnd
  GUI_RegisterObjectLong{"TABELLE", *listbrowser}

  *space.l = !SpaceObject, !EndObject
  *args.l  = !ButtonObject, @@
            #GA_ID, WZID("TABELLE_STATUS"), @@
            #GA_RelVerify, True, @@
            #GA_ReadOnly, False, @@
            #BUTTON_BevelStyle, #BVS_THIN, @@
            #BUTTON_Transparent, True, @@
            !ButtonEnd
;            #GA_Text, StrAddr(message), @@
  GUI_RegisterObjectLong{"TABELLE_STATUS",*args}
  *sublay1.l = !VLayoutObject, @@
            #LAYOUT_HorizAlignment, #LALIGN_CENTER, @@
            #LAYOUT_VertAlignment, #LALIGN_CENTER, @@
            #LAYOUT_BevelStyle, #BVS_NONE, @@
            #LAYOUT_AddChild, *listbrowser, @@
            #LAYOUT_AddChild, *space, @@
            #CHILD_WeightedHeight, 0, @@            
            #LAYOUT_AddChild, *args, @@
            #CHILD_WeightedHeight, 0, @@
            #LAYOUT_AddChild, *chooser, @@
            !LayoutEnd

  *winlayout.l = !VLayoutObject, @@
            #LAYOUT_FillPen,0, @@
            #LAYOUT_SpaceOuter, True, @@
            #LAYOUT_SpaceInner, True, @@
            #LAYOUT_FillPattern, &fpatt(0),@@
            #LAYOUT_FillPen, #SHINEPEN,@@
            #LAYOUT_AddChild, *sublay1, @@
            !LayoutEnd

  *winobj.l = !WindowObject, @@
            #WA_Title, StrAddr("Table-Demo"), @@
            #WA_Activate, True, @@
            #WA_DepthGadget, True, @@
            #WA_DragBar, True, @@
            #WA_CloseGadget, True, @@
            #WA_SizeGadget, True, @@
            #WA_Width, ScreenWidth/2, @@
            #WA_Height, ScreenHeight/2, @@
            #WA_IDCMP, #IDCMP_GADGETUP | #IDCMP_REFRESHWINDOW | #IDCMP_VANILLAKEY | #IDCMP_CLOSEWINDOW | #IDCMP_GADGETDOWN | #IDCMP_IDCMPUPDATE | #IDCMP_MOUSEMOVE, @@
            #WINDOW_Position, #WPOS_CENTERSCREEN, @@
            #WINDOW_AppPort, BlitzMsgPort, @@
            #WINDOW_ParentGroup, *winlayout, @@
            !EndObject
EndIf
AddIDCMP #IDCMP_MOUSEMOVE
GUI_OpenWindow{"WIN_TABELLE", ScreenWidth/4,ScreenHeight/4,ScreenWidth/2,ScreenHeight/2,*winobj}
GUI_InitTable{"WIN_TABELLE","TABELLE", 5}
GUI_SetTableTitle{"TABELLE","Name","Type","Size","Bits","Comment"}
GUI_SetPriority{"TABELLE",2,2,2,2,2}
GUI_DrawTable{"TABELLE"}

;-- fill table with some data
ChDir "sys:" : a.l = 0
While MoreEntries
  a + 1
  If EntryDIR Then d$ ="Dir" Else d$ = "File"
  GUI_AddRow{"TABELLE", EntryName$, d$, Str$(EntrySize), EntryBits$,"####"};EntryComment$}
;  If Left$(EntryName$,1)="D"
;    WZ_SetRowPen{"TABELLE",-1,-1,#FSF_BOLD}
;  EndIf
Wend
GUI_UpdateTable{"TABELLE"}

;--
;-- main loop
;--
exit.b = False
Repeat
  ev.l = WaitEvent
  DefaultOutput
  NPrint "EVENT: ",Hex$(ev), "  Code: ",EventCode, " Qualifier: ",EventQualifier

  ;-- close bubblehelp if open
  If (ev <> #IDCMP_INTUITICKS) AND (ev <> #IDCMP_ACTIVEWINDOW)
    GUI_HideBubble{}
  EndIf

  Select ev
    Case #IDCMP_CLOSEWINDOW
      Select EventWindow
      Case WZID("WIN_TABELLE")
        exit = True
      End Select

    Case #IDCMP_GADGETHELP
      GUI_ShowBubble{}

    Case #IDCMP_IDCMPUPDATE
      NPrint "IDCMP Update ",EventCode,"  ",GadgetHit
      GUI_GadName{}

    Case #IDCMP_GADGETUP
      NPrint "Gadget up ", GUI_GadName{}, "(",GadgetHit, "), Value:", EventCode

    Case #IDCMP_VANILLAKEY
      NPrint "Vanillakey ",EventVanillaKey

    Case #IDCMP_RAWKEY
      NPrint "Rawkey ",EventRawKey

    Case #IDCMP_MOUSEMOVE
      NPrint "X: ",EMouseX, ",Y: ",EMouseY

    Case #IDCMP_MOUSEBUTTONS
      NPrint "Buttons pressen"

  End Select

  Select GUI_CheckTableEvent{ev, "TABELLE"}
    Case #WZTABLEEVENT_TITLECLICK
      error{"a title was clicked on"}

    Case #WZTABLEEVENT_DOUBLECLICK
      x.w = GUI_Row{"TABELLE"}
      y.w = GUI_Column{"TABELLE"}
      error{"Selected via doubleclick: "+Str$(x)+","+Str$(y)}

    Case #WZTABLEEVENT_CELLSELECTED
      x.w = GUI_Row{"TABELLE"}
      y.w = GUI_Column{"TABELLE"}
      If (x > 0) AND (y > 0)
        z$ = "TABELLE" + ": cell " + Str$(x) + "," + Str$(y) + ":" + WZ_GetCell{"TABELLE",x,y} + "___" + WZ_GetCell{"TABELLE",x,2}
      Else
        If x <> ox.w
          z$ = "selected row: " + Str$(x)
        EndIf
      EndIf
      ox.w = x
      Use Window WZID("WIN_TABELLE")
      GUI_SetGadgetString{"TABELLE_STATUS",z$}
    End Select

Until exit = True

ende:
GUI_HideBubble{}
;-- removes all entries of the tables
GUI_KillTable{"TABELLE"}
;-- close the window and all attached objects
GUI_CloseWindow{"WIN_TABELLE"}
;-- free additional memory
GUI_Cleanup{}


End

Goto wzguiEnd:
wzgui:
IncBin "blitz3:sourcecodes/includes/wizard_Tools.include.wizard"
wzguiEnd:

