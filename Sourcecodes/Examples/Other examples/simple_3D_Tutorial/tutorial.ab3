OPTIMIZE 1
DEFTYPE.l

NEWTYPE .vtx
  sx.l ; screenX
  sy.l ; screenY
  vx.f ; pointX, has to be float!!! everything else may be long (.l)
  vy.f ; pointY
  vz.f ; pointZ
End NEWTYPE

NEWTYPE .plg
  vtx1.l
  vtx2.l
  vtx3.l
End NEWTYPE

Dim List points.vtx(1000)
Dim List polygons.plg(1500)

INCLUDE "3dfunctions.ab3"

; =======================================================================================

.MAINPROGRAM:
FindScreen 0
Window 0, 0,0,640,480,$100F,"3D-Sample (press mouse to exit)", 120, 120
Use Screen 0

NPrint "Please wait load Object ..."
_model.s = "Kugel2.obj"
;_model.s = "Zylinder.obj"
If NOT loadModel{_model}
  NPrint "Object loaded!"
  End
EndIf

NPrint "Vertices: ", CountList(points())
NPrint "Polygons: ", CountList(polygons())

scaleObject{0.055,0.055,0.055}
;scaleObject{0.1,0.1,0.1}

Repeat
  ;InnerCls 0
  drawObject{0, True}            ; clear the object
  rotateObject{0.1, -0.3, 1}  ; rotate object
  renderObject{320, 240}      ; calculate object
  drawObject{1, True}            ; draw the object
  VWait 1
Until Joyb(0) <> 0 
