; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = "Blitz3:Sourcecodes/Bin"
; ExeFile         = "3d"
; CreateIcon      = 0
; Residents       = "all.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 100000
; MakeSmallest    = 1
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 395
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8192
; RuntimeDebug    = 0
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 521
; CursorColumn    = 13
; LabelSearch     = "numVertices"
; LabelRemark     = 0
; LabelAll        = 1
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 100
; Max GadgetList  = 100
; Max Shape       = 200
; Max MenuList    = 100
; Max IntuiFont   = 10
; Max BlitzFont   = 1
; Max Bank        = 1
; Max GTList      = 100
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 100
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max Window      = 100
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 4
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; /XTRA
OPTIMIZE 4: SYNTAX 6

#RENDER_DOTS = 0
#RENDER_WIREFRAME = 1
#RENDER_FILLED = 2

#SWIDTH = 320
#SHEIGHT = 256
#hw = #SWIDTH / 2
#hh = #SHEIGHT / 2

NEWTYPE.config
  showNums.b
  showData.b
  renderMode.b
  culling.b
  normals.b
End NEWTYPE
DEFTYPE.config config

NEWTYPE.Vertex
  x.q
  y.q
  z.q
End NEWTYPE

NEWTYPE.Vector
  x.q
  y.q
  z.q
End NEWTYPE

NEWTYPE.Triangle
  v1.w   ;Index of Vertex 1
  v2.w   ;Index of Vertex 2
  v3.w   ;Index of Vertex 3
  normal.Vector
  avgZ.q
End NEWTYPE

Dim verts.Vertex(200)
Dim xVerts.Vertex(200)
Dim cols.w(200)
xNumVertices.w = 0

Dim faces.Triangle(500)
numFaces.w = 0
Dim xFaces.Triangle(500)
xNumFaces.w = 0

BLITZ

;============================================================================================
Function.b LoadModel{modelname.s}
SHARED verts(), numVertices, faces(), numFaces, xVerts()

  DEFTYPE.s rawLine
  DEFTYPE.s prefix
  DEFTYPE.w spPos
  DEFTYPE.w vIdx, fIdx
  DEFTYPE.s val1, val2, val3

  If ReadFile(0,modelname)
    FileInput 0

    vIdx =  0
    fIdx = -1
    While NOT Eof(0)
      rawLine = Edit$(80)

      InitArgParse rawLine
      prefix = NextArg$

      If prefix <> ""
        If prefix = "v" OR prefix = "f"
          val1 = NextArg$
          val2 = NextArg$
          val3 = NextArg$
        End If

        Select prefix
        Case "v"
          vIdx = vIdx + 1
          verts(vIdx)\x = Val(val1)
          verts(vIdx)\y = Val(val2)
          verts(vIdx)\z = Val(val3)

        Case "f"
          fIdx = fIdx + 1
          faces(fIdx)\v1 = Val(val1)
          faces(fIdx)\v2 = Val(val2)
          faces(fIdx)\v3 = Val(val3)

        Case "#"
          ; comment

        Case "g"
          ; name of object
        Default
          NPrint "unsupported prefix <",prefix,">"
        End Select
      EndIf
    Wend
    CloseFile 0
    DefaultInput

    numVertices = vIdx
    numFaces = fIdx

    Function Return True
  EndIf
End Statement


Statement CalcNormals{}
SHARED faces(), xVerts(), numFaces

  DEFTYPE.Triangle f
  DEFTYPE.Vertex v1, v2, v3
  DEFTYPE.q ax, ay, az
  DEFTYPE.q bx, by, bz
  DEFTYPE.q nx, ny, nz

  For j.w = 0 To numFaces
    CopyType faces(j), f
    CopyType xVerts(f\v1),v1
    CopyType xVerts(f\v2),v2
    CopyType xVerts(f\v3),v3

    ;Edge vector A V3 - V1
    ax = v3\x - v1\x
    ay = v3\y - v1\y
    az = v3\z - v1\z

    ;Edge vector B V2 - V1
    bx = v2\x - v1\x
    by = v2\y - v1\y
    bz = v2\z - v1\z

    ;Calc cross product
    nx = (ay * bz) - (az * by)
    ny = (az * bx) - (ax * bz)
    nz = (ax * by) - (ay * bx)

    ;Normalize vector
    _Length.q = Sqr(nx * nx + ny * ny + nz * nz)

    If _Length > 0
      faces(j)\normal\x = nx / _Length
      faces(j)\normal\y = ny / _Length
      faces(j)\normal\z = nz / _Length
    End If
  Next

End Statement

;Insert triangles in order
Statement InsertTriangle{*tri.Triangle, _Length.w}
SHARED xFaces()
  DEFTYPE.Triangle temp
  For i.w = 0 To _Length - 1
    If *tri\avgZ > xFaces(i)\avgZ        ;Found spot To insert tri
      For j.w = _Length To i + 1 Step -1 ;Shuffle existing items forward
        ;SWAP faces(j), faces(j - 1)
        CopyType xFaces(j), temp
        CopyType xFaces(j-1), xFaces(j)
        CopyType temp, xFaces(j-1)
      Next
      CopyType *tri, xFaces(i)
      Pop For : Goto endF
    End If
  Next
  endF:

  If i = _Length
    CopyType *tri, xFaces(_Length)
  End If

End Statement


Statement CullFaces{}
SHARED faces(), numFaces, xFaces(), xNumFaces, xVerts()
  DEFTYPE.Vertex vtx
  DEFTYPE.Vector camVtr, normal
  DEFTYPE.q x, y, z
  DEFTYPE.Vertex v1, v2, v3

  xNumFaces = 0
  For i.w = 0 To numFaces
    ;-- The camera vector is the normalised vector from the origin To the first vertex of the triangle
    CopyType xVerts(faces(i)\v1), vtx
    x = vtx\x
    y = vtx\y
    z = vtx\z

    _Length.q = Sqr(x * x + y * y + z * z)
    camVtr\x = x / _Length
    camVtr\y = y / _Length
    camVtr\z = z / _Length

    CopyType faces(i)\normal,normal

    dotProd.q = (camVtr\x * normal\x) + (camVtr\y * normal\y) + (camVtr\z * normal\z)

    If dotProd > 0
       CopyType xVerts(faces(i)\v1), v1
       CopyType xVerts(faces(i)\v2), v2
       CopyType xVerts(faces(i)\v3), v3
       faces(i)\avgZ = (v1\z + v2\z + v3\z) / 3
       InsertTriangle{faces(i), xNumFaces}
       xNumFaces + 1
    End If
  Next

End Statement


;V1 should be the Point of the triangle
NEWTYPE.Polygon
  x0.w : y0.w
  x1.w : y1.w
  x2.w : y2.w
  x3.w : y3.w
End NEWTYPE

Statement DrawVertex{*V.Vertex, color.w, @idx.w}

  Plot #hw + *V\x, #hh + *V\y, color
  Plot #hw + *V\x, #hh + *V\y+1, color
  If idx <> -1
    FNSPrint 0, #hw + *V\x, #hh + *V\y+1, Str$(idx),1,color
  EndIf

End Statement

Statement DrawTriangle{*argV1.Vertex, *argV2.Vertex, *argV3.Vertex, color.w, @filled.b}
  DEFTYPE.Vertex temp

  CopyType *argV1, v1.Vertex
  CopyType *argV2, v2.Vertex
  CopyType *argV3, v3.Vertex

  ;-- Fix order of V2 AND V3 by x val
  If v2\x > v3\x
    ;Swap v2, v3
    CopyType v2, temp
    CopyType v3, v2
    CopyType temp, v3
  End If

  p.Polygon\x0 = #hw + v1\x, #hh + v1\y
  p.Polygon\x1 = #hw + v2\x, #hh + v2\y
  p.Polygon\x2 = #hw + v3\x, #hh + v3\y
;  p.Polygon\x3 = #hw + v1\x, #hh + v1\y

  If filled
    Polyf 3,p, color;,-1
  Else
    Poly 3,p, color
  EndIf

End Statement


Statement RenderFace{*srcTri.Triangle, color.w}
SHARED xVerts(), config

  DEFTYPE.Vertex v1,v2,v3,v4, temp

  CopyType xVerts(*srcTri\v1),v1
  CopyType xVerts(*srcTri\v2),v2
  CopyType xVerts(*srcTri\v3),v3

;Goto skip
  ;-- Sort the verticies by y value
  If v1\y < v2\y    ;Swap v1, v2
    CopyType v2, temp
    CopyType v1, v2
    CopyType temp, v1
  End If

  If v2\y < v3\y    ;Swap v2, v3
    CopyType v3, temp 
    CopyType v2, v3
    CopyType temp, v2
  End If

  If v1\y < v2\y    ;Swap v1, v2
    CopyType v2, temp
    CopyType v1, v2
    CopyType temp, v1
  End If

skip:
  Select config\renderMode
  Case #RENDER_WIREFRAME
    DrawTriangle{v1, v2, v3, color, False}
  Case #RENDER_FILLED
    DrawTriangle{v1, v2, v3, color, True}
  End Select

End Statement


Statement DrawObject{}
SHARED xFaces(), xNumFaces, xVerts(), xNumVertices, config


  If config\renderMode = #RENDER_DOTS OR config\showNums
    cstep.q = 16.0 / xNumFaces
    For i.w = 1 To xNumVertices
      If config\showNums
        DrawVertex{xVerts(i),i * cstep,i}
      Else
        DrawVertex{xVerts(i),i * cstep,-1}
      EndIf

    Next
    If NOT config\showNums Then Statement Return
  EndIf

  DEFTYPE.Vector light, n
  For i.w = 0 To xNumFaces

    If config\normals
      CopyType xFaces(i)\normal, n.Vector
      ;light\x = .3
      ;light\y = -.3
      ;light\z = .91
      light\x = .577
      light\y = -.577
      light\z = .577
      ;light\x = .7
      ;light\y = -.7
      ;light\z = .14

      DotProduct_.q = (n\x * light\x) + (n\y * light\y) + (n\z * light\z)

      color.b = 1 + DotProduct_ * 15.0
    Else
      color.b = 15
    EndIf

    RenderFace{xFaces(i), color}

    If i < 20 AND config\showData
      Colour color
      NPrint "f",i," : ", xFaces(i)\v1, ", ", xFaces(i)\v2, ", ", xFaces(i)\v3
    EndIf
  Next i
End Statement




; Rotate around the y-axis, angle in radians
Statement RotateObject{angleX.q, angleY.q, angleZ.q}
SHARED xVerts(),xNumVertices

  For i.w = 1 To xNumVertices

    If angleX <> 0
      _sinX.q = Sin(angleX) : _cosX.q = Cos(angleX)
      CopyType xVerts(i), vtx.Vertex
      xVerts(i)\y = vtx\y * _cosX - vtx\z * _sinX
      xVerts(i)\z = vtx\y * _sinX + vtx\z * _cosX
    EndIf

    If angleY <> 0
      _sinY.q = Sin(angleY) : _cosY.q = Cos(angleY)
      CopyType xVerts(i), vtx.Vertex
      xVerts(i)\x = vtx\z * _sinY + vtx\x * _cosY
      xVerts(i)\z = vtx\z * _cosY - vtx\x * _sinY
    EndIf

    If angleZ <> 0
      _sinZ.q = Sin(angleZ) : _cosZ.q = Cos(angleZ)
      CopyType xVerts(i), vtx.Vertex
      xVerts(i)\x = vtx\x * _cosZ - vtx\y * _sinZ
      xVerts(i)\y = vtx\x * _sinZ + vtx\y * _cosZ
    EndIf

  Next i

End Statement

Statement TransformObject{tX.q, tY.q, tZ.q}
SHARED xVerts(),xNumVertices

  For i.w = 1 To xNumVertices
    xVerts(i)\x = xVerts(i)\x + tX
    xVerts(i)\y = xVerts(i)\y + tY
    xVerts(i)\z = xVerts(i)\z + tZ
  Next i

End Statement

Statement ScaleObject{fX.q, fY.q, fZ.q}
SHARED xVerts(),xNumVertices

  For i.w = 1 To xNumVertices
    If fX <> 0 Then xVerts(i)\x = xVerts(i)\x * fX
    If fY <> 0 Then xVerts(i)\y = xVerts(i)\y * fY
    If fZ <> 0 Then xVerts(i)\z = xVerts(i)\z * fZ
  Next i
End Statement

Statement ApplyPerspective{}
SHARED xVerts(), xNumVertices

  For i.w = 1 To xNumVertices
    xVerts(i)\x = (160.0 * xVerts(i)\x) / xVerts(i)\z
    xVerts(i)\y = (160.0 * xVerts(i)\y) / xVerts(i)\z
  Next i

End Statement

Statement CopyVerts{}
SHARED verts(), xVerts(), numVertices, xNumVertices
  For i.w = 1 To numVertices
    CopyType verts(i), xVerts(i)
  Next
  xNumVertices = numVertices
End Statement

Statement CopyFaces{}
SHARED faces(), xFaces(), numFaces, xNumFaces
  For i.w = 0 To numFaces
    CopyType faces(i), xFaces(i)
  Next
  xNumFaces = numFaces
End Statement

Function.q getMaxZSize{}
SHARED verts(), numVertices

  DEFTYPE.q tempZ
  For i.w = 1 To numVertices
    If Abs(verts(i)\z) > tempZ Then tempZ = Abs(verts(i)\z)
  Next
  Function Return tempZ

End Statement


; =========================================================================================================
objfile.s = "/Data/models/simple.obj"
objfile.s = "/Data/models/cube.obj"
objfile.s = "/Data/models/pyramid.obj"
objfile.s = "/Data/models/octahedron.obj"
objfile.s = "/Data/models/diamond.obj"
objfile.s = "/Data/models/sphere.obj"
;objfile.s = "/Data/models/humanoid_quad.obj"
;objfile.s = "/Data/models/humanoid_tri.obj"
;objfile.s = "/Data/models/spitf3.obj"
;objfile.s = "/Data/models/lamp.obj"

If NOT LoadModel{objfile}
  NPrint "not ok"
  End
EndIf

;-- Install font as number 1
#font=1
suc.l = InstallFNS(#font,?font_dat)
If suc<>#font
  NPrint "not font!"
  End
EndIf


;-- init the output and some fancy colors
BitMap 0,320,256,4
Slice 0,44,4: Show 0
InitPalette 0,16
For i.w = 0 To 15
  PalRGB 0,i, i, i, i
Next
ShowPalette 0

;-- set bitmap 0 as output bitmap for print operations
BitMapOutput 0
FNSOutput 0,1


; --
; -- adjust the transformation to a suitable value
; --
tx.q = 0 : ty.q = 0 : tz.q = getMaxZSize{} * 2.5
config\renderMode = #RENDER_WIREFRAME
config\culling = True : config\normals = True
; --
; -- main loop
; --
BLITZ
Mouse On : BlitzKeys On : exit.b = False
Repeat
  startTime.q = Timer
  lastkey.w = BlitzKey

  CopyVerts{}

  RotateObject{angleX.q,angleY.q,angleZ.q}
  TransformObject{tx,ty,tz}
  ScaleObject{0,0,0}
  If config\normals Then CalcNormals{}
  If config\culling Then CullFaces{} Else CopyFaces{}
  ApplyPerspective{}

  Cls : VWait 2
  DrawObject{}

  endTime.q = Timer
  Locate 0,0 : Colour 15
  NPrint objfile
  NPrint "Frame time: ", endTime - startTime
  NPrint "Triangles: ", numFaces + 1,", Vertices: ", numVertices
  NPrint "Faces culled: ", numFaces - xNumFaces
  NPrint "transform: ",tx," ",ty," ",tz
  NPrint "(V) (C) (N) (I) (D) (W) (F) (+) (-)"

  If lastkey<>-1 Then olastkey.w = lastkey
  NPrint olastkey

  Select lastkey

  Case 119 : config\renderMode = #RENDER_WIREFRAME        ; W
  Case 102 : config\renderMode = #RENDER_FILLED           ; F
  Case 100 : config\renderMode = #RENDER_DOTS             ; D

  Case 118 : config\showNums = -1-config\showNums          ; V
  Case 105 : config\showData = -1-config\showData          ; I
  Case  99 : config\culling = -1-config\culling            ; C
  Case 110 : config\normals = -1-config\normals            ; N

  Case 28: ty - 0.25  ; up
  Case 29: ty + 0.25  ; down
  Case 31: tx - 0.25  ; left
  Case 30: tx + 0.25  ; right
  Case 45: tz + 0.25  ; -
  Case 43: tz - 0.25  ; +
  Case 27 : exit = True
  End Select

  If Joyb(0) <> 0 Then exit = True

  angleY = angleY + (Pi / 128.0)
  angleX = Pi + 0.05
Until exit = True
AMIGA
End

;Incbin our font into the compiled file to save effort later
font_dat: IncBin "/data/FNS/fonts/Times15.FNS"
