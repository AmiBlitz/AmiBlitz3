; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = "Blitz3:Sourcecodes/Bin"
; ExeFile         = "3d"
; CreateIcon      = 0
; Residents       = "all.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 100000
; MakeSmallest    = 1
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 522
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8192
; RuntimeDebug    = 1
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 473
; CursorColumn    = 1
; LabelSearch     = "#FRAMEWAIT"
; LabelRemark     = 0
; LabelAll        = 1
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 100
; Max GadgetList  = 100
; Max Shape       = 200
; Max MenuList    = 100
; Max IntuiFont   = 10
; Max BlitzFont   = 1
; Max Bank        = 1
; Max GTList      = 100
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 100
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 4
; Max Window      = 100
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; /XTRA
;--
;-- based on the video "Its QBasic time"
;-- by Old Man Yells at Code:
;-- https://www.youtube.com/watch?v=Ax9j_C1ouSI&t=1348s
;--

OPTIMIZE 5: SYNTAX 6

#RENDER_DOTS = 0
#RENDER_WIREFRAME = 1
#RENDER_FILLED = 2

#MODELSIZE = 10       ; added this parameter to adjust the size of a model
#FRAMEWAIT = 0        ; VWait after every frame (5 = max. 10 frames per second), set to 0 to measure the real speed
#SWIDTH = 320
#SHEIGHT = 256
#hw = #SWIDTH / 2
#hh = #SHEIGHT / 2

NEWTYPE.config
  showNums.b
  showData.b
  showLight.b
  renderMode.b
  culling.b
  normals.b
End NEWTYPE
DEFTYPE.config config

NEWTYPE.Vertex
  x.q
  y.q
  z.q
End NEWTYPE

NEWTYPE.Vector
  x.q
  y.q
  z.q
End NEWTYPE

NEWTYPE.Triangle
  v1.w   ;Index of Vertex 1
  v2.w   ;Index of Vertex 2
  v3.w   ;Index of Vertex 3
  normal.Vector
  avgZ.q ;average depth, also the sort key for SortList (a quick is stored as a 32 bit long)
End NEWTYPE

;-- used for drawing
NEWTYPE.Polygon
  x0.w : y0.w
  x1.w : y1.w
  x2.w : y2.w
  x3.w : y3.w
End NEWTYPE

DEFTYPE.Vector light,light2
Dim List verts.Vertex(750)
Dim List xVerts.Vertex(750)
Dim List faces.Triangle(1500)
Dim List xFaces.Triangle(1500)
SHARED numFaces.w
SHARED numFacesX.w          ; number of visible faces in the list xFaces()
SHARED numVertices.w

BLITZ

;============================================================================================
Function.b LoadModel{modelname.s}
SHARED verts(), faces(), xVerts(), xFaces()

  DEFTYPE.s rawLine
  DEFTYPE.s prefix
  DEFTYPE.s val1, val2, val3
  DEFTYPE.b vIndex

  noerrors.b = True
  If ReadFile(0,modelname)
    FileInput 0

    ClearList verts() : dummy.b = AddLast(verts()) ; add dummy vertex, as count starts with 1
    ClearList xVerts(): dummy.b = AddLast(xVerts())
    ClearList faces()
    While (NOT Eof(0)) AND noerrors
      rawLine = Edit$(80)

      InitArgParse rawLine
      prefix = NextArg$

      If prefix <> ""
        If prefix = "v" OR prefix = "f"
          val1 = NextArg$
          val2 = NextArg$
          val3 = NextArg$
        End If

        Select prefix
        Case "i" ; if i is set, the index of vertices should be at 0 instead of 1
          vIndex = 1
        Case "v"
          NPrint CountItem(verts()),": ", val1," ",val2," ",val3
          If AddLast(verts())
            verts()\x = Val(val1)
            verts()\y = Val(val2)
            verts()\z = Val(val3)
            dummy.b = AddLast(xVerts())
          Else
            NPrint "Could not add vertex to list!"
            noerrors = False
          EndIf

        Case "f"
          ;-- the numbers of vertices start with 1 in the definitions file!
          If AddLast(faces())
            faces()\v1 = Val(val1) + vIndex
            faces()\v2 = Val(val2) + vIndex
            faces()\v3 = Val(val3) + vIndex
          Else
            NPrint "Could not add face to list!"
            noerrors = False
          EndIf

        Case "#"
          ; comment

        Case "g"
          ; name of object
        Default
          NPrint "unsupported prefix <",prefix,">"
        End Select
      EndIf
    Wend
    numFaces = CountList(faces())
    numVertices = CountList(verts()) - 1
    CloseFile 0
    DefaultInput
  Else
   noerrors = False
  EndIf
  Function Return noerrors
End Function


Statement CalcNormals{}
SHARED faces(), xVerts()

  DEFTYPE.Triangle f
  DEFTYPE.Vertex v1, v2, v3
  DEFTYPE.q ax, ay, az
  DEFTYPE.q bx, by, bz
  DEFTYPE.q nx, ny, nz, m

  For j.w = 0 To numFaces - 1   ;the faces are 0 .. numFaces-1

    CopyType faces(j), f        ; this is just for readability and could be removed for a little speed gain
    CopyType xVerts(f\v1),v1
    CopyType xVerts(f\v2),v2
    CopyType xVerts(f\v3),v3

    ;-- Edge vector A V3 - V1
    ax = v3\x - v1\x
    ay = v3\y - v1\y
    az = v3\z - v1\z

    ;-- Edge vector B V2 - V1
    bx = v2\x - v1\x
    by = v2\y - v1\y
    bz = v2\z - v1\z

    ;-- Calc cross product
    nx = (ay * bz) - (az * by)
    ny = (az * bx) - (ax * bz)
    nz = (ax * by) - (ay * bx)

    ;-- Normalize vector
    ;-- first divide by the largest component, so the squares stay small (quick range)
    ;-- and very small normals don't lose their precision
    m = Abs(nx)
    If Abs(ny) > m Then m = Abs(ny)
    If Abs(nz) > m Then m = Abs(nz)

    If m > 0
      nx = nx / m : ny = ny / m : nz = nz / m
      _Length.q = Sqr(nx * nx + ny * ny + nz * nz)
      faces(j)\normal\x = nx / _Length
      faces(j)\normal\y = ny / _Length
      faces(j)\normal\z = nz / _Length
    End If
  Next

End Statement

Statement CullFaces{}
SHARED faces(), xFaces(), xVerts()
  DEFTYPE.q x, y, z

  ;-- xFaces() is used as a real list: the visible faces are appended with AddLast and
  ;-- sorted once at the end. This replaces InsertTriangle, which had to move all following
  ;-- entries with CopyType for every inserted face.
  ClearList xFaces()
  numFacesX = 0
  For i.w = 0 To numFaces - 1
    USEPATH faces(i)
    x = xVerts(\v1)\x
    y = xVerts(\v1)\y
    z = xVerts(\v1)\z
    dotProd.q = (x * \normal\x) + (y * \normal\y) + (z * \normal\z)

    If dotProd > 0
       \avgZ = (xVerts(\v1)\z + xVerts(\v2)\z + xVerts(\v3)\z) / 3

       ;-- append the visible face to the list
       If AddLast(xFaces())
         CopyType faces(i), xFaces()
         numFacesX + 1
       EndIf
    End If
  Next

  ;-- sort back to front (painter's algorithm): largest depth first
  ;-- a quick is a 32 bit fixed point long, so SortList can use avgZ directly
  SortList xFaces(), SizeOf .Triangle\avgZ, -1
End Statement



Statement DrawLight{color.w}
SHARED light

  DEFTYPE.Vertex l
  l\x = 1.0 * (#hw * light\x) / light\z
  l\y = 1.0 * (#hh * light\y) / light\z
  l\z = 1.0 * Abs(light\z)

  Circle #hw + l\x, #hh + l\y, l\z, color
  Locate 0,18 : Print #hw + l\x, "," , #hh + l\y
End Statement

Statement DrawVertex{*V.Vertex, color.w, @idx.w}

  Plot #hw + *V\x, #hh + *V\y, color
  Plot #hw + *V\x, #hh + *V\y+1, color
  If idx <> -1
    FNSPrint 0, #hw + *V\x, #hh + *V\y+1, Str$(idx),1,color
  EndIf

End Statement

Statement DrawTriangle{*argV1.Vertex, *argV2.Vertex, *argV3.Vertex, color.w, @filled.b}
  DEFTYPE.Polygon p

  p\x0 = #hw + *argV1\x : p\y0 = #hh + *argV1\y
  p\x1 = #hw + *argV2\x : p\y1 = #hh + *argV2\y
  p\x2 = #hw + *argV3\x : p\y2 = #hh + *argV3\y
  p\x3 = p\x0           : p\y3 = p\y0

  If filled
    Polyf 3, &p, color
  Else
    ;FIX wireframe with Line, independent of how Poly closes the outline
    Line p\x0, p\y0, p\x1, p\y1, color
    Line p\x1, p\y1, p\x2, p\y2, color
    Line p\x2, p\y2, p\x0, p\y0, color
  EndIf

End Statement


Statement RenderFace{*srcTri.Triangle, color.w}
SHARED config, xVerts()

  ;-- The vertices are passed directly as pointers into xVerts(), no copies.
  ;-- The old sorting of the vertices by y (with up to 12 CopyType per face) was removed:
  ;-- Polyf and Line don't need a special order of the corners.
  Select config\renderMode
  Case #RENDER_WIREFRAME
    DrawTriangle{xVerts(*srcTri\v1), xVerts(*srcTri\v2), xVerts(*srcTri\v3), color, False}
  Case #RENDER_FILLED
    DrawTriangle{xVerts(*srcTri\v1), xVerts(*srcTri\v2), xVerts(*srcTri\v3), color, True}
  End Select

End Statement


Statement DrawObject{}
SHARED config, light, xFaces(), xVerts()

  If config\renderMode = #RENDER_DOTS OR config\showNums
    cstep.q = 16.0 / numVertices
    For i.w = 1 To numVertices
      If config\showNums
        DrawVertex{xVerts(i),i * cstep, i}
      Else
        DrawVertex{xVerts(i),i * cstep,-1}
      EndIf

    Next
    If NOT config\showNums Then Statement Return
  EndIf

  DEFTYPE.Vector n, ln
  DEFTYPE.q colF

  _len.q = Sqr(light\x * light\x + light\y * light\y + light\z * light\z)
  If _len > 0
    ln\x = light\x / _len : ln\y = light\y / _len : ln\z = 0 - light\z / _len
  Else
    ln\x = 0 : ln\y = 0 : ln\z = -1
  EndIf

  ;-- xFaces() is sorted as a list, so it must be read with the list commands, not by index
  k.w = 0                       ; position in the list, only for the debug output
  ResetList xFaces()
  While NextItem(xFaces())

    If config\normals
      CopyType xFaces()\normal, n

      DotProduct_.q = (n\x * ln\x) + (n\y * ln\y) + (n\z * ln\z)
      colF = 1 - (DotProduct_ * 14.0)
      If colF < 4 Then colF = 4
      If colF > 15 Then colF = 15
      color.b = colF
    Else
      color.b = 15
    EndIf

    RenderFace{xFaces(), color}

    If k < 20 AND config\showData
      Colour color
      NPrint "f",k," : ", xFaces()\v1, ", ", xFaces()\v2, ", ", xFaces()\v3
    EndIf
    k + 1
  Wend
End Statement




;-- Rotate around the y-axis, angle in radians
Statement RotateObject{angleX.q, angleY.q, angleZ.q}
SHARED xVerts()

  For i.w = 1 To numVertices

    If angleX <> 0
      _sinX.q = Sin(angleX) : _cosX.q = Cos(angleX)
      CopyType xVerts(i), vtx.Vertex
      xVerts(i)\y = vtx\y * _cosX - vtx\z * _sinX
      xVerts(i)\z = vtx\y * _sinX + vtx\z * _cosX
    EndIf

    If angleY <> 0
      _sinY.q = Sin(angleY) : _cosY.q = Cos(angleY)
      CopyType xVerts(i), vtx.Vertex
      xVerts(i)\x = vtx\z * _sinY + vtx\x * _cosY
      xVerts(i)\z = vtx\z * _cosY - vtx\x * _sinY
    EndIf

    If angleZ <> 0
      _sinZ.q = Sin(angleZ) : _cosZ.q = Cos(angleZ)
      CopyType xVerts(i), vtx.Vertex
      xVerts(i)\x = vtx\x * _cosZ - vtx\y * _sinZ
      xVerts(i)\y = vtx\x * _sinZ + vtx\y * _cosZ
    EndIf

  Next i
End Statement

Statement TransformObject{tX.q, tY.q, tZ.q}
SHARED xVerts()

  For i.w = 1 To numVertices
    xVerts(i)\x = xVerts(i)\x + tX
    xVerts(i)\y = xVerts(i)\y + tY
    xVerts(i)\z = xVerts(i)\z + tZ
  Next i
End Statement

Statement ScaleObject{fX.q, fY.q, fZ.q}
SHARED xVerts()

  For i.w = 1 To numVertices
    If fX <> 0 Then xVerts(i)\x = xVerts(i)\x * fX
    If fY <> 0 Then xVerts(i)\y = xVerts(i)\y * fY
    If fZ <> 0 Then xVerts(i)\z = xVerts(i)\z * fZ
  Next i
End Statement

Statement ApplyPerspective{}
SHARED xVerts()

  For i.w = 1 To numVertices
    ;-- divide first: #hw * x could leave the quick range for large x
    If xVerts(i)\z > 0
      xVerts(i)\x = xVerts(i)\x / xVerts(i)\z * #hw
      xVerts(i)\y = xVerts(i)\y / xVerts(i)\z * #hh
    EndIf
  Next i
End Statement

Statement CopyVerts{}
SHARED verts(), xVerts()
  For i.w = 1 To numVertices
    CopyType verts(i), xVerts(i)
  Next
End Statement

Statement CopyFaces{}
SHARED faces(), xFaces()
  ;-- all faces visible, unsorted (as before)
  ClearList xFaces()
  numFacesX = 0
  For i.w = 0 To numFaces - 1
    If AddLast(xFaces())
      CopyType faces(i), xFaces()
      numFacesX + 1
    EndIf
  Next
End Statement

Function.q getMaxZSize{}
SHARED verts()

  DEFTYPE.q tempZ
  For i.w = 1 To numVertices
    If Abs(verts(i)\z) > tempZ Then tempZ = Abs(verts(i)\z)
  Next
  Function Return tempZ
End Function

;-- Scale the model so that its largest coordinate is #MODELSIZE.
;-- This keeps all intermediate values (products, squares) inside the quick range,
;-- independent of the units used in the .obj file. The picture doesn't change,
;-- because the camera distance (tz) is calculated from the model size.
Statement NormaliseModel{}
SHARED verts()
  DEFTYPE.q m, f

  For i.w = 1 To numVertices
    If Abs(verts(i)\x) > m Then m = Abs(verts(i)\x)
    If Abs(verts(i)\y) > m Then m = Abs(verts(i)\y)
    If Abs(verts(i)\z) > m Then m = Abs(verts(i)\z)
  Next

  If m > 0
    f = #MODELSIZE / m
    For i = 1 To numVertices
      verts(i)\x = verts(i)\x * f
      verts(i)\y = verts(i)\y * f
      verts(i)\z = verts(i)\z * f
    Next
  EndIf
End Statement


; =========================================================================================================
AMIGA
objfile.s = "/Data/models/simple.obj"
objfile.s = "/Data/models/cube.obj"
;objfile.s = "/Data/models/pyramid.obj"
;objfile.s = "/Data/models/octahedron.obj"
;objfile.s = "/Data/models/diamond.obj"
objfile.s = "/Data/models/sphere3.obj"
;objfile.s = "/Data/models/humanoid_quad.obj"
;objfile.s = "/Data/models/humanoid_tri.obj"
;objfile.s = "/Data/models/spitf3.obj"
;objfile.s = "/Data/models/lamp.obj"
;objfile.s = "/Data/models/cylinder.obj"
;objfile.s = "/Data/models/dolphin.obj"

If NOT LoadModel{objfile}
  NPrint "not ok"
  End
EndIf
NormaliseModel{}


;-- Install font as number 1
#font=1
suc.l = InstallFNS(#font,?font_dat)
If suc<>#font
  NPrint "not font!"
  End
EndIf


;-- init the doubel buffering output and some fancy colors
BitMap 1,320,256,4
BitMap 0,320,256,4
Gosub getPointer

BLITZ
Slice 0,44,4: Show 0
InitPalette 0,16
For i.w = 0 To 15
  PalRGB 0,i, i, i, i
Next
ShowPalette 0
Pointer 0,0

;-- set bitmap 0 as output bitmap for print operations
BitMapOutput 0
FNSOutput 0,1


; --
; -- adjust the transformation to a suitable value
; --

tx.q = 0 : ty.q = 0 : tz.q = getMaxZSize{} * 2.5
config\renderMode = #RENDER_WIREFRAME
config\culling = True : config\normals = True

light\x = -.8
light\y = -.7
light\z = 1

; --
; -- main loop
; --
Mouse On : BlitzKeys On : exit.b = False
db.w = 1

;-- frame counter: total number of frames and frames per second,
frameCount.l = 0                   ; frames since program start
fpsFrames.l  = 0                   ; frames since the last FPS update
fpsStart.l   = Timer               ; time of the last FPS update
fps10.l      = 0                   ; frames per second * 10 (one decimal place without floats)

Repeat
  startTime.l = Timer
  lastkey.w = BlitzKey
  ;-----------
  CopyVerts{}
  RotateObject{angleX.q,angleY.q,angleZ.q}
  TransformObject{tx,ty,tz}
  ScaleObject{0,0,0}
  If config\normals Then CalcNormals{}
  If config\culling Then CullFaces{} Else CopyFaces{}
  ApplyPerspective{}

  Use BitMap db : BitMapOutput db : FNSOutput db,1
  Cls
  DrawObject{}
  If config\showLight Then DrawLight{15}
  ;-----------
  endTime.l = Timer

  Locate 0,0 : Colour 15
  NPrint objfile
  NPrint "Frame time: ", endTime - startTime, " / 50 s"
  NPrint "Frames: ", frameCount, "  FPS: ", fps10 / 10, ".", fps10 MOD 10, "   " 
  NPrint "Triangles: ", numFaces,", Vertices: ", numVertices      ;FIX both are counts now
  NPrint "Faces culled: ", numFaces - numFacesX
  NPrint "transform: ",tx," ",ty," ",tz
  NPrint "(L) (V) (C) (N) (I) (D) (W) (F) (+) (-)"

  Locate 0,17 : Print light\x, "," ,light\y

  If lastkey<>-1 Then olastkey.w = lastkey
  NPrint olastkey

  ;-- show the finished picture and swap the buffers
  VWait : Show db
  db = 1 - db

  If #FRAMEWAIT > 0 Then VWait #FRAMEWAIT

  ;-- update the frame counter (includes drawing, text output and VWait)
  frameCount + 1
  fpsFrames + 1
  now.l = Timer
  If now - fpsStart >= 50
    fps10 = fpsFrames * 500 / (now - fpsStart)
    fpsFrames = 0
    fpsStart = now
  EndIf

  Select lastkey

  Case 119 : config\renderMode = #RENDER_WIREFRAME        ; W
  Case 102 : config\renderMode = #RENDER_FILLED           ; F
  Case 100 : config\renderMode = #RENDER_DOTS             ; D

  Case 118 : config\showNums = -1-config\showNums          ; V
  Case 105 : config\showData = -1-config\showData          ; I
  Case  99 : config\culling = -1-config\culling            ; C
  Case 110 : config\normals = -1-config\normals            ; N
  Case 108 : config\showLight = -1-config\showLight        ; L

  Case 28: ty - 0.5  ; up
  Case 29: ty + 0.5  ; down
  Case 31: tx - 0.5  ; left
  Case 30: tx + 0.5  ; right
  Case 45: tz + 0.5  ; -
  Case 43: tz - 0.5  ; +

  Case 27 : exit = True
  End Select

  If Joyb(0) 
    light\x = 1.0 * (MouseX - #hw) / #hw
    light\y = 1.0 * (MouseY - #hh) / #hh
  EndIf

  angleY + (Pi / 128.0)
  If angleY > 2 * Pi Then angleY - 2 * Pi    ; keep the angle small (quick range)
  angleX = Pi + 0.05

Until exit = True
AMIGA
End

.getPointer:
  Use BitMap 0
  Line 0,3,7,3,1
  Line 3,0,3,7,1
  GetaShape 0,0,0, 7,7
  GetaSprite 0,0
Return

;-- Incbin our font into the compiled file to save effort later
font_dat: IncBin "/data/FNS/fonts/Times15.FNS"
