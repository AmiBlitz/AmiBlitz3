; ExeFile         = "3d"
; CreateIcon      = 0
; Residents       = "all.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 100000
; MakeSmallest    = 1
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 515
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8192
; RuntimeDebug    = 1
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 603
; CursorColumn    = 1
; LabelSearch     = "drawvertex"
; LabelRemark     = 0
; LabelAll        = 1
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 100
; Max GadgetList  = 100
; Max Shape       = 200
; Max MenuList    = 100
; Max IntuiFont   = 10
; Max BlitzFont   = 1
; Max Bank        = 1
; Max GTList      = 100
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 100
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max Window      = 100
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 4
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; /XTRA
;--
;-- based on the video "Its QBasic time"
;-- by Old Man Yells at Code:
;-- https://www.youtube.com/watch?v=Ax9j_C1ouSI&t=1348s
;--

OPTIMIZE 5: SYNTAX 6

#RENDER_DOTS = 0
#RENDER_WIREFRAME = 1
#RENDER_FILLED = 2

#SWIDTH = 320
#SHEIGHT = 256
#hw = #SWIDTH / 2
#hh = #SHEIGHT / 2

NEWTYPE.config
  showNums.b
  showData.b
  showLight.b
  renderMode.b
  culling.b
  normals.b
End NEWTYPE
DEFTYPE.config config

NEWTYPE.Vertex
  x.f
  y.f
  z.f
End NEWTYPE

NEWTYPE.Vector
  x.f
  y.f
  z.f
End NEWTYPE

NEWTYPE.Triangle
  v1.w   ;Index of Vertex 1
  v2.w   ;Index of Vertex 2
  v3.w   ;Index of Vertex 3
  normal.Vector
  avgZ.f
End NEWTYPE

;-- used for drawing
NEWTYPE.Polygon
  x0.w : y0.w
  x1.w : y1.w
  x2.w : y2.w
  x3.w : y3.w
End NEWTYPE

DEFTYPE.Vector light,light2
Dim List verts.Vertex(750)
Dim List xVerts.Vertex(750)
Dim List faces.Triangle(1500)
Dim List xFaces.Triangle(1500)
SHARED numFaces.w
SHARED numFacesX.w          ; culled number of faces
SHARED numVertices.w

BLITZ

;============================================================================================
Function.b LoadModel{modelname.s}
SHARED verts(), faces(), xVerts(), xFaces()

  DEFTYPE.s rawLine
  DEFTYPE.s prefix
  DEFTYPE.s val1, val2, val3
  DEFTYPE.b vIndex

  noerrors.b = True
  If ReadFile(0,modelname)
    FileInput 0

    ClearList verts() : dummy.b = AddLast(verts()) ; add dummy vertex, as count starts with 1
    ClearList xVerts(): dummy.b = AddLast(xVerts())
    ClearList faces()
    While NOT Eof(0) OR anyerror.b
      rawLine = Edit$(80)

      InitArgParse rawLine
      prefix = NextArg$

      If prefix <> ""
        If prefix = "v" OR prefix = "f"
          val1 = NextArg$
          val2 = NextArg$
          val3 = NextArg$
        End If

        Select prefix
        Case "i" ; if i is set, the index of vertices should be at 0 instead of 1
          vIndex = 1
        Case "v"
          NPrint CountItem(verts()),": ", val1," ",val2," ",val3
          If AddLast(verts())
            verts()\x = Val(val1)
            verts()\y = Val(val2)
            verts()\z = Val(val3)
            dummy.b = AddLast(xVerts())
          Else
            NPrint "Could not add vertex to list!"
            noerrors = False
          EndIf

        Case "f"
          ;-- the numbers of vertices start with 1 in the definitions file!
          If AddLast(faces())
            faces()\v1 = Val(val1) + vIndex
            faces()\v2 = Val(val2) + vIndex
            faces()\v3 = Val(val3) + vIndex
            dummy.b = AddLast(xFaces())
          Else
            NPrint "Could not add face to list!"
            noerrors = False
          EndIf

        Case "#"
          ; comment

        Case "g"
          ; name of object
        Default
          NPrint "unsupported prefix <",prefix,">"
        End Select
      EndIf
    Wend
    numFaces = CountList(faces())
    numVertices = CountList(verts())
    CloseFile 0
    DefaultInput
  Else
   noerrors = False
  EndIf
  Function Return noerrors
End Statement


Statement CalcNormals{}
SHARED faces(), xVerts()

  DEFTYPE.Triangle f
  DEFTYPE.Vertex v1, v2, v3
  DEFTYPE.f ax, ay, az
  DEFTYPE.f bx, by, bz
  DEFTYPE.f nx, ny, nz

  For j.w = 0 To numFaces ;CountList(faces())
    CopyType faces(j), f
    CopyType xVerts(f\v1),v1
    CopyType xVerts(f\v2),v2
    CopyType xVerts(f\v3),v3

    ;-- Edge vector A V3 - V1
    ax = v3\x - v1\x
    ay = v3\y - v1\y
    az = v3\z - v1\z

    ;-- Edge vector B V2 - V1
    bx = v2\x - v1\x
    by = v2\y - v1\y
    bz = v2\z - v1\z

    ;-- Calc cross product
    nx = (ay * bz) - (az * by)
    ny = (az * bx) - (ax * bz)
    nz = (ax * by) - (ay * bx)

    ;-- Normalize vector
    _Length.f = Sqr(nx * nx + ny * ny + nz * nz)

    If _Length > 0
      faces(j)\normal\x = 1.0 * nx / _Length
      faces(j)\normal\y = 1.0 * ny / _Length
      faces(j)\normal\z = 1.0 * nz / _Length
    End If
  Next

End Statement

Statement InsertTriangle{*tri.Triangle, _Length.w}
SHARED xFaces()
  DEFTYPE.Triangle temp
  For i.w = 0 To _Length - 1
    If *tri\avgZ > xFaces(i)\avgZ        ;Found spot To insert tri
      For j.w = _Length To i + 1 Step -1 ;Shuffle existing items forward
        ;SWAP faces(j), faces(j - 1)
        CopyType xFaces(j), temp
        CopyType xFaces(j-1), xFaces(j)
        CopyType temp, xFaces(j-1)
      Next
      CopyType *tri, xFaces(i)
      Pop For : Goto endF
    End If
  Next
  endF:

  If i = _Length
    CopyType *tri, xFaces(_Length)
  End If

End Statement


Statement CullFaces{}
SHARED faces(), xFaces(), xVerts()
  DEFTYPE.Vector camVtr
  DEFTYPE.f x, y, z

  numFacesX = -1
  For i.w = 0 To numFaces; CountList(faces())
    USEPATH faces(i)
    ;-- The camera vector is the normalised vector from the origin to the first vertex of the triangle
    x = xVerts(\v1)\x
    y = xVerts(\v1)\y
    z = xVerts(\v1)\z
    _Length.f = Sqr(x * x + y * y + z * z)
    camVtr\x = x / _Length
    camVtr\y = y / _Length
    camVtr\z = z / _Length

    dotProd.f = (camVtr\x * \normal\x) + (camVtr\y * \normal\y) + (camVtr\z * \normal\z)

    If dotProd > 0
       \avgZ = (xVerts(\v1)\z + xVerts(\v2)\z + xVerts(\v3)\z) / 3

       ;-- Insert triangles in order
       numFacesX + 1
       InsertTriangle{faces(i), numFacesX}
    End If
  Next
  ShellSort &xFaces(),numFacesX
End Statement



Statement DrawLight{color.w}
SHARED light

  DEFTYPE.Vertex l
  l\x = 1.0 * (#hw * light\x) / light\z
  l\y = 1.0 * (#hh * light\y) / light\z
  l\z = 1.0 * Abs(light\z)

  Circle #hw + l\x, #hw + l\y, l\z, color
  Locate 0,18 : Print #hw + l\x, "," , #hh + l\y
End Statement

Statement DrawVertex{*V.Vertex, color.w, @idx.w}

  Plot #hw + *V\x, #hh + *V\y, color
  Plot #hw + *V\x, #hh + *V\y+1, color
  If idx <> -1
    FNSPrint 0, #hw + *V\x, #hh + *V\y+1, Str$(idx),1,color
  EndIf

End Statement

Statement DrawTriangle{*argV1.Vertex, *argV2.Vertex, *argV3.Vertex, color.w, @filled.b}
  DEFTYPE.Vertex temp

  CopyType *argV1, v1.Vertex
  CopyType *argV2, v2.Vertex
  CopyType *argV3, v3.Vertex

  ;-- Fix order of V2 AND V3 by x val
  If v2\x > v3\x
    ;Swap v2, v3
    CopyType v2, temp
    CopyType v3, v2
    CopyType temp, v3
  End If

  p.Polygon\x0 = #hw + v1\x, #hh + v1\y
  p.Polygon\x1 = #hw + v2\x, #hh + v2\y
  p.Polygon\x2 = #hw + v3\x, #hh + v3\y
;  p.Polygon\x3 = #hw + v1\x, #hh + v1\y

  If filled
    Polyf 3,p, color;,-1
  Else
    Poly 3,p, color
  EndIf

End Statement


Statement RenderFace{*srcTri.Triangle, color.w}
SHARED config, xVerts()

  DEFTYPE.Vertex v1,v2,v3,v4, temp

  CopyType xVerts(*srcTri\v1),v1
  CopyType xVerts(*srcTri\v2),v2
  CopyType xVerts(*srcTri\v3),v3

  ;-- Sort the verticies by y value
  If v1\y < v2\y    ;Swap v1, v2
    CopyType v2, temp
    CopyType v1, v2
    CopyType temp, v1
  End If

  If v2\y < v3\y    ;Swap v2, v3
    CopyType v3, temp 
    CopyType v2, v3
    CopyType temp, v2
  End If

  If v1\y < v2\y    ;Swap v1, v2
    CopyType v2, temp
    CopyType v1, v2
    CopyType temp, v1
  End If
skip:

  Select config\renderMode
  Case #RENDER_WIREFRAME
    DrawTriangle{v1, v2, v3, color, False}
  Case #RENDER_FILLED
    DrawTriangle{v1, v2, v3, color, True}
  End Select

End Statement


Statement DrawObject{}
SHARED config, light, xFaces(), xVerts()

  If config\renderMode = #RENDER_DOTS OR config\showNums
    cstep.f = 16.0 / numVertices
    For i.w = 1 To numVertices
      If config\showNums
        DrawVertex{xVerts(i),i * cstep, i}
      Else
        DrawVertex{xVerts(i),i * cstep,-1}
      EndIf

    Next
    If NOT config\showNums Then Statement Return
  EndIf

  DEFTYPE.Vector n
  For i.w = 0 To numFacesX

    If config\normals
      CopyType xFaces(i)\normal, n

      DotProduct_.f = (n\x * light\x) + (n\y * light\y) + (n\z * light\z)
      Locate 0,0 : NPrint DotProduct_
      color.b = 15 - (DotProduct_ * 15.0)
    Else
      color.b = 15
    EndIf

    RenderFace{xFaces(i), color}

    If i < 20 AND config\showData
      Colour color
      NPrint "f",i," : ", xFaces(i)\v1, ", ", xFaces(i)\v2, ", ", xFaces(i)\v3
    EndIf
  Next i
End Statement




;-- Rotate around the y-axis, angle in radians
Statement RotateObject{angleX.f, angleY.f, angleZ.f}
SHARED xVerts()

  For i.w = 1 To numVertices

    If angleX <> 0
      _sinX.f = Sin(angleX) : _cosX.f = Cos(angleX)
      CopyType xVerts(i), vtx.Vertex
      xVerts(i)\y = vtx\y * _cosX - vtx\z * _sinX
      xVerts(i)\z = vtx\y * _sinX + vtx\z * _cosX
    EndIf

    If angleY <> 0
      _sinY.f = Sin(angleY) : _cosY.f = Cos(angleY)
      CopyType xVerts(i), vtx.Vertex
      xVerts(i)\x = vtx\z * _sinY + vtx\x * _cosY
      xVerts(i)\z = vtx\z * _cosY - vtx\x * _sinY
    EndIf

    If angleZ <> 0
      _sinZ.f = Sin(angleZ) : _cosZ.f = Cos(angleZ)
      CopyType xVerts(i), vtx.Vertex
      xVerts(i)\x = vtx\x * _cosZ - vtx\y * _sinZ
      xVerts(i)\y = vtx\x * _sinZ + vtx\y * _cosZ
    EndIf

  Next i
End Statement

Statement TransformObject{tX.f, tY.f, tZ.f}
SHARED xVerts()

  For i.w = 1 To numVertices
    xVerts(i)\x = xVerts(i)\x + tX
    xVerts(i)\y = xVerts(i)\y + tY
    xVerts(i)\z = xVerts(i)\z + tZ
  Next i
End Statement

Statement ScaleObject{fX.f, fY.f, fZ.f}
SHARED xVerts()

  For i.w = 1 To numVertices
    If fX <> 0 Then xVerts(i)\x = xVerts(i)\x * fX
    If fY <> 0 Then xVerts(i)\y = xVerts(i)\y * fY
    If fZ <> 0 Then xVerts(i)\z = xVerts(i)\z * fZ
  Next i
End Statement

Statement ApplyPerspective{}
SHARED xVerts()

  For i.w = 1 To numVertices
    xVerts(i)\x = 1.0 * (#hw * xVerts(i)\x) / xVerts(i)\z
    xVerts(i)\y = 1.0 * (#hh * xVerts(i)\y) / xVerts(i)\z
  Next i
End Statement

Statement CopyVerts{}
SHARED verts(), xVerts()
  For i.w = 1 To numVertices
    CopyType verts(i), xVerts(i)
  Next
End Statement

Statement CopyFaces{}
SHARED faces(), xFaces()
  For i.w = 0 To numFaces
    CopyType faces(i), xFaces(i)
  Next
  numFacesX = numFaces
End Statement

Function.f getMaxZSize{}
SHARED verts()

  DEFTYPE.f tempZ
  For i.w = 1 To numVertices
    If Abs(verts(i)\z) > tempZ Then tempZ = Abs(verts(i)\z)
  Next
  Function Return tempZ
End Statement


; =========================================================================================================
AMIGA
objfile.s = "/Data/models/simple.obj"
objfile.s = "/Data/models/cube.obj"
;objfile.s = "/Data/models/pyramid.obj"
;objfile.s = "/Data/models/octahedron.obj"
;objfile.s = "/Data/models/diamond.obj"
;objfile.s = "/Data/models/sphere3.obj"
;objfile.s = "/Data/models/humanoid_quad.obj"
;objfile.s = "/Data/models/humanoid_tri.obj"
;objfile.s = "/Data/models/spitf3.obj"
;objfile.s = "/Data/models/lamp.obj"
;objfile.s = "/Data/models/cylinder.obj"
;objfile.s = "/Data/models/dolphin.obj"

If NOT LoadModel{objfile}
  NPrint "not ok"
  End
EndIf


;-- Install font as number 1
#font=1
suc.l = InstallFNS(#font,?font_dat)
If suc<>#font
  NPrint "not font!"
  End
EndIf


;-- init the output and some fancy colors
BitMap 0,320,256,4
Gosub getPointer
BLITZ
Slice 0,44,4: Show 0
InitPalette 0,16
For i.w = 0 To 15
  PalRGB 0,i, i, i, i
Next
ShowPalette 0
Pointer 0,0
;-- set bitmap 0 as output bitmap for print operations
BitMapOutput 0
FNSOutput 0,1


; --
; -- adjust the transformation to a suitable value
; --

  ;light\x = .3
  ;light\y = -.3
  ;light\z = .91
  ;light\x = .577
  ;light\y = -.577
  ;light\z = .577

tx.f = 0 : ty.f = 0 : tz.f = getMaxZSize{} * 2.5
config\renderMode = #RENDER_WIREFRAME
config\culling = True : config\normals = True

light\x = -.8
light\y = -.7
light\z = 1

; --
; -- main loop
; --
Mouse On : BlitzKeys On : exit.b = False
Repeat
  startTime.f = Timer
  lastkey.w = BlitzKey

  CopyVerts{}
  RotateObject{angleX.f,angleY.f,angleZ.f}
  TransformObject{tx,ty,tz}
  ScaleObject{0,0,0}
  If config\normals Then CalcNormals{}
  If config\culling Then CullFaces{} Else CopyFaces{}
  ApplyPerspective{}


  Cls : VWait 1
  DrawObject{}
  If config\showLight Then DrawLight{15}

  endTime.f = Timer

  Locate 0,0 : Colour 15
  NPrint objfile
  NPrint "Frame time: ", endTime - startTime
  NPrint "Triangles: ", numFaces + 1,", Vertices: ", numVertices + 1
  NPrint "Faces culled: ", numFaces - numFacesX
  NPrint "transform: ",tx," ",ty," ",tz
  NPrint "(L) (V) (C) (N) (I) (D) (W) (F) (+) (-)"

  Locate 0,17 : Print light\x, "," ,light\y

  If lastkey<>-1 Then olastkey.w = lastkey
  NPrint olastkey
  VWait 5

  Select lastkey

  Case 119 : config\renderMode = #RENDER_WIREFRAME        ; W
  Case 102 : config\renderMode = #RENDER_FILLED           ; F
  Case 100 : config\renderMode = #RENDER_DOTS             ; D

  Case 118 : config\showNums = -1-config\showNums          ; V
  Case 105 : config\showData = -1-config\showData          ; I
  Case  99 : config\culling = -1-config\culling            ; C
  Case 110 : config\normals = -1-config\normals            ; N
  Case 108 : config\showLight = -1-config\showLight        ; L

  Case 28: ty - 0.5  ; up
  Case 29: ty + 0.5  ; down
  Case 31: tx - 0.5  ; left
  Case 30: tx + 0.5  ; right
  Case 45: tz + 0.5  ; -
  Case 43: tz - 0.5  ; +

  Case 27 : exit = True
  End Select

  If Joyb(0) 
    light\x = (MouseX-#hw) / #hw * 1.0
    light\y = (MouseY-#hh) / #hh * 1.0
  EndIf

  angleY + (Pi / 128.0)
  angleX = Pi + 0.05

Until exit = True
AMIGA
End

.getPointer:
  Use BitMap 0
  Line 0,3,7,3,1
  Line 3,0,3,7,1
  GetaShape 0,0,0, 7,7
  GetaSprite 0,0
Return

;-- Incbin our font into the compiled file to save effort later
font_dat: IncBin "/data/FNS/fonts/Times15.FNS"
