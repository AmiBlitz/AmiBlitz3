#GID_INTEGER_1  = 9
#GID_GETFILE    = 10
#GID_GETFONT    = 11
#GID_GETSCREEN  = 12
#GID_LISTBROWSER= 13
#GID_LISTVIEW   = 14
#GID_RADIOBUTTON= 15
#GID_FUELGAUGE  = 16

space1.l  = !SpaceObject, !EndObject
space2.l  = !SpaceObject, !EndObject

*clicktabList1.List = ClickTabsA{"About|Settings|Gadgets|Listbrowser"}

*chooserList1.List = InitChooserList{}
For z.b = 0 To 9
  AddChooserListEntry{*chooserList1, "Entry " + Str$(z)}
  ;AddChooserListEntry{*chooserList1,"leute"}
Next z

*cinfo.ColumnInfo = AllocLBColumnInfoA_(2,VarArgs(@@
                      #LBCIA_Column, 0, #LBCIA_Title,StrAddr("test1"), #LBCIA_Weight,50,@@
                      #LBCIA_Column, 1, #LBCIA_Title,StrAddr("test2"), #LBCIA_Weight,50,@@
                      #TAG_DONE))


;*lblist.List = BrowserNodesA{"Topic|Issue|a|b|c|d|e"}
*lblist.List = InitListBrowserList{}
For z.b = 0 To 9
  AddListBrowserListEntry{*lblist, 2,VarArgs(#LBNA_Column, 0, #LBNCA_Text, StrAddr("entry a" + Str$(z)),@@
                                #LBNA_Column, 1, #LBNCA_Text, StrAddr("entry b" + Str$(z)),@@
                                #TAG_DONE)}
Next

*lvlabels.ListLabelNode = ListviewLabelsA{"Hallo|Ich|Bin|Jetzt|Hier"}

*rblabels.List = RadioButtonsA{"option1|option2"}



reactObj(#GID_BUTTON_QUIT) = !ButtonObject, @@
            #GA_ID, #GID_BUTTON_QUIT, @@
            #GA_RelVerify, True, @@
            #GA_Text, StrAddr("_Quit"), @@
            !EndObject

