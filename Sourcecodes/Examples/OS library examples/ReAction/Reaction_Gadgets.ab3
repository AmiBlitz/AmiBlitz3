; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = "RAM Disk:"
; ExeFile         = "react.exe"
; CreateIcon      = 1
; Residents       = "all2.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 1
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 429
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 1
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 0
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 57
; CursorColumn    = 1
; LabelSearch     = "#GID_LISTBROWSER"
; LabelRemark     = 0
; LabelAll        = 1
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 20
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 100
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max Window      = 100
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 4
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; /XTRA
; -- Reaction Simple Window, as demonstrated at
; -- http://www.pjhutchison.org/tutorial/reaction_window.html

;-- activate new syntax mode
WBStartup : OPTIMIZE 4 : SYNTAX 3

INCLUDE "reactionlib.include.ab3"

; =====================================================================
*WindowBase.Library = OpenLibrary_("window.class", 44)
*LabelBase.Library  = OpenLibrary_("images/label.image", 44)
*LayoutBase.Library = OpenLibrary_("gadgets/layout.gadget", 44)
*SpaceBase.Library = OpenLibrary_("gadgets/space.gadget", 44)
*CheckboxBase.Library = OpenLibrary_("gadgets/checkbox.gadget", 44)
*ChooserBase.Library = OpenLibrary_("gadgets/chooser.gadget", 44)
*StringBase.Library = OpenLibrary_("gadgets/string.gadget", 44)
*IntegerBase.Library = OpenLibrary_("gadgets/integer.gadget", 44)
*GetfileBase.Library = OpenLibrary_("gadgets/getfile.gadget", 44)
*GetfontBase.Library = OpenLibrary_("gadgets/getfont.gadget", 44)
*GetscreenmodeBase.Library = OpenLibrary_("gadgets/getscreenmode.gadget", 44)
*ClicktabBase.Library = OpenLibrary_("gadgets/clicktab.gadget", 44)
*ListbrowserBase.Library = OpenLibrary_("gadgets/listbrowser.gadget", 44)
*ListviewBase.Library = OpenLibrary_("gadgets/listview.gadget", 44)
*RadiobuttonBase.Library = OpenLibrary_("gadgets/radiobutton.gadget", 44)
*FuelgaugeBase.Library = OpenLibrary_("gadgets/fuelgauge.gadget", 44)

_test1.l = (*WindowBase=0) OR (*LayoutBase=0) OR (*ClicktabBase=0)
_test2.l = *LabelBase=0 OR *CheckboxBase=0 OR *ChooserBase=0 OR *StringBase=0 OR *IntegerBase=0 OR *GetfileBase=0 OR *GetfontBase=0 OR *ListbrowserBase=0 OR *RadiobuttonBase=0 OR *FuelgaugeBase=0
If (_test1 OR _test2)
  NPrint "A library could not be opened!"
  NPrint _test1
  NPrint _test2
  VWait 50
  Goto cleanup
EndIf

*AppPort.MsgPort = CreateMsgPort_
If *AppPort = 0
  NPrint "Could not get a message port."
  Goto cleanup
EndIf

; =============================================================================
Dim reactObj.l(20)
#GID_CLICKTABS  = 0
#GID_PAGE1      = 1
#GID_BUTTON_QUIT= 3
#GID_CHECKBOX_1 = 4
#GID_CHECKBOX_2 = 5
#GID_CHECKBOX_3 = 6
