          #INTEGER_MaxChars, 6, @@
          #INTEGER_Minimum, -2, @@
          #INTEGER_Maximum, 10000, @@
          #INTEGER_Number, 42, @@
          !IntegerEnd

labint1.l = !LabelObject, #LABEL_Text, StrAddr("_Integer"), !LabelEnd
labstr1.l = !LabelObject, #LABEL_Text, StrAddr("_String"), !LabelEnd

reactObj(#GID_GETFILE) = !GetFileObject, @@
          #GA_ID, #GID_GETFILE, @@
          #GA_RelVerify, True, @@
          !EndObject

reactObj(#GID_GETFONT) = !GetFontObject, @@
          #GA_ID, #GID_GETFONT, @@
          #GA_RelVerify, True, @@
          !EndObject

reactObj(#GID_GETSCREEN) = !GetScreenModeObject, @@
          #GA_ID, #GID_GETSCREEN, @@
          #GA_RelVerify, True, @@
          !EndObject

reactObj(#GID_RADIOBUTTON) = !RadioButtonObject, @@
                             #GA_ID, #GID_RADIOBUTTON, @@
