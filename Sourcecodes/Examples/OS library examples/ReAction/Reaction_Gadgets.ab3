reactObj(#GID_FUELGAUGE)   = !FuelGaugeObject, @@
                             #GA_ID, #GID_FUELGAUGE, @@
                             #GA_RelVerify, True, @@
                             #FUELGAUGE_Min, 0, @@
                             #FUELGAUGE_Max, 100, @@
                             #FUELGAUGE_Level, 10, @@
                             #FUELGAUGE_Percent, True, @@
                             #FUELGAUGE_Ticks, 5, @@,
                             #FUELGAUGE_TickSize, 5, @@,
                             #FUELGAUGE_ShortTicks, True ,@@,
                             !FuelGaugeEnd


label.l = !LabelObject, @@
          #LABEL_Text, StrAddr("This is the first application\\nthat has been compiled with AmiBlitz3!\\nNice !"), @@
          !LabelEnd

vlay1.l = !VLayoutObject, @@
          #LAYOUT_SpaceOuter, True, @@
          #LAYOUT_SpaceInner, True, @@
          #LAYOUT_BevelStyle, #BVS_GROUP, @@
          #LAYOUT_Label,StrAddr("Textlabel"), @@
          #LAYOUT_LabelPlace, #BVJ_TOP_LEFT, @@
          #LAYOUT_HorizAlignment, #LALIGN_CENTER, @@
          #LAYOUT_AddImage, label, @@
          !LayoutEnd

vlay2.l = !VLayoutObject, @@
          #LAYOUT_SpaceOuter, True, @@
          #LAYOUT_SpaceInner, True, @@
          #LAYOUT_BevelStyle, #BVS_THIN, @@
          #LAYOUT_Label,StrAddr("Buttons"), @@
          #LAYOUT_LabelPlace, #BVJ_TOP_LEFT, @@
          #LAYOUT_AddChild, reactObj(#GID_CHOOSER), @@
          #LAYOUT_AddChild, reactObj(#GID_CHECKBOX_1), @@
          #LAYOUT_AddChild, reactObj(#GID_CHECKBOX_2), @@
          #LAYOUT_AddChild, reactObj(#GID_CHECKBOX_3), @@
          #LAYOUT_AddChild, reactObj(#GID_STRING_1), @@
          #CHILD_Label, labstr1, @@
          #CHILD_Label, labint1, @@
          #LAYOUT_AddChild, reactObj(#GID_INTEGER_1), @@
          #LAYOUT_AddChild, reactObj(#GID_RADIOBUTTON), @@
          #LAYOUT_AddChild, reactObj(#GID_FUELGAUGE), @@
          !LayoutEnd

vlay3.l = !VLayoutObject, @@
          #LAYOUT_SpaceOuter, True, @@
          #LAYOUT_SpaceInner, True, @@
          #LAYOUT_BevelStyle, #BVS_THIN, @@
          #LAYOUT_Label,StrAddr("Requesters"), @@
          #LAYOUT_LabelPlace, #BVJ_TOP_LEFT, @@
          #LAYOUT_AddChild, reactObj(#GID_GETFONT), @@
          #CHILD_WeightedHeight, 0, @@
          #LAYOUT_AddChild, reactObj(#GID_GETFILE), @@
          #CHILD_WeightedHeight, 0, @@
          #LAYOUT_AddChild, reactObj(#GID_GETSCREEN), @@
          #CHILD_WeightedHeight, 0, @@
          !LayoutEnd

reactObj(#GID_LISTBROWSER) = !ListBrowserObject, @@
          #GA_ID, #GID_LISTBROWSER, @@
          #GA_RelVerify, True, @@
          #LISTBROWSER_ColumnInfo, *cinfo, @@
          #LISTBROWSER_ColumnTitles, True, @@
          #LISTBROWSER_TitleClickable, True, @@
          #LISTBROWSER_Labels,*lblist, @@
          #LISTBROWSER_ShowSelected, True, @@
          #LISTBROWSER_Separators, True, @@
          !ListBrowserEnd

reactObj(#GID_LISTVIEW) = !ListViewObject, @@
                          #GA_ID, #GID_LISTVIEW, @@
                          #GA_RelVerify, True, @@
                          #LISTVIEW_Labels, *lvlabels, @@
                          !ListViewEnd

vlay4.l = !VLayoutObject, @@
          #LAYOUT_SpaceOuter, True, @@
          #LAYOUT_SpaceInner, True, @@
          #LAYOUT_AddChild, reactObj(#GID_LISTBROWSER), @@
          #LAYOUT_AddChild, reactObj(#GID_LISTVIEW), @@
          !LayoutEnd

pages.l = !PageObject, @@
          #LAYOUT_DeferLayout, True, @@
          #LAYOUT_SpaceOuter, True, @@
          #LAYOUT_SpaceInner, True, @@
          #PAGE_Add, vlay1, @@
          #PAGE_Add, vlay3, @@
          #PAGE_Add, vlay2, @@
          #PAGE_Add, vlay4, @@
          !PageEnd

reactObj(#GID_CLICKTABS) = !ClickTabsObject, @@
            #GA_ID, #GID_CLICKTABS,@@
            #GA_RelVerify, True, @@
            #CLICKTAB_Labels,*clicktabList1,@@
            #CLICKTAB_Current,3,@@
            #CLICKTAB_PageGroup, pages, @@
            !ClickTabsEnd


*winlayout.l = !VLayoutObject, @@
               #LAYOUT_SpaceOuter, True, @@
               #LAYOUT_SpaceInner, True, @@
               #LAYOUT_DeferLayout, True, @@
               #LAYOUT_SpaceOuter, 12, @@
               #LAYOUT_AddChild, reactObj(#GID_CLICKTABS), @@
               #LAYOUT_AddChild, reactObj(#GID_BUTTON_QUIT), @@
               #CHILD_WeightedHeight, 0, @@
               !LayoutEnd

*winobj.l = !WindowObject, @@
            #WA_ScreenTitle, StrAddr("AmiBlitz3: ReAction !!"), @@
            #WA_Title, StrAddr("AmiBlitz3 ReAction Example"), @@
            #WA_Activate, True, @@
            #WA_DepthGadget, True, @@
            #WA_DragBar, True, @@
            #WA_CloseGadget, True, @@
            #WA_SizeGadget, True, @@
            #WA_Width, 400, @@
            #WA_Height, 150, @@
            #WINDOW_IconifyGadget, True, @@
            #WINDOW_IconTitle, "Example", @@
            #WINDOW_AppPort, *AppPort, @@
            #WINDOW_AppWindow, True, @@
            #WINDOW_Position, #WPOS_CENTERSCREEN, @@
            #WINDOW_ParentGroup, *winlayout, @@
            !EndObject

If (*winobj)
  *win.Window = !RA_OpenWindow{*winobj}
  If *win
    DEFTYPE.l _wait, signal, app, result
    DEFTYPE.l getattribute
    DEFTYPE.w done, code, selgadget
    GetAttr_ #WINDOW_SigMask, *winobj, &signal
    app = 1 LSL *AppPort\mp_SigBit
    NPrint "app:", Hex$(app), " signal:", Hex$(signal)
  
    done = False
    While (NOT done)
      _wait = Wait_( signal | #SIGBREAKF_CTRL_C | app)
      
      If (_wait AND #SIGBREAKF_CTRL_C)
        done = True
      Else
        Repeat
          result = !RA_HandleInput{*winobj, &code}

          Select (result AND #WMHI_CLASSMASK)
          Case #WMHI_CLOSEWINDOW:
            done = True

          Case #WMHI_ICONIFY
            NPrint "Iconify", !RA_Iconify{*winobj}

          Case #WMHI_UNICONIFY
            NPrint "Uniconfiy!", !RA_Uniconify{*winobj}

          Case #WMHI_GADGETUP
            selgadget = (result AND #WMHI_GADGETMASK)
            NPrint "Gadget #", selgadget

            Select selgadget
            Case #GID_BUTTON_QUIT
              done = True

            Case #GID_RADIOBUTTON
              GetAttr_ #RADIOBUTTON_Selected, reactObj(#GID_RADIOBUTTON), &getattribute
              NPrint "selected entry: ", getattribute
              SetGadgetAttrsA_ reactObj(#GID_FUELGAUGE),*win,0,VarArgs(#FUELGAUGE_Level,getattribute * 25,#TAG_DONE)

            Case #GID_CHOOSER
              GetAttr_ #CHOOSER_Selected, reactObj(#GID_CHOOSER), &getattribute
              NPrint "selected entry: ", getattribute

            Case #GID_GETFILE
              If DoMethod(reactObj(#GID_GETFILE), #GFILE_REQUEST, 0)
                GetAttr_ #GETFILE_FullFile,reactObj(#GID_GETFILE), &getattribute
                NPrint "File ", Peek.s(getattribute)
              EndIf

            Case #GID_GETFONT
              If DoMethod(reactObj(#GID_GETFONT), #GFONT_REQUEST, *win)
                GetAttr_ #GETFONT_TextAttr, reactObj(#GID_GETFONT), &getattribute
                NPrint "Font ", Peek.s(Peek.l(getattribute))
              EndIf

            Case #GID_GETSCREEN
              If DoMethod(reactObj(#GID_GETSCREEN), #GSM_REQUEST, *win)
                GetAttr_ #GETSCREENMODE_DisplayID,reactObj(#GID_GETSCREEN), &getattribute
                NPrint "Screen ", getattribute
              EndIf
            End Select

          Case #WMHI_GADGETHELP
            NPrint "Gadget help ", Hexw$(code)
          Case #WMHI_CHANGEWINDOW
            NPrint "Window changed!"
          Case #WMHI_INACTIVE
            NPrint "Window inactive"
          Case #WMHI_ACTIVE
            NPrint "Window active!"
          Case #WMHI_RAWKEY
            NPrint "keypressed!"
          Case #WMHI_MOUSEBUTTONS
            NPrint "Mouse click!"          

          Default
            If result OR code
              NPrint "received signal: ", Hex$(_wait)," result: ",Hex$(result), " code: ",Hexw$(code)
            EndIf

          End Select
        Until done OR (result = #WMHI_LASTMSG)
      EndIf
    Wend
  EndIf
Else
  NPrint "Window could not be opened."
EndIf

cleanup:
NPrint "Cleaning up..."

;-- removing window and all linked objects
DisposeObject_ *winobj

;-- freeing datalists for objects
If *chooserList1 Then FreeChooserLabels{*chooserList1}
If *clicktabList1 Then FreeClickTabs{*clicktabList1}
If *lblist Then FreeListBrowserNodes{*lblist}
If *lvlabels Then FreeListviewLabels{*lvlabels}

;-- remove message port
DeleteMsgPort_ *AppPort

;--  closing used libraries
If *RadiobuttonBase Then CloseLibrary_ *RadiobuttonBase
If *GetfontBase Then CloseLibrary_ *GetfontBase
If *GetscreenmodeBase Then CloseLibrary_ *GetscreenmodeBase
If *GetfileBase Then CloseLibrary_ *GetfileBase
If *StringBase Then CloseLibrary_ *StringBase
If *IntegerBase Then CloseLibrary_ *IntegerBase
If *CheckboxBase Then CloseLibrary_ *CheckboxBase
If *ChooserBase Then CloseLibrary_ *ChooserBase
If *SpaceBase Then CloseLibrary_ *SpaceBase
If *LabelBase Then CloseLibrary_ *LabelBase
If *ListbrowserBase Then CloseLibrary_ *ListbrowserBase
If *ListviewBase Then CloseLibrary_ *ListviewBase
If *ClicktabBase Then CloseLibrary_ *ClicktabBase
If *FuelgaugeBase Then CloseLibrary_ *FuelgaugeBase
If *LayoutBase Then CloseLibrary_ *LayoutBase
If *WindowBase Then CloseLibrary_ *WindowBase
NPrint "Quit"
End
