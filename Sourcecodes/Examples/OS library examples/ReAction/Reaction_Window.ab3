; /XTRA
; -- Reaction Simple Window to demonstrate
; -- Window events, there are not gadgets used
; -- just a single layout without content
; -- 
; -- for a more sophisticated example see Reaction_Gadgets.ab3
WBStartup 

;-- activate new syntax mode for implicit variable declarations
OPTIMIZE 4 : SYNTAX 3

;-- open the needed reaction classes
*WindowBase.Library = OpenLibrary_("window.class", 44)
*LayoutBase.Library = OpenLibrary_("gadgets/layout.gadget", 44)
If (*WindowBase = 0 OR *LayoutBase=0)
  NPrint "A library could not be opened!"
  Goto cleanup
EndIf

;-- create a message port for external communication like iconify
*AppPort.MsgPort = CreateMsgPort_
If *AppPort = 0
  NPrint "Could not get a message port."
  Goto cleanup
EndIf

;-- build and link the reaction objects
*layoutobj.l = !VLayoutObject, @@
               #LAYOUT_SpaceOuter, True, @@
               #LAYOUT_SpaceInner, True, @@
               #LAYOUT_DeferLayout, True, @@
               !LayoutEnd

*winobj.l = !WindowObject, @@
            #WA_ScreenTitle, StrAddr("AmiBlitz3: ReAction !!"), @@
            #WA_Title, StrAddr("AmiBlitz3 ReAction Example"), @@
            #WA_Activate, True, @@
            #WA_DepthGadget, True, @@
            #WA_DragBar, True, @@
            #WA_CloseGadget, True, @@
            #WA_SizeGadget, True, @@
            #WA_Width, 250, @@
            #WA_Height, 120, @@
            #WINDOW_IconifyGadget, True, @@
            #WINDOW_IconTitle, "Reaction Example", @@
            #WINDOW_AppPort, *AppPort, @@
            #WINDOW_AppWindow, True, @@
            #WINDOW_Position, #WPOS_CENTERSCREEN, @@
            #WINDOW_ParentGroup, *layoutobj, @@
            !EndObject

If *winobj
  *win.Window = !RA_OpenWindow{*winobj}
  If *win
    DEFTYPE.l _wait, signal, app, result
    DEFTYPE.w done, code
    GetAttr_ #WINDOW_SigMask, *winobj, &signal
    app = 1 LSL *AppPort\mp_SigBit
    NPrint "app:", Hex$(app), " signal:", Hex$(signal)
  
    done = False
    While (NOT done)
      _wait = Wait_( signal | #SIGBREAKF_CTRL_C | app)
      
      If (_wait AND #SIGBREAKF_CTRL_C)
        done = True
      Else
        Repeat
          result = !RA_HandleInput{*winobj, &code}

          Select (result AND #WMHI_CLASSMASK)
          Case #WMHI_CLOSEWINDOW:
            done = True

          Case #WMHI_ICONIFY
            NPrint "Iconify", !RA_Iconify{*winobj}

          Case #WMHI_UNICONIFY
            NPrint "Uniconfiy!", !RA_Uniconify{*winobj}

          Case #WMHI_CHANGEWINDOW
            NPrint "Window changed!"

          Case #WMHI_INACTIVE
            NPrint "Window inactive"

          Case #WMHI_ACTIVE
            NPrint "Window active!"

          Case #WMHI_RAWKEY
            NPrint "keypressed!"

          Case #WMHI_MOUSEBUTTONS
            NPrint "Mouse click!"          

          End Select
        Until done OR (result = #WMHI_LASTMSG)
      EndIf
    Wend
  EndIf
Else
  NPrint "Window could not be opened."
EndIf

cleanup:
NPrint "Cleaning up..."

;-- removing window and all linked objects
DisposeObject_ *winobj

;-- remove message port
DeleteMsgPort_ *AppPort

;--  closing used libraries
If *LayoutBase Then CloseLibrary_ *LayoutBase
If *WindowBase Then CloseLibrary_ *WindowBase

NPrint "Quit"
End
