; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = "RAM Disk:"
; ExeFile         = "testsprite.exe"
; CreateIcon      = 1
; Residents       = "all.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 1
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 360
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 1
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 0
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 142
; CursorColumn    = 50
; LabelSearch     = ""
; LabelRemark     = 0
; LabelAll        = 0
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max Shape       = 100
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 20
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 100
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 4
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; Max Window      = 100
; /XTRA
XINCLUDE "sdl.include.ab3"

#NUM_SPRITES = 16
#MAX_SPEED = 1
SHARED *spr.SDL_Surface
SHARED sprites_visible.w

; -- Allocate memory for the sprite info
Dim positions.SDL_Rect(#NUM_SPRITES)
Dim velocities.SDL_Rect(#NUM_SPRITES)

Function.l FastestFlags{flags.l, width.l, height.l, bpp.b}
    DEFTYPE.SDL_VideoInfo *info

 ;-- Hardware acceleration is only used in fullscreen mode
 flags = flags | #SDL_FULLSCREEN

 ;-- Check for various video capabilities
 *info = SDL_GetVideoInfo{}
 If *info\blit_hw_CC AND *info\blit_fill
  ;-- We use accelerated colorkeying and color filling
  flags = flags | #SDL_HWSURFACE
 EndIf
    ;--
 ;-- If we have enough video memory, and will use accelerated
 ;-- blits directly to it, then use page flipping.
 ;--
 If flags AND #SDL_HWSURFACE = #SDL_HWSURFACE
  ; Direct hardware blitting without double-buffering
  ; causes really bad flickering.
  ;
  If  *info\video_mem*1024 > (height*width*bpp/8)
   flags = flags | #SDL_DOUBLEBUF
        Else
   flags = flags AND #SDL_HWSURFACE
  EndIf
    EndIf

 ;-- Return the flags
 Function Return flags
End Function

Function.w LoadSprite{*screen.SDL_Surface, file.s}
    *temp.SDL_Surface = 0
    *s.SDL_RWops

    ;-- Load the sprite image
    *s = SDL_RWFromFile{file, "rb"}
    NPrint "RWFromFile: ",Hex$(*s)
    If *s = 0
        End
    EndIf

    *spr = SDL_LoadBMP_RW{*s,1}
End Function

Statement MoveSprites{*scr.SDL_Surface, background.l}
SHARED positions(),velocities()

 nupdates.w = 0

 ;-- Erase all the sprites if necessary
 If sprites_visible
  SDL_FillRect{*scr, 0, background}
 EndIf

 ;-- Move the sprite, bounce at the wall, and draw
 For i.w = 0 To #NUM_SPRITES - 1
  positions(i)\x = positions(i)\x + velocities(i)\x

  If (positions(i)\x < 0) OR (positions(i)\x >= *scr\w)
   velocities(i)\x = -velocities(i)\x
   positions(i)\x + velocities(i)\x
  EndIf
  positions(i)\y + velocities(i)\y
  If (positions(i)\y < 0) OR (positions(i)\y >= *scr\h)
   velocities(i)\y = -velocities(i)\y
   positions(i)\y + velocities(i)\y
  EndIf

  ; -- Blit the sprite onto the screen
  SDL_BlitSurface{*spr, 0, *scr, &positions(i)}

  nupdates + 1
 Next i

 ; -- Update the screen!
 If *scr\flags AND #SDL_DOUBLEBUF = #SDL_DOUBLEBUF
    SDL_Flip{*scr}
 Else
   ;SDL_UpdateRects(*scr, nupdates, sprite_rects)
   SDL_UpdateRect{*scr, 0,0,639,479}
 EndIf
 sprites_visible = 1
End Statement

; ==============================================================================

DEFTYPE.SDL_Surface *scr
DEFTYPE.w width, height
DEFTYPE.b video_bpp
DEFTYPE.l videoflags, background

; -- Initialize SDL
NPrint "BEFORE SDL_Init"
If SDL_Init{#SDL_INIT_VIDEO} = 0
  NPrint "Init successful."
  NPrint "Quit successful."
Else
  NPrint "No success."
  Goto exit
End If
NPrint "AFTER SDL_Init"

; -- Set video mode
width = 640 : height = 480 : video_bpp = 8
videoflags = #SDL_SWSURFACE | #SDL_ANYFORMAT | #SDL_HWSURFACE | #SDL_DOUBLEBUF ; | #SDL_FULLSCREEN
*scr = SDL_SetVideoMode{width, height, video_bpp, videoflags}
If *scr = 0
    NPrint  "Couldn't set ",width, "x",height, " video mode: ", SDL_GetError{}
    Goto exit
EndIf
NPrint "SetVideoMode OK"

; -- Load the sprite
If LoadSprite{*scr, "Blitz3:Sourcecodes/data/sdl/icon.bmp"} < 0
  NPrint "Could not load sprite"
  Goto exit
EndIf

; -- Init random positions
RndSeed Timer
For i.w = 0 To #NUM_SPRITES-1
    positions(i)\x = Rnd(1) * *scr\w
    positions(i)\y = Rnd(1) * *scr\h
    positions(i)\w = *spr\w
    positions(i)\h = *spr\h
    velocities(i)\x = 0
    velocities(i)\y = 0
    While  velocities(i)\x = 0 AND velocities(i)\y = 0
        velocities(i)\x = (Rnd(1) * (#MAX_SPEED*2+1))-#MAX_SPEED
        velocities(i)\y = (Rnd(1) * (#MAX_SPEED*2+1))-#MAX_SPEED
    Wend
Next i 
background = SDL_MapRGB{*scr\_format, 0, 0, 0}

; -- Print out information about our surfaces
NPrint "Screen is at ",*scr\_format\BitsPerPixel," bits per pixel"
NPrint "Flags ", Hex$(*scr\flags)
If *scr\flags AND #SDL_HWSURFACE = #SDL_HWSURFACE
 NPrint "Screen is in video memory"
Else
 NPrint "Screen is in system memory"
EndIf

If *scr\flags AND #SDL_DOUBLEBUF = #SDL_DOUBLEBUF
 NPrint "Screen has double-buffering enabled"
EndIf

If *spr\flags AND #SDL_HWSURFACE = #SDL_HWSURFACE
    NPrint "Sprite is in video memory"
Else
    NPrint "Sprite is in system memory"
EndIf

;-- Run a sample blit to trigger blit acceleration
DEFTYPE.SDL_Rect dst
dst\x = 0
dst\y = 0
dst\w = *spr\w
dst\h = *spr\h
SDL_BlitSurface{*spr, 0, *scr, &dst}
SDL_FillRect{*scr, &dst, background}

If *spr\flags AND #SDL_HWACCEL = #SDL_HWACCEL
    NPrint "Sprite blit uses hardware acceleration"
EndIf
If *spr\flags AND #SDL_RLEACCEL = #SDL_RLEACCEL
    NPrint "Sprite blit uses RLE acceleration"
EndIf


; -- Loop, blitting sprites and waiting for a keystroke
DEFTYPE.l _then, _now, frames
frames = 0
sprites_visible = 0
_then = SDL_GetTicks{}
DEFTYPE.SDL_Event _event : done.b = 0
While done = 0
    ; -- Check for events
    frames + 1
    While SDL_PollEvent{&_event}
        Select _event\_type
        Case #SDL_KEYDOWN:
            ; any keypress quits the app...
            done = 1
        Case #SDL_QUIT
            done = 1
        End Select
    Wend
    MoveSprites{*scr, background}
Wend
SDL_FreeSurface{*spr}

; -- Print out some timing information
_now = SDL_GetTicks{}
If _now > _then
    NPrint (frames*1000)/(_now-_then), " frames per second"                
EndIf

exit:
SDL_Quit{}
