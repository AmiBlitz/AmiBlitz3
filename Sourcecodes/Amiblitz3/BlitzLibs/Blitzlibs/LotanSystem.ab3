!libheader {147,0,0,finit,0}

!afunction{#word}
!args
!libs{#doslib,#la6}
!subs{do_ctrlc,0,0}
!name{"CtrlC"," - Returns True if a CTRL/C has been received"}

!afunction{#long}
!args{#long}
!libs{#execlib,#la6}
!subs{do_new,0,0}
!args{#long,#long}
!libs{#execlib,#la6}
!subs{do_new1,0,0}
!name{"New","(Size[,Type]) - Allocates Memory"}

!astatement
!args{#long}
!libs{#execlib,#la6}
!subs{do_dispose,0,0}
!name{"Dispose","(Addr) - Deallocates previously allocated memory"}

; moved to environlib
!acommand{#word}
!args
!libs{#execlib,#la0}
!subs{do_kickversion,0,0}
