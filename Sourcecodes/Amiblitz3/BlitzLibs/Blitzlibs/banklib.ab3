; /XTRA
;
; memory bank library with misc memory commands
;

; allocmem and freemem added for standardisations sake
; loadbank now allocates memory for size of file
;

!libheader{#banklib,0,0,finit,0}

!afunction {#long}
!args {#word}
!libs {#banklib,$1380}
!subs {_bankloc,0,0}
!name {"Bank","(bank#)  ;returns location of bank, 0 if not in use",_toke}

!astatement
!args {#word,#long,#long}
!libs {#banklib,$1380}
!subs {_initbank,0,0}
!name {"InitBank","bank#,size,memtype ;0=fast 2=chip 65536=clrmem"}

!astatement
!args {#word}
!libs {#banklib,$1380}
!subs {_freebank,0,0}
!name {"FreeBank","bank#"}

!astatement
!args {#word,#string}
!libs {#doslib,#la6,#banklib,$1380}
!subs {_bankload,0,0}
!args {#word,#string,#long}
!libs {#doslib,#la6,#banklib,$1380}
!subs {_bankloadb,0,0}
!name {"LoadBank","bank#,filename$[,memtype]"}

!astatement
!args {#word,#string}
!libs {#doslib,#la6,#banklib,$1380}
!subs {_banksave,0,0}
!name {"SaveBank","bank#,filename$"}

!afunction {#long}
!args {#word}
!libs {#banklib,$1380}
!subs {_bankloc,0,0}
!name {"BankLoc","(bank#)"}

!afunction {#long}
!args {#word}
!libs {#banklib,$1380}
!subs {_banksize,0,0}
!name {"BankSize","(bank#)"}

!afunction {#long}
!args {#long,#long}
!libs
!subs {_allocmem,0,0}
!name {"AllocMem","(size,memtype) memtype: 0=fast 2=chip 65536=clrmem"}

!astatement
!args {#long,#long}
!libs
!subs {_freemem,0,0}
!name {"FreeMem","address,size"}


!afunction{#long}
!args{#long}
!libs{#execlib,#la6}
!subs{do_new,0,0}
!args{#long,#long}
!libs{#execlib,#la6}
!subs{do_new1,0,0}
!name{"New","(Size[,Type]) - Allocates Memory"}

!astatement
!args{#long}
!libs{#execlib,#la6}
!subs{do_dispose,0,0}
!name{"Dispose","(Addr) - Deallocates previously allocated memory"}

finit: !nullsub{_codefinit,0,0,#execlib,#la6}

_load:!nullsub{0,0,0}
_save:!nullsub{0,0,0}
_use:!nullsub{0,0,0}
_free:!nullsub{0,0,0}

!libfin{_toke,_load,_save,_use,_free,5,4}

NEWTYPE .bank
  pos.l:size.l:memtype.l
End NEWTYPE

._initbank:
  MOVEM.l d1-d2,-(a7)
  BSR _freebank
  MOVEM.l (a7)+,d0-d1
  
  TST.l d0 : BEQ size0
    MOVEM.l d0-d1,4(a3)
    ALibJsr #globalalloc
    MOVE.l d0,(a3)
  size0:
RTS

._freebank:
  MOVEM.l (a3),d0-d1
  TST.l d0 : BEQ nobnk
    MOVE.l d0,a1
    MOVE.l d1,d0 : BEQ nobnk
      ALibJsr #globalfree
      MOVEQ#0,d0
      MOVE.l d0,(a3)
      MOVE.l d0,4(a3)
  nobnk:
RTS

._bankload:
  MOVEQ#0,d2
  TST.l (a3) : BEQ _bankloadb
  MOVE.l 8(a3),d2

._bankloadb:
  MOVE.l d1,d0
  MOVE.l d0,fname
  MOVE.l d2,-(a7)
  ALibJsr Exists
  MOVE.l (a7)+,d2
  TST.l d0 : BEQ noload
  CMP.l 8(a3),d2 : BNE yoloc
    CMP.l 4(a3),d0 : BMI noloc
  yoloc:
    MOVE.l d0,d1
    BSR _initbank
  noloc:
  MOVE.l fname(pc),d1
  MOVE.l #1005,d2
  JSR -30(a6)
  MOVE.l d0,hand : BEQ noload
    MOVE.l hand(pc),d1
    MOVEM.l (a3),d2-d3
    JSR -42(a6)
    MOVE.l hand(pc),d1
    JSR -36(a6)
  noload:
RTS

._banksave:
  TST.l (a1):BEQ nosave:MOVE.l #1006,d2:JSR -30(a6):MOVE.l d0,hand
  BEQ nosave:MOVE.l hand(pc),d1:MOVEM.l (a3),d2-d3:JSR -48(a6)
  MOVE.l hand(pc),d1:JSR -36(a6):nosave:RTS

._bankloc:
  MOVE.l(a3),d0
RTS

._banksize:
  MOVE.l4(a3),d0
RTS

._allocmem:
  ALibJsr #globalalloc
RTS

._freemem:
  MOVE.l d0,a1
  MOVE.l d1,d0
  ALibJsr #globalfree
RTS

.do_new:
  MOVE.L #$00010000,D1  ;22a: 223c00010000
do_new1:
  ADDQ.L #8,D0   ;230: 5080
  MOVE.L D0,D2   ;232: 2400
  JSR _AllocMem(A6)  ;234: 4eaeff3a
  TST.L D0 ;BEQ.S LAB_0003  ;23a: 6712
  Dc.w $6712
 MOVEA.L D0,A0   ;23c: 2040
 MOVE.L D2,4(A0)  ;23e: 21420004
 MOVE.L memlist(PC),(A0) ;242: 20ba0068
 MOVE.L D0,memlist  ;246: 23c0000002ac
 ADDQ.L #8,D0   ;24c: 5080
  LAB_0003:
RTS

.do_dispose:
  TST.L D0 ;BEQ.S LAB_0006  ;252: 671c
  Dc.w $671c
    SUBQ.L #8,D0   ;254: 5180
    LEA memlist(PC),A1  ;256: 43fa0054
    LAB_0005:
      MOVE.L (A1),D1   ;25a: 2211
      ;BEQ.S LAB_0006  ;25c: 6712
      Dc.w $6712
      MOVEA.L A1,A2   ;25e: 2449
      MOVEA.L D1,A1   ;260: 2241
      CMP.L D1,D0   ;262: b081
      ;BNE.S LAB_0005  ;264: 66f4
      Dc.w $66f4
      MOVE.L 4(A1),D0  ;266: 20290004
      MOVE.L (A1),(A2)  ;26a: 2491
      JSR _FreeMem(A6)  ;26c: 4eaeff2e
 LAB_0006:
RTS

_codefinit:
 MOVEA.L memlist(PC),A2
 MOVE.L A2,D0 ;BEQ.S LAB_000E  ;298: 6710
 Dc.w $6710
  LAB_000D:
    MOVEA.L A2,A1   ;29a: 224a
    MOVE.L 4(A2),D0  ;29c: 202a0004
    MOVEA.L (A2),A2   ;2a0: 2452
    JSR _FreeMem(A6)  ;2a2: 4eaeff2e
    MOVE.L A2,D0   ;2a6: 200a
    ;BNE.S LAB_000D  ;2a8: 66f0
  Dc.w $66f0 
  LAB_000E:
RTS

; ========================================================

hand:    Dc.l 0
fname:   Dc.l 0
memlist: Dc.l $00000000
