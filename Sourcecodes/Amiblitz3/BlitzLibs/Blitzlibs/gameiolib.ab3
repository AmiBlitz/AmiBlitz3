; /XTRA
CIAA_PRA EQU $BFE001
JOY0DAT  EQU $DFF00A
JOY1DAT  EQU $DFF00C
POTGOR  EQU $DFF016
POTGO  EQU $DFF034


!libheader{#gameiolib,0,0,0,errors}

!afunction{#word}
!args{#word}
!libs
!subs{do_joyx,errcheck,0}
!name{"Joyx","(Port)"

!afunction{#word}
!args{#word}
!libs
!subs{do_joyy,errcheck,0}
!name{"Joyy","(Port)"

!afunction{#word}
!args{#word}
!libs
!subs{do_joyr,errcheck,0}
!name{"Joyr","(Port)"

!afunction{#word}
!args{#word}
!libs
!subs{do_joyb,errcheck,0}
!name{"Joyb","(Port)"

!afunction{#word}
!args{#word}
!libs
!subs{do_gameb,errcheck,0}
!name{"Gameb","(Port)"}

!libfin

; ==========================================================================================
.do_joyx:
  MOVE.w JOY0DAT,D1

  TST.w D0 : BEQ.w LAB_0001
     MOVE.w JOY1DAT,D1
  LAB_0001:

  MOVEQ #-1,D0 

  BTST #9,D1 : BNE.w LAB_0002
    MOVEQ #1,D0
    BTST #1,D1 : BNE.w LAB_0002
    MOVEQ #0,D0
  LAB_0002:
RTS

.do_joyy:
  MOVE.w JOY0DAT,D1
  
  TST.w D0 : BEQ.w LAB_0004
    MOVE.w JOY1DAT,D1
  LAB_0004:
 
  MOVE.w D1,D2
  LSR.w #1,D2
  EOR.w D2,D1
  MOVEQ #-1,D0
  BTST #8,D1 : BNE.w LAB_0005
    MOVEQ #1,D0
    LSR.w #1,D1 : BCS.w LAB_0005
    MOVEQ #0,D0
  LAB_0005:
RTS

.do_joyr:
  BSR.w do_joyx
  AND.w #$0003,D0  
  LSL.w #1,D0   
  MOVE.w D0,D3   
  BSR.w LAB_0004  
  AND.w #$0003,D0  
  LSL.w #3,D0   
  OR.w D3,D0   
  MOVE.w LAB_0007(PC,D0.w),D0
RTS

LAB_0007:
Dc.w $0008
Dc.w $0002
Dc.w $0008
Dc.w $0006
Dc.w $0004
Dc.w $0003
Dc.w $0008
Dc.w $0005
Dc.w $0008
Dc.w $0008
Dc.w $0008
Dc.w $0008
Dc.w $0000
Dc.w $0001
Dc.w $0008
Dc.w $0007

.do_joyb:
  TST.w D0 : BNE.w joyb_port1

  MOVEQ #0,D0
  BTST #6,CIAA_PRA : BNE.w LAB_0009
    MOVEQ #1,D0
  LAB_0009:

  BTST #2,POTGOR : BNE.w LAB_000A
    BSET #1,D0
  LAB_000A:
RTS

joyb_port1:
  MOVEQ #0,D0
  BTST #7,CIAA_PRA : BNE.w LAB_000C
    MOVEQ #1,D0
  LAB_000C:

  MOVE.w #$c000,POTGO 
  BTST #6,POTGOR : BNE.w LAB_000D
    BSET #1,D0
  LAB_000D:
RTS

.do_gameb:
  LEA CIAA_PRA,A0
  LEA POTGOR,A1
  TST.w D0 : BEQ.w LAB_0011

  MOVEQ #7,D3
  MOVE.w #$4000,D4
  BSET D3,512(A0)
  BCLR D3,(A0)
  MOVE.w #$2000,POTGO
  MOVEQ #6,D1
  MOVEQ #0,D0
  LAB_000F:
    TST.b (A0)   ;226: 4a10
    TST.b (A0)   ;228: 4a10
    TST.b (A0)   ;22a: 4a10
    TST.b (A0)   ;22c: 4a10
    TST.b (A0)   ;22e: 4a10
    TST.b (A0)   ;230: 4a10
    TST.b (A0)   ;232: 4a10
    TST.b (A0)   ;234: 4a10
    MOVE.w (A1),D2   ;236: 3411
    BSET D3,(A0)   ;238: 07d0
    BCLR D3,(A0)   ;23a: 0790
    AND.w D4,D2   ;23c: c444
    BNE.w LAB_0010  ;23e: 66000004
      BSET D1,D0   ;242: 03c0
    LAB_0010:
  DBF D1,LAB_000F  ;244: 51c9ffe0
  MOVE.w #$3000,POTGO  ;248: 33fc300000dff034
  BCLR D3,512(A0)  ;250: 07a80200
RTS    ;254: 4e75

LAB_0011:
  MOVEQ #6,D3   ;256: 7606
  MOVE.w #$0400,D4  ;258: 383c0400
  BSET D3,512(A0)  ;25c: 07e80200
  BCLR D3,(A0)   ;260: 0790
  MOVE.w #$0200,POTGO  ;262: 33fc020000dff034
  MOVEQ #6,D1   ;26a: 7206
  MOVEQ #0,D0   ;26c: 7000
  TST.b (A0)   ;26e: 4a10
  TST.b (A0)   ;270: 4a10
  TST.b (A0)   ;272: 4a10
  TST.b (A0)   ;274: 4a10
  TST.b (A0)   ;276: 4a10
  TST.b (A0)   ;278: 4a10
  TST.b (A0)   ;27a: 4a10
  TST.b (A0)   ;27c: 4a10
  MOVE.w (A1),D2   ;27e: 3411
  BSET D3,(A0)   ;280: 07d0
  BCLR D3,(A0)   ;282: 0790
  AND.w D4,D2   ;284: c444
  BNE.w LAB_0012  ;286: 66000004
  BSET D1,D0   ;28a: 03c0
  LAB_0012:
  DBF D1,LAB_000F  ;28c: 51c9ff98
  MOVE.w #$0300,POTGO  ;290: 33fc030000dff034
  BCLR D3,512(A0)  ;298: 07a80200
RTS

; ======================================================================================
errors:

errmsg1: Dc.b "Joyport must be 0 or 1",0,0
Even

errcheck:
  TST.w D0 : BEQ.w LAB_0015
    CMPI.w #$0001,D0 : BEQ.w LAB_0015
      MOVE.l #errmsg1,D0 : TRAP #0
  LAB_0015:
RTS
