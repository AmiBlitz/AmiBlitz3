;--use special hook feature of OS3+ GTListviews
!libheader{#RILVCallHook,init,0,finit,0}

!afunction{#long}
!args
!libs{#graphicslib,#la6}
!subs{do_retrievecallhook,0,0}
!name{"RetrieveCallHook","",0}

finit: !nullsub{codeinit,0,0}
init: !nullsub{codefinit,0,0}

!libfin
; ============================================================================

codefinit: RTS
codeinit:  RTS

gfxbase: Dc.l $00000000

; #GTLV_CallBack (struct Hook *) - Callback hook for various listview
;        operations. As of V39, the only callback supported is for custom
;        rendering of individual items in the listview. The call back hook
;        is called with:
;        A0 - struct Hook *
;        A1 - struct LVDrawMsg *
;        A2 - struct Node *

.do_retrievecallhook:
  MOVE.L A6,gfxbase
  LEA hookCode(PC),A0
  MOVE.L A0,D0
RTS

