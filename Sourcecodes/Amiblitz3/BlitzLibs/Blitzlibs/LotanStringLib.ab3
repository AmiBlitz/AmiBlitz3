; ==================================================================================
; LotanString Library 1.02 (23.01.00)
; Reconstructed from the IRA disassembly LotanString.asm (library number 22).
;
; Notes:
; - Short branches (Bcc.s) as in the original; they require OPTIMIZE 8.
; - strbuffer: 8 KB work buffer allocated in init via GlobalAlloc
;   (used by StrPack as default table and by StrChg as temporary buffer).
; - Library calls: _ToUpper = -174(A6), _ToLower = -180(A6) of utility.library.
; ==================================================================================

OPTIMIZE 8   ; enables short branches (Bcc.s)

#lotanstringlib = 22
!libheader {#lotanstringlib,init,0,0,errors}

!afunction{#long}
!args{#unknown}
!libs
!subs{do_StrLen,0,0}
!name{"StrLen","(Str)|(Addr)"}

!afunction{#string}
!args{#string,#long}
!libs
!subs{do_StrLeft,0,0}
!args{#string,#long,#byte}
!libs
!subs{do_StrLeft2,0,0}
!name{"StrLeft","(Str,Len[,Pad])"}

!afunction{#string}
!args{#string,#long}
!libs
!subs{do_StrRight,0,0}
!args{#string,#long,#byte}
!libs
!subs{do_StrRight2,0,0}
!name{"StrRight","(Str,Len[,Pad])"}

!afunction{#string}
!args{#string}
!libs{#utilitylib,#la6}
!subs{do_StrUpper,0,0}
!name{"StrUpper","(Str)"}

!afunction{#string}
!args{#string}
!libs{#utilitylib,#la6}
!subs{do_StrLower,0,0}
!name{"StrLower","(Str)"}

!afunction{#string}
!args{#string}
!libs
!subs{do_StrFlip,0,0}
!name{"StrFlip","(Str)"}

!afunction{#string}
!args{#string}
!libs
!subs{do_StrPack,0,0}
!args{#string,#string}
!libs
!subs{do_StrPack2,0,0}
!name{"StrPack","(Str[,Table])"}

!afunction{#string}
!args{#string,#long}
!libs
!subs{do_StrClone,0,0}
!name{"StrClone","(Str,Num)"}

!afunction{#string}
!args{#word}
!libs
!subs{do_StrRange,0,0}
!args{#word,#word}
!libs
!subs{do_StrRange2,0,0}
!name{"StrRange","(Start[,End]) - Returns all characters between Start and END"}

!afunction{#string}
!args{#string,#string,#string}
!libs
!subs{do_StrChg,0,0}
!name{"StrChg","(Str,OldStr,NewStr) - Replace all OldStr by NewStr in Str"}

!afunction{#string}
!args{#string,#long}
!libs
!subs{do_StrSub,0,0}
!args{#string,#long,#long}
!libs
!subs{do_StrSub2,0,0}
!args{#string,#long,#long,#byte}
!libs
!subs{do_StrSub3,0,0}
!name{"StrSub","(Str,Pos[,Len[,Pad]]) - Returns a sub-string in Str"}

!afunction{#string}
!args{#string,#string,#string}
!libs
!subs{do_StrTrans,0,0}
!args{#string,#string,#string,#byte}
!libs
!subs{do_StrTrans2,0,0}
!name{"StrTrans","(Str,OutTable,InTable[,Pad])"}

init: !nullsub{do_init,0,0,#execlib,#la6}

!libfin

; ==================================================================================

; StrLen(Str) returns the stored string length,
; StrLen(Addr) counts the bytes up to the terminating zero.
.do_StrLen:
  CMPI.w #7,-(A2) : BNE.s sl_addr         ; argument type = #string ?
  
  MOVEA.l D0,A3
  MOVE.l -(A2),D0        ; length of the string
RTS

sl_addr:
  MOVEA.l D0,A0
  MOVE.l D0,D1
  sl_loop:
    TST.b (A0)+
  BNE.s sl_loop
  MOVE.l A0,D0
  SUBQ.l #1,D0
  SUB.l D1,D0
RTS

; StrLeft(Str,Len[,Pad]) - Len < 0 removes -Len characters from the right
.do_StrLeft:
  MOVEQ #32,D2             ; default pad = space
.do_StrLeft2:
  MOVE.l -(A2),D3          ; D3 = length of Str
  MOVE.l D1,D0
  TST.l D3 : BEQ do_return0

  SUBQ.l #1,A3
  SUBA.l D3,A3             ; A3 = start of Str
  TST.l D1 : BLT.s sleft_neg
  MOVEA.l A3,A0
  CMP.l D1,D3 : BHI.s sleft_done
  ADDA.l D3,A0             ; Len >= length: pad the rest
  SUBQ.l #1,D1
  sleft_pad:
    MOVE.b D2,(A0)+
  DBF D1,sleft_pad
  sleft_done:
  ADDA.l D0,A3
RTS
sleft_neg:
  NOT.l D1
  ADDQ.l #1,D1             ; D1 = -Len
  CMP.l D1,D3 : BLS do_return0

  SUB.l D1,D3
  ADDA.l D3,A3
  MOVE.l D3,D0
RTS

; StrRight(Str,Len[,Pad]) - Len < 0 removes -Len characters from the left
.do_StrRight:
  MOVEQ #32,D2             ; default pad = space
.do_StrRight2:
  MOVE.l -(A2),D3          ; D3 = length of Str
  TST.l D3 : BEQ do_return0

  SUBQ.l #1,A3
  SUBA.l D3,A3             ; A3 = start of Str
  TST.l D1 : BEQ do_return0

  BLT.s sright_neg
  MOVEA.l A3,A0
  MOVE.l D1,D0
  ADDA.l D0,A3
  CMP.l D1,D3 : BLT.s sright_pad
  MOVEA.l A0,A1            ; Len <= length: move the right part down
  SUB.l D1,D3
  ADDA.l D3,A0
  SUBQ.l #1,D1
  sright_copy:
    MOVE.b (A0)+,(A1)+
  DBF D1,sright_copy
RTS
sright_pad:
  ADDA.l D3,A0             ; Len > length: move Str to the right end
  SUB.l D3,D1
  MOVEA.l A3,A1
  SUBQ.l #1,D3
  sright_move:
    MOVE.b -(A0),-(A1)
  DBF D3,sright_move
  SUBQ.l #1,D1
  sright_fill:             ; ... and fill the left side with pad
    MOVE.b D2,-(A1)
  DBF D1,sright_fill
RTS
sright_neg:
  NOT.l D1
  ADDQ.l #1,D1             ; D1 = -Len
  CMP.l D1,D3 : BLE do_return0

  MOVEA.l A3,A0
  SUB.l D1,D3
  ADDA.l D1,A0
  MOVE.l D3,D0
  SUBQ.l #1,D3
  sright_cut:
    MOVE.b (A0)+,(A3)+
  DBF D3,sright_cut
RTS

; StrUpper(Str) - uses utility.library ToUpper()
.do_StrUpper:
  BSR str_start
  TST.l D3 : BEQ do_return0

  SUBQ.l #1,D3
  supper_loop:
    MOVE.b (A3),D0
    JSR -174(A6)           ; _ToUpper
    MOVE.b D0,(A3)+
  DBF D3,supper_loop
  MOVE.l (A2)+,D0
RTS

; StrLower(Str) - uses utility.library ToLower()
.do_StrLower:
  BSR str_start
  TST.l D3 : BEQ do_return0

  SUBQ.l #1,D3
  slower_loop:
    MOVE.b (A3),D0
    JSR -180(A6)           ; _ToLower
    MOVE.b D0,(A3)+
  DBF D3,slower_loop
  MOVE.l (A2)+,D0
RTS

; StrFlip(Str) - reverses the string in place
.do_StrFlip:
  MOVEA.l A3,A0
  MOVEA.l A3,A1
  MOVE.l -(A2),D0
  MOVE.l D0,D1
  SUBA.l D1,A0
  SUBQ.l #1,A0             ; A0 = first char
  SUBQ.l #2,A3             ; A3 = last char
  LSR.l #1,D1
  SUBQ.l #1,D1
  sflip_loop:
    MOVE.b (A0),D2
    MOVE.b (A3),(A0)+
    MOVE.b D2,(A3)
    SUBQ.l #1,A3
  DBF D1,sflip_loop
  MOVEA.l A1,A3
RTS

; StrPack(Str[,Table]) - removes all characters contained in Table (default: space)
.do_StrPack:
  MOVEA.l strbuffer(PC),A1
  MOVE.b #32,(A1)          ; table = " "
  MOVEA.l D0,A0
  MOVE.l -(A2),D3
  MOVEQ #1,D4
  BRA.s spack_start
.do_StrPack2:
  MOVEA.l D0,A0
  MOVEA.l D1,A1
  MOVE.l -(A2),D3          ; D3 = length of Table
  MOVE.l -(A2),D4          ; D4 = length of Str
  SUBA.l D4,A3
  SUBQ.l #1,A3
spack_start:
  MOVEQ #0,D0
  BSR str_start2
  SUBQ.l #1,D3
  SUBQ.l #1,D4
  spack_loop:
    MOVE.l A1,D1
    MOVE.l D4,D2
    spack_check:
      MOVE.b (A0),D5
      CMP.b (A1)+,D5
      BEQ.s spack_skip
    DBF D4,spack_check
    MOVE.b (A0),(A3)+      ; not in table: keep it
    ADDQ.l #1,D0
  spack_skip:
    MOVE.l D2,D4
    MOVEA.l D1,A1
    ADDQ.l #1,A0
  DBF D3,spack_loop
RTS

; StrClone(Str,Num) - repeats Str Num times
.do_StrClone:
  MOVEA.l D0,A0
  BSR str_start
  SUBQ.l #1,D1
  SUBQ.l #1,D3
  MOVEQ #0,D0
  sclone_loop:
    MOVEM.l D3/A0,-(A7)
    sclone_copy:
      MOVE.b (A0)+,(A3)+
      ADDQ.l #1,D0
    DBF D3,sclone_copy
    MOVEM.l (A7)+,D3/A0
  DBF D1,sclone_loop
RTS

; StrRange(Start[,End]) - all characters from Start to End (default: End = 255)
.do_StrRange:
  MOVEQ #-1,D0
.do_StrRange2:
  MOVEQ #0,D3
  SUB.b D0,D1
  MOVE.b D1,D3
  srange_loop:
    MOVE.b D0,(A3)+
    ADDQ.w #1,D0
  DBF D1,srange_loop
  MOVEQ #0,D0
  MOVE.l D3,D0
  ADDQ.l #1,D0
RTS

; StrChg(Str,OldStr,NewStr) - replaces all OldStr by NewStr (uses strbuffer)
.do_StrChg:
  MOVE.l -(A2),D5          ; D5 = length of Str
  TST.l D5 : BEQ do_return0

  MOVE.l -(A2),D6          ; D6 = length of OldStr
  MOVE.l -(A2),D7          ; D7 = length of NewStr
  SUBQ.l #3,A3
  SUBA.l D5,A3
  SUBA.l D6,A3
  SUBA.l D7,A3
  MOVEA.l D0,A0
  MOVEA.l D1,A1
  MOVEA.l D2,A2
  MOVEM.l A3-A5,-(A7)
  MOVEA.l strbuffer(PC),A3
  schg_loop:
    MOVE.b (A0),D0
    CMP.b (A1),D0 : BNE.s schg_copychar
    MOVEA.l A0,A4
    MOVEA.l A1,A5
    MOVE.l D6,D0
    SUBQ.l #1,D0
    schg_cmp:
      CMPM.b (A4)+,(A5)+ : BNE.s schg_copychar
    DBF D0,schg_cmp
    MOVEA.l A4,A0          ; OldStr found: skip it ...
    TST.l D7 : BEQ.s schg_next
    MOVE.l D7,D0
    SUBQ.l #1,D0
    MOVE.l A2,-(A7)
    schg_insert:           ; ... and insert NewStr
      MOVE.b (A2)+,(A3)+
    DBF D0,schg_insert
    MOVEA.l (A7)+,A2
    schg_next:
    TST.l D5 : BEQ.s schg_done
    SUB.l D6,D5
  BRA.s schg_loop
  schg_copychar:
    MOVE.b (A0)+,(A3)+
  DBF D5,schg_loop
  SUBQ.l #1,A3

  schg_done:
  MOVE.l A3,D1
  MOVEM.l (A7)+,A3-A5
  MOVEA.l strbuffer(PC),A0
  SUB.l A0,D1
  MOVE.l D1,D0 : BEQ do_return0
  SUBQ.l #1,D1
  schg_result:             ; copy the result from strbuffer to the string stack
    MOVE.b (A0)+,(A3)+
  DBF D1,schg_result
RTS

; StrSub(Str,Pos[,Len[,Pad]]) - Len defaults to the rest of Str, Pad to space
.do_StrSub:
  MOVE.l -4(A2),D2
  SUB.l D1,D2
.do_StrSub2:
  MOVEQ #32,D3
.do_StrSub3:
  MOVE.l -(A2),D4          ; D4 = length of Str
  SUBQ.l #1,A3
  SUBA.l D4,A3
  CMP.l D1,D4 : BLS do_return0
  TST.l D4 : BEQ do_return0
  TST.l D2 : BEQ do_return0

  TST.l D1 : BHI.s ssub_pos
    MOVEQ #1,D1
  ssub_pos:
  SUBQ.l #1,D1
  MOVEA.l D0,A0
  ADDA.l D1,A0
  MOVE.l D2,D0
  MOVE.l D2,D7
  CMP.l D2,D4 : BHI.s ssub_len
    MOVE.l D4,D7
    SUB.l D1,D7
  ssub_len:
  SUBQ.l #1,D7
  ssub_copy:
    MOVE.b (A0)+,(A3)+
  DBF D7,ssub_copy
  SUB.l D1,D4
  CMP.l D4,D2 : BLS.s ssub_done
  SUB.l D4,D2
  SUBQ.l #1,D2
  ssub_pad:
    MOVE.b D3,(A3)+
  DBF D2,ssub_pad
  ssub_done:
RTS

; StrTrans(Str,OutTable,InTable[,Pad]) - each char found in InTable is replaced
; by the char at the same position in OutTable (or by Pad if OutTable is shorter)
.do_StrTrans:
  MOVEQ #32,D3
.do_StrTrans2:
  MOVEA.l D0,A3
  MOVEA.l D1,A0
  MOVEA.l D2,A1
  MOVE.l -(A2),D7
  MOVE.l D7,-(A7)
  MOVE.l -(A2),D6
  MOVE.l -(A2),D5 : BEQ.s strans_empty
  SUBQ.l #1,D5
  SUBQ.l #1,D7
  strans_loop:
    MOVEA.l A1,A2
    MOVE.b (A3)+,D0
    MOVE.l D5,D1
    strans_find:
      CMP.b (A2)+,D0 : BEQ.s strans_found
    DBF D1,strans_find
    BRA.s strans_next
  strans_found:
    SUBQ.l #1,A2
    MOVE.l A2,D0
    SUB.l A1,D0            ; D0 = index in InTable
    CMP.l D6,D0 : BGE.s strans_pad
    MOVE.b 0(A0,D0.w),-1(A3)
    BRA.s strans_next
  strans_pad:
    MOVE.b D3,-1(A3)
  strans_next:
  DBF D7,strans_loop
  MOVE.l (A7)+,D0
RTS
strans_empty:
  MOVE.l (A7)+,D0
  ADDA.l D0,A3
RTS

; --- helpers ---
str_start:                 ; pop length into D3, A3 = start of the string
  MOVE.l -(A2),D3
str_start2:
  SUBA.l D3,A3
  SUBQ.l #1,A3
RTS

do_return0:                ; empty result
  MOVEQ #0,D0
RTS

do_init:                   ; allocate 8 KB work buffer
  MOVE.l #$2000,D0
  MOVEQ #0,D1
  ALibJsr $c002            ; #globalalloc
  MOVE.l D0,strbuffer
RTS

strbuffer:  Dc.l 0

errors: Dc.b "$VER: Lotan's String Library 1.02 (23.01.00)",0
