; /XTRA
;$VER:MethodBBLib V1.5
!libheader{#amiga_lib,0,0,0,errors}

!acommand{#long}
!args{#long,#long}
!libs{#intuitionlib,#la6}
!subs{do_inithook,0,0}
!name{"InitHook"," *ClassPtr, DispatcherAdr"}

!afunction{#long}
!args
!libs
!subs{do_gethookmsg,0,0}
!name{"GetHookMsg"," -Read MsgPtr from the Hook"}

!afunction{#long}
!args
!libs
!subs{do_gethookobj,0,0}
!name{"GetHookObj"," -Read ObjPtr from Hook"}

!afunction{#long}
!args{#long,#long}
!libs
!subs{do_instdata,0,0}
!name{"INST_DATA"," ( *ClassPtr, *Obj )"}

!acommand{#long}
!args{#long,#long}
!libs
!subs{do_doMethoda,0,0}
!name{"DoMethodA"," ( *ObjPtr,*MsgPtr )"}

!acommand{#long}
!repargs{1,1,#long,#long}
!libs
!subs{do_domethod,0,0}
!name{"DoMethod"," ( *ObjPtr,MethodID,Tag[,Tag..] )"}

!acommand{#long}
!args{#long,#long,#long}
!libs
!subs{do_dosupermethoda,0,0}
!name{"DoSuperMethodA"," ( *ClassPtr,*ObjPtr,*MsgPtr )"}

!acommand{#long}
!repargs{2,1,#long,#long,#long}
!libs
!subs{do_dosupermethod,0,0}
!name{"DoSuperMethod"," ( *ClassPtr,*ObjPtr,MethodID,Tag[,Tag..] )"}

!acommand{#long}
!args{#long,#long,#long}
!libs
!subs{do_coercemethoda,0,0}
!name{"CoerceMethodA"," ( *ClassPtr,*ObjPtr,*MsgPtr )"}

!acommand{#long}
!repargs{2,1,#long,#long,#long}
!libs
!subs{do_coercemethod,0,0}
!name{"CoerceMethod"," ( *ClassPtr,*ObjPtr,MethodID,Tag[,Tag..] )"}

!acommand{#long}
!repargs{2,1,#long,#long,#long}
!libs
!subs{do_setsuperattrs,0,0}
!name{"SetSuperAttrs"," ( *ClassPtr,*ObjPtr,Tag[,Tag..])"}

!afunction{#long}               
!repargs{0,1,#long}             
!libs
