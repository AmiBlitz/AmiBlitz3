!name{"NewList","*list.List - Prepare a List for first use"}


!libfin
; ===================================================================================

.do_inithook: ; d0: classptr, d1: dispatcheraddr
  MOVEM.L A0-A6,-(A7)
  TST.L D0 : BEQ.W LAB_0001
    MOVEA.L D0,A1    ; struct IClass
    LEA _hookEntry(PC),A0
    MOVE.L A0,8(A1)       ; IClass\Hook\h_Entry, stub function entry point
    MOVE.L D1,12(A1)   ; IClass\Hook\h_SubEntry, the custom function entry pointer
  LAB_0001:
  MOVEM.L (A7)+,A0-A6
RTS

_hookEntry:
  MOVE.L A1,pushMsgPktPtr
  MOVE.L A2,pushObjectPtr
  MOVE.L A0,pushHookPtr
  MOVEA.L 12(A0),A0             ; fetch actual hook entry pointer ...
  JSR (A0)         ; and call it
RTS

.do_gethookmsg:
  MOVE.L pushMsgPktPtr,D0
RTS

.do_gethookobj:
  MOVE.L pushObjectPtr,D0
RTS

.do_instdata:
  MOVEM.L A0-A6,-(A7)
  MOVEA.L D0,A0  
  ADD.W 30(A0),D1
  MOVE.L D1,D0   
  MOVEM.L (A7)+,A0-A6
RTS

.do_doMethoda:
  TST.L D0 : BEQ.W cmnullreturn

  MOVEA.L D0,A2
  MOVEA.L D1,A1
  MOVEA.L -4(A2),A0
BRA.W cminvoke

.do_domethod:
  TST.L D0 : BEQ.W cmnullreturn 

  LEA args(PC),A1
  MOVE.L A1,D1
  SUBQ.W #1,D7
  LAB_0008:
    MOVE.L -(A2),(A1)+
  DBF D7,LAB_0008
  MOVEA.L D0,A2
  MOVEA.L D1,A1
  MOVEA.L -4(A2),A0
BRA.W cminvoke

.do_dosupermethoda:
  MOVEA.L D1,A2 : BEQ.W cmnullreturn
  MOVEA.L D0,A0 : BEQ.W cmnullreturn
  MOVEA.L D2,A1
  MOVEA.L 24(A0),A0
BRA.W cminvoke

.do_dosupermethod:
  LEA args(PC),A1
  MOVEA.L A1,A2
  SUBQ.W #1,D7
  LAB_000B:
    MOVE.L -(A2),(A1)+
  DBF D7,LAB_000B
  MOVEA.L D1,A2 : BEQ.W cmnullreturn 
  MOVEA.L D0,A0 : BEQ.W cmnullreturn 
  MOVEA.L D2,A1  
  MOVEA.L 24(A0),A0
BRA.W cminvoke

.do_coercemethoda:
  MOVEA.L D1,A2 : BEQ.W cmnullreturn
  MOVEA.L D0,A0 : BEQ.W cmnullreturn
  MOVEA.L D2,A1
BRA.W cminvoke

.do_coercemethod:
  LEA args(PC),A1
  MOVEA.L A1,A2 
  SUBQ.W #1,D7
  LAB_000E:
    MOVE.L -(A2),(A1)+
  DBF D7,LAB_000E
  MOVEA.L D1,A2 : BEQ.W cmnullreturn
  MOVEA.L D0,A0 : BEQ.W cmnullreturn
  MOVEA.L D2,A1 
BRA.W cminvoke

.do_setsuperattrs:
  LEA args(PC),A1
  MOVE.L A1,D2   
  SUBQ.W #1,D7   
  LAB_0010:
    MOVE.L -(A2),(A1)+ 
  DBF D7,LAB_0010
  MOVEA.L D1,A2 : BEQ.W cmnullreturn
  MOVEA.L D0,A0 : BEQ.W cmnullreturn
  MOVEA.L 24(A0),A0
  MOVE.L #$00000000,-(A7)
  MOVE.L D2,-(A7)
  MOVE.L #$00000103,-(A7)
  LEA (A7),A1
  PEA ssaret(PC)
  MOVE.L 8(A0),-(A7)
RTS

.cminvoke:
  PEA cmreturn(PC)
  MOVE.L 8(A0),-(A7)
RTS

.cmnullreturn:
  MOVEQ #0,D0

.cmreturn:
RTS

ssaret:
  LEA 12(A7),A7
  MOVEA.L (A7)+,A2
RTS

._VarArgs
  LEA args(pc),a1
  MOVE.l a1,d0
  SUBQ #1,d7
  Loop4:
    MOVE.l -(a2),(a1)+
  DBF d7,Loop4
RTS     

.do_getclass:
  TST.l D0 : BEQ errlib
  
  MOVEM.l a4-a6/d7,-(a7)
  MOVE.l D0,A6
  JSR -30(A6)
  MOVEM.l (a7)+,a4-a6/d7
RTS

; STRUCTURE	LH,0
;	APTR	    LH_HEAD
;	APTR	    LH_TAIL
;	APTR	    LH_TAILPRED
;	UBYTE	    LH_TYPE
;	UBYTE	    LH_pad
;	LABEL	    LH_SIZE ;word aligned
.do_newlist:          ;Prepare a list header for use
  MOVE.l A0,-(a7)

  MOVEA.l D0,A0
  MOVE.l A0,8(A0)     ;LH_TAILPRED
  ADDQ.l #4,A0        ;Get address of LH_TAIL
  CLR.l  (A0)         ;Clear LH_TAIL
  MOVE.l A0,-(A0)     ;Address of LH_TAIL to LH_HEAD

  MOVE.l (a7)+,A0
RTS

; =================================================================================
pushHookPtr:   Ds.L 1
pushMsgPktPtr: Ds.L 1
pushObjectPtr: Ds.L 1
args:          Ds.L 32

; =================================================================================
errors:
errlib:
MOVE.l #errorNoLib,D0 : TRAP #$0
;
errorNoLib: Dc.b "Invalid Library pointer.",0,0
