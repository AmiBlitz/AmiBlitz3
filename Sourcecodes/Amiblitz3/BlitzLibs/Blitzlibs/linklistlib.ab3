;;********************** CODE BELOW *************************

.do_FreePtrList:
  MOVE.l d0,a1
  !checklist{a1}

  MOVE.l sizestore,d1
  BSR freelist
RTS


.do_AddPtrFirst:         ; add an item at the beginning of the list.
  MOVE.l d0,a0
  !checklist{a0}

  !_disable
  MOVE.l -16(a0),a1     ; next of head of free
  MOVE.l (a1),d0 : BNE 'l1               ; if no memory left get now one
    TST.w -34(a0) : BEQ 'done
    BSR increase
    MOVE.l -16(a0),a1
    MOVE.l (a1),d0
 'l1:

  MOVE.l a1,-32(a0)     ; now current

  MOVE.l a3,-(a7)
  BSR unlinkitem

  LEA -28(a0),a2        ; head of used items
  BSR linkitem

  MOVE.l (a7)+,a3

  MOVE.l a1,d0
  ADDQ.l #8,d0

 'done:
  !_enable
RTS


.do_PrevPtrItem:         ; if no current, do last item.
  MOVE.l d0,a0
  !checklist{a0}

  !_disable
  MOVE.l -32(a0),d0 : BEQ do_LastPtrItem2

  MOVE.l d0,a1
  MOVE.l 4(a1),a1         ;previous of current
  MOVE.l 4(a1),d0 : BEQ 'done:
    MOVE.l a1,-32(a0)
    MOVE.l a0,d0
    ADDQ.l #8,d0
 'done:
  !_enable
RTS


.do_LastPtrItem:        ; d0=array base. make current=last
  MOVE.l d0,a0
  !checklist{a0}

  !_disable
do_LastPtrItem2:
  MOVE.l -20(a0),a1     ;a1=prev of tail node
  MOVE.l 4(a1),d0
  BNE 'skip
    MOVE.l d0,a1
 'skip:
  MOVE.l a1,-32(a0)

  !_enable
  TST.l d0 : BEQ 'knob
    MOVE.l a1,d0
    ADDQ.l #8,d0
 'knob:
RTS


.do_FirstPtrItem:
  MOVE.l d0,a0
  !checklist{a0}

  !_disable
do_FirstPtrItem2:
  MOVE.l -28(a0),a1   ;a1=next of head node
  MOVE.l (a1),d0
  BNE 'skip
    MOVE.l d0,a1
 'skip:
  MOVE.l a1,-32(a0)

  !_enable
  TST.l d0:BEQ 'knob
    MOVE.l a1,d0
    ADDQ.l #8,d0
 'knob:
RTS

.do_SortPtrList:
  MOVE.l d0,a0
  !checklist{a0}
BRA do_SortList

.do_CountPtrList:
  MOVE.l d0,a0
  !checklist{a0}

  ;
  ;d0 = array base! return how many items in list
  ;
  !_disable
  MOVE.l -28(a0),d1         ; head of used items
  MOVEQ #-1,d0

  'loop
    ADDQ.l #1,d0
    MOVE.l d1,a0
    MOVE.l (a0),d1
  BNE 'loop
  !_enable
RTS

.do_GetPtrItem:
  MOVE.l d0,a0
  !checklist{a0}

  MOVE.l -32(a0),d0
  ADDQ.l #8,d0
RTS


.do_KillPtrItem:          ; must be a current item to kill!
                          ; set current to previous of me after killing it
  MOVE.l d0,a0
  !checklist{a0}

  !_disable
  MOVE.l -32(a0),a1       ; current item
  MOVE.l 4(a1),-(a7)      ; old previous of current
  ;
  MOVE.l a3,-(a7)
  BSR unlinkitem          ; remove from used...
  LEA -16(a0),a2
  BSR linkitem            ; add to free
  MOVE.l (a7)+,a3
  ;
  MOVE.l (a7)+,a1
  MOVE.l 4(a1),d0 : BNE 'skip
    MOVE.l d0,a1
 'skip:
  MOVE.l a1,-32(a0)       ; update current item
  MOVE.l a1,d0
  ADDQ.l #8,d0
  !_enable
RTS


.do_AddPtrItem:
  MOVE.l d0,a0
  !checklist{a0}
  !_disable
  MOVE.l -16(a0),a1       ; next of head node
  MOVE.l (a1),d0: BNE 'l1 ; if no memory left get now one
    TST.w -34(a0)         ; check it is a linked list
    BEQ 'done
      BSR increase
      MOVE.l -16(a0),a1
      MOVE.l (a1),d0
 'l1:
  MOVE.l a3,-(a7)
  BSR unlinkitem
  MOVE.l -32(a0),d0 : BNE 'skip
    LEA -28(a0),a2
    MOVE.l a2,d0
 'skip:
  MOVE.l d0,a2
  BSR linkitem
  MOVE.l (a7)+,a3
  MOVE.l a1,-32(a0)       ; now current
  MOVE.l a1,d0
  ADDQ.l #8,d0

 'done:
  !_enable
RTS

.do_NextPtrItem:
  MOVE.l d0,a0
  !checklist{a0}

  !_disable
  MOVE.l -32(a0),d0 : BEQ do_FirstPtrItem2

  MOVE.l d0,a1
  MOVE.l (a1),a1 ;next of current
  MOVE.l (a1),d0 : BEQ 'done
    MOVE.l a1,-32(a0)
    MOVE.l a1,d0
    ADDQ.l #8,d0
 'done:
  !_enable
RTS

.do_NextPtrItem2:
  MOVE.l d0,a0               ;d1 may not trash
  !checklist{a0}
  !_disable
  MOVE.l -32(a0),d0 : BEQ do_FirstPtrItem2b

  MOVE.l d0,a1
  MOVE.l (a1),a1 ;next of current
  MOVE.l (a1),d0 : BEQ 'done
    MOVE.l a1,-32(a0)
    MOVE.l a1,d0
    ADDQ.l #8,d0
    MOVE.l d1,a0
    MOVE.l d0,(a0)
 'done:
  !_enable
RTS

.do_FirstPtrItem2b:
  MOVE.l -28(a0),a1            ;a1=head of used items
  MOVE.l (a1),d0 : BNE 'skip
    MOVE.l d0,a1
 'skip:

  MOVE.l a1,-32(a0):
  !_enable
  TST.l d0 : BEQ 'knob
    MOVE.l a1,d0
    ADDQ.l #8,d0
    MOVE.l d1,a0
    MOVE.l d0,(a0)
 'knob:
RTS


.do_AddPtrLast:
  MOVE.l d0,a0
  !checklist{a0}
  !_disable
  MOVE.l -16(a0),a1  ;next of free
  MOVE.l (a1),d0 : BNE 'l1           ; if no memory left get now one

  TST.w -34(a0) : BEQ 'done          ; check it is a linked list
    BSR increase
    MOVE.l -16(a0),a1
    MOVE.l (a1),d0
   'l1:
    MOVE.l a1,-32(a0)
    MOVE.l a3,-(a7)
    BSR unlinkitem
    MOVE.l -20(a0),a2:;prev of tail of used
    BSR linkitem
    MOVE.l (a7)+,a3
    MOVE.l a1,d0
    ADDQ.l #8,d0
 'done:
  !_enable
RTS

.do_CreatePtrList:
  TST.l d0 : BEQ err1

  ADD.l #$8,d1                     ; add memory for the list pointers 
  MOVE.l d1,d4
  MOVE.l d1,sizestore

  MOVE.l d0,addstore
  MOVE.l d0,a0
  MOVE.l (a0),d0 : BEQ 'skip
    BSR.w do_FreePtrList
 'skip

  ; ----------- Create new Pool
  MOVEM.l a6/d2,-(a7)
  MOVE.l #$10001,d0
  MOVE.l ##pool_puddlesize,d1               ; $7D0
  MOVE.l ##pool_threshsize,d2
  ;MOVE.l _execbase,a6 : JSR _CreatePool(a6)                   
  ALibJsr $C009                    ; create pool

  TST.l d0 : BEQ 'out

  MOVE.l d0,a2                    ; poolheader

  MOVE.l #$10001,d1
  MOVEQ #40,d0
  ADD.l sizestore,d0
  ALibJsr #localalloc             ; localalloc (d0:byteSize; d1:requirements)

  MOVEM.l (a7)+,a6/d2
  ; ------------------------------------

  MOVE.l d0,a0
  MOVE.l a2,0(a0)                 ; write poolheader

  SWAP d4
  CLR.w d4
  SWAP d4
  MOVE.w d4,4(a0)                 ; write size

  MOVE.l d0,a2
  LEA 40(a2),a0
  MOVE.l addstore,a1  
  MOVE.l a0,(a1)

  ;
  ;Empty out the IN-USE list, FREE list, and set ID
  ;
  MOVE.l a0,a1
  ADD.l sizestore,a1

  LEA 4+8(a2),a3 : MOVE.l a3,12+8(a2) : ADDQ #4,a3 : MOVE.l a3,4+8(a2)
  LEA 16+8(a2),a3: MOVE.l a3,24+8(a2) : ADDQ #4,a3 : MOVE.l a3,16+8(a2)
  MOVE.l #"lIsT",28+8(a2)
  
  ;--
  ;-- Create the entries for all list elements
  ;--
  LEA 20+8(a2),a2:;tail node
  
  MOVEQ #0,d1
 'loop:                 ;insert a0 node before a2 node

    MOVE.l 4(a2),a3:;   old last of tail
    ;
    MOVE.l a2,(a0):;    new next of me
    MOVE.l a3,4(a0):;   new last of me
    ;
    MOVE.l a0,4(a2):;   new last of tail
    MOVE.l a0,(a3):;    new next of old last
    ADDQ.l #1,d1
    ADD.l d4,a0
  CMP.l a1,a0 : BCS 'loop

  CMP.l #1,d1 : BNE 'l1
    MOVE.w #1,-$16(a2)  ; -22
 'l1
  RTS

 'out:
  BSR err7
  MOVEM.l (a7)+,a6/d2
RTS

_initlink
maxstack:         Dc.l 0
currstack:        Dc.l 0
currsp:           Dc.l 0
sizestore:        Dc.l 0
addstore:         Dc.l 0
is32bitCPU:       Dc.w 0
reverseOrder:     Dc.w 0
freelistmem:      Dc.w 0


.check_32bit_cpu:            ; returns true if 32bit cpu
  MOVEQ #0,d0
  MOVEA.l _execbase,a0
  MOVE 296(a0),d1            ; AttnFlags of execbase
  BTST #1,d1
  BEQ 'no020
    MOVE #1,d0
    MOVE #1,is32bitCPU
 'no020:
RTS

.finit:
  BSR check_32bit_cpu

  CLR.l currstack
  CLR.l currsp
  MOVEQ #8,d0

.do_ItemStackSize           ; d0 = stack size
  MOVE.l currstack(pc),d1
  BEQ 'skip
    MOVE.l d0,d2
    MOVE.l d1,a1
    MOVE.l maxstack(pc),d0
    ALibJsr #globalfree
    CLR.l currstack
    MOVE.l d2,d0
 'skip
  LSL.l #3,d0
  MOVEQ #1,d1
  MOVE.l d0,maxstack
  ALibJsr #globalalloc
  MOVE.l d0,currstack
  MOVE.l d0,currsp
RTS


.dopushcurrent
  MOVE.l d0,a0
  MOVE.l currsp(pc),a1
  MOVE.l a0,(a1)+
  MOVE.l -32(a0),(a1)+
  MOVE.l a1,currsp
RTS

.dopopcurrent
  MOVE.l d0,a0
  MOVE.l currsp(pc),a1
  MOVE.l -(a1),-32(a0)
  SUBQ #4,a1
  MOVE.l a1,currsp
RTS

.do_ClearList1:
  !_disable
  MOVE.w d1,freelistmem
  BRA contclearlist

.do_ClearList:
  !_disable
  MOVE.w #0,freelistmem
  contclearlist:

  MOVE.l d0,a0              ; list pointer

  TST freelistmem : BEQ 'loop
    TST.w -34(a0) : BEQ err6  
    BSR recreatepool
    BRA 'done2
 'loop:
    MOVE.l -28(a0),a1       ; head of used items
    MOVE.l (a1),d1 : BEQ 'done

    BSR unlinkitem
    LEA -16(a0),a2          ; head of free items
    BSR linkitem
  BRA 'loop
 'done:
  CLR.l -32(a0) ; pointer to current list item
 'done2:
  !_enable
RTS 

; ==================================================================================
; internal function to be used by arrayslib
; ==================================================================================
.freelist:
  ;--
  ;-- free memory for whole pool and create a new one
  ;-- inputs pointer to list structure in D0, size list in D1
  ;--
  MOVEM.l a0-a1/a5-a6,-(a7)

  MOVEA.l d0,a1

  MOVE.l -40(a1),a0                       ; get poolheader Address
  CMP.l #0,a0 : BEQ 'nopool
    MOVEM.l d1/a1,-(a7)
    CLR.l -40(a1)  
    ALibJsr $C00A                         ; delete pool
    MOVEM.l (a7)+,d1/a1
 'nopool:          

  MOVEQ #40,d0                            ; free list structure
  SUB.l d0,a1                             ; get address of list memory
  ADD.l d1,d0                             ; calc memory size 40 + list data
  ALibJsr #localfree                      ; free it

  MOVEM.l (a7)+,a0-a1/a5-a6
RTS

.createlist: ; inputs: d3:size of requested listentries
             ;         d4:size of elementtype (given by compiler)

  MOVEM.l d2-d4,-(a7)
  MOVE.l #$10001,d0                        ; #MEMF_CLEAR & #MEMF_PUBLIC
  MOVE.l #2000,d1                        ; alloc at least 2000 bytes
  MOVE.l #2000,d2
  ;MOVE.l _execbase,a6 : JSR _CreatePool(a6)                   
  ALibJsr $C009                            ; create pool
  MOVEM.l (a7)+,d2-d4
  
  TST.l d0 : BEQ err7
  
  MOVE.l d0,a2                            ; poolheader to A2

  ;-- allocate memory for the linklist meta data
  MOVE.l #$10001,d1                       ; #MEMF_CLEAR & #MEMF_PUBLIC
  MOVEQ #40,d0                            ; 40 bytes is for the meta data...
  ADD.l d3,d0                             ; OLDSTYLE: alloc memory for number of entries if no pool is available
  ALibJsr #localalloc
  MOVE.l d0,a0                            ; allocated memory addr in a0

  ;-- fill the list meta data .....
  MOVE.l a2,0(a0)                         ; write poolheader in list structure

  SWAP d4
  CLR.w d4
  SWAP d4
  MOVE.w d4,4(a0)                         ; write size of type into list structure

  MOVE.l d0,a2
  LEA 40(a2),a0
  MOVE.l a0,-(a7)                         ; store pointer to data in order to return it later

  ;--
  ;-- Empty out the IN-USE list, FREE list, and set ID
  ;--
  MOVE.l a0,a1                            ; get the beginning and the end of the memory area
  ADD.l d3,a1                             ; add size of requested entries
                                          ; this is for the reparation of all links for each element

  LEA  4 + 8(a2),a3 : MOVE.l a3,12 + 8(a2) : ADDQ #4,a3 : MOVE.l a3, 4 + 8(a2)
  LEA 16 + 8(a2),a3 : MOVE.l a3,24 + 8(a2) : ADDQ #4,a3 : MOVE.l a3,16 + 8(a2)
  MOVE.l #"lIsT",28 + 8(a2)                 ; $6c497354

  ;--
  ;-- Create the entries for all list elements
  ;--
  LEA 20 + 8(a2),a2                       ; tail node

  MOVEQ #0,d1
 'loop:                                   ; insert a0 node before a2 node
    ;
    MOVE.l 4(a2),a3                       ; old last of tail
    ;
    MOVE.l a2,(a0)                        ; new next of me
    MOVE.l a3,4(a0)                       ; new last of me
    ;
    MOVE.l a0,4(a2)                       ; new last of tail
    MOVE.l a0,(a3)                        ; new next of old last
    ADDQ.l #1,d1
    ADD.l d4,a0
  CMP.l a1,a0 : BCS 'loop

  ;-- if 0 elements are requested, use the dynamic pooling!
  CMP.l #1,d1 : BNE 'l1
    MOVE.w #1,-22(a2)                     ; -$16(a2)
 'l1

  MOVE.l (a7)+,a0                         ; store pointer to data 
RTS

.recreatepool:
  ;--
  ;-- free memory for whole pool and create a new one
  ;--
  MOVEA.l d0,a1                           ; get list pointer
  MOVE.l -40(a1),a0                       ; get poolHeader

  CMP.l #0,a0 : BEQ 'nopool               ; if not poolheader is available skip all 
    MOVE.l a1,-(a7)                       ; store pointer to list
    CLR.l -16(a1)                         ; clear pointer to free items list
    CLR.l -28(a1)                         ; clear pointer to used items list
    CLR.l -40(a1)                         ; clear pooladdress
    ;MOVE.l _execbase,a6 : JSR _DeletePool(a6)
    ALibJsr $C00A                         ; delete pool

    ;-- create a new pool
    MOVE.l #$10001,d0                     ; #MEMF_CLEAR & #MEMF_PUBLIC
    MOVE.l ##pool_puddlesize,d1           ; alloc at least 2000 bytes
    MOVE.l ##pool_threshsize,d2
    ;MOVE.l _execbase,a6 : JSR _CreatePool(a6)                   
    ALibJsr $C009                         ; get new pool

    MOVE.l (a7)+,a1                       ; store pointer to list

    MOVE.l d0,-40(a1)                     ; write new poolheader to list structure

    MOVEA.l a1, a2
    SUB.l #40,a2
    LEA 40(a2),a0

    ;--
    ;-- Empty out the IN-USE list, FREE list, and set ID
    ;--
    LEA  4 + 8(a2),a3 : MOVE.l a3,12 + 8(a2) : ADDQ #4,a3 : MOVE.l a3, 4 + 8(a2)
    LEA 16 + 8(a2),a3 : MOVE.l a3,24 + 8(a2) : ADDQ #4,a3 : MOVE.l a3,16 + 8(a2)
    MOVE.l #"lIsT",28 + 8(a2)                 ; $6c497354

    ;--
    ;-- Create the entries for all list elements
    ;--
    LEA 20 + 8(a2),a2

    MOVE.l 4(a2),a3                       ; old last of tail
    ;
    MOVE.l a2,(a0)                        ; new next of me
    MOVE.l a3,4(a0)                       ; new last of me
    ;
    MOVE.l a0,4(a2)                       ; new last of tail
    MOVE.l a0,(a3)                        ; new next of old last

 'nopool
RTS



.do_ResetList:
  MOVE.l d0,a0
  CLR.l -32(a0)
RTS

.do_ResetPtrList:      ;reset a list
  MOVE.l d0,a0:
  !checklist{a0}
  CLR.l -32(a0)
RTS


.do_CountItem:              ; d0=array base, return number of current item, 0 =if not in list
  !_disable
  MOVE.l d0,a0
  MOVE.l -32(a0),d0 : BEQ 'done      ; no current item?
    MOVE.l d0,d2
    MOVEQ #0,d1
    MOVE.l -28(a0),d0
   'loop
      MOVE.l d0,a0
      MOVE.l (a0),d0 : BEQ 'done               ; last!
        ADDQ.l #1,d1
    CMP.l a0,d2 : BNE 'loop
    MOVE.l d1,d0
 'done
  !_enable
RTS

.do_CountList:               ; d0=array base! return how many items in list
  !_disable
  MOVE.l d0,a0
  MOVE.l -28(a0),d1
  
  MOVEQ #-1,d0
 'loop
    ADDQ.l #1,d0
    MOVE.l d1,a0
    MOVE.l (a0),d1
  BNE 'loop

  !_enable
RTS

.do_FirstItem:              ; ok, d0=array base. make current=first
  !_disable
  MOVE.l d0,a0

  do_FirstItem2:
  MOVE.l -28(a0),a1         ; a1=head of used items
  MOVE.l (a1),d0
  BNE 'skip
    MOVE.l d0,a1
 'skip:
  MOVE.l a1,-32(a0)
  !_enable
  TST.l d0
  BEQ 'knob
    MOVEQ #-1,d0
 'knob
RTS

.do_LastItem:               ; d0 = array base. make current=last
  !_disable
  MOVE.l d0,a0

  do_LastItem2:
  MOVE.l -20(a0),a1         ; a1 = prev of tail node
  MOVE.l 4(a1),d0 : BNE 'skip
    MOVE.l d0,a1
 'skip:
  MOVE.l a1,-32(a0)

  !_enable
  TST.l d0 : BEQ 'knob
    MOVEQ #-1,d0
 'knob:
RTS

.unlinkitem:                    ;item to unlink in a1
  MOVE.l 4(a1),a2
  MOVE.l (a1),a3
  MOVE.l a2,4(a3)
  MOVE.l a3,(a2)
RTS

.linkitem:                      ;link item in a1 after a2
  MOVE.l (a2),a3
  MOVE.l a1,(a2)
  MOVE.l a1,4(a3)
  MOVE.l a2,4(a1)
  MOVE.l a3,(a1)
RTS

.do_KillItem:                   ; must be a current item to kill!
                                ; set current to previous of me after killing it
  !_disable

  MOVE.l d0,a0                  ; which list ?
  MOVE.l -32(a0),a1             ; current item
  MOVE.l 4(a1),-(a7)            ; old previous of current

  MOVE.l a3,-(a7)
  BSR unlinkitem                ; remove from used...
  LEA -16(a0),a2
  BSR linkitem                  ; add to free

  MOVE.l (a7)+,a3
  MOVE.l (a7)+,a1
  MOVE.l 4(a1),d0 : BNE 'skip
    MOVE.l d0,a1
 'skip:
  MOVE.l a1,-32(a0)

  !_enable
RTS

.do_AddItem:                    ; if no current, add at beginning
  !_disable
  MOVE.l d0,a0
  MOVE.l -16(a0),a1             ; next of free nodes
  MOVE.l (a1),d0 : BNE 'l1      ; if no memory left get now one

  TST.w -34(a0) : BEQ 'done     ; check if it is a linked list
    BSR increase
    MOVE.l -16(a0),a1
    MOVE.l (a1),d0
   'l1:
    MOVE.l a3,-(a7)
    BSR unlinkitem
    MOVE.l -32(a0),d0 : BNE 'skip  ; head of free items
      LEA -28(a0),a2            ; head node of used items
      MOVE.l a2,d0
   'skip:
    MOVE.l d0,a2
    BSR linkitem
    MOVE.l (a7)+,a3
    MOVE.l a1,-32(a0)           ; set to current item
    MOVEQ #-1,d0
 'done:
  !_enable
RTS
 
.increase:
  !_enable
  MOVEM.l a0-a2/a6/d2,-(a7)

  MOVE.l a0,a2                    ; list pointer
  MOVE.l -40(a2),a0               ; get poolHeader, is 0 if no kick2.0
  
  MOVEQ #0,d0
  MOVE.w -36(a2),d0               ; size of datatype to add to list
  ADDQ.l #8,d0                    ; internal data for prev/next pointer

  MOVEQ #incnum,d1                ; number of entries to alloc mem for

  MOVE.w is32bitCPU(PC),d2        ; calc d0 * d1
  TST.w d2 : BNE '32bit_available
    BSR mulunsigned
    BRA '32bitend
 '32bit_available
    MULU.l d1,d0
 '32bitend

  MOVE.l d0,d2                    ; requested memsize in d0 & d2
  ;MOVEA.l _execbase,a6 : JSR _AllocPooled(a6)            ; d0 = AllocPooled(a0=poolHeader,d0=memSize)
  ALibJsr $C00B

  TST.l d0 : BEQ noinc
    !_disable
    ;MOVE.l d0,-16(a2)
    MOVE.l d0,a0                  ; address of allocated memory

    MOVE.l a0,a1
    SUBQ.l #8,d2                  ; a1 = address + (memsize - 8)
    ADD.l d2,a1

    MOVEQ #0,d2
    MOVE.w -36(a2),d2             ; size of datatype
    ADDQ.l #8,d2                  ; d2 = type size + 8

                                  ; add new free entries to list of free entries
    LEA -12(a2),a2                ; get tail of free of current list
   'loop:                         ; insert a0 node before a2 node
      MOVE.l 4(a2),a3             ;   old last of tail
      MOVE.l a2,(a0)              ;   new next of me
      MOVE.l a3,4(a0)             ;   new last of me
      MOVE.l a0,4(a2)             ;   new last of tail
      MOVE.l a0,(a3)              ;   new next of old last
      ADD.l d2,a0                 ; add (size of entry + next/prev-pointers)
    CMP.l a1,a0 : BCS 'loop
    MOVEM.l (a7)+,a0-a2/a6/d2
    RTS

  noinc:
  MOVEM.l (a7)+,a0-a2/a6/d2
  ADDQ.l #4,a7
RTS

.mulunsigned:         ;Input d0:d1 = values, d0=Return
  MOVEM.l d2/d3,-(a7)
  MOVE.w  d1,d2       ; mul lower bytes
  MULU    d0,d2
  MOVE.l  d1,d3
  SWAP    d3          ; mul higher bytes
  MULU    d0,d3
  SWAP    d3
  CLR.w   d3
  ADD.l   d3,d2
  SWAP    d0
  MULU    d1,d0
  SWAP    d0
  CLR.w   d0
  ADD.l   d2,d0
  MOVEM.l (A7)+,d2/d3
RTS


.do_AddFirst:                  ; add an item at the beginning of the list.
  !_disable
  MOVE.l d0,a0

  MOVE.l -16(a0),a1            ; head node of free
  MOVE.l (a1),d0 : BNE 'l1     ; if no free entry left, get now one
    TST.w -34(a0) : BEQ 'done  ; check it is a linked list
    BSR increase
    MOVE.l -16(a0),a1          ; head node of free
    MOVE.l (a1),d0
 'l1:

  MOVE.l a1,-32(a0)            ; set new entry as current

  MOVE.l a3,-(a7)
  BSR unlinkitem               ; remove from free entries list

  LEA -28(a0),a2               ; head node of in use
  BSR linkitem                 ; add it to the in-use list

  MOVE.l (a7)+,a3
  MOVEQ #-1,d0

 'done:
  !_enable
RTS

.do_AddLast:                   ; add item at end of the list
  !_disable
  MOVE.l d0,a0
  MOVE.l -16(a0),a1            ; next of free
  MOVE.l (a1),d0
  BNE 'l1                      ; if no item left, get some new ones

  TST.w -34(a0) : BEQ 'done    ; else check if it is a dynamic list
    BSR increase               ; increase buffer
    MOVE.l -16(a0),a1          
    MOVE.l (a1),d0
   'l1:
    MOVE.l a1,-32(a0)
    MOVE.l a3,-(a7)
    BSR unlinkitem
    MOVE.l -20(a0),a2          ; prev of tail of used
    BSR linkitem
    MOVE.l (a7)+,a3
    MOVEQ #-1,d0
 'done:
  !_enable
RTS


.do_NextItem:
  !_disable
  MOVE.l d0,a0

  MOVE.l -32(a0),d0 : BEQ do_FirstItem2             ; if no current, do first item.

  MOVE.l d0,a1
  MOVE.l (a1),a1                ; get next of current
  MOVE.l (a1),d0 : BEQ 'done
    MOVE.l a1,-32(a0)
    MOVEQ #-1,d0
 'done:
  !_enable
RTS

.do_NextItemFast:
  MOVE.l d0,a0
  MOVE.l -32(a0),d0 : BEQ do_FirstItemfast  ; if no current, do first item.

  MOVE.l d0,a1
  MOVE.l (a1),a1        ; get next of current
  MOVE.l (a1),d0 : BEQ 'done
    MOVE.l a1,-32(a0)
    MOVEQ #-1,d0
 'done:
RTS

.do_FirstItemfast:
  MOVE.l -28(a0),a1 ;a1=head of used items
  MOVE.l (a1),d0 : BNE 'skip
    MOVE.l d0,a1
 'skip:
  MOVE.l a1,-32(a0)
  TST.l d0 : BEQ 'knob:
    MOVEQ #-1,d0
 'knob
RTS

.do_SetItem:
  MOVE.l d0,a0
  SUBQ.l #8,d1
  MOVE.l d1,-32(a0)
RTS

.do_GetItem:
  MOVE.l d0,a0
  MOVE.l -32(a0),d0
  ADDQ.l #8,d0
RTS


.do_PrevItem                         ; if no current, do last item.
  !_disable
  MOVE.l d0,a0
  MOVE.l -32(a0),d0 : BEQ do_LastItem2

  MOVE.l d0,a1
  MOVE.l 4(a1),a1                    ; previous of current
  MOVE.l 4(a1),d0 : BEQ 'done
    MOVE.l a1,-32(a0)
    MOVEQ #-1,d0
 'done:
  !_enable
RTS


.do_SortList2:
  TST.w d2 : BEQ do_SortList
    MOVE.w #1,reverseOrder
    BRA sortlist3

.do_SortList ; d0: ptr to array, d1: size of element
  MOVE.w #0,reverseOrder

  sortlist3:
  !_disable
  MOVE d1,d6                             ; size of element
  MOVEM.l a4-a6,-(a7)
  MOVE.l d0,a0
  SUB.l #24,d0
  LEA -28(a0),a0                        ; head of used items
  CMP.l(a0),d0 : BEQ dun                ; check if first entry is empty

  dopass:
    MOVE.l (a0),a1
    MOVEM.l (a1),a2-a3
    CMP.l a2,d0 : BEQ dun
      MOVE.l (a2),a4
      MOVE.l 8(a1,d6),d1                ; size of element ?

      MOVEQ #0,d3               ;d3=flag
      CMP.l d3,a3 : BNE nxpass
        TRAP #0
      nxpass:

      MOVE.l 8(a2,d6),d2

      TST.w reverseOrder : BEQ 'normal
        CMP.l d1,d2 : BPL doswap
        BRA 'revdone
      'normal
        CMP.l d1,d2 : BMI doswap
      'revdone
      MOVE.l d2,d1

      nxitem:
      CMP.l d0,a4 : BEQ dunpass
        MOVE.l a1,a3
        MOVE.l a2,a1
        MOVE.l a4,a2
        MOVE.l (a2),a4
        BRA nxpass
      dunpass:
    MOVE.l a2,d0
  TST d3 : BNE dopass

  dun:
  !_enable
  MOVEM.l (a7)+,a4-a6
RTS

.doswap:
  MOVE.l a2,(a3)
  MOVEM.l a1/a3,(a2)
  MOVE.l a2,4(a1)
  MOVE.l a4,(a1)
  MOVE.l a1,4(a4)
  EXG a1,a2
  MOVEQ #1,d3
BRA nxitem

.do_Swapitems
  TST.l d0 : BEQ quitswap
  TST.l d1 : BEQ quitswap
  CMP.l d0,d1 : BEQ quitswap
  
  MOVEM.l a1-a3,-(a7)  
  !_disable

  SUBQ.l #8,d0        ; we do not start at the data, but at the internal entrypoint!
  SUBQ.l #8,d1

  ;--
  MOVE.l d0, a1       ; el1
  MOVE.l 4(a1),-(a7)  ; store link to old previous of el1
  BSR unlinkitem

  MOVE.l d1, a1       ; el2
  MOVE.l 4(a1),-(a7)  ; store link to old previous of el2
  BSR unlinkitem

  MOVE.l (a7)+,a2
  MOVE.l d0, a1
  BSR linkitem        ; link a1 after a2

  MOVE.l (a7)+,a2
  MOVE.l d1, a1
  BSR linkitem        ; link a1 after a2

  !_enable
  MOVEM.l (a7)+,a1-a3

  quitswap:
RTS

.do_islist:
  !_disable

  MOVE.l d0,a0
  MOVEQ #0,d0

  CMP.l #"lIsT",-4(a0) : BNE 'done
  
  MOVEQ #-1,d0
  TST.w -34(a0) : BEQ 'done
    MOVEQ #-2,d0
 'done

  !_enable
RTS


;******************** ERROR CHECKING ***********************

err1: MOVE.l #mess1,d0 : TRAP #0
err2: MOVE.l #mess2,d0 : TRAP #0
err3: MOVE.l #mess3,d0 : TRAP #0
err4: MOVE.l #mess4,d0 : TRAP #0
err5: MOVE.l #mess5,d0 : TRAP #0
err6: MOVE.l #mess6,d0 : TRAP #0
err7: MOVE.l #mess7,d0 : TRAP #0

errors:
mess1: Dc.b "Array or pointer is not a List",0,0
mess2: Dc.b "No Current Item",0
mess3: Dc.b "Current Stack overflow",0,0
mess4: Dc.b "Current Stack Empty",0
mess5: Dc.b "Wrong Array on Stack",0,0
mess6: Dc.b "Not a dynamic list",0,0
mess7: Dc.b "Could not alloc mempool for linked list",0
Even

.popchk:
  MOVE.l currsp(pc),a0
  CMP.l currstack(pc),a0 : BLS err4
  CMP.l -8(a0),d0 : BNE err5
BRA lchk

.pushchk:
  MOVE.l currsp(pc),a0
  SUB.l maxstack(pc),a0
  CMP.l currstack(pc),a0 : BCC err3
BRA lchk

.lchk2:
  MOVE.l d0,a0
  TST.l -32(a0) : BEQ err2

.lchk:
  MOVE.l d0,a0
  CMP.l #"lIsT",-4(a0) : BNE err1
RTS
