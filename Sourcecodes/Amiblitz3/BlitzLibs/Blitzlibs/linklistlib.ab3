#_execbase                   = $4

Macro _disable
  MOVE.l _execbase,a6
  JSR _Disable(a6)
End Macro

Macro _enable
  ;MOVE #$c000,$dff09a ; old code of BB2
  JSR _Enable(a6)
End Macro

Macro checklist
  CMP.l #"lIsT",-4(`1) : BNE err1
End Macro
;
;   LINKED LISTS LIBRARY
;
;list format is as follows
;00    -40.l  : poolheader for listmem
;04.l (-36.w) : size of type
;06.l (-34.w) : mode 0 =oldlist 1=dynamic list
;08.l (-32.l) : current item, 0 If none
;12.l (-28.l) : List head node of in use
;16.l (-24.l) : List tail node of in use
;20.l (-20.l) : ?
;24.l (-16.l) : List head of free
;28.l (-12.l) : List tail of free
;32.l (-08.l) : ?
;36.l (-04.l) : "lIsT"     an identifier to detect wrong use of pointers
;40.l (-00.l) : Begin of list data

#incnum = 6                 ; number of entries to increase the memory pool
#pool_puddlesize = 2000     ; puddlesize of the memorypool for each list
#pool_threshsize = 2000     ; threshsize of the memorypool for each list
;20/8/93
;added SortList command to sort lists on the first long in item
;really pleased with this one (see isometric demo)

