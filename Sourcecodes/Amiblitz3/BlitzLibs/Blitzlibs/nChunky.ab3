; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = "Blitz3:BlitzLibs/UserLibs"
; ExeFile         = "nChunky_new.obj"
; CreateIcon      = 0
; Residents       = "libnums.res,libjsrs.res,libmacs.res,LVO.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 1
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 13
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 0
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 0
; AutoRun         = 0
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 283
; CursorColumn    = 1
; LabelSearch     = ""
; LabelRemark     = 0
; LabelAll        = 0
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max Shape       = 100
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 20
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 5
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 4
; Max Window      = 20
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; /XTRA
; ===========================================================================
; Note on the chunky-to-planar routines (c2p) - comparison of 2026-11-05
; (derived from the source code, NOT measured on a real Amiga)
;
; Estimated ranking for 320 x 200 x 8 bitplanes on AGA, fast -> slow:
;   1. c2p040_320_200      (nC2P.ab3)        single pass, longword writes
;   2. ChunkyToBitMap      (chunkylib.ab3)   single pass, but byte writes
;   3. NChunkyToBitmapV40  (nChunky.ab3)     OS WriteChunkyPixels
;   4. NChunkyToBtm        (BDChunkyLib.ab3) WritePixelArray8 + temp BitMap per call
;   5. ChunkyToPlanar      (QuickLib.ab3)    8 passes, bits gathered one by one
; (3. and 4. depend on the Kickstart version and installed system patches)
;
;   NChunkyToBitmapV40 / NChunkyToBitmapV39:
;   - no c2p routine of its own: V40 calls WriteChunkyPixels (graphics V40),
;     V39 calls WritePixelArray8 (graphics V39) of the operating system
;   - on AGA without a graphics card this is the generic software c2p of
;     the OS, usually slower than a specialised c2p; speed depends on the
;     Kickstart version and system patches
; ===========================================================================

!libheader{#nchunkylib,0,0,finit,0}

!acommand{#long}
!args{#long,#word,#word}
!libs
!subs{do_nchunkybuffer,0,0}
!name{"NChunkyBuffer","(#Buffer, Width, Height) - Allocate a chunky buffer"}

!astatement
!args{#word,#word,#long,#word,#word}
!libs
