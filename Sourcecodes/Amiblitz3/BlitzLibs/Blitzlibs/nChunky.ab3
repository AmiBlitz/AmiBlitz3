!name{"NChunkyBlock","ShapeWidth, ShapeHeight, ShapeAddress, X, Y"}

!astatement
!args{#byte}
!libs
!subs{do_nchunkycls,0,0}
!args{#byte,#word,#word}
!libs
!subs{do_nchunkycls2,0,0}
!name{"NChunkyCls","Colour [,FirstRow, NumRows]"}

!astatement
!args{#word,#word,#byte}
!libs
!subs{do_nchunkyplot,0,0}
!name{"NChunkyPlot","X, Y, Colour"}

!astatement
!args{#long}
!libs
