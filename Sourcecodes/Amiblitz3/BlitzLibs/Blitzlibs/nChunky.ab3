!name{"NInitChunky","(#NumObjectMax)"}

!astatement
!args{#long}
!libs
!subs{do_nfreechunkybuffer,0,0}
!name{"NFreeChunkyBuffer","#Buffer"}

!afunction{#long}
!args
!libs
!subs{do_nchunkyid,0,0}
!name{"NChunkyID","- Return the chunkybuffer memory pointer"}

!astatement
!args{#word,#word,#word,#word,#byte}
