; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = "Blitz3:BlitzLibs/Decompiled/baselibs"
; ExeFile         = "utillib_new.obj"
; CreateIcon      = 0
; Residents       = "libjsrs.res,libnums.res,libmacs.res,LVO.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 64000
; MakeSmallest    = 1
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 3288
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8192
; RuntimeDebug    = 0
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 0
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 61
; CursorColumn    = 20
; LabelSearch     = ""
; LabelRemark     = 0
; LabelAll        = 1
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 25
; Max GadgetList  = 5
; Max Shape       = 100
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 25
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 30
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max Window      = 25
; Max BitMap      = 1
; Max Screen      = 5
; Max Palette     = 4
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; /XTRA

; TODO: move CreateMsgPort/DelteMsgPort to amiga_lib
; 

ABSEXECBASE EQU $4
!libheader{#utillib,init,3,finit,0}
 
!afunction{#long}
!args{#string}
!libs
!subs{do_createmsgport,0,0}
!name{"CreateMsgPort"," *UserPort.port=CreateMsgPort(PortName$)"}

!astatement
!args{#long}
!libs
!subs{do_deletemsgport,0,0}
!name{"DeleteMsgPort"," *UserPort"}

!acommand{#long}
!args
!libs
!subs{do_wait,0,0}
!name{"Wait", ""}

!afunction{#string}
!args{#long}
!libs
!subs{do_taskname,0,0}
!name{"TaskName$","task"}

init:  !nullsub{codeinit,0,0}
finit: !nullsub{codefinit,0,0}

!libfin

; =======================================================================
.do_taskname:
  TST.L D0 : BNE.w LAB_0004
    MOVEA.L ABSEXECBASE,A6
    SUBA.L A1,A1
    JSR _FindTask(A6)
    MOVEA.L D0,A0
  LAB_0004:
  MOVEA.L D0,A0
  MOVEA.L 10(A0),A0
  MOVEQ #0,D0
  LAB_0005:
    ADDQ.L #1,D0
    MOVE.b (A0)+,D1
    MOVE.b D1,(A3)+
  TST.b D1 : BNE.w LAB_0005
  SUBQ.L #1,D0
RTS

.codeinit:
  CLR.L receivedSignals
  MOVE.L #receivedSignals,D0
RTS

.do_wait:
  MOVEA.L ABSEXECBASE,A6
  SUBA.L A1,A1
  JSR _FindTask(A6)
  MOVEA.L D0,A0
  MOVE.L 18(A0),D0
  JSR _Wait(A6)
  MOVE.L D0,receivedSignals
RTS

receivedSignals: Dc.l $00000000
LAB_0009: Dc.l $00000000
          Dc.l $00000000

.codefinit:
    MOVEA.L #LAB_0009,A0
    MOVE.L (A0),D0
    TST.L D0 : BEQ.w LAB_000B
    
	ADDI.L #$00000008,D0
    JSR do_deletemsgport
  BRA.w codefinit
  LAB_000B:
RTS

.do_createmsgport:
  MOVEA.L D0,A3					  ; pointer to given portname
  MOVEM.L D1-D7/A1-A6,-(A7)
  MOVE.L D0,-(A7)

  MOVE.L #$0000002a,D0
  MOVE.L #$00010001,D1
  ALibJsr #globalalloc
  TST.L D0 : BEQ.w errorMem
 
  MOVEA.L D0,A5
  ADDA.L #$00000008,A5
  MOVE.L #$ffffffff,D0
  MOVEA.L ABSEXECBASE,A6
  JSR _AllocSignal(A6)
  TST.L D0 : BEQ.w errorSignal
  MOVE.b D0,15(A5)                ; MsgPort\mp_SigBit
 
  SUBA.L A1,A1
  MOVEA.L ABSEXECBASE,A6
  JSR _FindTask(A6)
  MOVE.L D0,16(A5)                ; MsgPort\*mp_SigTask
 
  MOVE.b #$00,14(A5)
  MOVE.b #$00,9(A5)               ; MspPort\node\ln_Pri
  MOVE.b #$04,8(A5)               ; MsgPort\Node\ln_Type
  ;-- init MsgList
  LEA 20(A5),A0                   ; MsgPort\mp_MsgList
  MOVE.L A0,8(A0)
  ADDQ.L #4,A0
  CLR.L (A0)
  MOVE.L A0,-(A0)
  MOVEA.L (A7)+,A3
  TST.b (A3) : BEQ.w LAB_000E 
 
  MOVEA.L 32(A7),A4
  MOVE.L -4(A4),D0
  ADDI.L #$00000005,D0
  MOVE.L D0,D6
  MOVE.L #$00010001,D1
  ALibJsr #globalalloc
  TST.L D0 : BEQ.w errorMem2
 
  ADDI.L #$00000004,D0
  MOVEA.L D0,A0
  MOVEA.L A0,A6
  MOVE.L D6,-4(A0)
  MOVE.L -4(A4),D0
  LAB_000D:                       ; copy name to Msgport stucture
    MOVE.b (A3)+,(A0)+
  DBF D0,LAB_000D
  MOVE.L A6,10(A5)                ; MsgPort\node\ln_name
  MOVEA.L A5,A1
  MOVEA.L ABSEXECBASE,A6
  JSR _AddPort(A6)

  LAB_000E:
  BSR.w LAB_0014  ;28c: 61000088
  MOVE.L A5,D0   ;290: 200d
  SUBA.L #$00000008,A5  ;292: 9bfc00000008
  MOVE.L A5,(A0)   ;298: 208d
  MOVE.L A0,4(A5)  ;29a: 2b480004
  MOVEM.L (A7)+,D1-D7/A1-A6 ;29e: 4cdf7efe
  RTS    ;2a2: 4e75

  errorSignal:
  MOVEA.L A5,A1   ;2a4: 224d
  MOVE.L #$00000022,D0  ;2a6: 203c00000022
  ALibJsr #globalfree
  MOVEA.L (A7)+,A0  ;2b2: 205f
  MOVEM.L (A7)+,D1-D7/A1-A6 ;2b4: 4cdf7efe
  MOVE.L #LAB_0013,D0 : TRAP #0

  errorMem:
  MOVEA.L (A7)+,A0
  errorMem2:
  MOVEM.L (A7)+,D1-D7/A1-A6
  MOVE.L #LAB_0012,D0 : TRAP #0

LAB_0012: Dc.b "Failed to allocate memory for Port",0,0
LAB_0013: Dc.b "Failed to allocate signal for Port",0,0

LAB_0014:
  MOVEA.L #LAB_0009,A1
  LAB_0015:
    MOVEA.L A1,A0
    MOVEA.L (A0),A1
  CMPA.L #$00000000,A1 : BNE.w LAB_0015
RTS

.do_deletemsgport:
  MOVEM.L D0-D7/A0-A6,-(A7)
  MOVEA.L D0,A5
  
  TST.L 10(A5) : BEQ.w LAB_0017
    MOVEA.L A5,A1
    MOVEA.L ABSEXECBASE,A6
    JSR _RemPort(A6)
    MOVEA.L 10(A5),A1         ; free port name string
    SUBA.L #$00000004,A1
    MOVE.L (A1),D0
    ALibJsr #globalfree
  LAB_0017:

  MOVEQ #0,D0
  MOVE.b 15(A5),D0
  MOVEA.L ABSEXECBASE,A6
  JSR _FreeSignal(A6)

  SUBA.L #$00000008,A5
  MOVEA.L 4(A5),A0
  MOVE.L (A5),(A0)
  MOVEA.L (A5),A1
  CMPA.L #$00000000,A1 : BEQ.w LAB_0018
    MOVE.L A0,4(A1) 
  LAB_0018:
  MOVEA.L A5,A1   
  MOVE.L #$0000002a,D0
  ALibJsr #globalfree
  MOVEM.L (A7)+,D0-D7/A0-A6 
RTS
 