.do_cplot: ; d0:Chunky#, d1:x, d2:y [,d3:color.l],[d3:red.b, d4:green.b, d5:blue.b]
  MOVE.B D3,D5 
  MOVE.W D3,D4 
  LSR.W #8,D4
  SWAP D5 
do_cplot2:
  MOVE.L 0(A3),D0 : BEQ.W LAB_000A 
    MOVEA.L D0,A0 : ADDA.W D1,A0   
    MOVE.W 22(A3),D0                       ;width16
    MULU #$0003,D2 
    MULU D0,D2   
    ADDA.L D2,A0 : MOVE.B D3,(A0)
    ADDA.W D0,A0 : MOVE.B D4,(A0)
    ADDA.W D0,A0 : MOVE.B D5,(A0)
  LAB_000A:
RTS

.do_gplot:
 MOVE.L 8(A3),D0 : BEQ.W LAB_000C
   MOVEA.L D0,A0  
   MULU 22(A3),D2 
   ADDA.L D2,A0
   MOVE.B D3,0(A0,D1.W)
 LAB_000C:
RTS

.do_cpoint:
 MOVE.L 0(A3),D0 : BEQ.W LAB_000A 

 MOVEA.L D0,A0   ;07b2: 2040
 MOVEQ #0,D0   ;07b4: 7000
 ADDA.W D1,A0   ;07b6: d0c1
 MOVE.W 22(A3),D1  ;07b8: 322b0016
 MULU #$0003,D2  ;07bc: c4fc0003
 MULU D1,D2   ;07c0: c4c1
 ADDA.L D2,A0   ;07c2: d1c2
 MOVE.B (A0),D0   ;07c4: 1010
 ASL.L #8,D0   ;07c6: e180
 ADDA.W D1,A0   ;07c8: d0c1
 MOVE.B (A0),D0   ;07ca: 1010
 ASL.L #8,D0   ;07cc: e180
 ADDA.W D1,A0   ;07ce: d0c1
 MOVE.B (A0),D0   ;07d0: 1010
RTS    ;07d2: 4e75

.do_gpoint:
 MOVE.L 8(A3),D0 : BEQ.W LAB_000C
 
 MOVEA.L D0,A0
 MULU 22(A3),D2
 ADDA.L D2,A0
 MOVE.B 0(A0,D1.W),D0
RTS

codeinit:
 MOVE.L #$00010000,D0      ; 65536 bytes
 MOVEQ #0,D1
 ALibJsr #globalalloc
 MOVE.L D0,LAB_001A : BEQ.W LAB_0017

 MOVEA.L D0,A0
 MOVEQ #7,D0
 MOVEQ #23,D4
 
 LAB_0010:
   MOVEQ #0,D1
   ADDQ.W #1,D4

   LAB_0011:
     MOVEQ #0,D2
     MOVEQ #0,D3
     MOVE.W #$0007,D5
    
     LAB_0012:
   	   BTST D5,D1 : BEQ.W LAB_0013
         BSET D4,D2
   	   LAB_0013:
   	   SUBI.W #$0008,D4 : BMI.W LAB_0014
     DBF D5,LAB_0012
     LAB_0014:
  
     SUBQ.W #1,D5
     ADDI.W #$0020,D4
     LAB_0015:
       BTST D5,D1 : BEQ.W LAB_0016
         BSET D4,D3
       LAB_0016:
       SUBI.W #$0008,D4
     DBF D5,LAB_0015
     ADDI.W #$0020,D4
     MOVE.L D2,(A0)+
     MOVE.L D3,(A0)+
     ADDI.B #$01,D1 
   BNE.W LAB_0011 
 DBF D0,LAB_0010
 LAB_0017:
RTS

codefinit:
  MOVE.L LAB_001A(PC),D0 : BEQ.W LAB_0019
    MOVEA.L D0,A1 
    MOVE.L #$00010000,D0
    ALibJsr #globalfree
    CLR.L LAB_001A
  LAB_0019:
RTS
LAB_001A: Dc.l $00000000

;NEWTYPE.chunky
; memaddress8.l  ;0
; memsize8.l    ;4
; memaddress24  ;8
; memsize24.l       ;12
; width    ;16
; height            ;18
; flags             ;20
; width16           ;22
;End NEWTYPE

.do_initchunky: ;d0:Chunky#,d1:width,d2:height,d3:flags (1=24bit 2=8bit)
  MOVEM.W D1-D3,16(A3)
  ADDI.W #$000f,D1 
  AND.W #$fff0,D1  
  MOVE.W D1,22(A3)  

  BSR.W do_freechunky 

  BTST #0,D3 : BEQ.W LAB_001C  ; 24bit mode
 MOVE.W 22(A3),D0  ;0894: 302b0016
 MULU #$0003,D0    ;0898: c0fc0003
 MULU 18(A3),D0    ;089c: c0eb0012
 MOVE.L D0,4(A3)   ;08a0: 27400004
 MOVEQ #1,D1       ;08a4: 7201
 SWAP D1           ;08a6: 4841
 ALibJsr #globalalloc     ;08a8: 4eb98000c002
 MOVE.L D0,0(A3)   ;08ae: 27400000
  LAB_001C:

  BTST #1,D3 : BEQ.W LAB_001D    ; 8bit mode
 MOVE.W 22(A3),D0  ;08ba: 302b0016
 MULU 18(A3),D0    ;08be: c0eb0012
 MOVE.L D0,12(A3)  ;08c2: 2740000c
 MOVEQ #1,D1       ;08c6: 7201
 SWAP D1           ;08c8: 4841
 ALibJsr #globalalloc     ;08ca: 4eb98000c002
 MOVE.L D0,8(A3)   ;08d0: 27400008
  LAB_001D:
RTS

.do_freechunky:
  MOVE.L 0(A3),D0 : BEQ.W LAB_001F
    MOVEA.L D0,A1   ;08de: 2240
    MOVE.L 4(A3),D0 ;08e0: 202b0004
    BEQ.W LAB_001F  ;08e4: 67000008
      ALibJsr #globalfree
  LAB_001F:

  CLR.L 0(A3)       ;08ee: 42ab0000
  CLR.L 4(A3)       ;08f2: 42ab0004
  MOVE.L 8(A3),D0 : BEQ.W LAB_0020
   MOVEA.L D0,A1     ;08fe: 2240
   MOVE.L 12(A3),D0  ;0900: 202b000c
   BEQ.W LAB_0020    ;0904: 67000008
      ALibJsr #globalfree
  LAB_0020:
  CLR.L 8(A3)       ;090e: 42ab0008
  CLR.L 12(A3)      ;0912: 42ab000c
RTS

.do_chunkyloc:
  MOVE.L 0(A3),D0
RTS

