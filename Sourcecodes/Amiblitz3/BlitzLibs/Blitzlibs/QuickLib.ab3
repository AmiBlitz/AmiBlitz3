; /XTRA
; QuickLib v1.21  by Giuseppe Perniola

;this lib is obsolete, as ...
;  the multiply/division-routines have been implemented into AmiBlitz3s standard lmulib/ldivlib and will be used on OPTIMIZE 1
;  QPlot has been integrated into scrollib
;  WLimit/WWrap has been integrated into vallib
;  the c2p routines are about 50% slower than the routines in chunkylib and can easily be substituted

!libheader{#QuickLib,0,0,0,0}

!afunction{#quick}
!args{#quick,#quick}
!libs
!subs{_QAdd,0,0}
!name{"QAdd","(First,Second)"}

!afunction{#quick}
!args{#quick,#quick}
!libs
!subs{_QSub,0,0}
!name{"QSub","(First,Second)"}

!afunction{#quick}
!args{#quick,#quick}
!libs
!subs{_QMul020,0,0}
!name{"QMul020","(First,Second)"}

!afunction{#quick}
!args{#quick,#quick}
!libs
!subs{_QDiv020,0,0}
!name{"QDiv020","(First,Second)"}

!afunction{#word}
!args{#word,#word,#word}
!libs
!subs{_WWrap,0,0}
!name{"WWrap","(Word,Low,High)"}

!afunction{#word}
!args{#word,#word,#word}
!libs
!subs{_WLimit,0,0}
!name{"WLimit","(Word,Low,High)"}

!astatement
!args{#word,#word,#word,#byte}
!libs{#bitmaplib,$1080}
!subs{_QPlot,_CheckErrorQPlot,0}
!name{"QPlot","Bitmap#,X,Y,Plane"}

!afunction{#long}
!args{#word}
!libs{#QuickLib,$1080}
!subs{_ChunkyBuffer,_CheckErrorChunkyBuffer,0}
!name{"ChunkyBuffer","(ChunkyBuffer#)",_toke}

!afunction{#long}
!args{#word}
!libs{#QuickLib,$1080}
!subs{_ChunkyBufferSize,_CheckErrorChunkyBufferSize,0}
!name{"ChunkyBufferSize","(ChunkyBuffer#)"}

!astatement
!args{#word,#word}
!libs{#QuickLib,$1080,#bitmaplib,$1181}
!subs{_InitChunkyBuffer,_CheckErrorInitChunkyBuffer,0}
!name{"InitChunkyBuffer","ChunkyBuffer#,Bitmap#"}

!astatement
!args{#word}
!libs{#QuickLib,$1280}
!subs{_ChunkyToPlanar,_CheckErrorChunkyToPlanar,0}
!name{"ChunkyToPlanar","ChunkyBuffer#"}

!astatement
!args{#word}
!libs{#QuickLib,$1080}
!subs{_ClearChunkyBuffer,_CheckErrorClearChunkyBuffer,0}
!name{"ClearChunkyBuffer","ChunkyBuffer#"}

!astatement
!args{#word}
!libs{#QuickLib,$1080}
!subs{_FreeChunkyBuffer,_CheckErrorFreeChunkyBuffer,0}
!name{"FreeChunkyBuffer","ChunkyBuffer#"}

_free:!nullsub{0,0,0}

!libfin{_toke,0,0,0,_free,2,5}

; ===========================================================================

NEWTYPE .ChunkyBuffer
  _depth.w
  _size.l
  _addressChunkyBuffer.l
  _addressBitmap.l
  _sizeChunkyBuffer.l
End NEWTYPE

._QAdd:
  ADD.l d1,d0
RTS

._QSub:
  SUB.l d1,d0
RTS

._QMul020:
  MOVE.l d1,d3
  MOVE.l d0,d1
  MOVEQ #0,d2

  Dc.l $4c013c02 ; MULS.L D1,D2:D3
  MOVE.W D2,D3
  SWAP D3
  
  MOVE.l d3,d0
RTS

._QDiv020:
  MOVE.l d0,d3

  SWAP D3
  MOVE.L D3,D2
  EXT.L D2
  MOVE.W #$0000,D3
  Dc.l $4c413c02 ; ;DIVS.L D1,D2:D3  

  MOVE.l d3,d0
RTS

._WWrap:
  CMP.w d1,d0 : BGE Esci00
    SUB.w d1,d0
    ADD.w d2,d0
    BRA Esci01
  Esci00:
  CMP.w d2,d0 : BLT Esci01
    SUB.w d2,d0
    ADD.w d1,d0
  Esci01:
RTS

._WLimit:
  CMP.w d1,d0 : BGE Esci04
    MOVE.w d1,d0
    BRA Esci05
  Esci04:
  CMP.w d2,d0 : BLT Esci05
    MOVE.w d2,d0
  Esci05:
RTS

._QPlot: ; a0:selected Bitmap,d1:X,d2:Y,d3:Plane
  MOVE.w 0(a0),d0
  MULU d0,d2
  ASL.w #2,d3
  MOVEA.l 4(a0,d3.w),a0
  MOVEQ #0,d4
  MOVE.w d1,d4
  LSR.w #3,d4
  ADD.l d4,d2
  ADDA.l d2,a0
  ASL.w #3,d0
  SUBQ.w #1,d0
  SUB.w d1,d0
  BSET.b d0,0(a0)
RTS

._ChunkyBuffer:
  MOVE.l 6(a0),d0
RTS

._ChunkyBufferSize:
  MOVE.l 14(a0),d0
RTS

._InitChunkyBuffer:
  MOVEM.w 0(a1),d0-d2
  SUBQ.w #1,d2
  MOVE.w d2,0(a0)
  MOVE.w d0,d3
  MULU d1,d0
  LSR.l #2,d0
  SUBQ.l #1,d0
  MOVE.l d0,2(a0)
  LSL.l #3,d3
  MULU d1,d3
  MOVE.l d3,14(a0)
  MOVE.l d3,d0
  MOVE.l #65536,d1
  ALibJsr #globalalloc
  MOVE.l d0,6(a0)
  MOVE.l 8(a1),10(a0)
RTS

._ChunkyToPlanar:
  MOVEQ #0,d2
  MOVE.w 0(a2),d2
  MOVE.l 2(a2),d0
  MOVEA.l 10(a2),a0
  MOVEA.l 6(a2),a2
  MOVE.l #$1010101,d4
  Loop03:
    SWAP d2
    MOVEA.l a2,a1
    MOVE.l d0,d3
    Loop01:
      MOVEQ #7,d5
      MOVEQ #0,d6
      Loop02:
        LSL.l #4,d6
        MOVE.l (a1)+,d7
        AND.l d4,d7
        LSR.l d2,d7
        OR.b d7,d6
        LSR.l #7,d7
        OR.b d7,d6
        LSR.l #7,d7
        OR.b d7,d6
        LSR.l #7,d7
        OR.b d7,d6
      DBRA d5,Loop02
      MOVE.l d6,(a0)+
    DBRA d3,Loop01
    ADDQ.w #1,d2
    LSL.l #1,d4
    SWAP d2
  DBRA d2,Loop03
RTS

._ClearChunkyBuffer:
  MOVE.l 14(a0),d0
  LSR.l #2,d0
  SUBQ.l #1,d0
  MOVEA.l 6(a0),a0
  Loop04:
    MOVE.l #0,(a0)+
  DBRA d0,Loop04
RTS

._FreeChunkyBuffer:
  MOVE.l 14(a0),d0
  MOVEA.l 6(a0),a1
  ALibJsr #globalfree
  MOVEQ #0,d0
  MOVE.w d0,0(a0)
  MOVE.l d0,2(a0)
  MOVE.l d0,6(a0)
  MOVE.l d0,10(a0)
  MOVE.l d0,14(a0)
RTS

; ==============================================================
_CheckErrorQPlot:
  TST.w 0(a0) : BEQ _Error1
  TST.w d1 : BLT _Error2
  TST.w d2 : BLT _Error2
  TST.w d3 : BLE _Error3
  MOVEQ #0,d4
  MOVE.w 0(a0),d4
  ASL.w #3,d4
  CMP.w d1,d4 : BLE _Error2
  MOVE.w 2(a0),d4
  CMP.w d2,d4 : BLE _Error2
  MOVE.w 4(a0),d4
  CMP.w d3,d4 : BLT _Error3
RTS

_CheckErrorChunkyBuffer:
  TST.w 0(a0) : BEQ _Error4
RTS

_CheckErrorInitChunkyBuffer:
  TST.w 0(a0) : BNE _Error5
  TST.w 0(a1) : BEQ _Error1
RTS

_CheckErrorChunkyToPlanar:
  TST.w 0(a2) : BEQ _Error4
RTS

_CheckErrorChunkyBufferSize:
  TST.w 0(a0) : BEQ _Error4
RTS

_CheckErrorClearChunkyBuffer:
  TST.w 0(a0) : BEQ _Error4
RTS

_CheckErrorFreeChunkyBuffer:
  TST.w 0(a0) : BEQ _Error4
RTS

_Error1: MOVE.l #Error1,d0 : TRAP #0
_Error2: MOVE.l #Error2,d0 : TRAP #0
_Error3: MOVE.l #Error3,d0 : TRAP #0
_Error4: MOVE.l #Error4,d0 : TRAP #0
_Error5: MOVE.l #Error5,d0 : TRAP #0

Error1: Dc.b "Uninitialized Bitmap",0
Error2: Dc.b "Coords outside of Bitmap",0
Error3: Dc.b "Illegal number of Planes",0
Error4: Dc.b "Uninitialized ChunkyBuffer",0
Error5: Dc.b "ChunkyBuffer already initialized",0
