; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = "Development:AmiBlitz3/BlitzLibs/Userlibs"
; ExeFile         = "arrayslib_new.obj"
; CreateIcon      = 0
; Residents       = "libmacs.res,libjsrs.res,LVO.res,libnums.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 1
; FuncOptimize    = 1
; Version         = 0.0.0
; NumberOfBuilds  = 18
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 0
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 1
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 180
; CursorColumn    = 1
; LabelSearch     = "00a"
; LabelRemark     = 0
; LabelAll        = 1
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max Shape       = 100
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 5
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 5
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max Window      = 5
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 4
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; /XTRA
#_execbase        = $4
#createlinkedlist = $4024
#freelinkedlist   = $4025

!syslibheader{#arrayslib,$c400,$c407,init,0,0,0}
!nullsub{do_newarr,0,0}              ; $C400
!nullsub{do_newlocarr,0,0}           ; $C401
!nullsub{do_arrmult,0,0}             ; $C402 
!nullsub{do_newlist,0,0}             ; $C403
!nullsub{do_newloclist,0,0}          ; $C404 
!nullsub{do_newarr2,0,0}             ; $C405
!nullsub{do_newlocarr2,0,0}          ; $C406

init:!nullsub{codeinit,0,0}          ; $C407
!libfin

;******************** CODE BELOW *****************

;
;A List looks like this!
;
;-8.l : poolheader
;-4.l : size
;00.l : Current
;04.l : \
;08.l :  > - freaky list header for items in existance
;12.l : /
;16.l : \
;20.l :  > - freaky list header for free items
;24.l : /
;28.l : "lIsT" : list ID

;           40 long

.codeinit:
RTS

.do_newlocarr:
  MOVE.b #1,localmode
  EXG a4,a5
  BSR do_newarrb
  EXG a4,a5
RTS

.do_newarr:
  CLR.b localmode
.do_newarrb
  MOVE.l 0(a5,d2),d0 : BEQ 'skip
    MOVE.l d0,a1
    MOVE.l 0(a5,d3),d0              ; if array address and size is set delete the old array first
    TST.b localmode : BNE 'm10
      ALibJsr #globalfree
      BRA 'l5
   'm10
      ALibJsr #localfree
   'l5
 'skip:
  MOVE.l 0(a5,d3),d0                ; requestes data size
  MOVE.l #$10001,d1                 ;#MEMF_CLEAR & #MEMF_PUBLIC
  TST.b localmode : BNE 'm1
    ALibJsr #globalalloc
    BRA 'm2
 'm1:
    ALibJsr #localalloc             
 'm2
  MOVE.l d0,0(a5,d2)
RTS

.do_newlocarr2:
  MOVE.b #1,localmode
  EXG a4,a5
  BSR do_newarr2b
  EXG a4,a5
RTS
localmode: Dc.w 0

.do_newarr2:
  CLR.b localmode
.do_newarr2b
  MOVE.l a6,-(a7)
  MOVE.l 0(a5,d2),d0 : BEQ 'skip:    ;(a5,d3) =size  (a5,d2)=addr
    MOVE.l d0,-(a7)
    MOVE.l d1,-(a7)
    MOVE.l _execbase,a6
    JSR _Forbid(a6)

    MOVE.l #$20000,d1            ;#MEMF_LARGEST
    JSR _AvailMem(a6)            ;get largest free block
    MOVE.l d0,d1

    MOVE.l 0(a5,d3),d0           ; requested size + 200000 ? why ?
    ADD.l #200000,d0

    CMP.l d1,d0 : BLT 'c1        ; if less than requested size is available return with 0 in d0
      ADDQ #8,a7
      JSR _Permit(a6)
      MOVEQ #0,d0
      BRA 'l1
   'c1
      MOVE.l 0(a5,d3),d0              ;requested size
      MOVE.l #$10001,d1               ;#MEMF_CLEAR & #MEMF_PUBLIC
      TST.b localmode : BNE 'm1
        ALibJsr #globalalloc
        BRA 'm2
     'm1:
        ALibJsr #localalloc
     'm2 
      MOVE.l d0,0(a5,d2) : BEQ 'l5      ; copy new memory adress to 0(a5,d2)
        MOVE.l (a7)+,d1                 ; old size of array 
        MOVE.l (a7),a0                  ; old memory location of array
        MOVE.l d0,a1                    ; new memory location of array
        MOVE.l 0(a5,d3),d0              ; new size of array
        CMP.l d0,d1 : BGT 'l4           ; if array is smaller, new size to copy
          EXG.l d0,d1
       'l4
        JSR _CopyMem(a6)                ; copy old data: a0:source, a1:dest, d0:size

        MOVE.l (a7)+,a1                 ; old memory location of array
        MOVE.l 0(a5,d3),d0              ; new size of array will be ignored by free function
        TST.b localmode : BNE 'm10
          ALibJsr #globalfree
          BRA 'l5
       'm10
          ALibJsr #localfree
     'l5
      JSR _Permit(a6)
      BRA 'l1
 'skip:
    MOVE.l 0(a5,d3),d0
    MOVE.l #$10001,d1
    ALibJsr #localalloc
    MOVE.l d0,0(a5,d2)                  ; store address in basic var list
 'l1
  MOVE.l (a7)+,a6
RTS

.do_arrmult:
  ADDQ #1,d1
  MOVE.l d0,d2
  MULU d1,d0
  SWAP d2
  MULU d1,d2
  SWAP d2
  ADD.l d2,d0
RTS

.do_newloclist:                           ;A4: listsize
  MOVE.b #1,localmode
  EXG a4,a5
  BSR do_newlist
  EXG a4,a5
RTS

.do_newlist:
; a5: pointer basic varlist
; d2: index in varlist to use for initialized list structzre
; d3: index in varlist containing size of array
; d4: size of element ?
  
  CLR.b localmode
  
  MOVE.l 0(a5,d2),d0 : BEQ 'skip           ; address of array, if already used free all memory of it
    MOVE.l 0(a5,d3),d1                     ; size of list (elements*size)
    ALibJsr #freelinkedlist                ; function in linklistlib
 'skip

  MOVEM.l d2-d4/a5,-(a7)                    ; store registers used by compiler
  
  MOVE.l 0(a5,d3),d3                        ; requested data size of list
  ;MOVE.l d4,d4                             ; size of each element of the list (datatype), comes from compiler
  ALibJsr #createlinkedlist
  
  MOVEM.l (a7)+,d2-d4/a5
  
  MOVE.l a0,0(a5,d2)                        ; write list pointer into basic var list

RTS

.do_newlist_old:
; a5: pointer basic varlist
; d2: index in varlist to use for initialized list structzre
; d3: index in varlist containing size of array
; d4: size of element ?
  CLR.b localmode
  MOVE.l 0(a5,d2),d0 : BEQ 'skip          ; address of array, if already used free all memory of it
    MOVE.l d0,a1
    MOVE.l 0(a5,d3),d1                    ; size of list (elements*size)
    BSR freelist                
 'skip

  BSR createlist
RTS

.freelist: ; pointer to list structure in A1, size list in D1
  MOVE.l -40(a1),-(a7)                    ; store poolAddress

  SUB.l #40,a1                            ; get address of list memory
  MOVEQ #40,d0                            ; free list structure
  ADD.l d1,d0                             ; calc memory size 40 + list data
  ALibJsr #localfree                      ; free it

  MOVE.l (a7)+,a0                         ; do we have an additional pool?
  CMP.l #0,a0 : BEQ 'nopool
    MOVE.l a6,-(a7)
    ;MOVE.l _execbase,a6 : JSR _DeletePool(a6)                 
    ALibJsr $C00A
    MOVE.l (a7)+,a6
 'nopool:           
RTS

.createlist:
  MOVEM.l d2-d3/a5,-(a7)
  MOVE.l #$10001,d0                     ; #MEMF_CLEAR & #MEMF_PUBLIC
  MOVE.l #2000,d1                      ; alloc at least 2000 bytes
  MOVE.l #2000,d2
  ;MOVE.l _execbase,a6 : JSR _CreatePool(a6)                   
  ALibJsr $C009
  MOVEM.l (a7)+,d2-d3/a5
  
  TST.l d0 : BNE 'cont
    TRAP #0
    RTS
 'cont:

  MOVE.l d0,a2                            ; poolheader to A2

                                          ;-- allocate memory for the linklist meta data
  MOVE.l #$10001,d1                       ; #MEMF_CLEAR & #MEMF_PUBLIC
  MOVEQ #40,d0                            
  ADD.l 0(a5,d3),d0                       ; OLDSTYLE: alloc memory for number of entries if no pool is available
  ALibJsr #localalloc
  MOVE.l d0,a0                            ; allocated memory addr in a0

                                          ;-- fill the list meta data .....
  MOVE.l a2,0(a0)                         ; write poolheader in list structure

  SWAP d4
  CLR.w d4
  SWAP d4
  MOVE.w d4,4(a0)                         ; write size of type into list structure

  MOVE.l d0,a2
  LEA 40(a2),a0
  MOVE.l a0,0(a5,d2)                      ; write pointer to data into basic varlist

  ;--
  ;-- Empty out the IN-USE list, FREE list, and set ID
  ;--
  MOVE.l a0,a1
  ADD.l 0(a5,d3),a1                       ; add size of requested entries


  LEA  4 + 8(a2),a3 : MOVE.l a3,12 + 8(a2) : ADDQ #4,a3 : MOVE.l a3, 4 + 8(a2)
  LEA 16 + 8(a2),a3 : MOVE.l a3,24 + 8(a2) : ADDQ #4,a3 : MOVE.l a3,16 + 8(a2)
  MOVE.l #"lIsT",28 + 8(a2)                 ; $6c497354

  ;--
  ;-- Create the entries for all list elements
  ;--
  LEA 20 + 8(a2),a2                       ; tail node

  MOVEQ #0,d1
 'loop:                                   ; insert a0 node before a2 node
    ;
    MOVE.l 4(a2),a3                       ; old last of tail
    ;
    MOVE.l a2,(a0)                        ; new next of me
    MOVE.l a3,4(a0)                       ; new last of me
    ;
    MOVE.l a0,4(a2)                       ; new last of tail
    MOVE.l a0,(a3)                        ; new next of old last
    ADDQ.l #1,d1
    ADD.l d4,a0
  CMP.l a1,a0 : BCS 'loop

  ;-- if 0 elements are requested, use the dynamic pooling!
  CMP.l #1,d1 : BNE 'l1
    MOVE.w #1,-22(a2)                     ; -$16(a2)
 'l1
RTS

