#MAXBULLETS = 0
NEWTYPE .bullet
  counter.l
  x.w
  y.w
;  speed.w
;  active.w
;  v.b
;  xdir.w
;  ydir.w
;  frame.w
End NEWTYPE

NPrint "size of element: ", SizeOf.bullet

NPrint "Creating dynamic list..."
Dim List bullet.bullet(4)
NPrint "bullet, isList: " ,IsList(bullet())

counter.w = 0
While AddLast(bullet()) AND counter < 6

  bullet()\counter = counter
  counter + 1
Wend

NPrint "added elements: ", counter

DefaultInput
Print "Press enter: "
a$ = Edit$(2)

End
