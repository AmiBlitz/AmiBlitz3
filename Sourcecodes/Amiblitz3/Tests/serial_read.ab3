OPTIMIZE 4
XINCLUDE "serial_device.include.ab3"

device.s = "serial.device"
If serial_Open {0,device.s,0,9600}
  NPrint "serial open ..."

  received.s = "hallo\\n" + Chr$(13)
  serial_WriteMem{0,&received,Len(received)}
  received = ""

  While t < 10
    While serial_GetData{0} : Wend

    _reclength.w = serial_GetDataLength{0}
    _recdata.s = PeekS(serial_GetDataPtr{0},_reclength)
    NPrint _reclength, ": ", _recdata

    Delay_ 100 : t + 1
  Wend

  NPrint "close."
  serial_Close {0}
Else
  NPrint "ERROR: Unable to open ",device.s
End If
Delay_ 100
End
