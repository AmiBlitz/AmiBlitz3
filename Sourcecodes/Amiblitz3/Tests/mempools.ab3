; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = ""
; ExeFile         = ""
; CreateIcon      = 1
; Residents       = "all.res"
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 0
; FuncOptimize    = 0
; Version         = 0.0.0
; NumberOfBuilds  = 21
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 0
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 1
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 2
; CursorColumn    = 15
; LabelSearch     = ""
; LabelRemark     = 0
; LabelAll        = 0
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max Shape       = 100
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 20
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 5
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max Window      = 20
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 32
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; /XTRA
NPrint "OS Version ",KickVersion
;-- alloc pool
MOVEQ #0,d0
MOVE.l ##MEMF_CLEAR,d0
MOVE.l #2000,d1
MOVE.l #2000,d2
SysJsr $c009
mempool.l = PutD0
If mempool = 0
  NPrint "no pool allocated!"
  End
EndIf
NPrint "pool at: ",Hex$(mempool)

;-- alloc mem
GetD0 mempool
MOVE.l d0,a0
MOVE.l #1000,d0
SysJsr $c00b
memaddr.l = PutD0
If memaddr <> 0
  NPrint "allocated at: ",Hex$(memaddr)
  NPrint "read"
  For i.w = 0 To 100
   Print Hex$(Peek.b(memaddr+i))
  Next
  NPrint ""
  NPrint "write"
  For i.w = 0 To 100
   Poke.b memaddr+i,i
  Next

  DefaultOutput : DefaultInput : a$ = Edit$("Press enter: ", 1)
EndIf

;-- free memory
GetD0 mempool : MOVE.l d0,a0
GetD0 memaddr : MOVE.l d0,a1
GetD0 1000
SysJsr $c00c
NPrint "memory freed"

;-- delete pool
GetD0 mempool
MOVE.l d0,a0
;TRAP #5
SysJsr $c00a
NPrint "pool deleted"
End

