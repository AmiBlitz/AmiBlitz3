; /XTRA
#MAX = 1024
BitMap 0,16,16,7

NPrint "allocating shapes (maximum is " + Str$(Maximum Shape)+ ")"
MouseWait
For i.w = 0 To #MAX
  GetaShape i,0,0,16,16
Next

Free BitMap 0
NPrint "done"
MouseWait

NPrint "freeing shapes..."
For i.w = 0 To #MAX
  NPrint i
  Free Shape i
Next

NPrint "done"
End

