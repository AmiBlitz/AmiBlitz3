; Relocations inside a Chip section that follows a BSS section (#128):
; the longs of the chip data refer to the BSS, chip and code hunk and must
; be relocated in the chip hunk's own RELOC32 block.
; Expected output: "ref: -1 -1 -1"
a.l = ?zbss
b.l = ?zchip
c.l = ?lbl
lbl:
Poke.l a + 4, 77
NPrint "bss: ", Peek.l(a + 4), "  chip: ", Peek.w(b), " ", (TypeOfMem_(b) AND 2) <> 0
NPrint "ref: ", Peek.l(b + 2) = a, " ", Peek.l(b + 6) = b, " ", Peek.l(b + 10) = c
End
BSS
zbss: Ds.l 4
Chip
zchip: Dc.w 42
Dc.l zbss
Dc.l zchip
Dc.l lbl
