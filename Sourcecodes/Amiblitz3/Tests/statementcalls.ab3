OPTIMIZE 4 : SYNTAX 3
XINCLUDE "logging.include.ab3"

log_SetDestination{#log_toconsole}
log_SetLevel{#log_debug}
log_Init{"CON:400/400/1200/600"}

Statement NewListe{*listPtr.List}
  If *listPtr
    *listPtr\lh_Head     = &*listPtr\lh_Tail
    *listPtr\lh_Tail     = 0
    *listPtr\lh_TailPred = &*listPtr\lh_Head
  EndIf
End Statement

Function.List InitChooserList{}
  *list1.List = AllocMem_(SizeOf.List, #MEMF_PUBLIC)
  If *list1 Then NewListe{*list1}
  Function Return *list1
End Function


Statement AddChooserListEntry{*listPtr.List, entry.s}
  If *listPtr
    _tags.l = 0;VarArgs(#CNA_Text, StrAddr("hallo"), #TAG_DONE)

    *node.Node = AllocChooserNodeA_(_tags)
    If *node
      AddTail_ *listPtr, *node
      NPrint "added node ",Hex$(*node), " to list " , Hex$(*listPtr)
    Else
      NPrint "could not add"
    EndIf
  Else
    NPrint "cannot not process empty list pointer!"
  EndIf
End Statement

Statement FreeChooserLabels{*listPtr.List}

    If *listPtr
      *ln.Node = *listPtr\lh_Head
      Repeat
        *succ.Node = *ln\ln_Succ
        If Peek.l(*ln) <> 0
          FreeChooserNode_ *ln
          NPrint "freed node: ", Hex$(*ln)
        EndIf
        *ln = *succ
      Until *succ = 0

      FreeMem_ *listPtr, SizeOf.List
      NPrint "freed list at: ",Hex$(*listPtr)
    EndIf
End Statement

ttt.l = InitChooserList{}
NPrint "listpointer:",Hex$(ttt)
!log_HexDump{ttt,64}
AddChooserListEntry{ttt,"hallo"}
AddChooserListEntry{ttt,"hallo2"}
FreeChooserLabels{ttt}
MouseWait
End

