; XTRA
; Embedded .xtra Header
; 
; General Info
; -------------------------------------------------------
; ExePath         = ""
; ExeFile         = ""
; CreateIcon      = 1
; Residents       = ""
; 
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 0
; FuncOptimize    = 0
; Version         = 0.0.0
; NumberOfBuilds  = 6
; 
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 8191
; RuntimeDebug    = 1
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 1
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
; 
; Editor
; -------------------------------------------------------
; CursorLine      = 14
; CursorColumn    = 20
; LabelSearch     = ""
; LabelRemark     = 0
; LabelAll        = 0
; LabelCase       = 0
; LabelPosition   = 0
; 
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max Shape       = 100
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 20
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 5
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 32
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; Max Window      = 20
; /XTRA
BLITZ
BitMap 0,320,256,3
BitMapOutput 0
Slice 0,44,3
Show 0
BlitzKeys On

RGB 0,0,0,0
RGB 1,0,15,0

Repeat
  joy0_x.w = Joyx(0)
  joy0_y.w = Joyy(0)
  joyb0.w  = Joyb(0)

  joy1_x.w = Joyx(1)
  joy1_y.w = Joyy(1)
  joyb1.w  = Joyb(1)

  Cls 0
  Colour 1,0
  Locate 4,5
  NPrint "JOYSTICK-TEST"
  Locate 4,7
  NPrint "--- PORT 1"
  Locate 4,8
  NPrint "JOY X: ",joy0_x
  Locate 4,9
  NPrint "JOY Y: ",joy0_y
  Locate 4,10
  NPrint "JOY BUTTON: ",joyb0

  Locate 4,12
  NPrint "--- PORT 2"

  Locate 4,13
  NPrint "JOY X: ",joy1_x
  Locate 4,14
  NPrint "JOY Y: ",joy1_y
  Locate 4,15
  NPrint "JOY BUTTON: ",joyb1

  Locate 4,18
  NPrint "ESC: STOPPEN"
  VWait
Until RawStatus($45)

FreeSlices
Free BitMap 0
End
