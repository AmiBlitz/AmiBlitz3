; Relocations inside a Chip section that is followed by a BSS section
; (#128): the longs of the chip data refer to the BSS, Chip and code hunk
; and must be relocated in the chip hunk's own RELOC32 block.
;
; The program checks itself: every check prints "ok" or "FAILED", the last
; line is "PASSED" or "FAILED". An executable of a compiler with the bug
; prints FAILED or crashes.

failed.w = 0

Statement check{ok.w, what.s}
  SHARED failed
  If ok
    NPrint "ok      ", what
  Else
    NPrint "FAILED  ", what
    failed = failed + 1
  EndIf
End Statement

b.l = ?zchip
c.l = ?lbl
lbl:
a.l = ?zbss
check{Peek.l(a) = 0, "the BSS section is cleared"}
check{(TypeOfMem_(b) AND 2) <> 0, "the Chip section is in chip memory"}
check{Peek.w(b) = 42, "the data of the Chip section"}
check{Peek.l(b + 2) = a, "Dc.l in the Chip section to a BSS label"}
check{Peek.l(b + 6) = b, "Dc.l in the Chip section to a Chip label"}
check{Peek.l(b + 10) = c, "Dc.l in the Chip section to a code label"}

If failed = 0
  NPrint "PASSED"
Else
  NPrint "FAILED: ", failed, " check(s)"
EndIf
End

Chip
zchip: Dc.w 42
Dc.l zbss
Dc.l zchip
Dc.l lbl
BSS
zbss: Ds.l 4
