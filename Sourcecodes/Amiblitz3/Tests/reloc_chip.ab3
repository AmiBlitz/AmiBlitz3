; Relocations inside a Chip section without a BSS section (#128): the
; longs of the chip data refer to the chip and code hunk and must be
; relocated in the chip hunk's own RELOC32 block.
; Expected output: "ref: -1 -1"
b.l = ?zchip
c.l = ?lbl
lbl:
NPrint "chip: ", Peek.w(b), " ", (TypeOfMem_(b) AND 2) <> 0
NPrint "ref: ", Peek.l(b + 2) = b, " ", Peek.l(b + 6) = c
End
Chip
zchip: Dc.w 42
Dc.l zchip
Dc.l lbl
