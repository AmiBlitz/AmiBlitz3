; Relocations inside a Chip section without a BSS section (#128): the
; longs of the chip data refer to the Chip and code hunk and must be
; relocated in the chip hunk's own RELOC32 block.
;
; The program checks itself: every check prints "ok" or "FAILED", the last
; line is "PASSED" (return code 0) or "FAILED" (return code 10). An
; executable of a compiler with the bug prints FAILED or crashes.

failed.w = 0

Statement check{ok.w, what.s}
  SHARED failed
  If ok
    NPrint "ok      ", what
  Else
    NPrint "FAILED  ", what
    failed = failed + 1
  EndIf
End Statement

b.l = ?zchip
c.l = ?lbl
lbl:
check{(TypeOfMem_(b) AND 2) <> 0, "the Chip section is in chip memory"}
check{Peek.w(b) = 42, "the data of the Chip section"}
check{Peek.l(b + 2) = b, "Dc.l in the Chip section to a Chip label"}
check{Peek.l(b + 6) = c, "Dc.l in the Chip section to a code label"}

If failed = 0
  NPrint "PASSED"
  rc.l = 0
Else
  NPrint "FAILED: ", failed, " check(s)"
  rc.l = 10
EndIf
GetReg d0,rc
End d0

Chip
zchip: Dc.w 42
Dc.l zchip
Dc.l lbl
