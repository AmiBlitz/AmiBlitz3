OPTIMIZE 8
MOVEQ #5,d0
MOVEQ #3,d1
ADD d1,d0
ADDQ #1,d0
CMP #9,d0 : BCC.s ende
  SUBQ #2,d0

CMP #9,d0 : BNE.s ende
  SUBQ #2,d0

CMP #9,d0 : BEQ.s weiter
  SUBQ #2,d0
  BRA ende

Ds.b 70
weiter:

a.w = PutD0
NPrint a
ende:

                             MouseWait

