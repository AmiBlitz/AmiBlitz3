; /XTRA
OPTIMIZE 1
CachesOff 1
INCLUDE "eclock.include.ab3"

DEFTYPE.q a,b,c,d

a = 2.0
b = 4.0

NPrint "running tests ..."
For t.b = 1 To 3
  NPrint "pass ", t
  eclock_Start{1000}
  For i.l = 0 To 1000000
    c = a / b
    c = c / 5.0
  Next
  time.l = eclock_Stop{}
  NPrint "result: ", c
  NPrint "time:   ", time,"ms"
Next t
NPrint "done"
