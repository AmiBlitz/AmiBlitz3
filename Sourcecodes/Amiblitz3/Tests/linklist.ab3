#MAXBULLETS = 5
NEWTYPE .bullet
  counter.l
  x.w
  y.w
  speed.w
  active.w
  v.b
  xdir.w
  ydir.w
  frame.w
End NEWTYPE


NPrint "size ", SizeOf.bullet
Dim List bullet.bullet(#MAXBULLETS)
counter.w = 0
While AddLast(bullet())
    bullet()\counter = counter
    bullet()\active=False
    bullet()\speed=8
    bullet()\v=0
    bullet()\xdir=0
    bullet()\ydir=1
    bullet()\frame=2
    NPrint "added ", CountItem(bullet())
    counter + 1
Wend
NPrint "end"

;SortList bullet(),SizeOf.bullet\counter,True

ResetList bullet()
While NextItem(bullet())
    NPrint bullet()\counter
Wend
NPrint ".........................."

ResetList bullet()
;dummy.l = NextItem(bullet())
dummy.l = NextItem(bullet())
*t1.bullet = GetItem(bullet())
dummy.l = NextItem(bullet())
*t2.bullet = GetItem(bullet())

SwapItems *t1,*t2

ResetList bullet()
dummy.l = NextItem(bullet())
*t1.bullet = GetItem(bullet())
dummy.l = NextItem(bullet())
*t2.bullet = GetItem(bullet())

ResetList bullet()
While NextItem(bullet())
    NPrint bullet()\counter
Wend
MouseWait
End
