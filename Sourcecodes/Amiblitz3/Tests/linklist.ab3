#MAXBULLETS = 0
NEWTYPE .bullet
  counter.l
  x.w
  y.w
  speed.w
  active.w
  v.b
  xdir.w
  ydir.w
  frame.w
End NEWTYPE

NPrint "size of element: ", SizeOf.bullet

NPrint "Creating dynamic list..."

Dim List bullet.bullet(#MAXBULLETS)
ClearList bullet()


NPrint "Creating array..."
Dim test.l(100)
test(0) = $12345678
test(100)=$12345678
NPrint Hex$(&test)
NPrint Hex$(&bullet)
Gosub waitforkey


NPrint "bullet, isList: " ,IsList(bullet())
NPrint "test, isList: ", IsList(test())


ttt:
zzz.w + 1
NPrint "=========== Pass ", zzz
counter.w = 0
While AddLast(bullet()) AND counter<40
    bullet()\counter = counter
    bullet()\active=False
    bullet()\speed=8
    bullet()\v=0
    bullet()\xdir=0
    bullet()\ydir=1
    bullet()\frame=2
;    NPrint "added ", CountItem(bullet())
    counter + 1
Wend
NPrint "added elements: ",CountList(bullet())
NPrint "allocated memory for list: ",(8 + SizeOf.bullet) * CountList(bullet()) + 40
memf.l = AvailMem_(0)
NPrint "Used mem: ", UsedMem," ", memf


ClearList bullet(),1
;Dim List bullet.bullet(#MAXBULLETS/2)
memf2.l = AvailMem_(0)
NPrint "used mem: ", UsedMem," ", memf2, ", freed ",memf2-memf
NPrint "cleared list"
If zzz<3 Then Goto ttt
Gosub waitforkey

;SortList bullet(),SizeOf.bullet\counter,True

ResetList bullet()
While NextItem(bullet())
    NPrint bullet()\counter
Wend
NPrint ".........................."

ResetList bullet()
;dummy.l = NextItem(bullet())
dummy.l = NextItem(bullet())
*t1.bullet = GetItem(bullet())
dummy.l = NextItem(bullet())
*t2.bullet = GetItem(bullet())

SwapItems *t1,*t2

ResetList bullet()
dummy.l = NextItem(bullet())
*t1.bullet = GetItem(bullet())
dummy.l = NextItem(bullet())
*t2.bullet = GetItem(bullet())

ResetList bullet()
While NextItem(bullet())
    NPrint bullet()\counter
Wend

Gosub waitforkey

End


.waitforkey:
  DefaultInput
  Print "Press enter: "
  NPrint Edit$(1)
Return
