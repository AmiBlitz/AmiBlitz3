; XTRA
; Version         = 1.2.3
; NumberOfBuilds  = 42
; /XTRA
OPTIMIZE 4
Macro cnt : NPrint "V-MAC-cnt `0" : End Macro
!cnt
!cnt{}
!cnt{a,b}
!cnt a,b,c
!cnt{f(1,2),3}
!cnt{a[1,2]}
!cnt{"x,y"}
Macro uq : NPrint "V-MAC-uq `@" : End Macro
!uq : !uq
!uq
Macro sp : NPrint "V-MAC-sp [`1|`2]" : End Macro
!sp{ x , y }
!sp{x}
Macro th
If `1 Then NPrint "V-MAC-then yes"
NPrint "V-MAC-then after"
End Macro
!th{0}
!th{1}
Macro ev : NPrint "V-MAC-ev `{1+1}" : End Macro
!ev{p,q}
Macro lt : NPrint "V-MAC-let `a`b`y" : End Macro
!lt{1,2,3,4,5,6,7,8,9,A,B}
Macro one : NPrint "V-MAC-one" : End Macro : NPrint "V-MAC-sameline"
!one
Macro ng : NPrint "V-MAC-neg ",`1 : End Macro
!ng -5
!ng $10
Macro hc ; header comment
NPrint "V-MAC-hc ok"
End Macro
!hc
Macro t1
NPrint "V-MAC-nest t1.1"
Macro t2
NPrint "V-MAC-nest t2"
End Macro
!t2
End Macro
!t1
!t2
Macro pc : NPrint "V-MAC-pc `:" : End Macro
!pc{a,b}
Macro sp2 : NPrint "V-MAC-sp2 [`1]" : End Macro
!sp2{ (a , b) }
End
