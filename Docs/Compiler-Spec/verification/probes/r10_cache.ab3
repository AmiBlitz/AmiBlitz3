; XTRA
; /XTRA
va.l = 5
MOVE.l #7,va@(a5)
vb.l = va
NPrint "R-1 global ",vb," (7 = no caching)"
va = 5 : MOVE.l #8,va@(a5) : vb = va
NPrint "R-2 same line ",vb," (8)"
va = 5 : vb = va + va : MOVE.l #9,va@(a5) : vc.l = va + vb
NPrint "R-3 after use ",vc," (19)"
Statement st{p.l}
  SHARED va,vb
  va = p
  MOVE.l #11,va@(a5)
  vb = va
  NPrint "R-4 in procedure ",vb," (11)"
End Statement
st{1}
For i.l = 1 To 2
  va = i : MOVE.l #20,va@(a5) : vb = va
  NPrint "R-5 loop ",vb," (20)"
Next
End
