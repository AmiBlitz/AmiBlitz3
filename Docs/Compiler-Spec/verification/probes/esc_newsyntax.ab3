; XTRA
; Version         = 1.2.3
; NumberOfBuilds  = 42
; /XTRA
OPTIMIZE 4
NPrint "V-ESC-0a [\41]"
NPrint "V-ESC-0b [\\41]"
NPrint "V-ESC-3a [\\R05*]"
NPrint "V-ESC-3b [\\R12-]"
NPrint "V-ESC-n  [\\n]"
NPrint "V-ESC-6a [\\\\]"
NPrint "V-ESC-6b [\\\\41]"
NPrint "V-ESC-hx [\\4e\\4E\\4a]"
NPrint "V-ESC-ci [\\__ver_major]"
NPrint "V-ESC-vr [\\__VER_MAJOR.\\__VER_MINOR.\\__VER_PATCH/\\__VER_BUILD]"
NPrint "V-ESC-vu [\\__VER_XXXXX]"
NPrint "V-ESC-tf [\\__THIS_FUNCTIONXY]"
NPrint "V-ESC-tp [\\__THIS_FUNCXYZABCD]"
NPrint "V-ESC-dt [\\__DATE__]"
NPrint "V-ESC-dg [\\__DATE_GER__]"
NPrint "V-ESC-cl [\\__CODELINE]"
Statement st{}
  NPrint "V-ESC-fn [\\__THIS_FUNCTION]"
End Statement
st{}
End
