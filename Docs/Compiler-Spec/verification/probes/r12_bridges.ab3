; XTRA
; /XTRA
NEWTYPE.ll
  lo.l
  hi.l
End NEWTYPE
DEFTYPE.ll n
Dim arr.ll(20)
va.l = 6 : vb.l = 3 : s$ = "hello" : fl.f = 1.5
Function.l fn{p.l}
  Function Return p*2
End Function
; register must survive a statement (longlong pattern: d3 across "x\lo = PutRegD0")
Macro keep
MOVE.l #$11112222,`1
`2
PutReg `1,kv.l
NPrint "K `3 `1 ",Hex$(kv)
End Macro
; register must survive PushD0 (ahi pattern: a6 across "PushD0 expr")
Macro keepp
MOVE.l #$11112222,`1
PushD0 `2
PutReg `1,kv.l
ADDQ.l #4,a7
NPrint "P `3 `1 ",Hex$(kv)
End Macro
; d0 after a statement (ABI candidate)
Macro dz
`1
PutReg d0,kv.l
NPrint "D `2 ",kv
End Macro
!keep{d2,n\lo = PutRegD0,A1}
!keep{d2,arr(va*2+vb)\lo = PutRegD0,A2}
!keep{d2,arr(fn{va}+Len(s$))\lo = PutRegD0,A3}
!keep{d3,n\lo = PutRegD0,A1}
!keep{d3,arr(va*2+vb)\lo = PutRegD0,A2}
!keep{d3,arr(fn{va}+Len(s$))\lo = PutRegD0,A3}
!keep{d4,n\lo = PutRegD0,A1}
!keep{d4,arr(va*2+vb)\lo = PutRegD0,A2}
!keep{d4,arr(fn{va}+Len(s$))\lo = PutRegD0,A3}
!keep{a0,n\lo = PutRegD0,A1}
!keep{a0,arr(va*2+vb)\lo = PutRegD0,A2}
!keep{a0,arr(fn{va}+Len(s$))\lo = PutRegD0,A3}
!keep{a1,n\lo = PutRegD0,A1}
!keep{a1,arr(va*2+vb)\lo = PutRegD0,A2}
!keep{a1,arr(fn{va}+Len(s$))\lo = PutRegD0,A3}
!keep{a6,n\lo = PutRegD0,A1}
!keep{a6,arr(va*2+vb)\lo = PutRegD0,A2}
!keep{a6,arr(fn{va}+Len(s$))\lo = PutRegD0,A3}
!keepp{d2,va,P1}
!keepp{d2,(va*vb+3)*(va-vb)/(vb+1),P2}
!keepp{d2,Len(s$+"x"),P3}
!keepp{d2,fl*2,P4}
!keepp{d3,va,P1}
!keepp{d3,(va*vb+3)*(va-vb)/(vb+1),P2}
!keepp{d3,Len(s$+"x"),P3}
!keepp{d3,fl*2,P4}
!keepp{a0,va,P1}
!keepp{a0,(va*vb+3)*(va-vb)/(vb+1),P2}
!keepp{a0,Len(s$+"x"),P3}
!keepp{a0,fl*2,P4}
!keepp{a6,va,P1}
!keepp{a6,(va*vb+3)*(va-vb)/(vb+1),P2}
!keepp{a6,Len(s$+"x"),P3}
!keepp{a6,fl*2,P4}
!dz{c.l = va*vb+3,D1 c=21}
!dz{c = fn{va},D2 c=12}
!dz{arr(2)\lo = va+vb,D3 =9}
!dz{c = Len(s$),D4 c=5}
!dz{PushD0 va+1,D5 =7 (stack!)}
ADDQ.l #4,a7
End
