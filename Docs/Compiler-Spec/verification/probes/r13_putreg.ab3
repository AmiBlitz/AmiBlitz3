; XTRA
; /XTRA
NEWTYPE.ll
  lo.l
  hi.l
End NEWTYPE
DEFTYPE.ll n
Dim arr.ll(20)
va.l = 6 : vb.l = 3 : s$ = "hello"
Function.l fn{p.l}
  Function Return p*2
End Function
MOVE.l #1234,d0
n\lo = PutRegD0
NPrint "B-1 ",n\lo," (1234)"
MOVE.l #2345,d0
arr(va*2+vb)\lo = PutRegD0
NPrint "B-2 ",arr(15)\lo," (2345)"
MOVE.l #3456,d0
arr(fn{va}+Len(s$))\lo = PutRegD0
NPrint "B-3 ",arr(17)\lo," (3456)"
MOVE.l #4567,d0
x.l = PutRegD0 + va
NPrint "B-4 ",x," (4573)"
y.l = 0
GetRegD0 va*vb+1
MOVE.l d0,y@(a5)
NPrint "B-5 ",y," (19)"
GetRegD0 va,vb,fn{va}
PutReg d1,z1.l : PutReg d2,z2.l
NPrint "B-6 ",z1," ",z2," (3 12)"
End
