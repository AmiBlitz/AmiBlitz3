; XTRA
; ExePath         = "RAM:"
; ExeFile         = "ide_argjoin"
; CreateIcon      = 0
; RuntimeDebug    = 0
; AutoRun         = 1
; /XTRA
OPTIMIZE 4
Macro cnt : NPrint "V-JOIN-6b `0 [`1|`2|`3]" : End Macro
If WriteFile(0,"SPEC:results/ide_argjoin.run.txt")
FileOutput 0
!cnt{a,@@
b}
NPrint "V-JOIN-6b end"
CloseFile 0
EndIf
End
