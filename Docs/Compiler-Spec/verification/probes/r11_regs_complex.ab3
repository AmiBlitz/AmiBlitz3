; XTRA
; /XTRA
va.l = 6 : vb.l = 3 : c.l = 0 : s$ = "abc"
Function.l fn{p.l}
  Function Return p*2
End Function
Function.l gn{p.l}
  q.l = ((p*3+1)*(p-2)+(p+4)*(p-1))/(p+2)
  Function Return q
End Function
Macro keep
MOVE.l #$11112222,`1
`2
PutReg `1,kv.l
NPrint "K `3 `1 ",Hex$(kv)
End Macro
