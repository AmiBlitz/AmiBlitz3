; XTRA
; Version         = 1.2.3
; NumberOfBuilds  = 42
; /XTRA
#X = 1
CNIF @#X
NPrint "V-CNIF-3a X defined"
CEND
CNIF @#Y
NPrint "V-CNIF-3b Y defined"
CELSE
NPrint "V-CNIF-3b Y undefined"
CEND
CNIF @#X = 1
NPrint "V-CNIF-3c @#X=1"
CEND
CNIF @#X = -1
NPrint "V-CNIF-3d @#X=-1"
CEND
NPrint "V-CNIF-4 a" : CNIF 0 : NPrint "V-CNIF-4 b" : CEND : NPrint "V-CNIF-4 c"
CNIF 0
NPrint "V-CNIF-5 one"
CELSE
NPrint "V-CNIF-5 two"
CELSE
NPrint "V-CNIF-5 three"
CEND
CSIF "abc" < "abd"
NPrint "V-CSIF-1 lt"
CEND
CSIF "ab" < "abc"
NPrint "V-CSIF-2 prefix lt"
CEND
CSIF "x" >< "y"
NPrint "V-CSIF-3 ne"
CEND
CNIF 0
Macro skipped : NPrint "no" : End Macro
CEND
CNIF 1 ; comment CEND
NPrint "V-CNIF-6 ok"
CEND
End
