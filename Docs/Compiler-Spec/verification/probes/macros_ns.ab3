; XTRA
; Version         = 1.2.3
; NumberOfBuilds  = 42
; /XTRA
OPTIMIZE 4
Macro cnt : NPrint "V-MAC-cnt `0" : End Macro
!cnt
!cnt{}
!cnt{a,b}
!cnt a,b,c
!cnt{f(1,2),3}
!cnt{a[1,2]}
!cnt{"x,y"}
!cnt{a,@@
 b}
Macro uq : NPrint "V-MAC-uq `@" : End Macro
!uq : !uq
!uq
Macro sp : NPrint "V-MAC-sp [`1|`2]" : End Macro
!sp{ x , y }
!sp{x}
Macro sq : ((`1)*(`1)) : End Macro
Macro hyp : Sqr(!sq{`1}+!sq{`2}) : End Macro
NPrint "V-MAC-rec ",!hyp{3,4}
Macro th
If `1 Then NPrint "V-MAC-then yes"
NPrint "V-MAC-then after"
End Macro
!th{0}
!th{1}
Macro ev : NPrint "V-MAC-ev `{1+1}" : End Macro
!ev{p,q}
Macro let : NPrint "V-MAC-let `a`b`y" : End Macro
!let{1,2,3,4,5,6,7,8,9,A,B}
Macro one : NPrint "V-MAC-one" : End Macro : NPrint "V-MAC-sameline"
!one
Macro neg : NPrint "V-MAC-neg ",`1 : End Macro
!neg -5
!neg $10
Macro hc ; header comment
NPrint "V-MAC-hc ok"
End Macro
!hc
Macro t1
NPrint "V-MAC-nest t1.1"
Macro t2
NPrint "V-MAC-nest t2"
End Macro
!t2
End Macro
!t1
!t2
End
